{
  "imports": {
    "wac/": "../wac/atoms/wac/"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run",
    "coverage": "deno run -A tools/coverage.ts",
    "mutate": "deno run -A tools/mutate.ts",
    "bench": "deno run -A tools/bench.ts",
    "bench:json": "deno run -A packages/json/bench/throughput.ts",
    "verify:fmt": "deno run -A packages/fmt/tools/sweep.ts",
    "coverage:json": "deno run -A packages/json/cov.ts",
    "coverage:fmt": "deno run -A packages/fmt/cov.ts",
    "coverage:bytes": "deno run -A packages/bytes/cov.ts"
  },
  "exclude": [
    ".cache"
  ]
}
