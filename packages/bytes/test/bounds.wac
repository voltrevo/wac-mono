// Fixture for the bounds traps, which cannot be tested from wac: a trap aborts the
// whole module, so each case needs its own call from the host.
import { Buf } from "../src/buf.wac";

export i32 getPastEnd() { Buf b = Buf.create(); b.push(1); return b.get(1); }
export i32 getNegative() { Buf b = Buf.create(); b.push(1); return b.get(0 - 1); }
export i32 getAtCapacityNotLength() {
  // Index inside the allocated array but past `len` — the case a naive bounds check
  // against data.len() rather than len would wrongly allow.
  Buf b = Buf.withCapacity(16);
  b.push(1);
  return b.get(5);
}
export i32 getOk() { Buf b = Buf.create(); b.push(42); return b.get(0); }

/** `pushRepeat` from before the buffer starts. */
export i32 pushRepeatBeforeStart() {
  Buf b = Buf.create();
  b.pushAll(u8[]('a', 'b'));
  b.pushRepeat(-1, 1);
  return b.len;
}

/**
 * `pushRepeat` whose source starts at the end.
 *
 * Not the same as a copy that *runs* past the end, which is legal and is how a run is spelled:
 * there the first byte read exists and the rest are written before they are read. Here the very
 * first byte read does not exist.
 */
export i32 pushRepeatPastEnd() {
  Buf b = Buf.create();
  b.pushAll(u8[]('a', 'b'));
  b.pushRepeat(2, 1);
  return b.len;
}

/** A negative count, which would otherwise just write nothing and hide a caller's arithmetic. */
export i32 pushRepeatNegativeCount() {
  Buf b = Buf.create();
  b.pushAll(u8[]('a', 'b'));
  b.pushRepeat(0, -1);
  return b.len;
}
