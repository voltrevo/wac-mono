// Write an ESTABLISH_INTRO cell to a file, so tor's own parser can judge it.
//
//   deno task app:build packages/tor/src/genintro.wac --allow-write -o /tmp/genintro.ts
//   deno run --allow-write /tmp/genintro.ts /tmp/cell.bin /tmp/vector.json
//   <estintro-probe built against libtor.a> /tmp/cell.bin <the KH from the vector>
//
// The same shape as `gendesc.wac` and for the same reason: the suite compares against committed
// bytes rather than running tor, because a test that needs a built tor tree turns the shared suite
// red for whoever has not got one. This is the half that regenerates them.
//
// Keys are derived from fixed seeds, so a change in the output is a change in the generator.

import { Core, Cli, Change, FileResult } from "../../platform/src/platform.wac";
import { itoa } from "../../fmt/src/itoa.wac";
import { encode as hexEncode } from "../../codec/src/hex.wac";
import { ed25519PublicKey } from "../../crypto/src/ed25519.wac";
import { decode as hexDecode } from "../../codec/src/hex.wac";
import { Introduce2, establishIntroCell, macSpanOf, parseIntroduce2, sigSpanOf } from "./hsservice.wac";

export i32 main(Core core, Cli cli) {
  if (cli.argCount().wait() < 2) {
    core.warn("usage: genintro <cell-out> <vector-out>");
    return 1;
  }
  string cellOut = string.fromBytes(cli.arg(0).wait());
  string vectorOut = string.fromBytes(cli.arg(1).wait());

  u8[] authSeed = seedFor(11);
  u8[] authPublic = ed25519PublicKey(authSeed);
  // Twenty bytes, the size of a circuit's `rend_circ_nonce`. Fixed, because the vector has to be
  // reproducible and the MAC covers it.
  u8[] kh = seedFor(12);
  u8[] khShort = u8[20]();
  for (i32 i = 0; i < 20; i++) { khShort[i] = kh[i]; }

  u8[] cell = establishIntroCell(authPublic, authSeed, khShort);
  if (cell.len() == 0) {
    core.warn("genintro: could not build the cell");
    return 1;
  }

  Change c = cli.writeFile(cellOut, cell).wait();
  if (!c.ok()) {
    core.warn("genintro: " + cellOut + ": " + c.message);
    return 1;
  }

  string json = "{\n" +
    "  \"note\": \"generated by packages/tor/src/genintro.wac; the spans are what tor's own " +
    "trn_cell_establish_intro_parse reports, via tools/estintro-probe.c\",\n" +
    "  \"authSeed\": \"" + hex(authSeed) + "\",\n" +
    "  \"authPublic\": \"" + hex(authPublic) + "\",\n" +
    "  \"circuitKH\": \"" + hex(khShort) + "\",\n" +
    "  \"cell\": \"" + hex(cell) + "\",\n" +
    "  \"macSpanLen\": " + itoa(macSpanOf(cell).len()) + ",\n" +
    "  \"sigSpanLen\": " + itoa(sigSpanOf(cell).len()) + "\n" +
    "}\n";
  Change v = cli.writeFile(vectorOut, json.toBytes()).wait();
  if (!v.ok()) {
    core.warn("genintro: " + vectorOut + ": " + v.message);
    return 1;
  }
  core.warn("genintro: wrote a " + itoa(cell.len()) + "-byte cell to " + cellOut);

  // Three more arguments turn this into the other half: read an INTRODUCE2 cell — one tor built — and
  // report what our service recovers from it. The comparison is against the values tor was *given*,
  // which is what makes it a check across the seam rather than a round trip through our own code.
  if (cli.argCount().wait() >= 5) {
    string cellPath = string.fromBytes(cli.arg(2).wait());
    u8[] encSecret = fromHex(cli.arg(3).wait());
    u8[] subcred = fromHex(cli.arg(4).wait());
    if (encSecret.len() != 32 || subcred.len() != 32) {
      core.warn("genintro: the secret and subcredential must each be 32 bytes of hex");
      return 1;
    }
    FileResult f = cli.readFile(cellPath).wait();
    if (!f.ok) {
      core.warn("genintro: " + cellPath + ": " + f.error);
      return 1;
    }
    Introduce2 got = parseIntroduce2(f.bytes, authPublic, encSecret, subcred);
    if (!got.ok) {
      cli.write("PARSE_FAILED\n".toBytes());
      return 1;
    }
    cli.write(("authKey " + hex(got.authKey) + "\n").toBytes());
    cli.write(("clientPublic " + hex(got.clientPublic) + "\n").toBytes());
    cli.write(("rendCookie " + hex(got.rendCookie) + "\n").toBytes());
    cli.write(("rendOnionKey " + hex(got.rendOnionKey) + "\n").toBytes());
    cli.write(("linkSpecifiers " + hex(got.linkSpecifiers) + "\n").toBytes());
    cli.write("PARSED\n".toBytes());
  }
  return 0;
}

/** Hex from a command line, or empty — a partial decode would be a key that is not the key. */
u8[] fromHex(u8[] text) {
  u8[]? decoded = hexDecode(text);
  return decoded is null ? u8[0]() : decoded!;
}

string hex(u8[] b) { return string.fromBytes(hexEncode(b)); }

/** A deterministic 32-byte seed, distinct per role. The same shape `gendesc.wac` uses. */
u8[] seedFor(i32 role) {
  u8[] s = u8[32]();
  for (i32 i = 0; i < 32; i++) { s[i] = (role * 61 + i * 7 + 3) & 0xFF; }
  return s;
}
