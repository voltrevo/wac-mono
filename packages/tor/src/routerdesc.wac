// Router descriptors: the document a relay publishes about itself.
//
// This file is the document's *signatures* first, because they are what a descriptor is checked by
// and where its layout is least forgiving. Generation is built on top of them.
//
// ## The digests cover the line that introduces them
//
// Both signatures are computed over a prefix of the document that **includes the keyword announcing
// the signature**, and neither includes what follows it. Tor builds a descriptor as a list of chunks
// and digests the list as it stands:
//
//     smartlist_add_strdup(chunks, "router-sig-ed25519 ");        <- appended first
//     crypto_digest_smartlist_prefix(digest, ..., ED_DESC_SIGNATURE_PREFIX, chunks, "", SHA256);
//
// So the ed25519 digest covers everything up to and including `router-sig-ed25519 ` — keyword, single
// trailing space, no newline — and the RSA digest covers everything up to and including
// `router-signature\n`, newline included. Stopping one line early, or including the newline after
// `router-sig-ed25519 `, both give a well-formed digest that verifies against nothing.
//
// ## Two different hashes and two different keys
//
// `router-sig-ed25519` is SHA-256, prefixed with `Tor router descriptor signature v1`, and signed by
// the relay's **signing key** — the one in `identity-ed25519`'s certified position — not by the master
// identity, which never signs a descriptor. `router-signature` is SHA-1 with no prefix at all, signed
// by the RSA identity with raw PKCS#1 and no DigestInfo.
//
// Four independent choices, each of which produces a plausible 64 or 128 bytes when wrong.

import { Buf } from "../../bytes/src/buf.wac";
import { ALPHABET_STANDARD, encode } from "../../codec/src/base64.wac";
import { civilFrom, derConcat, derInteger, derSequence } from "../../tls/src/derwrite.wac";
import { encodeUpper } from "../../codec/src/hex.wac";
import { itoa, itoa64 } from "../../fmt/src/itoa.wac";
import {
  curve25519ToEd25519Secret, ed25519PublicKey, ed25519PublicKeyExpanded, ed25519Sign,
  ed25519SignBit,
} from "../../crypto/src/ed25519.wac";
import { rsaSignRawPkcs1 } from "../../crypto/src/rsa.wac";
import { x25519Base } from "../../crypto/src/x25519.wac";
import {
  ed25519Cert, ed25519CertExpanded, onionKeyCrosscert,
  CERT_TYPE_ONION_ID, CERT_TYPE_SIGNING, KEY_TYPE_ED25519,
} from "./relaycert.wac";
import { sha1 } from "../../crypto/src/sha1.wac";
import { sha256 } from "../../crypto/src/sha256.wac";

/** `ED_DESC_SIGNATURE_PREFIX`, from `routerparse.h`. No separator follows it. */
u8[] edDescriptorPrefix() { return "Tor router descriptor signature v1".toBytes(); }

/** The text a descriptor's ed25519 signature is announced by, trailing space included. */
u8[] edSignatureKeyword() { return "router-sig-ed25519 ".toBytes(); }

/** The line a descriptor's RSA signature is announced by, newline included. */
u8[] rsaSignatureKeyword() { return "router-signature\n".toBytes(); }

/**
 * The offset just past `needle`, which must start a line, or -1.
 *
 * Matching only at a line start matters: `router-signature` is a prefix of nothing else in a
 * descriptor, but `router-sig-ed25519` would match inside an `opt router-sig-ed25519` and a keyword
 * appearing in a nickname or a contact line is not the document's own structure. hsdesc.wac's
 * `keywordValue` restricts itself the same way and for the same reason.
 */
export i32 pastLineStarting(u8[] text, u8[] needle) {
  if (needle.len() == 0 || text.len() < needle.len()) { return -1; }
  for (i32 i = 0; i + needle.len() <= text.len(); i++) {
    if (i != 0 && text[i - 1] != 10) { continue; }
    bool hit = true;
    for (i32 j = 0; j < needle.len(); j++) {
      if (text[i + j] != needle[j]) { hit = false; break; }
    }
    if (hit) { return i + needle.len(); }
  }
  return -1;
}

/** The first `n` bytes of `text`. */
u8[] head(u8[] text, i32 n) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = text[i]; }
  return out;
}

/**
 * The 32-byte SHA-256 a `router-sig-ed25519` signs, or empty if the keyword is absent.
 *
 * The prefix is concatenated with the document with no separator — tor passes it to
 * `crypto_digest_smartlist_prefix`, which hashes it and then the chunks.
 */
export u8[] edDescriptorDigest(u8[] descriptor) {
  i32 end = pastLineStarting(descriptor, edSignatureKeyword());
  if (end < 0) { return u8[0](); }
  u8[] prefix = edDescriptorPrefix();
  u8[] signed = u8[prefix.len() + end]();
  for (i32 i = 0; i < prefix.len(); i++) { signed[i] = prefix[i]; }
  for (i32 i = 0; i < end; i++) { signed[prefix.len() + i] = descriptor[i]; }
  return sha256(signed);
}

/**
 * The 20-byte SHA-1 a `router-signature` signs, or empty if the keyword is absent.
 *
 * No prefix here. The asymmetry with the ed25519 digest is tor's, not a simplification: the RSA
 * signature predates the personalisation convention.
 */
export u8[] rsaDescriptorDigest(u8[] descriptor) {
  i32 end = pastLineStarting(descriptor, rsaSignatureKeyword());
  if (end < 0) { return u8[0](); }
  return sha1(head(descriptor, end));
}

// ── The PEM blocks a descriptor carries ───────────────────────────────────────

/**
 * `SEQUENCE { INTEGER n, INTEGER e }` — a PKCS#1 `RSAPublicKey`.
 *
 * Not a `SubjectPublicKeyInfo`, which is the same key wrapped in an algorithm identifier and is what
 * most tools mean by an RSA public key. A descriptor's `onion-key` and `signing-key` blocks are the
 * bare sequence, and a relay's fingerprint is SHA-1 of it — three plausible encodings of one key, and
 * only this one is what every other relay computes.
 */
export u8[] rsaPublicKeyDer(u8[] modulus, u8[] exponent) {
  return derSequence(derConcat(u8[][](derInteger(modulus), derInteger(exponent))));
}

/** SHA-1 of the DER `RSAPublicKey`, which is what a relay's identity fingerprint is. */
export u8[] rsaFingerprint(u8[] modulus, u8[] exponent) {
  return sha1(rsaPublicKeyDer(modulus, exponent));
}

/**
 * A PEM block, wrapped the way tor writes one.
 *
 * `BASE64_ENCODE_MULTILINE` breaks at **64** characters, and the last line gets a newline like any
 * other. The width is not cosmetic here: these blocks sit inside a document that is hashed, so a
 * relay that wrapped at 76 — the width most base64 tools default to, and the one RFC 2045 specifies —
 * would produce a descriptor whose signature is over different bytes than a reader expects.
 */
export u8[] pemBlock(string label, u8[] der) {
  u8[] body = encode(der, ALPHABET_STANDARD(), true);
  Buf out = Buf.create();
  out.pushAll(("-----BEGIN " + label + "-----\n").toBytes());
  for (i32 i = 0; i < body.len(); i = i + 64) {
    i32 n = body.len() - i < 64 ? body.len() - i : 64;
    out.pushBytes(body, i, n);
    out.push(10);
  }
  out.pushAll(("-----END " + label + "-----\n").toBytes());
  return out.bytes();
}

// ── The document's own text ───────────────────────────────────────────────────
//
// Built as bytes rather than assembled as a string and converted at the end. `directory.wac` gives
// the reason for reading a descriptor and it applies to writing one: the signatures are over these
// bytes, so the bytes are what the code should be handling. A string round trip is a place for an
// encoding assumption to hide.

/** The keys a relay signs its descriptor with. RSA values are big-endian magnitudes. */
export struct RelayKeys {
  u8[] rsaIdentityN;
  u8[] rsaIdentityE;
  u8[] rsaIdentityD;
  u8[] rsaOnionN;
  u8[] rsaOnionE;
  u8[] rsaOnionD;
  u8[] edIdentitySeed;     // the master identity: signs the signing certificate and nothing else
  u8[] edSigningSeed;      // signs the descriptor
  u8[] ntorSecret;         // curve25519, and the source of the proposal 228 key
}

/** What a descriptor says about the relay, apart from its keys. */
export struct RelayInfo {
  string nickname;
  string address;
  i32 orPort;
  i32 dirPort;
  i64 published;           // seconds since the epoch
  i64 bandwidthRate;
  i64 bandwidthBurst;
  i64 bandwidthObserved;
  i64 certExpiryHours;     // hours since the epoch, which is how a certificate counts them
  /**
   * The `reject`/`accept` line this relay publishes.
   *
   * A field rather than a constant because it was a constant, and the constant disagreed with the
   * vote: descriptors said `reject *:*` while the consensus said `accept 1-65535`, and a client
   * believes the **descriptor** — so relays that advertised themselves as exits were never chosen as
   * one, and no stream ever reached them. Two documents describing one relay must not be able to
   * disagree, which is what putting the policy in one place buys.
   */
  string exitPolicy;
}

string pad2(i64 v) { return v < 10 ? "0" + itoa64(v) : itoa64(v); }

string pad4(i64 v) {
  string s = itoa64(v);
  while (s.len() < 4) { s = "0" + s; }
  return s;
}

/** `YYYY-MM-DD HH:MM:SS`, which is how a descriptor writes a time. Always UTC. */
export string publishedTime(i64 seconds) {
  i64[] p = civilFrom(seconds);
  return pad4(p[0]) + "-" + pad2(p[1]) + "-" + pad2(p[2]) + " " +
         pad2(p[3]) + ":" + pad2(p[4]) + ":" + pad2(p[5]);
}

/**
 * Base64 with the padding stripped, which is how a descriptor writes a bare key or signature.
 *
 * The `=` is dropped rather than never produced — tor's `base64_encode` writes padding and its
 * callers for these fields strip it, and a reader accepts either. The PEM blocks keep theirs.
 */
export string b64Unpadded(u8[] data) {
  return string.fromBytes(encode(data, ALPHABET_STANDARD(), false));
}

/**
 * The fingerprint as a descriptor writes it: uppercase hex in groups of four, space separated.
 *
 * The grouping looks cosmetic and is not: it is inside the bytes both signatures cover, so a
 * fingerprint written without the spaces changes every signature in the document.
 */
export string spacedFingerprint(u8[] digest) {
  u8[] h = encodeUpper(digest);
  Buf out = Buf.create();
  for (i32 i = 0; i < h.len(); i++) {
    if (i != 0 && i % 4 == 0) { out.push(32); }
    out.push(h[i]);
  }
  return string.fromBytes(out.bytes());
}

/**
 * A complete router descriptor, signed with both keys.
 *
 * The order of work is the order the signatures force. Everything up to `router-sig-ed25519 ` is
 * built first, because that text is inside the ed25519 digest; the signature is appended, then
 * `router-signature\n`, which is inside the RSA digest, and finally the RSA signature block. Trying
 * to lay the document out and sign afterwards does not work — there is no gap to write a signature
 * into that the digest has not already covered.
 *
 * Empty if any key is the wrong size or a certificate cannot be built, rather than a document with a
 * hole in it.
 */
export u8[] routerDescriptor(RelayKeys k, RelayInfo info) {
  u8[] masterPub = ed25519PublicKey(k.edIdentitySeed);
  u8[] signingPub = ed25519PublicKey(k.edSigningSeed);
  if (masterPub.len() != 32 || signingPub.len() != 32) { return u8[0](); }

  // The signing certificate: the master identity certifying the key that signs the descriptor, with
  // itself in extension 4 so a reader who has only the master key can check it.
  u8[] signingCert = ed25519Cert(CERT_TYPE_SIGNING, info.certExpiryHours, KEY_TYPE_ED25519,
                                 signingPub, masterPub, k.edIdentitySeed);
  if (signingCert.len() == 0) { return u8[0](); }

  // The ntor key, and the proposal 228 key derived from it that cross-certifies the identity.
  u8[] ntorPub = x25519Base(k.ntorSecret);
  u8[] ntorExpanded = curve25519ToEd25519Secret(k.ntorSecret);
  u8[] ntorEd = ed25519PublicKeyExpanded(ntorExpanded);
  u8[] ntorCross = ed25519CertExpanded(CERT_TYPE_ONION_ID, info.certExpiryHours, KEY_TYPE_ED25519,
                                      masterPub, ntorExpanded);
  if (ntorCross.len() == 0) { return u8[0](); }

  // The TAP onion key vouching for both identities.
  u8[] fingerprint = rsaFingerprint(k.rsaIdentityN, k.rsaIdentityE);
  u8[] onionCross = onionKeyCrosscert(fingerprint, masterPub, k.rsaOnionN, k.rsaOnionD);
  if (onionCross.len() == 0) { return u8[0](); }

  Buf d = Buf.create();
  d.pushAll(("router " + info.nickname + " " + info.address + " " + itoa(info.orPort) +
             " 0 " + itoa(info.dirPort) + "\n").toBytes());
  d.pushAll("identity-ed25519\n".toBytes());
  d.pushAll(pemBlock("ED25519 CERT", signingCert));
  d.pushAll(("master-key-ed25519 " + b64Unpadded(masterPub) + "\n").toBytes());
  d.pushAll(("platform Tor 0.4.7.13 on Linux\n").toBytes());
  d.pushAll(("proto " + PROTO_LINE + "\n").toBytes());
  d.pushAll(("published " + publishedTime(info.published) + "\n").toBytes());
  d.pushAll(("fingerprint " + spacedFingerprint(fingerprint) + "\n").toBytes());
  d.pushAll(("bandwidth " + itoa64(info.bandwidthRate) + " " + itoa64(info.bandwidthBurst) +
             " " + itoa64(info.bandwidthObserved) + "\n").toBytes());
  d.pushAll("onion-key\n".toBytes());
  d.pushAll(pemBlock("RSA PUBLIC KEY", rsaPublicKeyDer(k.rsaOnionN, k.rsaOnionE)));
  d.pushAll("signing-key\n".toBytes());
  d.pushAll(pemBlock("RSA PUBLIC KEY", rsaPublicKeyDer(k.rsaIdentityN, k.rsaIdentityE)));
  d.pushAll("onion-key-crosscert\n".toBytes());
  d.pushAll(pemBlock("CROSSCERT", onionCross));
  d.pushAll(("ntor-onion-key-crosscert " + itoa(ed25519SignBit(ntorEd)) + "\n").toBytes());
  d.pushAll(pemBlock("ED25519 CERT", ntorCross));
  d.pushAll("hidden-service-dir\n".toBytes());
  d.pushAll(("ntor-onion-key " + b64Unpadded(ntorPub) + "\n").toBytes());
  d.pushAll((info.exitPolicy + "\n").toBytes());
  d.pushAll("tunnelled-dir-server\n".toBytes());

  // The ed25519 signature covers the keyword announcing it, so the keyword goes in first.
  d.pushAll(edSignatureKeyword());
  u8[] edDigest = edDescriptorDigest(d.bytes());
  if (edDigest.len() != 32) { return u8[0](); }
  d.pushAll((b64Unpadded(ed25519Sign(k.edSigningSeed, edDigest)) + "\n").toBytes());

  // And the RSA signature covers its own keyword line, newline included.
  d.pushAll(rsaSignatureKeyword());
  u8[] rsaDigest = rsaDescriptorDigest(d.bytes());
  if (rsaDigest.len() != 20) { return u8[0](); }
  u8[] rsaSig = rsaSignRawPkcs1(k.rsaIdentityN, k.rsaIdentityD, rsaDigest);
  if (rsaSig.len() == 0) { return u8[0](); }
  d.pushAll(pemBlock("SIGNATURE", rsaSig));

  return d.bytes();
}

/** The subprotocol versions this implementation claims. */
const string PROTO_LINE =
  "Cons=1-2 Desc=1-2 DirCache=1-2 FlowCtrl=1 HSDir=1-2 HSIntro=3-5 HSRend=1-2 Link=1-5 " +
  "LinkAuth=1,3 Microdesc=1-2 Padding=2 Relay=1-3";

// ── The `r` line an authority writes about a relay ─────────────────────────────

/**
 * The digest that identifies a descriptor: SHA-1 over the span the RSA signature covers.
 *
 * **Not a hash of the whole document.** It stops after `router-signature\n`, before the signature
 * block, so a descriptor and its digest do not include the signature that authenticates them. This is
 * `rsaDescriptorDigest` under a second name because it is the same value used for two unrelated
 * purposes — what the RSA signature signs, and how a vote refers to the descriptor — and a reader of
 * either call site should not have to know about the other.
 *
 * The confusion is worth naming: hashing the whole descriptor yields a well-formed 20 bytes that no
 * authority agrees with, and nothing local can tell the difference. Asking tor which span it meant is
 * what settled it — `parsedesc-probe.c` prints `signed_descriptor_digest`, and with the whole-document
 * span zero of five real vote entries paired with their descriptors.
 */
export u8[] descriptorIdentityDigest(u8[] descriptor) { return rsaDescriptorDigest(descriptor); }

/** The relay's 20-byte identity digest, read from its descriptor's `fingerprint` line. */
export u8[] descriptorIdentity(u8[] descriptor) {
  return unhex(lineValue(descriptor, "fingerprint "));
}

/**
 * The `r` line an authority writes about a relay, derived from the relay's own descriptor.
 *
 * `r nickname identity digest publication address ORPort DirPort`, where `identity` is the 20-byte
 * SHA-1 of the DER `RSAPublicKey` identity and `digest` is the descriptor digest above — both base64
 * with the padding stripped, which is a third spelling of the fingerprint: a descriptor writes it as
 * spaced uppercase hex, a key certificate as unbroken hex, and a vote as base64.
 *
 * Empty if the descriptor is missing anything the line needs, rather than a line with a gap in it.
 */
export u8[] routerStatusLine(u8[] descriptor) {
  u8[] router = lineValue(descriptor, "router ");
  u8[] published = lineValue(descriptor, "published ");
  u8[] fingerprint = lineValue(descriptor, "fingerprint ");
  if (router.len() == 0 || published.len() == 0 || fingerprint.len() == 0) { return u8[0](); }

  // `router <nickname> <address> <ORPort> <SOCKSPort> <DirPort>` — the third field is dead weight in
  // the descriptor and the r line skips it, so the fields cannot simply be copied across in order.
  u8[][] parts = splitSpaces(router);
  if (parts.len() < 5) { return u8[0](); }

  u8[] identity = unhex(fingerprint);
  if (identity.len() != 20) { return u8[0](); }
  u8[] digest = descriptorIdentityDigest(descriptor);
  if (digest.len() != 20) { return u8[0](); }

  Buf out = Buf.create();
  out.pushAll("r ".toBytes());
  out.pushAll(parts[0]);
  out.push(32);
  out.pushAll(b64Unpadded(identity).toBytes());
  out.push(32);
  out.pushAll(b64Unpadded(digest).toBytes());
  out.push(32);
  out.pushAll(published);
  out.push(32);
  out.pushAll(parts[1]);
  out.push(32);
  out.pushAll(parts[2]);
  out.push(32);
  out.pushAll(parts[4]);
  return out.bytes();
}

/** The rest of the line starting with `keyword`, without its newline. Empty if absent. */
export u8[] lineValue(u8[] doc, string keyword) {
  i32 at = pastLineStarting(doc, keyword.toBytes());
  if (at < 0) { return u8[0](); }
  i32 end = at;
  while (end < doc.len() && doc[end] != 10) { end = end + 1; }
  u8[] out = u8[end - at]();
  for (i32 i = 0; i < end - at; i++) { out[i] = doc[at + i]; }
  return out;
}

/** Split on single spaces. Empty fields are dropped, which is what a run of spaces would produce. */
u8[][] splitSpaces(u8[] s) {
  i32 count = 0;
  i32 i = 0;
  while (i < s.len()) {
    while (i < s.len() && s[i] == 32) { i = i + 1; }
    if (i >= s.len()) { break; }
    count = count + 1;
    while (i < s.len() && s[i] != 32) { i = i + 1; }
  }
  u8[][] out = u8[][count]();
  i32 n = 0;
  i = 0;
  while (i < s.len()) {
    while (i < s.len() && s[i] == 32) { i = i + 1; }
    if (i >= s.len()) { break; }
    i32 from = i;
    while (i < s.len() && s[i] != 32) { i = i + 1; }
    u8[] part = u8[i - from]();
    for (i32 j = 0; j < i - from; j++) { part[j] = s[from + j]; }
    out[n] = part;
    n = n + 1;
  }
  return out;
}

/** Hex to bytes, spaces ignored — a descriptor's fingerprint line is written in groups. */
u8[] unhex(u8[] text) {
  i32 count = 0;
  for (i32 i = 0; i < text.len(); i++) { if (text[i] != 32) { count = count + 1; } }
  if (count % 2 != 0) { return u8[0](); }
  u8[] out = u8[count / 2]();
  i32 n = 0;
  i32 hi = -1;
  for (i32 i = 0; i < text.len(); i++) {
    if (text[i] == 32) { continue; }
    i32 v = hexValue(text[i]);
    if (v < 0) { return u8[0](); }
    if (hi < 0) { hi = v; } else { out[n] = hi * 16 + v; n = n + 1; hi = -1; }
  }
  return out;
}

i32 hexValue(i32 c) {
  if (c >= 48 && c <= 57) { return c - 48; }
  if (c >= 65 && c <= 70) { return c - 55; }
  if (c >= 97 && c <= 102) { return c - 87; }
  return -1;
}
