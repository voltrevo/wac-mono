// Router descriptors: the document a relay publishes about itself.
//
// This file is the document's *signatures* first, because they are what a descriptor is checked by
// and where its layout is least forgiving. Generation is built on top of them.
//
// ## The digests cover the line that introduces them
//
// Both signatures are computed over a prefix of the document that **includes the keyword announcing
// the signature**, and neither includes what follows it. Tor builds a descriptor as a list of chunks
// and digests the list as it stands:
//
//     smartlist_add_strdup(chunks, "router-sig-ed25519 ");        <- appended first
//     crypto_digest_smartlist_prefix(digest, ..., ED_DESC_SIGNATURE_PREFIX, chunks, "", SHA256);
//
// So the ed25519 digest covers everything up to and including `router-sig-ed25519 ` — keyword, single
// trailing space, no newline — and the RSA digest covers everything up to and including
// `router-signature\n`, newline included. Stopping one line early, or including the newline after
// `router-sig-ed25519 `, both give a well-formed digest that verifies against nothing.
//
// ## Two different hashes and two different keys
//
// `router-sig-ed25519` is SHA-256, prefixed with `Tor router descriptor signature v1`, and signed by
// the relay's **signing key** — the one in `identity-ed25519`'s certified position — not by the master
// identity, which never signs a descriptor. `router-signature` is SHA-1 with no prefix at all, signed
// by the RSA identity with raw PKCS#1 and no DigestInfo.
//
// Four independent choices, each of which produces a plausible 64 or 128 bytes when wrong.

import { Buf } from "../../bytes/src/buf.wac";
import { ALPHABET_STANDARD, encode } from "../../codec/src/base64.wac";
import { civilFrom, derConcat, derInteger, derSequence } from "../../tls/src/derwrite.wac";
import { encodeUpper } from "../../codec/src/hex.wac";
import { itoa64 } from "../../fmt/src/itoa.wac";
import { sha1 } from "../../crypto/src/sha1.wac";
import { sha256 } from "../../crypto/src/sha256.wac";

/** `ED_DESC_SIGNATURE_PREFIX`, from `routerparse.h`. No separator follows it. */
u8[] edDescriptorPrefix() { return "Tor router descriptor signature v1".toBytes(); }

/** The text a descriptor's ed25519 signature is announced by, trailing space included. */
u8[] edSignatureKeyword() { return "router-sig-ed25519 ".toBytes(); }

/** The line a descriptor's RSA signature is announced by, newline included. */
u8[] rsaSignatureKeyword() { return "router-signature\n".toBytes(); }

/**
 * The offset just past `needle`, which must start a line, or -1.
 *
 * Matching only at a line start matters: `router-signature` is a prefix of nothing else in a
 * descriptor, but `router-sig-ed25519` would match inside an `opt router-sig-ed25519` and a keyword
 * appearing in a nickname or a contact line is not the document's own structure. hsdesc.wac's
 * `keywordValue` restricts itself the same way and for the same reason.
 */
export i32 pastLineStarting(u8[] text, u8[] needle) {
  if (needle.len() == 0 || text.len() < needle.len()) { return -1; }
  for (i32 i = 0; i + needle.len() <= text.len(); i++) {
    if (i != 0 && text[i - 1] != 10) { continue; }
    bool hit = true;
    for (i32 j = 0; j < needle.len(); j++) {
      if (text[i + j] != needle[j]) { hit = false; break; }
    }
    if (hit) { return i + needle.len(); }
  }
  return -1;
}

/** The first `n` bytes of `text`. */
u8[] head(u8[] text, i32 n) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = text[i]; }
  return out;
}

/**
 * The 32-byte SHA-256 a `router-sig-ed25519` signs, or empty if the keyword is absent.
 *
 * The prefix is concatenated with the document with no separator — tor passes it to
 * `crypto_digest_smartlist_prefix`, which hashes it and then the chunks.
 */
export u8[] edDescriptorDigest(u8[] descriptor) {
  i32 end = pastLineStarting(descriptor, edSignatureKeyword());
  if (end < 0) { return u8[0](); }
  u8[] prefix = edDescriptorPrefix();
  u8[] signed = u8[prefix.len() + end]();
  for (i32 i = 0; i < prefix.len(); i++) { signed[i] = prefix[i]; }
  for (i32 i = 0; i < end; i++) { signed[prefix.len() + i] = descriptor[i]; }
  return sha256(signed);
}

/**
 * The 20-byte SHA-1 a `router-signature` signs, or empty if the keyword is absent.
 *
 * No prefix here. The asymmetry with the ed25519 digest is tor's, not a simplification: the RSA
 * signature predates the personalisation convention.
 */
export u8[] rsaDescriptorDigest(u8[] descriptor) {
  i32 end = pastLineStarting(descriptor, rsaSignatureKeyword());
  if (end < 0) { return u8[0](); }
  return sha1(head(descriptor, end));
}

// ── The PEM blocks a descriptor carries ───────────────────────────────────────

/**
 * `SEQUENCE { INTEGER n, INTEGER e }` — a PKCS#1 `RSAPublicKey`.
 *
 * Not a `SubjectPublicKeyInfo`, which is the same key wrapped in an algorithm identifier and is what
 * most tools mean by an RSA public key. A descriptor's `onion-key` and `signing-key` blocks are the
 * bare sequence, and a relay's fingerprint is SHA-1 of it — three plausible encodings of one key, and
 * only this one is what every other relay computes.
 */
export u8[] rsaPublicKeyDer(u8[] modulus, u8[] exponent) {
  return derSequence(derConcat(u8[][](derInteger(modulus), derInteger(exponent))));
}

/** SHA-1 of the DER `RSAPublicKey`, which is what a relay's identity fingerprint is. */
export u8[] rsaFingerprint(u8[] modulus, u8[] exponent) {
  return sha1(rsaPublicKeyDer(modulus, exponent));
}

/**
 * A PEM block, wrapped the way tor writes one.
 *
 * `BASE64_ENCODE_MULTILINE` breaks at **64** characters, and the last line gets a newline like any
 * other. The width is not cosmetic here: these blocks sit inside a document that is hashed, so a
 * relay that wrapped at 76 — the width most base64 tools default to, and the one RFC 2045 specifies —
 * would produce a descriptor whose signature is over different bytes than a reader expects.
 */
export u8[] pemBlock(string label, u8[] der) {
  u8[] body = encode(der, ALPHABET_STANDARD(), true);
  Buf out = Buf.create();
  out.pushAll(("-----BEGIN " + label + "-----\n").toBytes());
  for (i32 i = 0; i < body.len(); i = i + 64) {
    i32 n = body.len() - i < 64 ? body.len() - i : 64;
    out.pushBytes(body, i, n);
    out.push(10);
  }
  out.pushAll(("-----END " + label + "-----\n").toBytes());
  return out.bytes();
}

// ── The document's own text ───────────────────────────────────────────────────
//
// Built as bytes rather than assembled as a string and converted at the end. `directory.wac` gives
// the reason for reading a descriptor and it applies to writing one: the signatures are over these
// bytes, so the bytes are what the code should be handling. A string round trip is a place for an
// encoding assumption to hide.

/** The keys a relay signs its descriptor with. RSA values are big-endian magnitudes. */
export struct RelayKeys {
  u8[] rsaIdentityN;
  u8[] rsaIdentityE;
  u8[] rsaIdentityD;
  u8[] rsaOnionN;
  u8[] rsaOnionE;
  u8[] rsaOnionD;
  u8[] edIdentitySeed;     // the master identity: signs the signing certificate and nothing else
  u8[] edSigningSeed;      // signs the descriptor
  u8[] ntorSecret;         // curve25519, and the source of the proposal 228 key
}

/** What a descriptor says about the relay, apart from its keys. */
export struct RelayInfo {
  string nickname;
  string address;
  i32 orPort;
  i32 dirPort;
  i64 published;           // seconds since the epoch
  i64 bandwidthRate;
  i64 bandwidthBurst;
  i64 bandwidthObserved;
  i64 certExpiryHours;     // hours since the epoch, which is how a certificate counts them
}

string pad2(i64 v) { return v < 10 ? "0" + itoa64(v) : itoa64(v); }

string pad4(i64 v) {
  string s = itoa64(v);
  while (s.len() < 4) { s = "0" + s; }
  return s;
}

/** `YYYY-MM-DD HH:MM:SS`, which is how a descriptor writes a time. Always UTC. */
export string publishedTime(i64 seconds) {
  i64[] p = civilFrom(seconds);
  return pad4(p[0]) + "-" + pad2(p[1]) + "-" + pad2(p[2]) + " " +
         pad2(p[3]) + ":" + pad2(p[4]) + ":" + pad2(p[5]);
}

/**
 * Base64 with the padding stripped, which is how a descriptor writes a bare key or signature.
 *
 * The `=` is dropped rather than never produced — tor's `base64_encode` writes padding and its
 * callers for these fields strip it, and a reader accepts either. The PEM blocks keep theirs.
 */
export string b64Unpadded(u8[] data) {
  return string.fromBytes(encode(data, ALPHABET_STANDARD(), false));
}

/**
 * The fingerprint as a descriptor writes it: uppercase hex in groups of four, space separated.
 *
 * The grouping looks cosmetic and is not: it is inside the bytes both signatures cover, so a
 * fingerprint written without the spaces changes every signature in the document.
 */
export string spacedFingerprint(u8[] digest) {
  u8[] h = encodeUpper(digest);
  Buf out = Buf.create();
  for (i32 i = 0; i < h.len(); i++) {
    if (i != 0 && i % 4 == 0) { out.push(32); }
    out.push(h[i]);
  }
  return string.fromBytes(out.bytes());
}
