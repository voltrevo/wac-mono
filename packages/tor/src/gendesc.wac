// Generate a router descriptor and write it to a file, so tor's own parser can judge it.
//
// This is the regeneration half of the differential in `test/routerdesc_wac.test.ts`. The suite does
// not run this: it compares against the descriptor bytes committed as a vector, because a test that
// needs a built tor tree present turns the shared suite red for whoever does not have one — the
// mistake `test/ntor_wac.test.ts` documents having made once already.
//
//     deno task app:build packages/tor/src/gendesc.wac -o /tmp/gendesc.ts --allow-write
//     deno run --allow-write /tmp/gendesc.ts /tmp/desc.txt
//     <parsedesc-probe built against libtor.a> < /tmp/desc.txt
//
// Everything is derived from fixed seeds, so the output is reproducible and a change in it is a
// change in the generator rather than in the weather. RSA-1024 key generation is a prime search and
// takes a moment; that is the reason this is a tool and the keys are committed with the vector rather
// than generated inside a test.

import { Core, Cli, Change, FileResult } from "../../platform/src/platform.wac";
import { Buf } from "../../bytes/src/buf.wac";
import { itoa, itoa64 } from "../../fmt/src/itoa.wac";
import { encode as hexEncode } from "../../codec/src/hex.wac";
import { rsaFingerprint } from "./routerdesc.wac";
import { generateRsaKey, RsaKey } from "../../crypto/src/rsagen.wac";
import { RelayInfo, RelayKeys, routerDescriptor } from "./routerdesc.wac";
import { AuthorityKeys, authorityCertificate } from "./authcert.wac";
import { RelayOpinion, VoteInfo, voteDocument } from "./vote.wac";
import { ConsensusInfo, ConsensusVoter, consensusDocument } from "./consensusgen.wac";
import { sha1 } from "../../crypto/src/sha1.wac";

/** A deterministic 32-byte seed. Distinct per role, so no two keys are the same key. */
u8[] seedFor(i32 role) {
  u8[] s = u8[32]();
  for (i32 i = 0; i < 32; i++) { s[i] = (role * 61 + i * 7 + 3) & 0xFF; }
  return s;
}

/** A curve25519 secret has to be clamped; `curve25519ToEd25519Secret` uses it as a scalar unchanged. */
u8[] ntorSecret() {
  u8[] s = seedFor(9);
  s[0] = s[0] & 248;
  s[31] = s[31] & 127;
  s[31] = s[31] | 64;
  return s;
}

export i32 main(Core core, Cli cli) {
  if (cli.argCount().wait() < 1) {
    core.warn("usage: gendesc <out-path>");
    return 1;
  }
  string out = string.fromBytes(cli.arg(0).wait());

  core.log("gendesc: generating two RSA-1024 keys (a prime search, so this takes a moment)");
  RsaKey identity = generateRsaKey(1024, seedFor(1));
  RsaKey onion = generateRsaKey(1024, seedFor(2));
  if (!identity.ok || !onion.ok) {
    core.warn("gendesc: RSA key generation failed");
    return 1;
  }

  RelayKeys keys = RelayKeys(
    identity.modulus, identity.publicExponent, identity.privateExponent,
    onion.modulus, onion.publicExponent, onion.privateExponent,
    seedFor(3), seedFor(4), ntorSecret());

  // A fixed time by default, so the vectors are reproducible: 2026-08-05 12:00:00 UTC, with a
  // certificate expiry a year past it — certificates count in hours, not seconds.
  //
  // A fifth argument overrides it, which is what a *live* server needs: a document whose validity
  // window is in the past is correctly refused by any client, so the committed fixture cannot also be
  // the thing a real tor bootstraps from. The window widens with it for the same reason — the default
  // 20/40/60 seconds mirrors chutney's voting interval and is far too short to bootstrap against.
  i64 published = 1785931200;
  bool live = cli.argCount().wait() >= 5;
  if (live) {
    i64 given = atoi64(cli.arg(4).wait());
    if (given <= 0) {
      core.warn("gendesc: the fifth argument must be a unix time in seconds");
      return 1;
    }
    published = given;
  }
  i64 window = live ? 3600 : 20;
  RelayInfo info = RelayInfo("wacrelay", "127.0.0.1", 9001, 0, published,
                             1073741824, 1073741824, 640416,
                             (published / 3600) + 8760);

  u8[] desc = routerDescriptor(keys, info);
  if (desc.len() == 0) {
    core.warn("gendesc: could not build a descriptor");
    return 1;
  }

  // Written as the test's vector, not as a bare document: reproducing these bytes needs the private
  // exponents, and an RSA-1024 prime search is far too slow to run inside the suite. With the keys
  // committed the test is a byte-for-byte comparison that costs nothing.
  Change c = cli.writeFile(out, vectorJson(keys, info, desc).toBytes()).wait();
  if (!c.ok()) {
    core.warn("gendesc: " + out + ": " + c.message);
    return 1;
  }
  core.log("gendesc: wrote a " + itoa(desc.len()) + "-byte descriptor, with its keys, to " + out);

  // The authority key certificate, when a second path is given. Same tool because it needs the same
  // slow prime search, and doing both in one run means one wait instead of two.
  if (cli.argCount().wait() >= 2) {
    string certOut = string.fromBytes(cli.arg(1).wait());
    core.log("gendesc: generating the authority's two keys");
    RsaKey authIdentity = generateRsaKey(1024, seedFor(5));
    RsaKey authSigning = generateRsaKey(1024, seedFor(6));
    if (!authIdentity.ok || !authSigning.ok) {
      core.warn("gendesc: authority key generation failed");
      return 1;
    }
    AuthorityKeys ak = AuthorityKeys(
      authIdentity.modulus, authIdentity.publicExponent, authIdentity.privateExponent,
      authSigning.modulus, authSigning.publicExponent, authSigning.privateExponent);

    i64 expires = published + 31536000;
    u8[] cert = authorityCertificate(ak, published, expires);
    if (cert.len() == 0) {
      core.warn("gendesc: could not build an authority certificate");
      return 1;
    }
    Change cc = cli.writeFile(certOut, certVectorJson(ak, published, expires, cert).toBytes()).wait();
    if (!cc.ok()) {
      core.warn("gendesc: " + certOut + ": " + cc.message);
      return 1;
    }
    core.log("gendesc: wrote a " + itoa(cert.len()) + "-byte authority certificate to " + certOut);

    // And a vote, when a third path is given. The relay it votes about is the one whose descriptor
    // this run produced, so the whole set is consistent and reproducible from the same seeds.
    if (cli.argCount().wait() >= 3) {
      string voteOut = string.fromBytes(cli.arg(2).wait());
      // A sixth argument names a descriptor to vote about instead of the one generated here. That is
      // what makes the documents describe a relay that *exists*: `relayd --descriptor` writes the one
      // for the keys it actually serves with, and an authority voting about anything else describes a
      // relay a client would connect to and find the wrong identity at.
      // Every argument from the sixth on names a descriptor to vote about, so a network of several
      // relays is described by listing them. With none, the one generated here stands in.
      i32 extra = cli.argCount().wait() - 5;
      i32 count = extra > 0 ? extra : 1;
      RelayOpinion[] relays = RelayOpinion[count]();
      for (i32 ri = 0; ri < count; ri++) {
        u8[] subject = desc;
        if (extra > 0) {
          string subjectPath = string.fromBytes(cli.arg(5 + ri).wait());
          FileResult sf = cli.readFile(subjectPath).wait();
          if (!sf.ok) {
            core.warn("gendesc: " + subjectPath + ": " + sf.error);
            return 1;
          }
          subject = sf.bytes;
          core.log("gendesc: voting about the relay described in " + subjectPath);
        }
        relays[ri] = RelayOpinion(subject, "Exit Fast Guard HSDir Running Stable V2Dir Valid",
                                  640416, "reject 1-65535");
      }
      VoteInfo vi = VoteInfo("wacauth", "127.0.0.1", "127.0.0.1", 7000, 5000,
                             "agent-b@wac-mono", published, published + window,
                             published + window * 2, published + window * 3, 4, 4);
      u8[] vote = voteDocument(vi, ak, cert, relays);
      if (vote.len() == 0) {
        core.warn("gendesc: could not build a vote");
        return 1;
      }
      Change vc = cli.writeFile(voteOut, voteVectorJson(ak, vi, relays[0], cert, vote).toBytes()).wait();
      if (!vc.ok()) {
        core.warn("gendesc: " + voteOut + ": " + vc.message);
        return 1;
      }
      core.log("gendesc: wrote a " + itoa(vote.len()) + "-byte vote to " + voteOut);

      // And a consensus, when a fourth path is given. One authority, so the agreement is trivial and
      // the document is the point: the vote-digest is this vote's own digest, which is what a real
      // consensus records about each vote it was computed from.
      if (cli.argCount().wait() >= 4) {
        string consOut = string.fromBytes(cli.arg(3).wait());
        ConsensusVoter[] voters = ConsensusVoter[1]();
        voters[0] = ConsensusVoter("wacauth", rsaFingerprint(ak.identityN, ak.identityE),
                                   "127.0.0.1", "127.0.0.1", 7000, 5000, "agent-b@wac-mono",
                                   sha1(vote));
        ConsensusInfo ci = ConsensusInfo(32, published + window, published + window * 2,
                                         published + window * 3, 4, 4, WEIGHTS);
        u8[] cons = consensusDocument(ci, voters, relays, ak);
        if (cons.len() == 0) {
          core.warn("gendesc: could not build a consensus");
          return 1;
        }
        Change cc2 = cli.writeFile(consOut, consVectorJson(ak, ci, voters[0], relays[0], cons).toBytes()).wait();
        if (!cc2.ok()) {
          core.warn("gendesc: " + consOut + ": " + cc2.message);
          return 1;
        }
        core.log("gendesc: wrote a " + itoa(cons.len()) + "-byte consensus to " + consOut);
      }
    }
  }
  return 0;
}

/** Lowercase hex, for the key material in the vector. */
string hex(u8[] b) { return string.fromBytes(hexEncode(b)); }

/**
 * A JSON string body. The descriptor is ASCII with newlines; quote and backslash are handled anyway
 * so that a future field cannot silently produce invalid JSON.
 *
 * Built through a Buf rather than by concatenating a string per character — 2 KB of `out = out + c`
 * is 2000 allocations of a growing string, and the byte-oriented version is the shape the rest of
 * this package uses for documents.
 */
string jsonText(u8[] text) {
  Buf out = Buf.create();
  for (i32 i = 0; i < text.len(); i++) {
    i32 c = text[i];
    if (c == 10) { out.push(92); out.push(110); }
    else if (c == 34) { out.push(92); out.push(34); }
    else if (c == 92) { out.push(92); out.push(92); }
    else { out.push(c); }
  }
  return string.fromBytes(out.bytes());
}

string field(string name, string value) { return "  \"" + name + "\": \"" + value + "\",\n"; }

/**
 * The vector: every input, and the document they produce.
 *
 * Written by this tool rather than by a Python capture script because the private exponents only
 * exist here — `generateRsaKey` derives them from the seed and nothing else can recover them.
 */
string vectorJson(RelayKeys k, RelayInfo info, u8[] desc) {
  return "{\n" +
    field("note", "generated by packages/tor/src/gendesc.wac; accepted by tor's " +
                  "router_parse_entry_from_string") +
    field("rsaIdentityN", hex(k.rsaIdentityN)) +
    field("rsaIdentityE", hex(k.rsaIdentityE)) +
    field("rsaIdentityD", hex(k.rsaIdentityD)) +
    field("rsaOnionN", hex(k.rsaOnionN)) +
    field("rsaOnionE", hex(k.rsaOnionE)) +
    field("rsaOnionD", hex(k.rsaOnionD)) +
    field("edIdentitySeed", hex(k.edIdentitySeed)) +
    field("edSigningSeed", hex(k.edSigningSeed)) +
    field("ntorSecret", hex(k.ntorSecret)) +
    field("nickname", info.nickname) +
    field("address", info.address) +
    "  \"orPort\": " + itoa(info.orPort) + ",\n" +
    "  \"dirPort\": " + itoa(info.dirPort) + ",\n" +
    "  \"published\": " + itoa64(info.published) + ",\n" +
    "  \"bandwidthRate\": " + itoa64(info.bandwidthRate) + ",\n" +
    "  \"bandwidthBurst\": " + itoa64(info.bandwidthBurst) + ",\n" +
    "  \"bandwidthObserved\": " + itoa64(info.bandwidthObserved) + ",\n" +
    "  \"certExpiryHours\": " + itoa64(info.certExpiryHours) + ",\n" +
    "  \"descriptor\": \"" + jsonText(desc) + "\"\n" +
    "}\n";
}

/** The authority certificate vector, in the same shape and for the same reason as the descriptor's. */
string certVectorJson(AuthorityKeys k, i64 published, i64 expires, u8[] cert) {
  return "{\n" +
    field("note", "generated by packages/tor/src/gendesc.wac; accepted by tor's " +
                  "authority_cert_parse_from_string") +
    field("identityN", hex(k.identityN)) +
    field("identityE", hex(k.identityE)) +
    field("identityD", hex(k.identityD)) +
    field("signingN", hex(k.signingN)) +
    field("signingE", hex(k.signingE)) +
    field("signingD", hex(k.signingD)) +
    "  \"published\": " + itoa64(published) + ",\n" +
    "  \"expires\": " + itoa64(expires) + ",\n" +
    "  \"certificate\": \"" + jsonText(cert) + "\"\n" +
    "}\n";
}

/**
 * The vote vector. Self-contained on purpose — it repeats the certificate and the descriptor that the
 * other two vectors also carry, because a test that had to join three files to rebuild one document
 * would be checking the joining as much as the generator.
 */
string voteVectorJson(AuthorityKeys k, VoteInfo vi, RelayOpinion r, u8[] cert, u8[] vote) {
  return "{\n" +
    field("note", "generated by packages/tor/src/gendesc.wac; accepted by tor's " +
                  "networkstatus_parse_vote_from_string, which for a vote verifies the signature") +
    field("identityN", hex(k.identityN)) +
    field("identityE", hex(k.identityE)) +
    field("identityD", hex(k.identityD)) +
    field("signingN", hex(k.signingN)) +
    field("signingE", hex(k.signingE)) +
    field("signingD", hex(k.signingD)) +
    field("nickname", vi.nickname) +
    field("address", vi.address) +
    field("ip", vi.ip) +
    field("contact", vi.contact) +
    field("flags", r.flags) +
    field("exitPolicy", r.exitPolicy) +
    "  \"dirPort\": " + itoa(vi.dirPort) + ",\n" +
    "  \"orPort\": " + itoa(vi.orPort) + ",\n" +
    "  \"published\": " + itoa64(vi.published) + ",\n" +
    "  \"validAfter\": " + itoa64(vi.validAfter) + ",\n" +
    "  \"freshUntil\": " + itoa64(vi.freshUntil) + ",\n" +
    "  \"validUntil\": " + itoa64(vi.validUntil) + ",\n" +
    "  \"voteSeconds\": " + itoa(vi.voteSeconds) + ",\n" +
    "  \"distSeconds\": " + itoa(vi.distSeconds) + ",\n" +
    "  \"bandwidth\": " + itoa64(r.bandwidth) + ",\n" +
    field2("certificate", jsonText(cert)) +
    field2("descriptor", jsonText(r.descriptor)) +
    "  \"vote\": \"" + jsonText(vote) + "\"\n" +
    "}\n";
}

/** A field whose value is already escaped. */
string field2(string name, string escaped) { return "  \"" + name + "\": \"" + escaped + "\",\n"; }

/** The weights a real chutney consensus carries, which are the defaults when nothing is measured. */
const string WEIGHTS =
  "Wbd=3333 Wbe=0 Wbg=0 Wbm=10000 Wdb=10000 Web=10000 Wed=3333 Wee=10000 Weg=3333 Wem=10000 " +
  "Wgb=10000 Wgd=3333 Wgg=10000 Wgm=10000 Wmb=10000 Wmd=3333 Wme=0 Wmg=0 Wmm=10000";

/** The consensus vector, self-contained for the same reason the vote's is. */
string consVectorJson(AuthorityKeys k, ConsensusInfo ci, ConsensusVoter v, RelayOpinion r, u8[] cons) {
  return "{\n" +
    field("note", "generated by packages/tor/src/gendesc.wac; structure accepted by tor's " +
                  "networkstatus_parse_vote_from_string, which does NOT check a consensus signature " +
                  "— see issue 0081. The signature is checked by node in the test.") +
    field("identityN", hex(k.identityN)) +
    field("identityE", hex(k.identityE)) +
    field("identityD", hex(k.identityD)) +
    field("signingN", hex(k.signingN)) +
    field("signingE", hex(k.signingE)) +
    field("signingD", hex(k.signingD)) +
    field("nickname", v.nickname) +
    field("address", v.address) +
    field("ip", v.ip) +
    field("contact", v.contact) +
    field("identityDigest", hex(v.identityDigest)) +
    field("voteDigest", hex(v.voteDigest)) +
    field("flags", r.flags) +
    field("exitPolicy", r.exitPolicy) +
    field("bandwidthWeights", ci.bandwidthWeights) +
    "  \"dirPort\": " + itoa(v.dirPort) + ",\n" +
    "  \"orPort\": " + itoa(v.orPort) + ",\n" +
    "  \"consensusMethod\": " + itoa(ci.consensusMethod) + ",\n" +
    "  \"validAfter\": " + itoa64(ci.validAfter) + ",\n" +
    "  \"freshUntil\": " + itoa64(ci.freshUntil) + ",\n" +
    "  \"validUntil\": " + itoa64(ci.validUntil) + ",\n" +
    "  \"voteSeconds\": " + itoa(ci.voteSeconds) + ",\n" +
    "  \"distSeconds\": " + itoa(ci.distSeconds) + ",\n" +
    "  \"bandwidth\": " + itoa64(r.bandwidth) + ",\n" +
    field2("descriptor", jsonText(r.descriptor)) +
    "  \"consensus\": \"" + jsonText(cons) + "\"\n" +
    "}\n";
}

/** A unix time from its digits, or -1 — a partial parse would silently date the network wrongly. */
i64 atoi64(u8[] text) {
  if (text.len() == 0) { return -1; }
  i64 v = 0;
  for (i32 i = 0; i < text.len(); i++) {
    if (text[i] < 48 || text[i] > 57) { return -1; }
    v = v * 10 + ((text[i] - 48) as i64);
  }
  return v;
}
