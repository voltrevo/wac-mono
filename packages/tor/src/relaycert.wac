// A relay's certificates: the four things it must present to prove who it is.
//
// A Tor relay identifies itself with two long-term keys and a chain of short-lived ones. tor-spec
// §4.2's CERTS cell carries them:
//
//   | type | what it is                                     | signed by       |
//   | ---- | ---------------------------------------------- | --------------- |
//   |  2   | RSA1024 identity, self-signed X.509            | itself          |
//   |  4   | ed25519 signing key                            | ed25519 identity|
//   |  5   | the TLS link key, as a SHA-256 digest          | signing key     |
//   |  7   | the ed25519 identity, cross-certified          | RSA identity    |
//
// The point of the shape is that the two identity keys stay offline. A running relay holds only the
// *signing* key, which certifies the link key that changes with the TLS certificate; if it is
// compromised the identity is not. Type 7 is what ties the two identities together, so a client that
// knows a relay only by its RSA fingerprint can still believe its ed25519 key.
//
// This file builds types 4, 5 and 7. Type 2 is an X.509 certificate and lives in `relayx509.wac`,
// because DER is a different problem.
//
// ## Two signature constructions, and only one of them is obvious
//
// An **ed25519 certificate** (types 4 and 5) is signed over "the first N-64 bytes" — the whole
// certificate except the signature, with no prefix. cert-spec §1.1 says signatures are generally
// prefixed with a personalisation string "unless otherwise specified", and §2.1 specifies otherwise.
// Reading only §1.1 gives a certificate no relay accepts.
//
// The **RSA cross-certificate** (type 7) is the other way round: it *does* have a prefix, and the
// signature is over `SHA-256("Tor TLS RSA/Ed25519 cross-certificate" | ED25519_KEY | EXPIRATION)`
// with no DigestInfo. That is why `rsaSignRawPkcs1` exists.

import { ed25519Sign, ed25519Verify } from "../../crypto/src/ed25519.wac";
import { sha256 } from "../../crypto/src/sha256.wac";
import { rsaSignRawPkcs1 } from "../../crypto/src/rsa.wac";

/** `ed25519 signing key, signed with identity key`. */
export const i32 CERT_TYPE_SIGNING = 4;
/** `TLS link certificate, signed with ed25519 signing key`. */
export const i32 CERT_TYPE_LINK = 5;
/** `Ed25519 AUTHENTICATE cell key, signed with ed25519 signing key`. */
export const i32 CERT_TYPE_AUTH = 6;
/** `Ed25519 identity, signed with RSA identity` — a different format from 4, 5 and 6. */
export const i32 CERT_TYPE_RSA_CROSSCERT = 7;

/** `CERT_KEY_TYPE`: the certified key is an ed25519 public key. */
export const i32 KEY_TYPE_ED25519 = 1;
/** `CERT_KEY_TYPE`: the certified key is a SHA-256 digest of an X.509 certificate. */
export const i32 KEY_TYPE_SHA256_X509 = 3;

/** `signed-with-ed25519-key`, cert-spec §2.2.1. */
export const i32 EXT_SIGNED_WITH_KEY = 4;

u8[] be32(i64 v) {
  u8[] b = u8[4]();
  for (i32 i = 0; i < 4; i++) {
    b[i] = ((v >> (((3 - i) * 8) as@ u32)) & 0xFF) as~ i32;
  }
  return b;
}

/**
 * An ed25519 certificate (cert-spec §2.1), carrying its signing key in an extension.
 *
 *     VERSION[1]=1  CERT_TYPE[1]  EXPIRATION[4]  CERT_KEY_TYPE[1]  CERTIFIED_KEY[32]
 *     N_EXTENSIONS[1]=1  ExtLength[2]=32 ExtType[1]=4 ExtFlags[1]=0 signingKey[32]
 *     SIGNATURE[64]
 *
 * `expirationHours` is **hours** since the epoch, not seconds. A four-byte seconds field would have
 * run out in 2106; in hours it lasts to 10136, which is why the unit is unusual.
 *
 * The signing key is always included as extension 4. It is optional in the format and a relay that
 * omits it makes the certificate unverifiable by anyone who does not already have the key — which,
 * for the link certificate, is every client on its first connection.
 *
 * `signingSecret` is the 32-byte ed25519 seed, not an expanded key.
 */
export u8[] ed25519Cert(
  i32 certType, i64 expirationHours, i32 certKeyType, u8[] certifiedKey,
  u8[] signingKey, u8[] signingSecret
) {
  if (certifiedKey.len() != 32 || signingKey.len() != 32 || signingSecret.len() != 32) {
    return u8[0]();
  }
  if (expirationHours < 0 || expirationHours > 4294967295) { return u8[0](); }

  i32 bodyLen = 1 + 1 + 4 + 1 + 32 + 1 + 4 + 32;
  u8[] cert = u8[bodyLen + 64]();
  cert[0] = 1;
  cert[1] = certType;
  u8[] exp = be32(expirationHours);
  for (i32 i = 0; i < 4; i++) { cert[2 + i] = exp[i]; }
  cert[6] = certKeyType;
  for (i32 i = 0; i < 32; i++) { cert[7 + i] = certifiedKey[i]; }
  cert[39] = 1;                       // one extension
  cert[40] = 0;                       // ExtLength, big-endian 32
  cert[41] = 32;
  cert[42] = EXT_SIGNED_WITH_KEY;
  cert[43] = 0;                       // ExtFlags
  for (i32 i = 0; i < 32; i++) { cert[44 + i] = signingKey[i]; }

  // "The signature is formed by signing the first N-64 bytes of the certificate" — the whole thing
  // except the signature, and with no personalisation prefix, despite §1.1's general rule.
  u8[] body = u8[bodyLen]();
  for (i32 i = 0; i < bodyLen; i++) { body[i] = cert[i]; }
  u8[] sig = ed25519Sign(signingSecret, body);
  if (sig.len() != 64) { return u8[0](); }
  for (i32 i = 0; i < 64; i++) { cert[bodyLen + i] = sig[i]; }
  return cert;
}

/**
 * Whether an ed25519 certificate is signed by `signingKey`.
 *
 * The caller supplies the key rather than trusting extension 4: a certificate that carries the key
 * that signed it proves only that somebody with *a* key signed it. The extension exists so a
 * verifier can find the key it should already have been told about, not so it can decide what to
 * trust — and `certSignedWithKey` in `hsdesc.wac` is deliberately a separate function for that
 * reason.
 */
export bool verifyEd25519Cert(u8[] cert, u8[] signingKey) {
  if (cert.len() < 104 || signingKey.len() != 32) { return false; }
  if (cert[0] != 1) { return false; }
  i32 bodyLen = cert.len() - 64;
  u8[] body = u8[bodyLen]();
  for (i32 i = 0; i < bodyLen; i++) { body[i] = cert[i]; }
  u8[] sig = u8[64]();
  for (i32 i = 0; i < 64; i++) { sig[i] = cert[bodyLen + i]; }
  return ed25519Verify(signingKey, body, sig);
}

/** `"Tor TLS RSA/Ed25519 cross-certificate"`, the prefix type 7's signature covers. */
u8[] crossCertPrefix() { return "Tor TLS RSA/Ed25519 cross-certificate".toBytes(); }

/**
 * The type-7 RSA→ed25519 cross-certificate (cert-spec §2.3).
 *
 *     ED25519_KEY[32]  EXPIRATION_DATE[4]  SIGLEN[1]  SIGNATURE[SIGLEN]
 *
 * A different shape from types 4–6 and signed differently: the RSA identity signs
 * `SHA-256(prefix | ED25519_KEY | EXPIRATION)` as a **bare digest**, with no DigestInfo, which is
 * why `rsaSignRawPkcs1` rather than `rsaSignPkcs1`.
 *
 * `SIGLEN` is one byte, so a modulus above 2040 bits cannot be described here. Tor identity keys are
 * RSA-1024 and the field has never needed to be wider; a caller passing something larger gets an
 * empty result rather than a truncated length.
 */
export u8[] rsaCrossCert(u8[] ed25519Identity, i64 expirationHours, u8[] rsaModulus, u8[] rsaPrivate) {
  if (ed25519Identity.len() != 32) { return u8[0](); }
  if (expirationHours < 0 || expirationHours > 4294967295) { return u8[0](); }
  if (rsaModulus.len() == 0 || rsaModulus.len() > 255) { return u8[0](); }

  u8[] prefix = crossCertPrefix();
  u8[] signed = u8[prefix.len() + 36]();
  for (i32 i = 0; i < prefix.len(); i++) { signed[i] = prefix[i]; }
  for (i32 i = 0; i < 32; i++) { signed[prefix.len() + i] = ed25519Identity[i]; }
  u8[] exp = be32(expirationHours);
  for (i32 i = 0; i < 4; i++) { signed[prefix.len() + 32 + i] = exp[i]; }

  u8[] sig = rsaSignRawPkcs1(rsaModulus, rsaPrivate, sha256(signed));
  if (sig.len() == 0 || sig.len() > 255) { return u8[0](); }

  u8[] cert = u8[32 + 4 + 1 + sig.len()]();
  for (i32 i = 0; i < 32; i++) { cert[i] = ed25519Identity[i]; }
  for (i32 i = 0; i < 4; i++) { cert[32 + i] = exp[i]; }
  cert[36] = sig.len();
  for (i32 i = 0; i < sig.len(); i++) { cert[37 + i] = sig[i]; }
  return cert;
}

/** The digest a type-5 link certificate certifies: SHA-256 of the DER TLS certificate. */
export u8[] linkCertDigest(u8[] tlsCertDer) { return sha256(tlsCertDer); }

// ── The CERTS cell ────────────────────────────────────────────────────────────

/**
 * A CERTS cell body: `N [1]`, then `CertType [1] CLEN [2] Certificate [CLEN]` for each.
 *
 * `types[i]` describes `certs[i]`. No certificate may appear twice — tor-spec says "a CERTS cell may
 * have no more than one certificate of each CertType" — so a duplicate is refused here rather than
 * sent and rejected by the far end.
 */
export u8[] certsCell(i32[] types, u8[][] certs) {
  if (types.len() != certs.len() || types.len() == 0 || types.len() > 255) { return u8[0](); }
  for (i32 i = 0; i < types.len(); i++) {
    if (certs[i].len() == 0 || certs[i].len() > 65535) { return u8[0](); }
    for (i32 j = i + 1; j < types.len(); j++) {
      if (types[i] == types[j]) { return u8[0](); }
    }
  }
  i32 n = 1;
  for (i32 i = 0; i < certs.len(); i++) { n = n + 3 + certs[i].len(); }
  u8[] out = u8[n]();
  out[0] = types.len();
  i32 at = 1;
  for (i32 i = 0; i < certs.len(); i++) {
    out[at] = types[i];
    out[at + 1] = (certs[i].len() >> 8) & 0xFF;
    out[at + 2] = certs[i].len() & 0xFF;
    for (i32 j = 0; j < certs[i].len(); j++) { out[at + 3 + j] = certs[i][j]; }
    at = at + 3 + certs[i].len();
  }
  return out;
}

/** The certificate of type `want` in a CERTS cell body, or empty. */
export u8[] certOfType(u8[] cell, i32 want) {
  if (cell.len() < 1) { return u8[0](); }
  i32 n = cell[0];
  i32 at = 1;
  for (i32 i = 0; i < n; i++) {
    if (at + 3 > cell.len()) { return u8[0](); }
    i32 type = cell[at];
    i32 length = (cell[at + 1] * 256) + cell[at + 2];
    if (at + 3 + length > cell.len()) { return u8[0](); }
    if (type == want) {
      u8[] out = u8[length]();
      for (i32 j = 0; j < length; j++) { out[j] = cell[at + 3 + j]; }
      return out;
    }
    at = at + 3 + length;
  }
  return u8[0]();
}
