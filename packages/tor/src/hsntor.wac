// hs-ntor: the handshake a client runs with a hidden service, through two relays that see neither end.
//
// A variant of ntor (tor-spec §5.1.4) with one addition: as well as agreeing forward-secure keys, it
// carries *encrypted data to the service* inside the first message. That is what lets a client send
// its rendezvous cookie and chosen rendezvous point in the INTRODUCE1 cell itself, in one direction,
// with no round trip — the introduction point relays a cell it cannot read to a service it cannot
// identify.
//
//     PROTOID    = "tor-hs-ntor-curve25519-sha3-256-1"
//     t_hsenc    = PROTOID | ":hs_key_extract"
//     t_hsverify = PROTOID | ":hs_verify"
//     t_hsmac    = PROTOID | ":hs_mac"
//     m_hsexpand = PROTOID | ":hs_key_expand"
//
// The client, holding the service's introduction encryption key B and the introduction point's
// authentication key AUTH_KEY, generates x,X and computes
//
//     intro_secret_hs_input = EXP(B,x) | AUTH_KEY | X | B | PROTOID
//     info                  = m_hsexpand | N_hs_subcred
//     hs_keys               = SHAKE-256(intro_secret_hs_input | t_hsenc | info, 32 + 32)
//     ENC_KEY, MAC_KEY      = hs_keys
//
// and on the service's reply Y,
//
//     rend_secret_hs_input = EXP(X,y) | EXP(B,x) | AUTH_KEY | B | X | Y | PROTOID
//     NTOR_KEY_SEED        = MAC(rend_secret_hs_input, t_hsenc)
//     verify               = MAC(rend_secret_hs_input, t_hsverify)
//     auth_input           = verify | AUTH_KEY | B | Y | X | PROTOID | "Server"
//     AUTH_INPUT_MAC       = MAC(auth_input, t_hsmac)
//
// where `MAC(m, k) = SHA3-256(INT_8(len(k)) | k | m)`. rend-spec-v3 §3.3.2.
//
// ## What each Diffie-Hellman is for, and why a round trip cannot tell
//
// `EXP(B,x)` is against the service's *published* key, so it authenticates: only the service can
// derive the same value. `EXP(X,y)` is between two ephemerals, so it gives forward secrecy. Drop
// either and the handshake still completes and both sides still agree a key — the first silently
// loses forward secrecy, the second lets anyone impersonate the service. This is why the tests are a
// differential against tor rather than a round trip against ourselves, exactly as `src/ntor.wac`'s
// are and for the same reason.
//
// ## The subcredential is in `info`, not in the secret
//
// It goes through the KDF's info parameter rather than into the input secret. That is what binds the
// handshake to *this time period's* descriptor: a client using last period's subcredential derives
// different keys and the service's MAC check fails, rather than the two of them agreeing on
// something and failing later for a reason nobody can see.

import { sha3_256, shake256 } from "../../crypto/src/keccak.wac";
import { x25519, x25519Base } from "../../crypto/src/x25519.wac";

export const i32 S_KEY_LEN = 32;
export const i32 MAC_LEN = 32;
export const i32 PK_PUBKEY_LEN = 32;

u8[] protoid() { return "tor-hs-ntor-curve25519-sha3-256-1".toBytes(); }

u8[] tweak(string suffix) {
  u8[] p = protoid();
  u8[] s = suffix.toBytes();
  u8[] out = u8[p.len() + s.len()]();
  for (i32 i = 0; i < p.len(); i++) { out[i] = p[i]; }
  for (i32 i = 0; i < s.len(); i++) { out[p.len() + i] = s[i]; }
  return out;
}

export u8[] tHsEnc() { return tweak(":hs_key_extract"); }
export u8[] tHsVerify() { return tweak(":hs_verify"); }
export u8[] tHsMac() { return tweak(":hs_mac"); }
export u8[] mHsExpand() { return tweak(":hs_key_expand"); }

/** `packages/crypto`'s, re-exported so a caller of this handshake needs one import. */
export u8[] clientPublicKey(u8[] secret) { return x25519Base(secret); }

u8[] u64be(i64 v) {
  u8[] b = u8[8]();
  for (i32 i = 0; i < 8; i++) {
    b[i] = ((v >> (((7 - i) * 8) as@ u32)) & 0xFF) as~ i32;
  }
  return b;
}

u8[] concat(u8[][] parts) {
  i32 n = 0;
  for (i32 i = 0; i < parts.len(); i++) { n = n + parts[i].len(); }
  u8[] out = u8[n]();
  i32 at = 0;
  for (i32 i = 0; i < parts.len(); i++) {
    for (i32 j = 0; j < parts[i].len(); j++) { out[at + j] = parts[i][j]; }
    at = at + parts[i].len();
  }
  return out;
}

u8[] slice(u8[] s, i32 from, i32 to) {
  u8[] o = u8[to - from]();
  for (i32 i = 0; i < o.len(); i++) { o[i] = s[from + i]; }
  return o;
}

bool isZero(u8[] b) {
  i32 acc = 0;
  for (i32 i = 0; i < b.len(); i++) { acc = acc | b[i]; }
  return acc == 0;
}

/**
 * `MAC(key, message) = SHA3-256(INT_8(len(key)) | key | message)`, rend-spec-v3 §0.3.
 *
 * **The key comes first, and which argument is the key is not obvious from the specification.**
 * §3.3.2 writes `NTOR_KEY_SEED = MAC(rend_secret_hs_input, t_hsenc)`, which reads naturally as
 * "MAC of the secret under the tweak" — and is the opposite way round. §0.3 defines
 * `MAC(key=k, message=m)`, so positionally the *secret* is the key and the short tweak string is the
 * message. tor's `crypto_mac_sha3_256(out, len, key, key_len, msg, msg_len)` is called with
 * `(rend_secret_hs_input, T_HSENC)` and settles it.
 *
 * Getting this backwards produces a perfectly good 32 bytes that no service agrees with. It cost a
 * first attempt here, caught by the differential rather than by reading.
 *
 * The length prefix stops a key and a message being reinterpreted as a different split of the same
 * bytes — without it, `MAC("ab", "c")` and `MAC("a", "bc")` are one hash.
 */
export u8[] hsMac(u8[] key, u8[] message) {
  u8[][] parts = u8[][3]();
  parts[0] = u64be(key.len() as i64);
  parts[1] = key;
  parts[2] = message;
  return sha3_256(concat(parts));
}

/**
 * The INTRODUCE1 cell's `ENC_KEY | MAC_KEY`, 64 bytes, or empty.
 *
 * `introEncKey` is the service's `enc-key ntor` from the descriptor, `introAuthKey` the introduction
 * point's `auth-key`. Empty if the Diffie-Hellman degenerates — see below — which is a refusal and
 * not a key, because a caller handed keys plus a boolean tends to use the keys.
 */
export u8[] clientIntroduceKeys(
  u8[] introAuthKey, u8[] introEncKey, u8[] clientSecret, u8[] subcredential
) {
  if (introAuthKey.len() != 32 || introEncKey.len() != 32) { return u8[0](); }
  if (clientSecret.len() != 32 || subcredential.len() != 32) { return u8[0](); }

  u8[] clientPublic = x25519Base(clientSecret);
  u8[] shared = x25519(clientSecret, introEncKey);
  // A small-order `B` makes the shared value all zero for every scalar, so anyone holding no private
  // key derives exactly what we would. tor-spec says abort; there is no key to return here.
  if (isZero(shared)) { return u8[0](); }

  u8[][] secret = u8[][5]();
  secret[0] = shared;
  secret[1] = introAuthKey;
  secret[2] = clientPublic;
  secret[3] = introEncKey;
  secret[4] = protoid();

  u8[][] input = u8[][4]();
  input[0] = concat(secret);
  input[1] = tHsEnc();
  input[2] = mHsExpand();
  input[3] = subcredential;
  return shake256(concat(input), S_KEY_LEN + MAC_LEN);
}

/**
 * From the service's reply `Y`: `AUTH_INPUT_MAC | NTOR_KEY_SEED`, 64 bytes, or empty.
 *
 * The caller must compare `AUTH_INPUT_MAC` against the `AUTH` field of the RENDEZVOUS2 cell before
 * using the key seed. That comparison is the whole authentication of the service, and it is left to
 * the caller rather than done here because this function does not see the cell.
 *
 * **No subcredential.** Unlike the introduction half it is not an input, which the specification says
 * and tor's `hs_ntor_client_get_rendezvous1_keys()` confirms by not taking one. tor's own
 * `test-hs-ntor-cl client2` *does* accept a subcredential argument and then never uses it, so the
 * parameter is absent here rather than accepted and ignored — an argument that changes nothing is
 * worse than no argument.
 */
export u8[] clientRendezvousKeys(
  u8[] introAuthKey, u8[] clientSecret, u8[] introEncKey, u8[] serviceEphemeral
) {
  if (introAuthKey.len() != 32 || introEncKey.len() != 32) { return u8[0](); }
  if (clientSecret.len() != 32 || serviceEphemeral.len() != 32) { return u8[0](); }

  u8[] clientPublic = x25519Base(clientSecret);
  u8[] xy = x25519(clientSecret, serviceEphemeral);
  u8[] xb = x25519(clientSecret, introEncKey);
  if (isZero(xy) || isZero(xb)) { return u8[0](); }

  u8[][] parts = u8[][7]();
  parts[0] = xy;
  parts[1] = xb;
  parts[2] = introAuthKey;
  parts[3] = introEncKey;
  parts[4] = clientPublic;
  parts[5] = serviceEphemeral;
  parts[6] = protoid();
  u8[] rendSecret = concat(parts);

  u8[] keySeed = hsMac(rendSecret, tHsEnc());
  u8[] verify = hsMac(rendSecret, tHsVerify());

  u8[][] auth = u8[][7]();
  auth[0] = verify;
  auth[1] = introAuthKey;
  auth[2] = introEncKey;
  auth[3] = serviceEphemeral;
  auth[4] = clientPublic;
  auth[5] = protoid();
  auth[6] = "Server".toBytes();
  u8[] authMac = hsMac(concat(auth), tHsMac());

  u8[][] out = u8[][2]();
  out[0] = authMac;
  out[1] = keySeed;
  return concat(out);
}
