import { tlsClientInit, tlsClientFeed, tlsClientSend, tlsClientClose, tlsClientPhase,
         tlsClientFailure } from "../../tls/src/client.wac";
export u8[] a(u8[] h, u8[] r, i32[] o, u8[] e, u8[] p, u8[] k, u8[] x, i64 n) {
  return tlsClientInit(h, r, o, e, p, k, x, n);
}
export u8[] b(u8[] s, u8[] i) { return tlsClientFeed(s, i); }
export u8[] c(u8[] s, u8[] d) { return tlsClientSend(s, d); }
export u8[] d(u8[] s) { return tlsClientClose(s); }
export i32 e(u8[] s) { return tlsClientPhase(s); }
export i32 f(u8[] s) { return tlsClientFailure(s); }
