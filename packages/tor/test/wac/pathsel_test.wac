// Path selection.
//
// Everything here is deterministic on purpose. The chooser takes its randomness as an
// argument rather than drawing it, because a chooser with its own entropy can only be tested
// statistically — and a statistical test loose enough never to flake is loose enough to miss
// a real bias. Feeding it every value in [0, total) instead pins the distribution exactly.
//
// That matters more here than anywhere else in the package. A wrong handshake fails loudly;
// a wrong path selection builds a working circuit with the anonymity quietly removed.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import {
  weightedChoice, weightedBandwidths, positionWeight, pathAllows, sameSubnet16, choose,
  positionGuard, positionMiddle, positionExit, portPermitted,
  parseWeights, resolveFamilies, eligible, exitsAnything, pick, Families,
} from "../../src/pathsel.wac";
import { Relay, ExitPolicy } from "../../src/directory.wac";

/**
 * A relay with just the fields path selection reads.
 *
 * These used to be parallel arrays — bandwidths here, flags there, addresses flattened to
 * four bytes each — because the chooser was driven from TypeScript and a struct could not
 * cross that boundary. Nothing needed them to be separate; they are one record now.
 */
Relay mk(string name, string addr, i32 bw, string[] flags) {
  return Relay(name, u8[20](), addr, 9001, flags, "", bw, u8[32](), null, string[0]());
}

string[] noFlags() { return string[]("Running", "Valid"); }
string[] guardFlags() { return string[]("Running", "Valid", "Guard"); }
string[] exitFlags() { return string[]("Running", "Valid", "Exit"); }
string[] bothFlags() { return string[]("Running", "Valid", "Guard", "Exit"); }

/** Wgg Wgd Wge Wgm | Wmg Wmd Wme Wmm | Weg Wed Wee Wem */
i64[] weights() {
  return i64[](10000, 3333, 0, 10000,
               0, 3333, 0, 10000,
               3333, 3333, 10000, 10000);
}

i32[] noPath() { return i32[0](); }
i32[] emptyFamilyStart(i32 n) {
  i32[] s = i32[n + 1]();
  return s;   // every start is 0, so nobody has any family
}

export string test_the_distribution_is_exactly_proportional() {
  // Every value in [0, total) fed through, counting where each lands. Not a sample — the
  // whole space, so the counts must be the weights and not merely close to them.
  T t = T.create();
  i64[] w = i64[](3, 0, 7, 1, 9);
  i32[] hits = i32[5]();
  for (i64 r = 0; r < 20; r++) {
    i32 i = weightedChoice(w, r);
    hits[i]++;
  }
  t.eqI32(hits[0], 3, "weight 3 is chosen three times in twenty");
  t.eqI32(hits[1], 0, "a zero weight is never chosen");
  t.eqI32(hits[2], 7, "weight 7");
  t.eqI32(hits[3], 1, "weight 1");
  t.eqI32(hits[4], 9, "weight 9");
  return t.report();
}

export string test_a_zero_weight_relay_is_never_returned() {
  // The property the eligibility filter depends on: `choose` excludes a relay by zeroing its
  // weight, so a chooser that could still return a zero-weighted index would ignore every
  // flag check, every family and every subnet rule at once.
  T t = T.create();
  i64[] w = i64[](0, 5, 0, 0, 11, 0);
  for (i64 r = 0; r < 16; r++) {
    i32 i = weightedChoice(w, r);
    t.isTrue(w[i] > 0, "index " + itoa64(i as i64) + " has a non-zero weight");
  }
  return t.report();
}

export string test_no_eligible_relay_is_reported_not_papered_over() {
  T t = T.create();
  t.eqI32(weightedChoice(i64[](0, 0, 0), 5), -1, "all zero weights gives -1");
  t.eqI32(weightedChoice(i64[0](), 0), -1, "so does an empty candidate list");
  // And -1 rather than 0: returning the first relay would look like a working client that
  // always picks the same first hop.
  t.eqI32(weightedChoice(i64[](0, 0, 4), 0), 2, "the one non-zero entry is found");
  return t.report();
}

export string test_the_flag_combination_picks_the_right_weight() {
  // The ordering bug this is here for: a relay with Guard *and* Exit must take the "both"
  // weight. Testing Guard first and returning gives it the guard-only weight, which sends
  // scarce exit capacity into the guard position — and every test of a guard-only relay
  // still passes.
  T t = T.create();
  i64[] w = weights();
  t.eqI64(positionWeight(positionGuard(), true, false, w), 10000, "guard only, at the guard");
  t.eqI64(positionWeight(positionGuard(), true, true, w), 3333, "guard and exit, at the guard");
  t.eqI64(positionWeight(positionGuard(), false, true, w), 0, "exit only cannot be a guard");
  t.eqI64(positionWeight(positionGuard(), false, false, w), 10000, "neither flag, at the guard");

  t.eqI64(positionWeight(positionExit(), false, true, w), 10000, "exit only, at the exit");
  t.eqI64(positionWeight(positionExit(), true, true, w), 3333, "guard and exit, at the exit");
  t.eqI64(positionWeight(positionMiddle(), true, false, w), 0, "guard only, in the middle");
  t.eqI64(positionWeight(positionMiddle(), false, false, w), 10000, "neither, in the middle");

  // Stated as a relation rather than a number, since this is the actual invariant: a relay
  // carrying both flags must not be treated as though it carried only one.
  t.isTrue(positionWeight(positionGuard(), true, true, w)
           != positionWeight(positionGuard(), true, false, w),
           "both flags is not the same as guard alone");
  t.isTrue(positionWeight(positionExit(), true, true, w)
           != positionWeight(positionExit(), false, true, w),
           "both flags is not the same as exit alone");
  return t.report();
}

export string test_weighting_survives_a_bandwidth_that_overflows_32_bits() {
  // A consensus bandwidth times a weight of 10000 leaves 32 bits well behind. In i32 the
  // product wraps negative, `weightedChoice` traps on it, and before that the biggest relays
  // would simply stop being chosen — a bias toward small relays with nothing in the logs.
  T t = T.create();
  Relay[] r = Relay[](mk("a", "10.0.0.1", 1000000, guardFlags()),
                      mk("b", "20.0.0.1", 500000, guardFlags()),
                      mk("c", "30.0.0.1", 1, guardFlags()));
  i64[] out = weightedBandwidths(r, positionGuard(), weights());
  t.eqI64(out[0], 1000000, "a million times 10000 over 10000");
  t.eqI64(out[1], 500000, "and half of it");
  t.isTrue(out[0] > 0, "still positive, which i32 arithmetic would not be");
  // The ratio is what the selection actually uses, so check that rather than the magnitude.
  t.eqI64(out[0] / out[1], 2, "twice the bandwidth, twice the weight");
  return t.report();
}

export string test_weighting_scales_by_the_position() {
  T t = T.create();
  // Relay 0 has both flags, relay 1 has neither.
  Relay[] r = Relay[](mk("both", "10.0.0.1", 100, bothFlags()),
                      mk("plain", "20.0.0.1", 100, noFlags()));
  i64[] atGuard = weightedBandwidths(r, positionGuard(), weights());
  t.eqI64(atGuard[0], 33, "a guard+exit relay is discounted at the guard position");
  t.eqI64(atGuard[1], 100, "a plain relay is not");
  i64[] atExit = weightedBandwidths(r, positionExit(), weights());
  t.eqI64(atExit[0], 33, "and discounted at the exit too");
  t.eqI64(atExit[1], 100, "while a plain relay can still be one here");
  return t.report();
}

// ── Constraints ──────────────────────────────────────────────────────────────

export string test_two_relays_in_one_slash_sixteen_cannot_share_a_path() {
  T t = T.create();
  t.isTrue(sameSubnet16("10.1.2.3", "10.1.9.9"), "same /16");
  t.isTrue(!sameSubnet16("10.1.2.3", "10.2.2.3"), "second octet differs");
  t.isTrue(!sameSubnet16("10.1.2.3", "11.1.2.3"), "first octet differs");
  t.isTrue(!sameSubnet16("10.1.2.3", "not an address"), "an unreadable address shares nothing");

  // Three relays: 0 and 1 share a /16, 2 does not.
  Relay[] r = Relay[](mk("a", "10.1.0.1", 100, noFlags()),
                      mk("b", "10.1.0.2", 100, noFlags()),
                      mk("c", "10.2.0.1", 100, noFlags()));
  i32[] fs = emptyFamilyStart(3);
  i32[] fo = i32[0]();
  t.isTrue(!pathAllows(r, i32[](0), 1, fs, fo, false), "1 cannot join a path with 0");
  t.isTrue(pathAllows(r, i32[](0), 2, fs, fo, false), "2 can");
  t.isTrue(pathAllows(r, i32[](0), 1, fs, fo, true), "unless the rule is waived");
  return t.report();
}

export string test_a_relay_cannot_appear_twice_in_one_path() {
  T t = T.create();
  Relay[] r = Relay[](mk("a", "10.1.0.1", 100, noFlags()),
                      mk("b", "20.1.0.2", 100, noFlags()),
                      mk("c", "30.2.0.1", 100, noFlags()));
  i32[] fs = emptyFamilyStart(3);
  i32[] fo = i32[0]();
  t.isTrue(!pathAllows(r, i32[](1), 1, fs, fo, false), "the same relay is refused");
  t.isTrue(!pathAllows(r, i32[](0, 1), 1, fs, fo, true), "even with every rule waived");
  t.isTrue(pathAllows(r, i32[](0, 1), 2, fs, fo, false), "a third relay is fine");
  return t.report();
}

export string test_family_members_cannot_share_a_path() {
  T t = T.create();
  // Four relays on distinct /16s. 0 and 2 are family; 1 and 3 are unrelated.
  Relay[] r = Relay[](mk("a", "10.0.0.1", 100, noFlags()), mk("b", "20.0.0.1", 100, noFlags()),
                      mk("c", "30.0.0.1", 100, noFlags()), mk("d", "40.0.0.1", 100, noFlags()));
  // Flattened adjacency: relay 0 -> [2], relay 2 -> [0], others empty.
  i32[] fs = i32[](0, 1, 1, 2, 2);
  i32[] fo = i32[](2, 0);

  t.isTrue(!pathAllows(r, i32[](0), 2, fs, fo, false), "2 cannot join a path with 0");
  t.isTrue(!pathAllows(r, i32[](2), 0, fs, fo, false), "and 0 cannot join one with 2");
  t.isTrue(pathAllows(r, i32[](0), 1, fs, fo, false), "an unrelated relay can");
  t.isTrue(pathAllows(r, i32[](1), 3, fs, fo, false), "and so can two unrelated ones");
  // Family is not waived by allowSameSubnet — that flag is about addresses only.
  t.isTrue(!pathAllows(r, i32[](0), 2, fs, fo, true),
           "waiving the subnet rule does not waive the family rule");
  return t.report();
}

export string test_a_one_sided_family_entry_still_excludes() {
  // The adjacency `pathAllows` receives is symmetric by construction — the caller drops
  // claims that are not mutual. This checks the belt-and-braces half anyway, with asymmetric
  // data that only a bug in that resolution could produce.
  //
  // It exists because the test above could not see the difference. Its data was symmetric,
  // so dropping either direction of the check left every assertion passing; planting exactly
  // that fault was the only way to find out. The same shape as the relay tests' symmetric
  // oracle, and the same lesson.
  T t = T.create();
  Relay[] r = Relay[](mk("a", "10.0.0.1", 100, noFlags()), mk("b", "20.0.0.1", 100, noFlags()),
                      mk("c", "30.0.0.1", 100, noFlags()));
  // Relay 0 lists relay 2. Relay 2 lists nobody.
  i32[] forward = i32[](0, 1, 1, 1);
  i32[] fo = i32[](2);
  t.isTrue(!pathAllows(r, i32[](2), 0, forward, fo, false),
           "the relay that made the claim is excluded from a path holding its target");
  t.isTrue(!pathAllows(r, i32[](0), 2, forward, fo, false),
           "and the target is excluded from a path holding the claimant");

  // The mirror image: relay 2 lists relay 0, relay 0 lists nobody.
  i32[] backward = i32[](0, 0, 0, 1);
  i32[] bo = i32[](0);
  t.isTrue(!pathAllows(r, i32[](0), 2, backward, bo, false), "and the same the other way");
  t.isTrue(!pathAllows(r, i32[](2), 0, backward, bo, false), "in both orders");

  // An unrelated relay is still fine under either.
  t.isTrue(pathAllows(r, i32[](0), 1, forward, fo, false), "relay 1 is unaffected");
  t.isTrue(pathAllows(r, i32[](2), 1, backward, bo, false), "under either adjacency");
  return t.report();
}

export string test_choose_excludes_what_the_path_forbids() {
  // The two halves together: the weight says who is worth picking, the path says who is
  // allowed, and `choose` must apply both. Sweeping every random value proves the excluded
  // relay is unreachable rather than merely unlikely.
  T t = T.create();
  Relay[] r = Relay[](mk("a", "10.0.0.1", 100, noFlags()), mk("b", "10.0.0.2", 100, noFlags()),
                      mk("c", "30.0.0.1", 100, noFlags()));
  i32[] fs = emptyFamilyStart(3);
  i32[] fo = i32[0]();
  i64[] weighted = i64[](100, 100, 100);

  // With relay 0 already in the path, relay 1 shares its /16 and must never come back.
  i32[] chosen = i32[](0);
  i32 sawOne = 0;
  i32 sawTwo = 0;
  for (i64 rnd = 0; rnd < 300; rnd++) {
    i32 i = choose(r, weighted, chosen, fs, fo, false, rnd);
    if (i == 0) { t.isFalse(true, "the relay already in the path was chosen again"); }
    if (i == 1) { sawOne++; }
    if (i == 2) { sawTwo++; }
  }
  t.eqI32(sawOne, 0, "the same-/16 relay is never chosen");
  t.eqI32(sawTwo, 300, "and the eligible one always is");

  // With nothing chosen yet, all three are reachable in proportion.
  i32 c0 = 0;
  for (i64 rnd = 0; rnd < 300; rnd++) {
    if (choose(r, weighted, noPath(), fs, fo, false, rnd) == 0) { c0++; }
  }
  t.eqI32(c0, 100, "an unconstrained path picks each of three equally");
  return t.report();
}

export string test_a_fully_constrained_position_reports_no_candidate() {
  // The case a client must not paper over. If every relay is excluded there is no path, and
  // the honest answer is -1 — not a retry with the rules relaxed.
  T t = T.create();
  Relay[] r = Relay[](mk("a", "10.0.0.1", 50, noFlags()), mk("b", "10.0.0.2", 50, noFlags()));
  i32[] fs = emptyFamilyStart(2);
  i32[] fo = i32[0]();
  i64[] weighted = i64[](50, 50);
  t.eqI32(choose(r, weighted, i32[](0), fs, fo, false, 7), -1,
          "only relay left shares the /16, so there is no candidate");
  t.eqI32(choose(r, weighted, i32[](0), fs, fo, true, 7), 1,
          "and waiving the rule finds it");
  return t.report();
}

// ── Exit policies ────────────────────────────────────────────────────────────

export string test_an_accept_policy_permits_only_what_it_lists() {
  T t = T.create();
  // accept 80,443,8000-8100
  i32[] r = i32[](80, 80, 443, 443, 8000, 8100);
  t.isTrue(portPermitted(true, r, 80), "80 is listed");
  t.isTrue(portPermitted(true, r, 443), "443 is listed");
  t.isTrue(portPermitted(true, r, 8000), "the low end of a range is inclusive");
  t.isTrue(portPermitted(true, r, 8100), "and so is the high end");
  t.isTrue(portPermitted(true, r, 8050), "as is the middle");
  t.isTrue(!portPermitted(true, r, 79), "one below a single port");
  t.isTrue(!portPermitted(true, r, 81), "one above it");
  t.isTrue(!portPermitted(true, r, 7999), "one below a range");
  t.isTrue(!portPermitted(true, r, 8101), "one above it");
  t.isTrue(!portPermitted(true, r, 22), "and anything else");
  return t.report();
}

export string test_a_reject_policy_permits_everything_it_does_not_list() {
  // The same data read the other way. Stated as the exact complement, because getting the
  // polarity backwards sends traffic to precisely the exits that will refuse it — and that
  // looks like a flaky network, not a bug, since the client just retries elsewhere.
  T t = T.create();
  i32[] r = i32[](80, 80, 443, 443, 8000, 8100);
  for (i32 p = 1; p < 9000; p += 7) {
    t.isTrue(portPermitted(true, r, p) != portPermitted(false, r, p),
             "accept and reject disagree at every port, including " + itoa64(p as i64));
  }
  t.isTrue(!portPermitted(false, r, 80), "reject 80 refuses 80");
  t.isTrue(portPermitted(false, r, 22), "and permits 22");
  return t.report();
}

export string test_the_degenerate_policies_are_the_right_way_round() {
  T t = T.create();
  i32[] none = i32[0]();
  t.isTrue(!portPermitted(true, none, 80), "accept nothing permits nothing");
  t.isTrue(portPermitted(false, none, 80), "reject nothing permits everything");
  i32[] all = i32[](1, 65535);
  t.isTrue(portPermitted(true, all, 1), "accept 1-65535 permits the first port");
  t.isTrue(portPermitted(true, all, 65535), "and the last");
  t.isTrue(!portPermitted(false, all, 443), "reject 1-65535 permits nothing");
  return t.report();
}

// ── Resolving a consensus, ported from TypeScript ────────────────────────────

export string test_bandwidth_weights_are_read_or_defaulted() {
  T t = T.create();
  u8[] doc = ("network-status-version 3\n" +
    "bandwidth-weights Wgg=5000 Wed=1234 Wee=9999 Wgd=-1\n").toBytes();
  i64[] w = parseWeights(doc);
  t.eqI64(w[0], 5000, "Wgg");
  t.eqI64(w[9], 1234, "Wed");
  t.eqI64(w[10], 9999, "Wee");
  t.eqI64(w[3], 10000, "an absent weight is neutral rather than zero");
  t.eqI64(w[1], 0, "a negative one is clamped, since weightedChoice traps on it");

  i64[] none = parseWeights("network-status-version 3\n".toBytes());
  for (i32 i = 0; i < 12; i++) {
    // Wge is the one exception and has its own test below: the authorities never publish it
    // and tor hardcodes it to zero. This assertion said "all twelve" until a real consensus
    // was checked, which is to say it encoded the bug rather than catching it.
    if (i == 2) { continue; }
    t.eqI64(none[i], 10000, "no line at all means plain bandwidth, not no bandwidth");
  }
  return t.report();
}

export string test_a_family_claim_counts_only_when_mutual() {
  // Otherwise anyone can shrink everyone's candidate set by claiming kinship they are not
  // owed, which is a cheap way to push clients onto the relays an attacker does run.
  T t = T.create();
  Relay a = mk("alpha", "10.0.0.1", 100, noFlags());
  Relay b = mk("beta", "20.0.0.1", 100, noFlags());
  Relay c = mk("gamma", "30.0.0.1", 100, noFlags());
  a.family = string[]("beta");
  b.family = string[]("alpha");
  c.family = string[]("alpha");        // unrequited
  Relay[] r = Relay[](a, b, c);

  Families f = resolveFamilies(r);
  t.eqI32(f.start[1] - f.start[0], 1, "alpha has one family member");
  t.eqI32(f.of[f.start[0]], 1, "and it is beta");
  t.eqI32(f.start[2] - f.start[1], 1, "beta has one");
  t.eqI32(f.start[3] - f.start[2], 0, "gamma's one-sided claim on alpha is dropped");
  return t.report();
}

export string test_a_family_named_by_fingerprint_resolves() {
  T t = T.create();
  Relay a = mk("alpha", "10.0.0.1", 100, noFlags());
  Relay b = mk("beta", "20.0.0.1", 100, noFlags());
  for (i32 i = 0; i < 20; i++) { a.identity[i] = i; }
  for (i32 i = 0; i < 20; i++) { b.identity[i] = 100 + i; }
  // A consensus writes `$FINGERPRINT`, sometimes with `=name` or `~name` after it.
  a.family = string[]("$" + hexOf(b.identity) + "=beta");
  b.family = string[]("$" + hexOf(a.identity));
  Relay[] r = Relay[](a, b);

  Families f = resolveFamilies(r);
  t.eqI32(f.start[1] - f.start[0], 1, "alpha's family resolved by fingerprint");
  t.eqI32(f.of[f.start[0]], 1, "to beta");
  t.eqI32(f.start[2] - f.start[1], 1, "and beta's back to alpha");
  return t.report();
}

export string test_a_relay_must_be_usable_and_right_for_the_position() {
  T t = T.create();
  Relay guard = mk("g", "10.0.0.1", 100, guardFlags());
  Relay plain = mk("m", "20.0.0.1", 100, noFlags());
  Relay exit = mk("e", "30.0.0.1", 100, exitFlags());
  exit.exitPolicy = ExitPolicy(true, i32[](80, 80));

  t.isTrue(eligible(guard, positionGuard(), 0), "a Guard relay at the guard position");
  t.isTrue(!eligible(plain, positionGuard(), 0), "and a plain one is not");
  t.isTrue(eligible(plain, positionMiddle(), 0), "which is fine in the middle");
  t.isTrue(eligible(exit, positionExit(), 80), "an exit whose policy carries the port");
  t.isTrue(!eligible(exit, positionExit(), 443), "and not one whose policy does not");
  t.isTrue(eligible(exit, positionExit(), 0), "port 0 means no stream is planned");

  Relay noPolicy = mk("np", "40.0.0.1", 100, exitFlags());
  t.isTrue(!eligible(noPolicy, positionExit(), 80),
           "an Exit flag with no summary carries nothing — a missing p line is reject-all");
  t.isTrue(eligible(noPolicy, positionExit(), 0), "though it can still carry a directory circuit");

  Relay dead = mk("d", "50.0.0.1", 100, string[]("Guard"));
  t.isTrue(!eligible(dead, positionGuard(), 0), "Running and Valid are required");
  Relay keyless = mk("k", "60.0.0.1", 100, guardFlags());
  keyless.ntorOnionKey = u8[0]();
  t.isTrue(!eligible(keyless, positionGuard(), 0),
           "and a relay with no onion key cannot be handshaked with, whatever its flags say");
  return t.report();
}

export string test_pick_respects_flags_policy_and_the_path() {
  T t = T.create();
  Relay g = mk("g", "10.0.0.1", 100, guardFlags());
  Relay m = mk("m", "20.0.0.1", 100, noFlags());
  Relay e = mk("e", "30.0.0.1", 100, exitFlags());
  e.exitPolicy = ExitPolicy(true, i32[](443, 443));
  Relay[] r = Relay[](g, m, e);
  Families f = resolveFamilies(r);
  i64[] w = parseWeights("network-status-version 3\n".toBytes());

  for (i64 rnd = 0; rnd < 40; rnd++) {
    t.eqI32(pick(r, w, f, positionGuard(), i32[0](), 0, false, rnd), 0, "only one guard");
    t.eqI32(pick(r, w, f, positionExit(), i32[0](), 443, false, rnd), 2, "only one exit for 443");
    t.eqI32(pick(r, w, f, positionExit(), i32[0](), 22, false, rnd), -1, "and none for 22");
    t.eqI32(pick(r, w, f, positionMiddle(), i32[](0, 2), 0, false, rnd), 1,
            "the middle is whatever is left");
  }
  return t.report();
}

string hexOf(u8[] b) {
  u8[] digits = "0123456789ABCDEF".toBytes();
  u8[] out = u8[b.len() * 2]();
  for (i32 i = 0; i < b.len(); i++) {
    out[i * 2] = digits[(b[i] >> 4) & 15];
    out[i * 2 + 1] = digits[b[i] & 15];
  }
  return string.fromBytes(out);
}

export string test_wge_is_zero_because_nobody_publishes_it() {
  // The authorities publish nineteen bandwidth weights and Wge is not one of them. tor
  // hardcodes `We = 0` for the guard position, so an exit-only relay is never chosen as a
  // guard on bandwidth grounds.
  //
  // This defaulted to 10000 with the others until a real consensus was checked against the
  // parser. It was invisible, and would have stayed invisible: `eligible` rejects a relay
  // without the Guard flag before the weight is ever consulted, so two independent things
  // gave the same answer. The day the flag check moves or loosens, the weight is what would
  // have been holding the line — and at 10000 it would not have been.
  T t = T.create();
  i64[] w = parseWeights("network-status-version 3\n".toBytes());
  t.eqI64(w[2], 0, "Wge defaults to zero, not to the neutral 10000");
  t.eqI64(w[0], 10000, "while a weight that simply was not published stays neutral");

  // Present in the document, it is still read — the default is not a hardcode.
  i64[] given = parseWeights("bandwidth-weights Wge=1234 Wgg=5983\n".toBytes());
  t.eqI64(given[2], 1234, "an explicit Wge is honoured");
  t.eqI64(given[0], 5983, "and so is a real Wgg");

  // The consequence, spelled out: an exit-only relay weighs nothing at the guard position.
  t.eqI64(positionWeight(positionGuard(), false, true, parseWeights("x\n".toBytes())), 0,
          "an exit-only relay has no weight as a guard");
  return t.report();
}

/**
 * `exitsAnything` versus `eligible(r, positionExit(), 0)`.
 *
 * These look interchangeable and are not, which is the whole reason the function exists. A
 * port of 0 means "no stream is planned" — true of a directory circuit — so it deliberately
 * skips the policy check and passes for a relay whose summary is `reject 1-65535`, which is
 * most of the network.
 *
 * Written after a guard-selection check used the wrong one. It was meant to refuse a guard
 * that would leave no exit to build through, it asked with port 0, every Exit-flagged relay
 * answered yes, and it pinned the one relay that made every later circuit impossible. The
 * check ran, logged nothing, and protected nothing.
 */
Relay withPolicy(string name, string[] flags, bool isAccept, i32[] ranges) {
  return Relay(name, u8[20](), "10.0.0.1", 9001, flags, "", 1000, u8[32](),
               ExitPolicy(isAccept, ranges), string[0]());
}

export string test_exits_anything_is_not_eligible_with_port_zero() {
  T t = T.create();

  Relay rejectAll = withPolicy("rejects", exitFlags(), false, i32[](1, 65535));
  t.isTrue(eligible(rejectAll, positionExit(), 0),
           "port 0 passes a reject-all relay — no stream is planned, so no policy is read");
  t.isFalse(exitsAnything(rejectAll),
            "but it exits nothing, which is the question a guard check must ask");

  Relay web = withPolicy("web", exitFlags(), true, i32[](80, 80, 443, 443));
  t.isTrue(exitsAnything(web), "an accept list with ranges exits something");
  t.isTrue(eligible(web, positionExit(), 443), "and 443 is in it");
  t.isFalse(eligible(web, positionExit(), 25), "and 25 is not");

  Relay acceptNothing = withPolicy("empty", exitFlags(), true, i32[0]());
  t.isFalse(exitsAnything(acceptNothing), "an accept list with no ranges accepts nothing");

  // The reject cases. Something is permitted unless the ranges cover all of 1-65535, and the
  // gaps can only start at 1 or just past some range's end.
  Relay rejectMost = withPolicy("most", exitFlags(), false, i32[](1, 442, 444, 65535));
  t.isTrue(exitsAnything(rejectMost), "443 is the one port left, and it counts");
  t.isTrue(eligible(rejectMost, positionExit(), 443), "and it is the port that gets through");

  Relay rejectTail = withPolicy("tail", exitFlags(), false, i32[](2, 65535));
  t.isTrue(exitsAnything(rejectTail), "port 1 is uncovered");

  Relay rejectSplit = withPolicy("split", exitFlags(), false, i32[](1, 100, 101, 65535));
  t.isFalse(exitsAnything(rejectSplit), "two ranges that abut still cover everything");

  Relay noSummary = Relay("none", u8[20](), "10.0.0.1", 9001, exitFlags(), "", 1000,
                          u8[32](), null, string[0]());
  t.isFalse(exitsAnything(noSummary), "a missing summary is a reject-all, not 'no policy'");

  Relay notAnExit = withPolicy("plain", noFlags(), true, i32[](1, 65535));
  t.isFalse(exitsAnything(notAnExit), "no Exit flag, whatever the policy says");

  Relay bad = withPolicy("bad", string[]("Running", "Valid", "Exit", "BadExit"),
                         true, i32[](1, 65535));
  t.isFalse(exitsAnything(bad), "BadExit means the authorities said not to");
  return t.report();
}
