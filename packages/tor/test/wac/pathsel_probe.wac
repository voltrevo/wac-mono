// Path selection at the host boundary — transitional.
//
// `host/path.ts` still drives the chooser and still speaks in flattened arrays: bandwidths
// here, flags there, addresses as four bytes each. `src/pathsel.wac` no longer does, because
// a `Relay` is a struct on this side and the flattening only ever existed so that a struct
// could cross bindgen.
//
// So this rebuilds records from those arrays, which is the boundary tax made visible in one
// place instead of spread through the library. It goes when `host/path.ts` goes, and nothing
// new should be written against it — the wac tests call the real API directly.

import {
  weightedBandwidths as wb, choose as ch, weightedChoice as wc,
  positionWeight as pw, pathAllows as pa, sameSubnet16 as ss, portPermitted as pp,
} from "../../src/pathsel.wac";
import { Relay } from "../../src/directory.wac";

Relay blank() {
  return Relay("", u8[0](), "", 0, string[0](), "", 0, u8[0](), null, string[0]());
}

/** Flat arrays back into the records they were taken apart from. */
Relay[] rebuild(i64[] bandwidth, bool[] isGuard, bool[] isExit, u8[] addresses) {
  i32 n = bandwidth.len();
  Relay[] out = Relay[n](fill: blank());
  for (i32 i = 0; i < n; i++) {
    string[] flags = string[]("Running", "Valid",
                              isGuard[i] ? "Guard" : "-", isExit[i] ? "Exit" : "-");
    out[i] = Relay("", u8[0](), dotted(addresses, i * 4), 0, flags, "",
                   bandwidth[i] as! i32, u8[32](), null, string[0]());
  }
  return out;
}

/** Four bytes as the dotted quad `sameSubnet16` now compares. */
string dotted(u8[] a, i32 at) {
  if (at + 4 > a.len()) { return ""; }
  return d(a[at]) + "." + d(a[at + 1]) + "." + d(a[at + 2]) + "." + d(a[at + 3]);
}

string d(i32 v) {
  if (v == 0) { return "0"; }
  u8[] buf = u8[3]();
  i32 n = 0;
  i32 x = v;
  while (x > 0) {
    buf[n] = '0' + (x % 10);
    n++;
    x = x / 10;
  }
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = buf[n - 1 - i]; }
  return string.fromBytes(out);
}

export i64[] weightedBandwidths(i64[] bw, bool[] g, bool[] e, i32 pos, i64[] w) {
  return wb(rebuild(bw, g, e, u8[bw.len() * 4]()), pos, w);
}

export i32 choose(i64[] weighted, i32[] chosen, u8[] addrs, i32[] fs, i32[] fo, bool same, i64 r) {
  bool[] none = bool[weighted.len()]();
  return ch(rebuild(weighted, none, none, addrs), weighted, chosen, fs, fo, same, r);
}

export i32 weightedChoice(i64[] w, i64 r) { return wc(w, r); }
export i64 positionWeight(i32 p, bool g, bool e, i64[] w) { return pw(p, g, e, w); }

export bool pathAllows(i32[] c, i32 cand, u8[] a, i32[] fs, i32[] fo, bool same) {
  i32 n = a.len() / 4;
  bool[] none = bool[n]();
  return pa(rebuild(i64[n](), none, none, a), c, cand, fs, fo, same);
}

export bool sameSubnet16(u8[] a, u8[] b) { return ss(dotted(a, 0), dotted(b, 0)); }

export bool portPermitted(bool isAccept, i32[] ranges, i32 port) {
  return pp(isAccept, ranges, port);
}
