// A relay answering CREATE2, and carrying cells afterwards.
//
// The client half of this handshake is already checked against tor's own `test-ntor-cl`
// (`ntor_test.wac`), and the server half is checked there too — so the ntor arithmetic is not what
// is at stake here. What is:
//
//   - **the cell layer**: a CREATE2 payload read the way tor writes one, and a CREATED2 written the
//     way our client reads one;
//   - **the direction of the key material**, which the client never had to think about. A relay's
//     forward is the client's backward, and a relay that got it wrong would have every cell
//     unrecognised in both directions — a broken circuit, not a key error.
//
// Client and relay are both ours here, so this is not a differential. It says so; the differential
// is a C tor client building a circuit through this relay, which is `design/0002` step 3's *done*
// condition.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { x25519Base } from "../../../crypto/src/x25519.wac";
import {
  Created, Inbound, answerCreate2, create2Handshake, created2Cell, destroyCell,
  receiveFromClient, sendToClient, HOP_KEY_LEN, NTOR_REQUEST_LEN, NTOR_REPLY_LEN,
  DESTROY_PROTOCOL,
} from "../../src/relaycircuit.wac";
import { ntorClientRequest, ntorClientFinish } from "../../src/ntor.wac";
import { Hop, encryptRelay, decryptRelay, relayRecognized, relayCommand, relayStreamId,
         relayPayload, relayData, relayBegin } from "../../src/relay.wac";
import {
  encodeCreate2, decodeCreated2, cellPayload, cellCommand, cellCircId, cmdCreated2, cmdDestroy,
  handshakeNtor,
} from "../../src/cell.wac";

bool same(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}
u8[] fill(i32 n, i32 seed) {
  u8[] o = u8[n]();
  for (i32 i = 0; i < n; i++) { o[i] = (i * 31 + seed * 7 + 5) & 0xFF; }
  return o;
}
/** A curve25519 secret, clamped as the scalar must be. */
u8[] scalar(i32 seed) {
  u8[] s = fill(32, seed);
  s[0] = s[0] & 248;
  s[31] = (s[31] & 127) | 64;
  return s;
}

export string test_a_client_and_this_relay_agree_on_a_circuit() {
  // The whole handshake: the client builds a CREATE2, the relay answers, and both derive the same
  // keys. Then four relay cells in each direction, because a *running* digest that advances on only
  // one side survives the first cell and fails on the second.
  T t = T.create();
  u8[] identity = fill(20, 1);
  u8[] onionPriv = scalar(2);
  u8[] onionKey = x25519Base(onionPriv);
  u8[] clientEph = scalar(3);
  u8[] serverEph = scalar(4);

  u8[] request = ntorClientRequest(identity, onionKey, clientEph);
  t.eqI32(request.len(), NTOR_REQUEST_LEN, "an ntor request is 84 bytes");
  u8[] createCell = encodeCreate2(7, handshakeNtor(), request);

  Created answer = answerCreate2(7, cellPayload(createCell, 0), identity, onionPriv, serverEph);
  t.isTrue(answer.cell.len() > 0, "the relay answered");
  t.eqI32(cellCommand(answer.cell, 0), cmdCreated2(), "with a CREATED2 cell");
  t.eqI32(cellCircId(answer.cell, 0), 7, "on the circuit the client named");

  u8[] reply = decodeCreated2(cellPayload(answer.cell, 0));
  t.eqI32(reply.len(), NTOR_REPLY_LEN, "the reply is 64 bytes");

  // The client completes it. `ntorClientFinish` returns empty if the AUTH does not match, which is
  // the check that the relay is who the client asked for.
  u8[] clientKeys = ntorClientFinish(identity, onionKey, clientEph, reply, HOP_KEY_LEN);
  t.eqI32(clientKeys.len(), HOP_KEY_LEN, "the client accepted the relay's authentication");

  // Cells both ways. The client's hop is built the ordinary way; the relay's came out of
  // `answerCreate2` already reversed.
  Hop clientHop = Hop.create(clientKeys);
  i32 bad = 0;
  for (i32 n = 0; n < 4; n++) {
    // Client to relay.
    u8[] payload = fill(80 + n, 10 + n);
    u8[] wire = encryptRelay(clientHop, relayData(), 3 + n, payload);
    Inbound got = receiveFromClient(answer.hop, wire);
    if (!got.recognized) { bad = bad + 1; }
    if (got.command != relayData()) { bad = bad + 1; }
    if (got.streamId != 3 + n) { bad = bad + 1; }
    if (!same(got.data, payload)) { bad = bad + 1; }

    // Relay to client.
    u8[] back = fill(40 + n, 20 + n);
    u8[] cell = sendToClient(answer.hop, 7, relayData(), 3 + n, back);
    u8[] body = decryptRelay(clientHop, cellPayload(cell, 0));
    if (!relayRecognized(clientHop, body)) { bad = bad + 1; }
    if (!same(relayPayload(body), back)) { bad = bad + 1; }
  }
  t.eqI32(bad, 0, "four cells each way, recognised and byte-identical");
  return t.report();
}

export string test_the_relays_key_material_is_the_other_way_round() {
  // The assertion that the reversal is doing something. Build the relay's hop the *client's* way
  // from the same material and nothing must be recognised — if it were, the swap would be a no-op
  // and the circuit would only work by accident.
  T t = T.create();
  u8[] identity = fill(20, 5);
  u8[] onionPriv = scalar(6);
  u8[] onionKey = x25519Base(onionPriv);
  u8[] clientEph = scalar(7);

  u8[] request = ntorClientRequest(identity, onionKey, clientEph);
  Created answer = answerCreate2(1, cellPayload(encodeCreate2(1, handshakeNtor(), request), 0),
                                 identity, onionPriv, scalar(8));
  u8[] reply = decodeCreated2(cellPayload(answer.cell, 0));
  u8[] material = ntorClientFinish(identity, onionKey, clientEph, reply, HOP_KEY_LEN);
  t.eqI32(material.len(), HOP_KEY_LEN, "both sides derived key material");

  Hop clientHop = Hop.create(material);
  Hop wrongWay = Hop.create(material);        // the relay, built as if it were the client
  u8[] wire = encryptRelay(clientHop, relayData(), 1, "hello".toBytes());
  t.isFalse(relayRecognized(wrongWay, decryptRelay(wrongWay, wire)),
            "a relay using the client's key assignment recognises nothing");

  Hop rightWay = Hop.createReversed(material);
  t.isTrue(relayRecognized(rightWay, decryptRelay(rightWay, wire)),
           "and the reversed one recognises it");
  return t.report();
}

export string test_a_middle_relay_forwards_what_is_not_for_it() {
  // The whole of onion routing in one boolean. A cell addressed to a later hop decrypts to
  // something this hop does not recognise, and must be passed on with only this layer removed —
  // not dropped, and not treated as malformed.
  T t = T.create();
  u8[] material = fill(HOP_KEY_LEN, 9);
  Hop mine = Hop.createReversed(material);
  Hop somebodyElse = Hop.create(fill(HOP_KEY_LEN, 11));

  u8[] notForUs = encryptRelay(somebodyElse, relayData(), 1, "onwards".toBytes());
  Inbound got = receiveFromClient(mine, notForUs);
  t.isFalse(got.recognized, "a cell for a later hop is not recognised");
  t.eqI32(got.payload.len(), 509, "and comes out as a full payload to pass along");
  t.eqI32(got.command, -1, "with no command read from it");
  t.eqI32(got.data.len(), 0, "and no data — reading either would be reading somebody else's cell");

  // The layer really was removed: decrypting again with the same hop must not give the same bytes.
  t.isFalse(same(got.payload, notForUs), "our layer was stripped");
  return t.report();
}

export string test_a_create2_that_is_not_ntor_is_refused() {
  // TAP is dead, ntor-v3 is a different handshake, and guessing would hand `ntorServerRespond` the
  // wrong shape — which traps, because it asserts its own length. Refusing is not defensive noise:
  // a relay talks to strangers and a trap is a denial of service.
  T t = T.create();
  u8[] identity = fill(20, 12);
  u8[] onionPriv = scalar(13);
  u8[] good = ntorClientRequest(identity, x25519Base(onionPriv), scalar(14));

  t.eqI32(create2Handshake(cellPayload(encodeCreate2(1, handshakeNtor(), good), 0)).len(),
          NTOR_REQUEST_LEN, "an ntor CREATE2 reads");
  t.eqI32(create2Handshake(cellPayload(encodeCreate2(1, 1, good), 0)).len(), 0,
          "handshake type 1, TAP, is refused");
  t.eqI32(create2Handshake(cellPayload(encodeCreate2(1, 3, good), 0)).len(), 0,
          "handshake type 3, ntor-v3, is refused");
  t.eqI32(create2Handshake(cellPayload(encodeCreate2(1, handshakeNtor(), fill(83, 1)), 0)).len(), 0,
          "an 83-byte ntor request is refused");
  t.eqI32(create2Handshake(u8[3]()).len(), 0, "a payload too short for a header is refused");

  // A length field claiming more than the payload holds.
  u8[] lying = u8[509]();
  lying[1] = 2;                     // HTYPE = 2, ntor
  lying[2] = 255;                   // HLEN = 65535
  lying[3] = 255;
  t.eqI32(create2Handshake(lying).len(), 0, "a length past the payload is refused");

  // A *well-formed* header on a short payload — HLEN exactly 84, but only 50 bytes present. The
  // exact-length check above does not catch this one, and without the bounds check the read runs off
  // the end of the buffer and traps. Found by planting: removing the bounds check survived every
  // other case here, because they were all caught by HLEN not being 84.
  u8[] truncated = u8[50]();
  truncated[1] = 2;                 // HTYPE = 2, ntor
  truncated[2] = 0;                 // HLEN = 84, which is correct and still does not fit
  truncated[3] = 84;
  t.eqI32(create2Handshake(truncated).len(), 0, "a correct length on a truncated payload is refused");

  // And `answerCreate2` refuses the same things rather than trapping.
  Created bad = answerCreate2(1, lying, identity, onionPriv, scalar(15));
  t.eqI32(bad.cell.len(), 0, "the relay declines to answer");
  t.eqI32(answerCreate2(1, cellPayload(encodeCreate2(1, handshakeNtor(), good), 0),
                        fill(19, 1), onionPriv, scalar(15)).cell.len(), 0,
          "a 19-byte identity is refused");
  t.eqI32(answerCreate2(1, cellPayload(encodeCreate2(1, handshakeNtor(), good), 0),
                        identity, fill(31, 1), scalar(15)).cell.len(), 0,
          "a 31-byte onion key is refused");
  return t.report();
}

export string test_a_destroy_cell_says_why() {
  T t = T.create();
  u8[] cell = destroyCell(42, DESTROY_PROTOCOL);
  t.eqI32(cellCommand(cell, 0), cmdDestroy(), "a DESTROY cell");
  t.eqI32(cellCircId(cell, 0), 42, "on the right circuit");
  t.eqI32(cellPayload(cell, 0)[0], DESTROY_PROTOCOL, "carrying the reason");
  t.eqI32(cell.len(), 514, "and padded to a full cell like any other");
  return t.report();
}
