// Cell framing at the host boundary, for the link handshake driver.
import {
  encodeVersions as ev, negotiateVersion, encodeNetinfo as en, cellSize as cs, encodeFixed as ef,
  cellCommand as cc, cellPayload as cp, certsCount as ct, encodeCreate2 as ec2,
  decodeCreated2 as dc2, handshakeNtor,
} from "../../src/cell.wac";
import { ntorClientRequest as ncr, ntorClientFinish as ncf } from "../../src/ntor.wac";

export u8[] encodeFixed(i32 c, i32 cmd, u8[] p) { return ef(c, cmd, p); }
export u8[] encodeVersions(i32[] v) { return ev(v); }
export i32 negotiate(u8[] theirs, i32[] ours) { return negotiateVersion(theirs, ours); }
export u8[] encodeNetinfo(u8[] ip) { return en(ip); }
export i32 cellSize(u8[] b, i32 at) { return cs(b, at); }
export i32 cellCommand(u8[] b, i32 at) { return cc(b, at); }
export u8[] cellPayload(u8[] b, i32 at) { return cp(b, at); }
export i32 certsCount(u8[] p) { return ct(p); }
export u8[] encodeCreate2(i32 circ, u8[] hs) { return ec2(circ, handshakeNtor(), hs); }
export u8[] decodeCreated2(u8[] p) { return dc2(p); }
export u8[] ntorClientRequest(u8[] id, u8[] onion, u8[] priv) {
  return ncr(id, onion, priv);
}
export u8[] ntorClientFinish(u8[] id, u8[] onion, u8[] priv, u8[] reply, i32 keyLen) {
  return ncf(id, onion, priv, reply, keyLen);
}


// The relay layer. A Hop is a struct and cannot cross bindgen, so the host holds it as
// bytes and hands it back each call — see the note in relay.wac.
import {
  hopInit as hi, hopSend as hs, hopRecv as hr, hopStateLen as hsl,
  relayCommand as rc, relayStreamId as rs, relayPayload as rp, beginBody as bb,
  relayBegin as rb, relayData as rd, relayEnd as re, relayConnected as rcon,
  relaySendme as rsm, relayBeginDir as rbd, endReason as er,
} from "../../src/relay.wac";

export u8[] hopInit(u8[] material) { return hi(material); }
export u8[] hopSend(u8[] st, i32 cmd, i32 sid, u8[] data) { return hs(st, cmd, sid, data); }
export u8[] hopRecv(u8[] st, u8[] payload) { return hr(st, payload); }
export i32 hopStateLen() { return hsl(); }
export i32 relayCommand(u8[] b) { return rc(b); }
export i32 relayStreamId(u8[] b) { return rs(b); }
export u8[] relayPayload(u8[] b) { return rp(b); }
export u8[] beginBody(string hp) { return bb(hp); }
export i32 endReason(u8[] b) { return er(b); }
export i32 cmdRelayBegin() { return rb(); }
export i32 cmdRelayData() { return rd(); }
export i32 cmdRelayEnd() { return re(); }
export i32 cmdRelayConnected() { return rcon(); }
export i32 cmdRelaySendme() { return rsm(); }
export i32 cmdRelayBeginDir() { return rbd(); }

import {
  hopPeel as hp, hopWrap as hw, hopCheck as hc,
  extend2Body as e2b, extended2Reply as e2r, relayExtend2 as rx2, relayExtended2 as rx2d,
} from "../../src/relay.wac";

export u8[] hopPeel(u8[] st, u8[] p) { return hp(st, p); }
export u8[] hopWrap(u8[] st, u8[] p) { return hw(st, p); }
export u8[] hopCheck(u8[] st, u8[] b) { return hc(st, b); }
export u8[] extend2Body(u8[] ip, i32 port, u8[] id, u8[] hs) { return e2b(ip, port, id, hs); }
export u8[] extended2Reply(u8[] d) { return e2r(d); }
export i32 cmdRelayExtend2() { return rx2(); }
export i32 cmdRelayExtended2() { return rx2d(); }

import { hopDigest as hd, sendmeBodyV1 as sb } from "../../src/relay.wac";
export u8[] hopDigest(u8[] st, bool fwd) { return hd(st, fwd); }
export u8[] sendmeBodyV1(u8[] d) { return sb(d); }
