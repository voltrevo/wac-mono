// The vote signature span, against a signature a chutney authority made over its own vote.

import { T } from "../../../wactest/src/assert.wac";
import {
  compareBytes, RelayOpinion, signedLength, sortedStatusEntries, VoteInfo, voteDocument,
  voteSignatureDigest, voteSignatureDigest256,
} from "../../src/vote.wac";
import { AuthorityKeys } from "../../src/authcert.wac";
import { b64Unpadded, descriptorIdentity } from "../../src/routerdesc.wac";

const i32 V_VOTE = 0;
const i32 V_RECOVERED = 1;
const i32 V_DESC_COUNT = 2;
const i32 V_DESCRIPTOR = 3;
const i32 V_R_LINES = 4;
const i32 G_KEY = 5;
const i32 G_STR = 6;
const i32 G_NUM = 7;
const i32 G_CERT = 8;
const i32 G_DESC = 9;
const i32 G_VOTE = 10;

u8[] none() { return u8[0](); }

export string test_the_signed_span_is_tors(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();
  u8[] vote = ref(V_VOTE, none(), none());
  t.isTrue(vote.len() > 3000, "the vote is a whole document");

  u8[] want = ref(V_RECOVERED, none(), none());
  t.eqI32(want.len(), 20, "the signing key recovered a SHA-1 digest");

  // The assertion: tor's signature over tor's vote, under our span.
  t.eqBytes(voteSignatureDigest(vote), want, "our digest is the one the authority signed");

  // The span ends on the space after the keyword, and includes it. Asserted directly so a failure says
  // which rule broke rather than only that a digest differs.
  i32 end = signedLength(vote);
  t.isTrue(end > 0, "the keyword is present");
  t.eqI32(vote[end - 1], 32, "the span ends on the space after directory-signature");
  t.neI32(vote[end], 32, "and includes only that one space");

  // The fingerprints that follow are outside the span — an authority's signature does not cover the
  // claim about which authority made it.
  t.neI32(vote[end], 10, "the fingerprints follow the space, and are not signed");

  // The SHA-256 variant hashes the same span, which is what makes it a variant rather than a different
  // rule. Only the length is asserted: no vector here carries a sha256 signature to compare against.
  t.eqI32(voteSignatureDigest256(vote).len(), 32, "the sha256 form is over the same span");

  // A document without the keyword yields nothing rather than a digest of everything.
  t.eqI32(voteSignatureDigest("network-status-version 3\n".toBytes()).len(), 0,
          "no keyword, no digest");
  return t.report();
}

u8[] arg1(i32 i) {
  u8[] a = u8[1]();
  a[0] = i;
  return a;
}

export string test_the_entries_are_ordered_by_identity_digest(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();
  i32 n = ref(V_DESC_COUNT, none(), none())[0];
  t.isTrue(n >= 3, "several relays, so the order is a real question");

  u8[][] descriptors = u8[][n]();
  for (i32 i = 0; i < n; i++) { descriptors[i] = ref(V_DESCRIPTOR, arg1(i), none()); }

  // The r lines in our order, against the r lines in the order tor's authority wrote them. The input
  // order here is the vector's, which is neither the document's nor alphabetical.
  u8[][] lines = sortedStatusEntries(descriptors);
  u8[] joined = u8[0]();
  for (i32 i = 0; i < n; i++) {
    joined = i == 0 ? lines[i] : concat(concat(joined, "\n".toBytes()), lines[i]);
  }
  t.eqBytes(joined, ref(V_R_LINES, none(), none()),
            "our entry order is the order tor's authority wrote");

  // And the order really is ascending by digest, asserted directly so a failure names the rule.
  for (i32 i = 1; i < n; i++) {
    u8[] prev = identityOf(lines[i - 1]);
    u8[] here = identityOf(lines[i]);
    t.isTrue(prev.len() == 27 && here.len() == 27, "each line carries a base64 identity");
  }
  return t.report();
}

u8[] concat(u8[] a, u8[] b) {
  u8[] out = u8[a.len() + b.len()]();
  for (i32 i = 0; i < a.len(); i++) { out[i] = a[i]; }
  for (i32 i = 0; i < b.len(); i++) { out[a.len() + i] = b[i]; }
  return out;
}

/** The second field of an r line. */
u8[] identityOf(u8[] line) {
  i32 at = 0;
  i32 spaces = 0;
  while (at < line.len() && spaces < 2) {
    if (line[at] == 32) { spaces = spaces + 1; }
    at = at + 1;
  }
  i32 end = at;
  while (end < line.len() && line[end] != 32) { end = end + 1; }
  u8[] out = u8[end - at]();
  for (i32 i = 0; i < end - at; i++) { out[i] = line[at + i]; }
  return out;
}

/**
 * The smallest thing `sortedStatusEntries` will accept, with a chosen fingerprint.
 *
 * Only four lines matter to it: the `router` line for the nickname and ports, `published`, `fingerprint`
 * for the identity, and `router-signature` because the descriptor digest's span ends there.
 */
u8[] stubDescriptor(string nickname, string fingerprintHex) {
  return ("router " + nickname + " 127.0.0.1 1 0 2\n" +
          "published 2026-01-01 00:00:00\n" +
          "fingerprint " + fingerprintHex + "\n" +
          "router-signature\n").toBytes();
}

export string test_the_order_is_on_bytes_not_on_the_base64(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();

  // Two identities that the two orderings disagree about. Base64's alphabet is `A-Z a-z 0-9 + /` by
  // value, so 0x00… encodes to `AAA…` and 0xF4… to `9…`; by bytes the first is smaller, and by ASCII
  // text the second is, because '9' is 0x39 and 'A' is 0x41.
  //
  // The five real relays in the vector cannot show this: their digests all begin with base64 letters,
  // where ASCII order and base64 value order happen to agree. Sorting the text passed the whole
  // real-vote comparison — it was a surviving mutant until this test existed.
  u8[] low = stubDescriptor("low", "0000000000000000000000000000000000000000");
  u8[] high = stubDescriptor("high", "F400000000000000000000000000000000000000");

  u8[][] given = u8[][2]();
  given[0] = high;
  given[1] = low;

  u8[][] sorted = sortedStatusEntries(given);
  t.eqI32(sorted.len(), 2, "both entries come back");
  t.eqBytes(nicknameOf(sorted[0]), "low".toBytes(), "0x00 sorts before 0xF4, as bytes do");
  t.eqBytes(nicknameOf(sorted[1]), "high".toBytes(), "and 0xF4 comes second");

  // The disagreement itself, stated rather than implied.
  t.isTrue(compareBytes(descriptorIdentity(low), descriptorIdentity(high)) < 0,
           "by bytes, 0x00 precedes 0xF4");
  t.isTrue(compareBytes(b64Unpadded(descriptorIdentity(low)).toBytes(),
                        b64Unpadded(descriptorIdentity(high)).toBytes()) > 0,
           "by base64 text, the order is the other way round");
  return t.report();
}

/** The nickname field of an r line. */
u8[] nicknameOf(u8[] line) {
  i32 at = 2;                       // past "r "
  i32 end = at;
  while (end < line.len() && line[end] != 32) { end = end + 1; }
  u8[] out = u8[end - at]();
  for (i32 i = 0; i < end - at; i++) { out[i] = line[at + i]; }
  return out;
}

i64 gnum(fn[u8[](i32, u8[], u8[])] ref, i32 which) {
  u8[] b = ref(G_NUM, arg1(which), none());
  i64 v = 0;
  for (i32 i = 0; i < 8; i++) { v = v * 256 + (b[i] as i64); }
  return v;
}

string gstr(fn[u8[](i32, u8[], u8[])] ref, i32 which) {
  return string.fromBytes(ref(G_STR, arg1(which), none()));
}

export string test_the_vote_tor_accepted_is_reproduced(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();

  AuthorityKeys k = AuthorityKeys(
    ref(G_KEY, arg1(0), none()), ref(G_KEY, arg1(1), none()), ref(G_KEY, arg1(2), none()),
    ref(G_KEY, arg1(3), none()), ref(G_KEY, arg1(4), none()), ref(G_KEY, arg1(5), none()));

  VoteInfo info = VoteInfo(
    gstr(ref, 0), gstr(ref, 1), gstr(ref, 2),
    gnum(ref, 0) as~ i32, gnum(ref, 1) as~ i32, gstr(ref, 3),
    gnum(ref, 2), gnum(ref, 3), gnum(ref, 4), gnum(ref, 5),
    gnum(ref, 6) as~ i32, gnum(ref, 7) as~ i32);

  RelayOpinion[] relays = RelayOpinion[1]();
  relays[0] = RelayOpinion(ref(G_DESC, none(), none()), gstr(ref, 4), gnum(ref, 8), gstr(ref, 5));

  u8[] want = ref(G_VOTE, none(), none());
  t.isTrue(want.len() > 2000, "the committed vote is a whole document");

  // The assertion: tor's own parser accepted these exact bytes, and for a vote that means it verified
  // the signature — corrupting the signature, the embedded certificate, or one body byte are each
  // rejected. Reproducing them is reproducing a document a real tor checked.
  t.eqBytes(voteDocument(info, k, ref(G_CERT, none(), none()), relays), want,
            "the vote tor accepted is what we build");

  // Our own reading of it agrees about where the signature starts, which is the one rule the byte
  // comparison could not distinguish from a coincidence.
  u8[] built = voteDocument(info, k, ref(G_CERT, none(), none()), relays);
  i32 end = signedLength(built);
  t.isTrue(end > 0, "the built document announces its signature");
  t.eqI32(built[end - 1], 32, "and the signed span ends on the space");
  return t.report();
}
