// INTRODUCE2, against cells tor's own `hs_cell_build_introduce1` wrote.

import { T } from "../../../wactest/src/assert.wac";
import { Introduce2, parseIntroduce2, rendezvous1Cell } from "../../src/hsservice.wac";
import { linkSpecifiersValid } from "../../src/hsintro.wac";
import { hsMac, serviceIntroduceKeys } from "../../src/hsntor.wac";

const i32 I_COUNT = 0;
const i32 I_CELL = 1;
const i32 I_ENC_SECRET = 2;
const i32 I_SUBCRED = 3;
const i32 I_AUTH_KEY = 4;
const i32 I_CLIENT_PUBLIC = 5;
const i32 I_REND_COOKIE = 6;
const i32 I_REND_ONION_KEY = 7;
const i32 I_LINK_SPECS = 8;

u8[] none() { return u8[0](); }

u8[] at(i32 i) {
  u8[] a = u8[1]();
  a[0] = i;
  return a;
}

Introduce2 parsed(fn[u8[](i32, u8[], u8[])] ref, i32 i) {
  return parseIntroduce2(ref(I_CELL, at(i), none()), ref(I_AUTH_KEY, at(i), none()),
                         ref(I_ENC_SECRET, at(i), none()), ref(I_SUBCRED, at(i), none()));
}

/** Everything tor put in, recovered. */
export string test_a_cell_tor_built_is_understood(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();
  i32 n = ref(I_COUNT, none(), none())[0];
  t.isTrue(n >= 2, "there are several cells, not one");

  for (i32 i = 0; i < n; i++) {
    Introduce2 got = parsed(ref, i);
    t.isTrue(got.ok, "the cell parses and its MAC checks out");
    t.eqBytes(got.authKey, ref(I_AUTH_KEY, at(i), none()), "the introduction point's auth key");
    t.eqBytes(got.clientPublic, ref(I_CLIENT_PUBLIC, at(i), none()), "the client's ephemeral key");
    t.eqBytes(got.rendCookie, ref(I_REND_COOKIE, at(i), none()), "the rendezvous cookie");
    t.eqBytes(got.rendOnionKey, ref(I_REND_ONION_KEY, at(i), none()), "the rendezvous point's key");
  }
  return t.report();
}

/**
 * The link specifier list is the list, and not the padding after it.
 *
 * tor pads an INTRODUCE1 to a fixed size. A parser returning the rest of the plaintext agrees with
 * our own client's builder, which does not pad, and hands a caller a list followed by a few hundred
 * zero bytes. `linkSpecifiersValid` is asked here as well as the byte comparison, because it is what
 * a service would actually call next and it requires the list to be exactly consumed — so it is the
 * function that would have refused the padded answer.
 */
export string test_the_link_specifiers_stop_before_the_padding(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();
  i32 n = ref(I_COUNT, none(), none())[0];

  for (i32 i = 0; i < n; i++) {
    Introduce2 got = parsed(ref, i);
    t.eqBytes(got.linkSpecifiers, ref(I_LINK_SPECS, at(i), none()),
              "exactly the specifiers tor was given");
    t.isTrue(linkSpecifiersValid(got.linkSpecifiers),
             "and the list our own validator accepts, which the padded form is not");
    // The cell is far longer than what came back, which is what makes the two answers different.
    t.isTrue(ref(I_CELL, at(i), none()).len() > got.linkSpecifiers.len() + 100,
             "the cell really is padded, so this distinguishes the two readings");
  }
  return t.report();
}

/**
 * A cell that has been tampered with is refused.
 *
 * The MAC covers the whole cell including the twenty leading zero bytes, so any change anywhere
 * before it fails. Without these the tests above would pass for a parser that skipped the MAC
 * entirely and simply decrypted whatever it was handed.
 */
export string test_a_tampered_cell_is_refused(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();
  u8[] cell = ref(I_CELL, at(0), none());
  u8[] auth = ref(I_AUTH_KEY, at(0), none());
  u8[] secret = ref(I_ENC_SECRET, at(0), none());
  u8[] subcred = ref(I_SUBCRED, at(0), none());

  t.isTrue(parseIntroduce2(cell, auth, secret, subcred).ok, "the unmodified cell is accepted");

  // A *tampered* auth key: the MAC covers the field, so this fails whether the key used for the
  // derivation comes from the cell or from us. It passed before the fix below existed, which is why
  // it did not notice that the key was being taken from the cell.
  t.isTrue(!parseIntroduce2(flipAt(cell, 25), auth, secret, subcred).ok, "a changed auth key is refused");

  // The case that tells the two apart: tor's own cell, entirely self-consistent, offered at an
  // introduction point whose auth key is a different one. tor sets `data.auth_pk` from its own record
  // for the circuit the cell arrived on and never reads the field, so it rejects this. Deriving the
  // MAC key from the cell's field accepts it — the client names a key, we key the MAC with the same
  // wrong value, and it verifies. Nothing is tampered, so no MAC check can notice.
  t.isTrue(!parseIntroduce2(cell, flipAt(auth, 0), secret, subcred).ok,
           "a valid cell for another introduction point is refused");
  t.isTrue(!parseIntroduce2(cell, u8[31](), secret, subcred).ok, "and a key that is not a key");
  t.isTrue(!parseIntroduce2(flipAt(cell, 60), auth, secret, subcred).ok, "a changed CLIENT_PK is refused");
  t.isTrue(!parseIntroduce2(flipAt(cell, 120), auth, secret, subcred).ok,
           "a changed ciphertext byte is refused");
  t.isTrue(!parseIntroduce2(flipAt(cell, cell.len() - 1), auth, secret, subcred).ok,
           "a changed MAC is refused");
  // The leading LEGACY_KEY_ID is twenty zeros and is inside the MAC span, which is the detail the
  // specification states differently from what tor does. A parser using the shorter span accepts this.
  t.isTrue(!parseIntroduce2(flipAt(cell, 3), auth, secret, subcred).ok,
           "a byte of LEGACY_KEY_ID is covered too");

  // Wrong keys, which is what an introduction point relaying to the wrong service looks like.
  t.isTrue(!parseIntroduce2(cell, auth, flipScalar(secret), subcred).ok, "another service's secret fails");
  t.isTrue(!parseIntroduce2(cell, auth, secret, flipAt(subcred, 0)).ok,
           "another period's subcredential fails");
  return t.report();
}

/** Malformed input is refused rather than read past. */
export string test_a_malformed_cell_is_refused(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();
  u8[] cell = ref(I_CELL, at(0), none());
  u8[] auth = ref(I_AUTH_KEY, at(0), none());
  u8[] secret = ref(I_ENC_SECRET, at(0), none());
  u8[] subcred = ref(I_SUBCRED, at(0), none());

  t.isTrue(!parseIntroduce2(u8[0](), auth, secret, subcred).ok, "an empty cell is not a cell");
  t.isTrue(!parseIntroduce2(u8[40](), auth, secret, subcred).ok, "nor is a short run of zeros");
  t.isTrue(!parseIntroduce2(head(cell, 100), auth, secret, subcred).ok, "a truncated cell is refused");

  // A non-zero LEGACY_KEY_ID means a v2 introduction point, which this does not serve.
  //
  // Flipping the byte alone proves nothing here: LEGACY_KEY_ID is inside the MAC span, so the MAC
  // check refuses it whether or not the structural check exists — which a planted fault showed by
  // surviving. The cell below carries a **valid MAC over the modified bytes**, so only the explicit
  // check can refuse it. That is the cell a v2 introduction point would actually relay.
  u8[] legacy = flipAt(cell, 0);
  u8[] authKey = sub(legacy, 23, 55);
  u8[] clientPublic = sub(legacy, 56, 88);
  u8[] keys = serviceIntroduceKeys(authKey, secret, clientPublic, subcred);
  t.eqI32(keys.len(), 64, "the keys for the modified cell are derivable");
  u8[] remac = hsMac(sub(keys, 32, 64), sub(legacy, 0, legacy.len() - 32));
  for (i32 i = 0; i < 32; i++) { legacy[legacy.len() - 32 + i] = remac[i]; }
  t.isTrue(!parseIntroduce2(legacy, auth, secret, subcred).ok,
           "a legacy key id is refused even with a MAC that checks out");
  return t.report();
}

u8[] sub(u8[] s, i32 from, i32 to) {
  u8[] out = u8[to - from]();
  for (i32 i = 0; i < out.len(); i++) { out[i] = s[from + i]; }
  return out;
}

/** RENDEZVOUS1 is the cookie and the handshake, and refuses anything else. */
export string test_the_rendezvous1_cell_is_cookie_then_handshake(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();
  u8[] cookie = ref(I_REND_COOKIE, at(0), none());
  u8[] handshake = u8[64]();
  for (i32 i = 0; i < 64; i++) { handshake[i] = i; }

  u8[] cell = rendezvous1Cell(cookie, handshake);
  t.eqI32(cell.len(), 84, "twenty bytes of cookie and sixty-four of handshake");
  t.eqBytes(head(cell, 20), cookie, "the cookie comes first, which is all the relay reads");
  for (i32 i = 0; i < 64; i++) {
    t.eqI32(cell[20 + i], handshake[i], "then Y and AUTH, forwarded to the client untouched");
  }

  t.eqI32(rendezvous1Cell(u8[19](), handshake).len(), 0, "a nineteen-byte cookie is not one");
  t.eqI32(rendezvous1Cell(cookie, u8[63]()).len(), 0, "a short handshake is refused");
  t.eqI32(rendezvous1Cell(cookie, u8[0]()).len(), 0, "and an absent one");
  return t.report();
}

u8[] flipAt(u8[] b, i32 i) {
  u8[] out = u8[b.len()]();
  for (i32 j = 0; j < b.len(); j++) { out[j] = b[j]; }
  out[i] = out[i] ^ 1;
  return out;
}

/** As `flipAt(b, 0)`, but keeping curve25519's clamping so the result is still a valid scalar. */
u8[] flipScalar(u8[] b) {
  u8[] out = u8[b.len()]();
  for (i32 j = 0; j < b.len(); j++) { out[j] = b[j]; }
  out[1] = out[1] ^ 1;
  return out;
}

u8[] head(u8[] s, i32 n) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = s[i]; }
  return out;
}
