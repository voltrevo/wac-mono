// Descriptor parsing and both layers of decryption, against a descriptor tor published.
//
// `test/data/hsdesc_vectors.json` holds a real v3 descriptor — 14 KB, three introduction points —
// fetched by a tor client over its own circuits, together with the keys and plaintext digests derived
// independently by `tools/capture-descriptor.py` using `hashlib` and `openssl enc`. Nothing in the
// vector came from this implementation, and the capture verifies both layer MACs before writing, so a
// mis-captured descriptor cannot become an expected value.
//
// The strongest assertion here is the plaintext digest: SHAKE-256 key derivation, AES-256-CTR and the
// whole 10 KB layer have to be right to the byte, and one wrong bit anywhere changes the hash.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { sha3_256 } from "../../../crypto/src/keccak.wac";
import {
  decryptLayer, layerKeys, layerMac, keywordValue, keywordInt, pemBlock, findKeywordLine,
  certSignedWithKey, certCertifiedKey, certType, slice,
  superencryptedConstant, encryptedConstant,
  S_KEY_LEN, S_IV_LEN, MAC_KEY_LEN, SALT_LEN, MAC_LEN,
} from "../../src/hsdesc.wac";
import {
  IntroPoint, parseIntroPoints, linkSpecifiersValid, linkSpecifier,
  introduce1Plaintext, introduce1Cell, introduce1MacInput, establishRendezvousCell,
  rendezvous2HandshakeInfo, LS_IPV4, LS_LEGACY_ID, LS_ED25519_ID, buildIntroduce1,
} from "../../src/hsintro.wac";
import { hsMac } from "../../src/hsntor.wac";
import { aesCtr } from "../../../crypto/src/aesctr.wac";

const i32 V_DESCRIPTOR = 0;
const i32 V_KEYS = 1;         // identity(32) blinded(32) signing(32) subcred(32) revision(8)
const i32 V_LAYER = 2;        // a[0]=layer: salt(16) key(32) iv(16) mackey(32) sha3(32) len(8)
const i32 V_INTRO_COUNT = 3;
const i32 V_INTRO = 4;      // a[0]=i: lsLen(2) linkSpecifiers onion(32) enc(32) auth(32)

bool same(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}
i64 be64(u8[] b, i32 at) {
  i64 v = 0;
  for (i32 i = 0; i < 8; i++) { v = (v << 8) | (b[at + i] as i64); }
  return v;
}
u8[] arg1(i32 i) {
  u8[] a = u8[1]();
  a[0] = i;
  return a;
}
u8[] none() { return u8[0](); }

export string test_the_outer_descriptor_parses(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();
  u8[] doc = ref(V_DESCRIPTOR, none(), none());
  u8[] keys = ref(V_KEYS, none(), none());
  t.isTrue(doc.len() > 10000, "the descriptor is a real one, not a stub");

  t.isTrue(same(keywordValue(doc, "hs-descriptor".toBytes()), "3".toBytes()),
           "hs-descriptor 3");
  t.eqI64(keywordInt(doc, "revision-counter".toBytes()), be64(keys, 128),
          "the revision counter is the one the vector records");
  i64 lifetime = keywordInt(doc, "descriptor-lifetime".toBytes());
  t.isTrue(lifetime >= 30 && lifetime <= 720,
           "the lifetime is inside the 30..720 minutes rend-spec-v3 allows");

  // The certificate, and the two 32-byte keys in it that are easy to mix up: the *certified* key is
  // the short-lived descriptor signing key, and the blinded key is in extension 4.
  u8[] cert = pemBlock(doc, "descriptor-signing-key-cert".toBytes(), "ED25519 CERT".toBytes());
  t.isTrue(cert.len() > 100, "the signing key certificate decodes");
  t.eqI32(certType(cert), 8, "it is a type-8 descriptor signing certificate");
  t.isTrue(same(certSignedWithKey(cert), slice(keys, 32, 64)),
           "extension 4 carries the blinded public key");
  t.isTrue(same(certCertifiedKey(cert), slice(keys, 64, 96)),
           "and the certified key is the descriptor signing key");
  t.isFalse(same(certSignedWithKey(cert), certCertifiedKey(cert)),
            "the two keys are different, so confusing them would be caught");

  u8[] blob = pemBlock(doc, "superencrypted".toBytes(), "MESSAGE".toBytes());
  t.isTrue(blob.len() > SALT_LEN + MAC_LEN, "the superencrypted blob decodes");
  t.eqI32((blob.len() - SALT_LEN - MAC_LEN) % 16, 0,
          "the ciphertext is a whole number of AES blocks");
  return t.report();
}

export string test_both_layers_decrypt_to_what_tor_encrypted(fn[u8[](i32, u8[], u8[])] ref) {
  // The central test. Two layers, and for each: the derived keys must be tor's, and the plaintext
  // must hash to what an independent decryption produced.
  T t = T.create();
  u8[] doc = ref(V_DESCRIPTOR, none(), none());
  u8[] keys = ref(V_KEYS, none(), none());
  u8[] blinded = slice(keys, 32, 64);
  u8[] subcred = slice(keys, 96, 128);
  i64 revision = be64(keys, 128);

  u8[] outer = pemBlock(doc, "superencrypted".toBytes(), "MESSAGE".toBytes());
  u8[] first = checkLayer(t, ref, 0, outer, blinded, subcred, revision, superencryptedConstant(),
                          "superencrypted");
  if (first.len() == 0) { return t.report(); }

  // The first layer's plaintext is a document in its own right, holding the second layer's blob.
  u8[] inner = pemBlock(first, "encrypted".toBytes(), "MESSAGE".toBytes());
  t.isTrue(inner.len() > SALT_LEN + MAC_LEN, "the first layer contains the second layer's blob");
  u8[] second = checkLayer(t, ref, 1, inner, blinded, subcred, revision, encryptedConstant(),
                           "encrypted");
  if (second.len() == 0) { return t.report(); }

  // And what is inside is a descriptor body with introduction points.
  i32 wanted = ref(V_INTRO_COUNT, none(), none())[0];
  i32 found = 0;
  i32 at = 0;
  while (at >= 0) {
    at = findKeywordLine(second, "introduction-point ".toBytes(), at);
    if (at >= 0) {
      found = found + 1;
      at = at + 1;
    }
  }
  t.eqI32(found, wanted, "we found the introduction points tor published");
  t.isTrue(found >= 1, "there is at least one, or the descriptor is useless");
  t.isTrue(findKeywordLine(second, "onion-key ntor ".toBytes(), 0) >= 0,
           "an introduction point carries an ntor onion key");
  return t.report();
}

/** One layer: keys, MAC and plaintext, each against the vector. Returns the plaintext or empty. */
u8[] checkLayer(
  T t, fn[u8[](i32, u8[], u8[])] ref, i32 which, u8[] blob,
  u8[] secretData, u8[] subcred, i64 revision, u8[] constant, string name
) {
  u8[] v = ref(V_LAYER, arg1(which), none());
  u8[] wantSalt = slice(v, 0, 16);
  u8[] wantKey = slice(v, 16, 48);
  u8[] wantIv = slice(v, 48, 64);
  u8[] wantMacKey = slice(v, 64, 96);
  u8[] wantSha3 = slice(v, 96, 128);
  i64 wantLen = be64(v, 128);

  u8[] salt = slice(blob, 0, SALT_LEN);
  t.isTrue(same(salt, wantSalt), name + ": the salt is the one in the blob tor produced");

  // The three derived keys, separately. A wrong key and a failed MAC both present as "it did not
  // decrypt", and only asserting them apart says which.
  u8[] derived = layerKeys(secretData, subcred, revision, salt, constant);
  t.eqI32(derived.len(), S_KEY_LEN + S_IV_LEN + MAC_KEY_LEN, name + ": 80 bytes of key material");
  t.isTrue(same(slice(derived, 0, S_KEY_LEN), wantKey), name + ": SECRET_KEY agrees with tor's");
  t.isTrue(same(slice(derived, S_KEY_LEN, S_KEY_LEN + S_IV_LEN), wantIv),
           name + ": SECRET_IV agrees");
  t.isTrue(same(slice(derived, S_KEY_LEN + S_IV_LEN, derived.len()), wantMacKey),
           name + ": MAC_KEY agrees");

  u8[] ciphertext = slice(blob, SALT_LEN, blob.len() - MAC_LEN);
  t.isTrue(same(layerMac(wantMacKey, salt, ciphertext), slice(blob, blob.len() - MAC_LEN, blob.len())),
           name + ": the MAC we compute is the MAC on the wire");

  u8[] plain = decryptLayer(blob, secretData, subcred, revision, constant);
  t.eqI64(plain.len() as i64, wantLen, name + ": the plaintext is the expected length");
  t.isTrue(same(sha3_256(plain), wantSha3),
           name + ": the plaintext hashes to what an independent decryption produced");
  return plain;
}

export string test_a_tampered_layer_is_refused(fn[u8[](i32, u8[], u8[])] ref) {
  // AES-CTR is bit-for-bit malleable and the ciphertext comes from an unauthenticated relay. Without
  // the MAC an HSDir could rewrite the introduction points — which relays a client contacts and which
  // keys it uses — and the client would parse the result happily. So every part of the blob is moved
  // in turn and every one must be refused.
  T t = T.create();
  u8[] doc = ref(V_DESCRIPTOR, none(), none());
  u8[] keys = ref(V_KEYS, none(), none());
  u8[] blinded = slice(keys, 32, 64);
  u8[] subcred = slice(keys, 96, 128);
  i64 revision = be64(keys, 128);
  u8[] blob = pemBlock(doc, "superencrypted".toBytes(), "MESSAGE".toBytes());
  u8[] constant = superencryptedConstant();

  t.isTrue(decryptLayer(blob, blinded, subcred, revision, constant).len() > 0,
           "the unmodified blob decrypts, so the refusals below mean something");

  i32[] spots = i32[](0, 8, SALT_LEN, SALT_LEN + 1, SALT_LEN + 500, 5000);
  for (i32 i = 0; i < spots.len(); i++) {
    u8[] bad = u8[blob.len()]();
    for (i32 j = 0; j < blob.len(); j++) { bad[j] = blob[j]; }
    bad[spots[i]] = (bad[spots[i]] ^ 1);
    t.eqI32(decryptLayer(bad, blinded, subcred, revision, constant).len(), 0,
            "a flipped bit at " + itoa64(spots[i] as i64) + " is refused");
  }
  // And the MAC itself, which is the field an attacker would have to forge rather than avoid.
  u8[] badMac = u8[blob.len()]();
  for (i32 j = 0; j < blob.len(); j++) { badMac[j] = blob[j]; }
  badMac[blob.len() - 1] = (badMac[blob.len() - 1] ^ 1);
  t.eqI32(decryptLayer(badMac, blinded, subcred, revision, constant).len(), 0,
          "a flipped bit in the MAC is refused");

  // Wrong secrets: each of the three inputs to the key schedule, changed alone.
  u8[] otherKey = u8[32]();
  for (i32 i = 0; i < 32; i++) { otherKey[i] = blinded[i]; }
  otherKey[0] = (otherKey[0] ^ 1);
  t.eqI32(decryptLayer(blob, otherKey, subcred, revision, constant).len(), 0,
          "a wrong blinded key is refused");
  u8[] otherSub = u8[32]();
  for (i32 i = 0; i < 32; i++) { otherSub[i] = subcred[i]; }
  otherSub[31] = (otherSub[31] ^ 1);
  t.eqI32(decryptLayer(blob, blinded, otherSub, revision, constant).len(), 0,
          "a wrong subcredential is refused");
  t.eqI32(decryptLayer(blob, blinded, subcred, revision + 1, constant).len(), 0,
          "a wrong revision counter is refused");
  t.eqI32(decryptLayer(blob, blinded, subcred, revision, encryptedConstant()).len(), 0,
          "the other layer's constant is refused — the two are not interchangeable");

  // Truncation, which is the shape a malicious HSDir gets for free.
  t.eqI32(decryptLayer(slice(blob, 0, SALT_LEN + MAC_LEN - 1), blinded, subcred, revision,
                       constant).len(), 0, "a blob too short to hold a salt and a MAC is refused");
  t.eqI32(decryptLayer(u8[0](), blinded, subcred, revision, constant).len(), 0,
          "an empty blob is refused");
  return t.report();
}

export string test_the_document_reader_does_not_match_mid_line(fn[u8[](i32, u8[], u8[])] ref) {
  // dir-spec's format is keyword lines, and a reader that used a substring search would find
  // `signature` inside a base64 body and take whatever followed. That is not hypothetical here: a
  // 14 KB descriptor is mostly base64, so almost every short keyword appears inside it by chance.
  T t = T.create();
  u8[] doc = "hs-descriptor 3\nrevision-counter 42\nnot-a-keyword hs-descriptor 9\n".toBytes();
  t.isTrue(same(keywordValue(doc, "hs-descriptor".toBytes()), "3".toBytes()),
           "the keyword at the start of a line is found");
  t.eqI64(keywordInt(doc, "revision-counter".toBytes()), 42, "and an integer value reads");

  // The same text appearing mid-line must not be found as a keyword.
  u8[] mid = "some-line contains hs-descriptor 9\nhs-descriptor 3\n".toBytes();
  t.isTrue(same(keywordValue(mid, "hs-descriptor".toBytes()), "3".toBytes()),
           "a mid-line occurrence is skipped in favour of the real line");

  // Absent, and present but empty.
  t.eqI32(keywordValue(doc, "no-such-keyword".toBytes()).len(), 0, "an absent keyword is empty");
  t.eqI64(keywordInt(doc, "no-such-keyword".toBytes()), -1, "and an absent integer is -1");
  t.eqI64(keywordInt(doc, "not-a-keyword".toBytes()), -1, "a non-numeric value is -1, not 0");

  // A PEM block that never ends must not return the rest of the document.
  u8[] unterminated = "thing\n-----BEGIN MESSAGE-----\nQUJD\n".toBytes();
  t.eqI32(pemBlock(unterminated, "thing".toBytes(), "MESSAGE".toBytes()).len(), 0,
          "an unterminated block is refused rather than run to the end");
  u8[] good = "thing\n-----BEGIN MESSAGE-----\nQUJD\n-----END MESSAGE-----\n".toBytes();
  t.isTrue(same(pemBlock(good, "thing".toBytes(), "MESSAGE".toBytes()), "ABC".toBytes()),
           "a well-formed block decodes");
  return t.report();
}

// ── Introduction points ───────────────────────────────────────────────────────

export string test_the_introduction_points_are_the_ones_tor_published(
  fn[u8[](i32, u8[], u8[])] ref
) {
  // Decrypt both layers, then parse. Every key is compared against what an independent decryption
  // read out of the same descriptor, so a parser that took the wrong 32 bytes — and there are three
  // different 32-byte ntor-shaped keys per introduction point — fails here rather than at connect
  // time against a service that simply never answers.
  T t = T.create();
  u8[] doc = ref(V_DESCRIPTOR, none(), none());
  u8[] keys = ref(V_KEYS, none(), none());
  u8[] blinded = slice(keys, 32, 64);
  u8[] subcred = slice(keys, 96, 128);
  i64 revision = be64(keys, 128);

  u8[] first = decryptLayer(pemBlock(doc, "superencrypted".toBytes(), "MESSAGE".toBytes()),
                            blinded, subcred, revision, superencryptedConstant());
  u8[] second = decryptLayer(pemBlock(first, "encrypted".toBytes(), "MESSAGE".toBytes()),
                             blinded, subcred, revision, encryptedConstant());
  t.isTrue(second.len() > 0, "the second layer decrypted");

  IntroPoint[] points = parseIntroPoints(second);
  i32 want = ref(V_INTRO_COUNT, none(), none())[0];
  t.eqI32(points.len(), want, "every introduction point parsed");

  for (i32 i = 0; i < points.len(); i++) {
    u8[] expect = ref(V_INTRO, arg1(i), none());   // ls_len(2) ls onion(32) enc(32) auth(32)
    i32 lsLen = (expect[0] * 256) + expect[1];
    string which = "intro " + itoa64(i as i64);
    t.isTrue(same(points[i].linkSpecifiers, slice(expect, 2, 2 + lsLen)),
             which + ": the link specifiers are forwarded verbatim");
    t.isTrue(same(points[i].onionKey, slice(expect, 2 + lsLen, 2 + lsLen + 32)),
             which + ": onion-key ntor — the introduction relay's, for extending to it");
    t.isTrue(same(points[i].encKey, slice(expect, 2 + lsLen + 32, 2 + lsLen + 64)),
             which + ": enc-key ntor — the service's, for the hs-ntor handshake");
    t.isTrue(same(points[i].authKey, slice(expect, 2 + lsLen + 64, 2 + lsLen + 96)),
             which + ": auth-key, from inside its type-9 certificate");
    // The three keys are all 32 bytes and all distinct, so a transposition would be caught above —
    // assert the distinctness too, since a descriptor where two happened to match would make those
    // comparisons vacuous.
    t.isFalse(same(points[i].onionKey, points[i].encKey), which + ": onion-key is not enc-key");
    t.isFalse(same(points[i].onionKey, points[i].authKey), which + ": onion-key is not auth-key");
    t.isFalse(same(points[i].encKey, points[i].authKey), which + ": enc-key is not auth-key");
  }
  return t.report();
}

export string test_link_specifiers_are_read_without_being_rebuilt(fn[u8[](i32, u8[], u8[])] ref) {
  T t = T.create();
  u8[] expect = ref(V_INTRO, arg1(0), none());
  i32 lsLen = (expect[0] * 256) + expect[1];
  u8[] ls = slice(expect, 2, 2 + lsLen);
  t.isTrue(linkSpecifiersValid(ls), "a real link specifier list is well formed");

  // An IPv4 specifier is four address bytes and a big-endian port. chutney runs on loopback, so the
  // address is known and this checks the offsets rather than merely the length.
  u8[] v4 = linkSpecifier(ls, LS_IPV4);
  t.eqI32(v4.len(), 6, "the IPv4 specifier is six bytes");
  t.eqI32(v4[0], 127, "on loopback, as chutney runs everything");
  t.eqI32(v4[3], 1, "127.0.0.1");
  i32 port = (v4[4] * 256) + v4[5];
  t.isTrue(port > 1024, "the port is a real one, read big-endian");

  t.eqI32(linkSpecifier(ls, LS_LEGACY_ID).len(), 20, "the legacy identity is a 20-byte digest");
  t.eqI32(linkSpecifier(ls, LS_ED25519_ID).len(), 32, "the ed25519 identity is 32 bytes");
  t.eqI32(linkSpecifier(ls, 99).len(), 0, "an absent type is empty rather than the first entry");

  // Malformed lists are refused rather than half-read. A length running past the end is what a
  // truncated descriptor looks like, and reading it would walk off the buffer.
  t.isFalse(linkSpecifiersValid(u8[0]()), "an empty list is not valid");
  u8[] zero = u8[1]();
  t.isFalse(linkSpecifiersValid(zero), "a list claiming zero entries is not valid");
  u8[] overrun = u8[4]();
  overrun[0] = 1;
  overrun[1] = LS_IPV4;
  overrun[2] = 200;
  t.isFalse(linkSpecifiersValid(overrun), "an entry longer than the buffer is refused");
  u8[] trailing = u8[5]();
  trailing[0] = 1;
  trailing[1] = LS_IPV4;
  trailing[2] = 1;
  t.isFalse(linkSpecifiersValid(trailing), "trailing bytes after the last entry are refused");
  return t.report();
}

export string test_the_cells_have_the_layout_the_spec_fixes(fn[u8[](i32, u8[], u8[])] ref) {
  // Framing, where a mistake desynchronises rather than fails: an introduction point that reads
  // AUTH_KEY from the wrong offset finds no matching circuit and drops the cell silently.
  T t = T.create();
  u8[] expect = ref(V_INTRO, arg1(0), none());
  i32 lsLen = (expect[0] * 256) + expect[1];
  u8[] ls = slice(expect, 2, 2 + lsLen);
  u8[] onion = slice(expect, 2 + lsLen, 2 + lsLen + 32);
  u8[] auth = slice(expect, 2 + lsLen + 64, 2 + lsLen + 96);

  u8[] cookie = u8[20]();
  for (i32 i = 0; i < 20; i++) { cookie[i] = (i * 9 + 1) & 0xFF; }

  u8[] plain = introduce1Plaintext(cookie, onion, ls);
  t.eqI32(plain.len(), 20 + 1 + 1 + 2 + 32 + lsLen, "the plaintext is exactly its fields");
  t.isTrue(same(slice(plain, 0, 20), cookie), "the rendezvous cookie comes first");
  t.eqI32(plain[20], 0, "no extensions");
  t.eqI32(plain[21], 1, "ONION_KEY_TYPE is 1, ntor");
  t.eqI32(plain[22], 0, "ONION_KEY_LEN is big-endian 32");
  t.eqI32(plain[23], 32, "…and its low byte is 32");
  t.isTrue(same(slice(plain, 24, 56), onion), "then the rendezvous point's onion key");
  t.isTrue(same(slice(plain, 56, 56 + lsLen), ls), "then its link specifiers, verbatim");

  u8[] encrypted = u8[100]();
  for (i32 i = 0; i < 100; i++) { encrypted[i] = (i * 3) & 0xFF; }
  u8[] cell = introduce1Cell(auth, encrypted);
  t.eqI32(cell.len(), 20 + 1 + 2 + 32 + 1 + 100, "the cell is exactly its fields");
  // LEGACY_KEY_ID must be twenty zero bytes: that is how an introduction point tells a v3 cell from
  // a v2 one, and anything non-zero there is handled as legacy and dropped.
  i32 legacy = 0;
  for (i32 i = 0; i < 20; i++) { legacy = legacy | cell[i]; }
  t.eqI32(legacy, 0, "LEGACY_KEY_ID is twenty zero bytes");
  t.eqI32(cell[20], 2, "AUTH_KEY_TYPE is 2, ed25519");
  t.eqI32(cell[21], 0, "AUTH_KEY_LEN is big-endian 32");
  t.eqI32(cell[22], 32, "…and its low byte is 32");
  t.isTrue(same(slice(cell, 23, 55), auth), "then the auth key");
  t.eqI32(cell[55], 0, "then no extensions");
  t.isTrue(same(slice(cell, 56, cell.len()), encrypted), "then the encrypted portion");

  // The MAC covers the whole cell — see `test_an_introduce1_cell_macs_the_right_span`, where the
  // twenty leading zero bytes turned out to be included despite what the specification's wording
  // suggests.
  u8[] macInput = introduce1MacInput(cell);
  t.eqI32(macInput.len(), cell.len(), "the MAC input is the whole cell so far");
  t.eqI32(macInput[0], 0, "beginning at LEGACY_KEY_ID's first zero byte");

  // ESTABLISH_RENDEZVOUS is the cookie and nothing else.
  t.isTrue(same(establishRendezvousCell(cookie), cookie), "ESTABLISH_RENDEZVOUS is just the cookie");
  t.eqI32(establishRendezvousCell(u8[19]()).len(), 0, "a 19-byte cookie is refused");
  t.eqI32(introduce1Plaintext(u8[19](), onion, ls).len(), 0, "and in the plaintext too");
  t.eqI32(introduce1Plaintext(cookie, slice(onion, 0, 31), ls).len(), 0, "a short onion key too");
  t.eqI32(introduce1Cell(slice(auth, 0, 31), encrypted).len(), 0, "a short auth key too");

  // RENDEZVOUS2 carries SERVER_PK | AUTH, and a short cell must not be read as a valid one.
  u8[] rend = u8[64]();
  for (i32 i = 0; i < 64; i++) { rend[i] = (i * 5 + 2) & 0xFF; }
  t.eqI32(rendezvous2HandshakeInfo(rend).len(), 64, "a 64-byte RENDEZVOUS2 body reads");
  t.eqI32(rendezvous2HandshakeInfo(slice(rend, 0, 63)).len(), 0, "a 63-byte one is refused");
  return t.report();
}

export string test_an_introduce1_cell_macs_the_right_span(fn[u8[](i32, u8[], u8[])] ref) {
  // The MAC covers the cell from AUTH_KEY_TYPE to the end of the ciphertext, and not the MAC itself.
  // Building the cell twice is what makes that possible, and doing it inside one function is what
  // stops a caller MACing the wrong span — a wrong span still gives thirty-two plausible bytes and
  // an introduction point that drops the cell without saying why.
  T t = T.create();
  u8[] expect = ref(V_INTRO, arg1(0), none());
  i32 lsLen = (expect[0] * 256) + expect[1];
  u8[] auth = slice(expect, 2 + lsLen + 64, 2 + lsLen + 96);

  u8[] encKey = u8[32]();
  u8[] macKey = u8[32]();
  u8[] clientPub = u8[32]();
  for (i32 i = 0; i < 32; i++) {
    encKey[i] = (i * 3 + 1) & 0xFF;
    macKey[i] = (i * 5 + 2) & 0xFF;
    clientPub[i] = (i * 7 + 3) & 0xFF;
  }
  u8[] plaintext = u8[84]();
  for (i32 i = 0; i < plaintext.len(); i++) { plaintext[i] = (i * 11) & 0xFF; }

  u8[] cell = buildIntroduce1(auth, encKey, macKey, clientPub, plaintext);
  t.eqI32(cell.len(), 56 + 32 + plaintext.len() + 32, "the cell is header, key, ciphertext and MAC");
  t.isTrue(same(slice(cell, 56, 88), clientPub), "the ephemeral public key follows the header");

  // The ciphertext is the plaintext under AES-256-CTR with a zero IV, and is not the plaintext.
  u8[] ct = slice(cell, 88, 88 + plaintext.len());
  t.isFalse(same(ct, plaintext), "the payload is encrypted");
  t.isTrue(same(aesCtr(encKey, u8[16](), ct), plaintext), "and decrypts back under the same key");

  // **The MAC covers the whole cell up to the MAC — LEGACY_KEY_ID included.** rend-spec-v3 says
  // "from the AUTH_KEY through the end of ENCRYPTED_DATA", which reads as starting twenty bytes in;
  // tor's `compute_introduce_mac()` starts at byte 0. The twenty bytes are zeros, so nothing local
  // tells the two apart — this was found against a live service, which answered "Could not get valid
  // INTRO2 keys" and nothing else. The earlier version of this test asserted the *wrong* span and
  // passed.
  u8[] wantMac = slice(cell, cell.len() - 32, cell.len());
  t.isTrue(same(hsMac(macKey, slice(cell, 0, cell.len() - 32)), wantMac),
           "the MAC covers the whole cell up to the MAC");
  t.isFalse(same(hsMac(macKey, slice(cell, 20, cell.len() - 32)), wantMac),
            "not the span the specification's wording suggests");
  t.isFalse(same(hsMac(macKey, slice(cell, 23, cell.len() - 32)), wantMac),
            "and not the span starting at the auth key itself");
  t.isFalse(same(hsMac(macKey, cell), wantMac), "and not the whole cell including the MAC");

  // Every key changes the cell.
  u8[] other = u8[32]();
  for (i32 i = 0; i < 32; i++) { other[i] = macKey[i]; }
  other[0] = (other[0] ^ 1);
  t.isFalse(same(buildIntroduce1(auth, encKey, other, clientPub, plaintext), cell),
            "a different MAC key gives a different cell");
  t.eqI32(buildIntroduce1(auth, encKey, macKey, clientPub, u8[0]()).len(), 0,
          "an empty plaintext is refused");
  t.eqI32(buildIntroduce1(auth, slice(encKey, 0, 31), macKey, clientPub, plaintext).len(), 0,
          "a short encryption key is refused");
  return t.report();
}
