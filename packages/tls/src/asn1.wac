// DER, the encoding X.509 certificates are written in.
//
// ASN.1 has several encodings; DER is the one that is canonical, which matters here for
// a reason beyond tidiness: a certificate's signature covers its own bytes, so a parser
// that accepts a non-canonical encoding accepts two different byte strings as the same
// certificate — and only one of them was signed.
//
// Everything is a tag, a length, and a value. The tag says what it is, the length says
// how long, and constructed types nest more of the same inside. That is the whole
// format, and every complication is in the details of those three fields:
//
//   tag     one byte for the common cases. The low five bits are the number; 31 means
//           the number continues in following bytes, which nothing in X.509 uses.
//   length  below 0x80 it is the length. Otherwise the low seven bits say how many
//           bytes of length follow, big-endian. 0x80 alone means indefinite, which DER
//           forbids and BER allows — accepting it is how a parser diverges from the
//           thing that signed the bytes.
//   value   `length` bytes, whose meaning depends on the tag.
//
// This is a reader only. Nothing here produces DER, because a TLS client never needs to.

/** Universal tags, as they appear as whole first bytes. */
export i32 tagBoolean() { return 0x01; }
export i32 tagInteger() { return 0x02; }
export i32 tagBitString() { return 0x03; }
export i32 tagOctetString() { return 0x04; }
export i32 tagNull() { return 0x05; }
export i32 tagOid() { return 0x06; }
export i32 tagUtf8String() { return 0x0C; }
export i32 tagSequence() { return 0x30; }
export i32 tagSet() { return 0x31; }
export i32 tagPrintableString() { return 0x13; }
export i32 tagIa5String() { return 0x16; }
export i32 tagUtcTime() { return 0x17; }
export i32 tagGeneralizedTime() { return 0x18; }

/** A context-specific constructed tag, as `[n]` appears in an ASN.1 module. */
export i32 tagContext(i32 n) { return 0xA0 | n; }
/** A context-specific primitive tag, for the IMPLICIT cases. */
export i32 tagContextPrim(i32 n) { return 0x80 | n; }

/**
 * A cursor over DER.
 *
 * `start` and `end` bound the region this cursor may read, so a nested structure gets a
 * cursor that physically cannot read past its parent — the alternative is passing
 * lengths around and checking them, which is the same thing written once per call site
 * and forgotten at one of them.
 */
export struct Der {
  u8[] buf;
  i32 pos;
  i32 end;

  Der create(u8[] buf) { return Der(buf, 0, buf.len()); }
  Der over(u8[] buf, i32 start, i32 end) { return Der(buf, start, end); }

  bool empty(const this) { return this.pos >= this.end; }
  i32 remaining(const this) { return this.end - this.pos; }

  i32 peekTag(const this) {
    if (this.pos >= this.end) { trap; }
    return this.buf[this.pos];
  }

  i32 byte(this) {
    if (this.pos >= this.end) { trap; }
    i32 v = this.buf[this.pos];
    this.pos++;
    return v;
  }

  /**
   * Read a length, rejecting everything DER forbids.
   *
   * Three rejections, all of which some parser somewhere has skipped: the indefinite
   * form, which belongs to BER; a multi-byte length that would fit in fewer bytes, which
   * gives two encodings of one number; and a length that runs past the enclosing region.
   */
  i32 length(this) {
    i32 first = this.byte();
    if (first < 0x80) { return first; }
    if (first == 0x80) { trap; }             // indefinite length: BER, not DER
    i32 count = first & 0x7F;
    if (count > 4) { trap; }                 // longer than any certificate field
    i32 v = 0;
    for (i32 i = 0; i < count; i++) { v = (v << 8) | this.byte(); }
    if (v < 0) { trap; }
    if (count == 1 && v < 0x80) { trap; }    // should have used the short form
    if (v > this.end - this.pos) { trap; }
    return v;
  }

  /** Read one element of the expected tag, and return a cursor over its contents. */
  Der element(this, i32 tag) {
    i32 got = this.byte();
    if (got != tag) { trap; }
    i32 n = this.length();
    Der inner = Der(this.buf, this.pos, this.pos + n);
    this.pos += n;
    return inner;
  }

  /** Read one element of any tag; `lastTag` says which it was. */
  Der any(this) {
    this.byte();
    i32 n = this.length();
    Der inner = Der(this.buf, this.pos, this.pos + n);
    this.pos += n;
    return inner;
  }

  /** Skip one element whatever it is. */
  void skip(this) { this.any(); }

  /** The raw bytes of the next element, tag and length included. */
  u8[] elementBytes(this) {
    i32 begin = this.pos;
    this.byte();
    i32 n = this.length();
    this.pos += n;
    u8[] out = u8[this.pos - begin]();
    for (i32 i = 0; i < out.len(); i++) { out[i] = this.buf[begin + i]; }
    return out;
  }

  /** Everything left in this cursor's region. */
  u8[] rest(const this) {
    u8[] out = u8[this.end - this.pos]();
    for (i32 i = 0; i < out.len(); i++) { out[i] = this.buf[this.pos + i]; }
    return out;
  }

  /** Whether the next element has this tag, without consuming it. */
  bool nextIs(const this, i32 tag) {
    return this.pos < this.end && this.buf[this.pos] == tag;
  }

  /**
   * The contents of a BIT STRING, which is prefixed by a count of unused trailing bits.
   *
   * Every bit string X.509 uses is a whole number of bytes, so a non-zero count means
   * either a key that is not a key or an encoder doing something unusual; both are worth
   * refusing rather than silently misreading.
   */
  u8[] bitString(this) {
    Der inner = this.element(0x03);
    i32 unused = inner.byte();
    if (unused != 0) { trap; }
    return inner.rest();
  }

  /** An OBJECT IDENTIFIER's raw encoding, which is what comparisons want. */
  u8[] oid(this) { return this.element(0x06).rest(); }
}

/** Whether two OID encodings are the same. */
export bool oidEquals(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

/** 1.3.101.112 — Ed25519, RFC 8410. */
export u8[] oidEd25519() { return u8[](0x2B, 0x65, 0x70); }
/** 2.5.29.17 — subjectAltName. */
export u8[] oidSubjectAltName() { return u8[](0x55, 0x1D, 0x11); }
/** 2.5.29.19 — basicConstraints. */
export u8[] oidBasicConstraints() { return u8[](0x55, 0x1D, 0x13); }
/** 2.5.4.3 — commonName. */
export u8[] oidCommonName() { return u8[](0x55, 0x04, 0x03); }

// Algorithm identifiers a certificate can carry.
/** 1.2.840.10045.2.1 — id-ecPublicKey. */
export u8[] oidEcPublicKey() { return u8[](0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x02, 0x01); }
/** 1.2.840.10045.3.1.7 — prime256v1, the curve parameter for P-256. */
export u8[] oidPrime256v1() { return u8[](0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x03, 0x01, 0x07); }
/**
 * 1.3.132.0.34 — secp384r1, the curve parameter for P-384.
 *
 * A different arc from every other OID here: the P-256 parameters are under ANSI's
 * 1.2.840.10045, but P-384 and P-521 were only ever registered by SECG under 1.3.132, so
 * the byte string looks nothing like its neighbour and cannot be derived from it.
 */
export u8[] oidSecp384r1() { return u8[](0x2B, 0x81, 0x04, 0x00, 0x22); }
/** 1.2.840.10045.4.3.2 — ecdsa-with-SHA256. */
export u8[] oidEcdsaSha256() { return u8[](0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x02); }
/** 1.2.840.10045.4.3.3 — ecdsa-with-SHA384. */
export u8[] oidEcdsaSha384() { return u8[](0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x03); }
/** 1.2.840.113549.1.1.1 — rsaEncryption. */
export u8[] oidRsaEncryption() { return u8[](0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x01); }
/** 1.2.840.113549.1.1.10 — RSASSA-PSS. */
export u8[] oidRsaPss() { return u8[](0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x0A); }
/** 1.2.840.113549.1.1.11 / .12 / .13 — sha256/384/512 WithRSAEncryption. */
export u8[] oidRsaSha256() { return u8[](0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x0B); }
export u8[] oidRsaSha384() { return u8[](0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x0C); }
export u8[] oidRsaSha512() { return u8[](0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x0D); }

/**
 * The contents of an INTEGER, with any leading zero removed.
 *
 * DER writes integers signed, so a value whose top bit is set gets a leading zero byte
 * to keep it positive. An RSA modulus almost always has that bit set, so almost every
 * modulus in the world arrives one byte longer than it is — and using that length as the
 * key size makes every signature check fail on a length comparison.
 */
export u8[] unsignedInteger(u8[] der) {
  i32 at = 0;
  while (at + 1 < der.len() && der[at] == 0) { at++; }
  u8[] out = u8[der.len() - at]();
  for (i32 i = 0; i < out.len(); i++) { out[i] = der[at + i]; }
  return out;
}
/** 2.5.29.15 — keyUsage. */
export u8[] oidKeyUsage() { return u8[](0x55, 0x1D, 0x0F); }
