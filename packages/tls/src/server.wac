// A TLS 1.3 server handshake, RFC 8446 §4.
//
// Shaped like `packages/server`'s HTTP handler and for the same reason: everything wac
// cannot do lives in the host, and what is left is a pure function from bytes to bytes.
// The host owns the socket and the randomness — wasm has neither — and every decision
// about what those bytes mean is made here.
//
// ## The state is a byte string
//
// bindgen cannot marshal a struct across the boundary, so a connection cannot be a
// handle the host holds. The state is serialised instead, and `feed` takes the old state
// and returns the new one alongside whatever should go on the wire. That is a constraint
// rather than a design, but it has one real virtue: a connection's entire state is a
// byte string that a test can inspect, corrupt, or replay.
//
// The transcript is kept as bytes rather than as a running hash, because `sha256` here
// is one-shot. A handshake transcript is a few kilobytes, so this costs memory rather
// than correctness — but it does mean a peer that sends an enormous handshake makes us
// hold it, which is why `feed` caps the transcript.
//
// ## The flow
//
//   client                                        server
//   ClientHello              -------->
//                            <--------  ServerHello           (plaintext)
//                                       {EncryptedExtensions}
//                                       {Certificate}
//                                       {CertificateVerify}
//                                       {Finished}
//   {Finished}               -------->
//   [Application Data]       <------->  [Application Data]
//
// {} is encrypted under the handshake traffic keys, [] under the application ones.

import { sha256 } from "../../crypto/src/sha256.wac";
import { x25519, x25519Base } from "../../crypto/src/x25519.wac";
import { p256Ecdh, p256PublicKey } from "../../crypto/src/p256.wac";
import { hybridServerAccept } from "./hybrid.wac";
import { ed25519Sign } from "../../crypto/src/ed25519.wac";
import {
  deriveSecret, earlySecret, finishedVerify, handshakeSecret, hashLen, masterSecret,
  nextTrafficSecret, trafficKeyIv,
} from "./keyschedule.wac";
import {
  recordSeal, recordOpen, recordType, recordContent, suiteAes128Gcm, suiteKeyLen,
  typeHandshake, typeApplicationData, typeAlert, typeChangeCipherSpec, maxPlaintext,
  alertBody, plaintextAlert, alertCloseNotify, alertDecryptError, alertHandshakeFailure,
  alertIllegalParameter, alertProtocolVersion, alertUnexpectedMessage,
} from "./record.wac";
import {
  certificate, certificateVerify, certificateVerifyContent, encryptedExtensions,
  finished, handshakeMessage, messageBody, messageLength, messageType, parseClientHello,
  serverHello, ClientHello,
} from "./handshake.wac";
import { Reader, Writer } from "./wire.wac";

// Connection phases.
export i32 phaseStart() { return 0; }
export i32 phaseWaitFinished() { return 1; }
export i32 phaseEstablished() { return 2; }
export i32 phaseFailed() { return 3; }

/** The largest handshake transcript we will accumulate before giving up. */
i32 maxTranscript() { return 65536; }

/** A connection, as it is held between calls. */
struct Conn {
  i32 phase;
  i32 suite;
  i64 seqIn;
  i64 seqOut;
  u8[] clientSecret;      // current read secret: handshake, then application
  u8[] serverSecret;      // current write secret
  // Derived at the server's Finished and held until the client's arrives, because the
  // client keeps writing under handshake keys until then.
  u8[] clientAppSecret;
  u8[] serverAppSecret;
  u8[] transcript;
  u8[] certDer;
  u8[] seed;
  u8[] ephemeralPriv;
  u8[] serverRandom;
}

/**
 * Serialise a connection.
 *
 * Fixed-width fields first so the parse needs no lookahead, then the four variable ones
 * behind 32-bit lengths. Nothing here is secret from the host — it holds the keys either
 * way — so this is a plain encoding rather than a sealed one.
 */
u8[] encodeConn(Conn c) {
  Writer w = Writer.create();
  w.u8(c.phase);
  w.u16(c.suite);
  for (i32 i = 0; i < 8; i++) { w.u8(((c.seqIn >> (((7 - i) * 8) as i64)) & 255) as! i32); }
  for (i32 i = 0; i < 8; i++) { w.u8(((c.seqOut >> (((7 - i) * 8) as i64)) & 255) as! i32); }
  w.vec8(c.clientSecret);
  w.vec8(c.serverSecret);
  w.vec8(c.clientAppSecret);
  w.vec8(c.serverAppSecret);
  w.u32(c.transcript.len());
  w.bytes(c.transcript);
  w.u32(c.certDer.len());
  w.bytes(c.certDer);
  w.vec8(c.seed);
  w.vec8(c.ephemeralPriv);
  w.vec8(c.serverRandom);
  return w.take();
}

Conn decodeConn(u8[] state) {
  Reader r = Reader.create(state);
  i32 phase = r.u8();
  i32 suite = r.u16();
  i64 seqIn = 0;
  for (i32 i = 0; i < 8; i++) { seqIn = (seqIn << 8) | (r.u8() as i64); }
  i64 seqOut = 0;
  for (i32 i = 0; i < 8; i++) { seqOut = (seqOut << 8) | (r.u8() as i64); }
  u8[] clientSecret = r.vec8();
  u8[] serverSecret = r.vec8();
  u8[] clientApp = r.vec8();
  u8[] serverApp = r.vec8();
  u8[] transcript = r.take(r.u32());
  u8[] certDer = r.take(r.u32());
  u8[] seed = r.vec8();
  u8[] eph = r.vec8();
  u8[] rnd = r.vec8();
  r.expectEnd();
  return Conn(phase, suite, seqIn, seqOut, clientSecret, serverSecret, clientApp,
              serverApp, transcript, certDer, seed, eph, rnd);
}

/**
 * A new connection.
 *
 * The host supplies the ephemeral private key and the server random, because wac has no
 * randomness and inventing some here would be worse than not having it. Passing them in
 * also makes a handshake reproducible, which is what lets a test compare against a
 * recorded trace.
 */
export u8[] tlsServerInit(u8[] certDer, u8[] seed, u8[] ephemeralPriv, u8[] serverRandom) {
  if (seed.len() != 32) { trap; }
  if (ephemeralPriv.len() != 32) { trap; }
  if (serverRandom.len() != 32) { trap; }
  return encodeConn(Conn(0, suiteAes128Gcm(), 0, 0, u8[0](), u8[0](), u8[0](), u8[0](),
                         u8[0](), certDer, seed, ephemeralPriv, serverRandom));
}

/** Give up before any key exists: an alert in the clear, and the connection is done. */
u8[] failPlain(Conn c, i32 desc) {
  c.phase = 3;
  return plaintextAlert(desc);
}

void addTranscript(Conn c, u8[] msg) {
  if (c.transcript.len() + msg.len() > maxTranscript()) { trap; }
  u8[] t = u8[c.transcript.len() + msg.len()]();
  for (i32 i = 0; i < c.transcript.len(); i++) { t[i] = c.transcript[i]; }
  for (i32 i = 0; i < msg.len(); i++) { t[c.transcript.len() + i] = msg[i]; }
  c.transcript = t;
}

/** Seal a handshake message under the current write secret and append it to `out`. */
void sealInto(Writer out, Conn c, i32 contentType, u8[] content) {
  i32 keyLen = suiteKeyLen(c.suite);
  u8[] ki = trafficKeyIv(c.serverSecret, keyLen);
  u8[] key = u8[keyLen]();
  u8[] iv = u8[12]();
  for (i32 i = 0; i < keyLen; i++) { key[i] = ki[i]; }
  for (i32 i = 0; i < 12; i++) { iv[i] = ki[keyLen + i]; }
  out.bytes(recordSeal(c.suite, key, iv, c.seqOut, contentType, content, 0));
  c.seqOut += 1;
}

/** Open a record under the current read secret. */
u8[] openWith(Conn c, u8[] record) {
  i32 keyLen = suiteKeyLen(c.suite);
  u8[] ki = trafficKeyIv(c.clientSecret, keyLen);
  u8[] key = u8[keyLen]();
  u8[] iv = u8[12]();
  for (i32 i = 0; i < keyLen; i++) { key[i] = ki[i]; }
  for (i32 i = 0; i < 12; i++) { iv[i] = ki[keyLen + i]; }
  u8[] inner = recordOpen(c.suite, key, iv, c.seqIn, record);
  c.seqIn += 1;
  return inner;
}

/**
 * The whole server flight, in response to a ClientHello.
 *
 * ServerHello goes out in the clear because the keys it establishes do not exist until
 * the client has read it. Everything after is encrypted under the handshake traffic
 * keys, which is TLS 1.3's headline change: the certificate is no longer visible to an
 * observer.
 */
u8[] serverFlight(Conn c, u8[] clientHelloMsg) {
  ClientHello ch = parseClientHello(messageBody(clientHelloMsg), c.suite);
  // A peer's mistake gets an alert, not a trap. Trapping drops the connection with no
  // explanation, which leaves the client guessing between "wrong version", "no shared
  // cipher" and "the server is broken" — and those want different fixes.
  if (!ch.offersTls13) { return failPlain(c, alertProtocolVersion()); }
  if (ch.suite != c.suite) { return failPlain(c, alertHandshakeFailure()); }
  if (!ch.offersEd25519) { return failPlain(c, alertHandshakeFailure()); }
  // No x25519 share. The correct answer is a HelloRetryRequest asking for one, which is
  // not implemented — so this says so plainly rather than pretending the client is at
  // fault. See the README.
  if (ch.keyShare.len() < 3) { return failPlain(c, alertHandshakeFailure()); }

  addTranscript(c, clientHelloMsg);

  // The client's share arrives as group ++ key; answer in the same group.
  i32 group = (ch.keyShare[0] << 8) | ch.keyShare[1];
  u8[] peerKey = u8[ch.keyShare.len() - 2]();
  for (i32 i = 0; i < peerKey.len(); i++) { peerKey[i] = ch.keyShare[2 + i]; }

  // The hybrid does the exchange while building the share, because encapsulation
  // produces both at once; the other two derive the secret separately below.
  u8[] ourShare = u8[0]();
  u8[] hybridSecret = u8[0]();
  if (group == 0x11EC) {
    // The ML-KEM randomness is the server random reused. That is fine here and would not
    // be in a real deployment: it must be unpredictable and unique per handshake, and
    // this host supplies exactly one 32-byte random value per connection.
    u8[] accepted = hybridServerAccept(peerKey, c.serverRandom, c.ephemeralPriv);
    ourShare = u8[1120]();
    for (i32 i = 0; i < 1120; i++) { ourShare[i] = accepted[i]; }
    hybridSecret = u8[64]();
    for (i32 i = 0; i < 64; i++) { hybridSecret[i] = accepted[1120 + i]; }
  } else if (group == 0x001d) {
    ourShare = x25519Base(c.ephemeralPriv);
  } else {
    ourShare = p256PublicKey(c.ephemeralPriv);
  }
  u8[] sh = serverHello(c.serverRandom, ch.sessionId, c.suite, group, ourShare);
  addTranscript(c, sh);

  // The key schedule, up to the handshake traffic secrets. The transcript at this point
  // is exactly ClientHello ++ ServerHello, which is what "CH..SH" means in RFC 8446 §7.1
  // — one message too many or too few here yields keys that are wrong and look fine.
  u8[] shared = u8[0]();
  if (group == 0x11EC) {
    shared = hybridSecret;
  } else if (group == 0x001d) {
    shared = x25519(c.ephemeralPriv, peerKey);
  } else {
    shared = p256Ecdh(c.ephemeralPriv, peerKey);
  }
  u8[] early = earlySecret(u8[hashLen()]());
  u8[] hs = handshakeSecret(early, shared);
  u8[] thSh = sha256(c.transcript);
  u8[] clientHs = deriveSecret(hs, "c hs traffic".toBytes(), thSh);
  u8[] serverHs = deriveSecret(hs, "s hs traffic".toBytes(), thSh);

  Writer out = Writer.create();
  // ServerHello, in the clear.
  Writer plainRec = Writer.create();
  plainRec.u8(typeHandshake());
  plainRec.u16(0x0303);
  plainRec.vec16(sh);
  out.bytes(plainRec.take());

  // A ChangeCipherSpec that means nothing, sent because middleboxes expect one after a
  // ServerHello and drop connections that skip it. RFC 8446 appendix D.4.
  out.bytes(u8[](20, 3, 3, 0, 1, 1));

  c.serverSecret = serverHs;
  c.seqOut = 0;

  u8[] ee = encryptedExtensions();
  addTranscript(c, ee);
  sealInto(out, c, typeHandshake(), ee);

  u8[] cert = certificate(c.certDer);
  addTranscript(c, cert);
  sealInto(out, c, typeHandshake(), cert);

  // CertificateVerify signs the transcript so far, which now includes the certificate —
  // so the signature covers the key exchange, the identity, and everything either side
  // has said. That is what binds this certificate to this connection.
  u8[] toSign = certificateVerifyContent(sha256(c.transcript), true);
  u8[] cv = certificateVerify(ed25519Sign(c.seed, toSign));
  addTranscript(c, cv);
  sealInto(out, c, typeHandshake(), cv);

  u8[] fin = finished(finishedVerify(serverHs, sha256(c.transcript)));
  addTranscript(c, fin);
  sealInto(out, c, typeHandshake(), fin);

  // The application secrets come from the transcript *through the server's Finished*,
  // so they can be derived now even though the client has not answered yet. They are
  // held rather than installed: the client is still writing under handshake keys, and
  // switching the read side early would reject its Finished.
  u8[] master = masterSecret(hs);
  u8[] thSf = sha256(c.transcript);
  c.clientAppSecret = deriveSecret(master, "c ap traffic".toBytes(), thSf);
  c.serverAppSecret = deriveSecret(master, "s ap traffic".toBytes(), thSf);

  c.clientSecret = clientHs;
  c.seqIn = 0;
  c.phase = 1;
  return out.take();
}

/** What `tlsServerFeed` returns: new state, then bytes to send, then plaintext received. */
u8[] result(Conn c, u8[] toSend, u8[] appData) {
  u8[] state = encodeConn(c);
  Writer w = Writer.create();
  w.u32(state.len());
  w.bytes(state);
  w.u32(toSend.len());
  w.bytes(toSend);
  w.u32(appData.len());
  w.bytes(appData);
  return w.take();
}

/**
 * Feed the connection whatever has arrived, and get back what to send.
 *
 * The return is `[stateLen][state][toSendLen][toSend][appDataLen][appData]`, and the
 * caller must use the new state for the next call. `input` is whole records only — the
 * host buffers until `tlsRecordNeeded` says a complete one is present, the same
 * discipline `packages/server` uses for HTTP requests.
 *
 * Application data to *send* goes through `tlsServerSend` rather than here, because a
 * response is produced by the layer above rather than in reply to a record.
 */
export u8[] tlsServerFeed(u8[] state, u8[] input) {
  Conn c = decodeConn(state);
  Writer toSend = Writer.create();
  Writer appData = Writer.create();

  i32 pos = 0;
  while (pos < input.len()) {
    if (input.len() - pos < 5) { trap; }
    i32 recLen = (input[pos + 3] << 8) | input[pos + 4];
    if (pos + 5 + recLen > input.len()) { trap; }
    i32 outerType = input[pos];
    u8[] record = u8[5 + recLen]();
    for (i32 i = 0; i < 5 + recLen; i++) { record[i] = input[pos + i]; }
    pos += 5 + recLen;

    // A ChangeCipherSpec after the ClientHello is compatibility noise and must be
    // ignored without disturbing the sequence numbers — it is not an encrypted record,
    // so counting it would desynchronise every record after it.
    if (outerType == typeChangeCipherSpec()) { continue; }

    if (c.phase == 0) {
      if (outerType != typeHandshake()) { trap; }
      u8[] body = u8[recLen]();
      for (i32 i = 0; i < recLen; i++) { body[i] = record[5 + i]; }
      if (messageLength(body) != body.len()) { trap; }
      if (messageType(body) != 1) { trap; }
      toSend.bytes(serverFlight(c, body));
    } else if (c.phase == 1) {
      u8[] inner = openWith(c, record);
      if (recordType(inner) != typeHandshake()) { trap; }
      u8[] msg = recordContent(inner);
      if (messageType(msg) != 20) { trap; }
      // verify_data covers the transcript up to but not including this message.
      u8[] want = finishedVerify(c.clientSecret, sha256(c.transcript));
      u8[] got = messageBody(msg);
      i32 diff = got.len() == want.len() ? 0 : 1;
      if (diff == 0) {
        for (i32 i = 0; i < want.len(); i++) { diff = diff | (got[i] ^ want[i]); }
      }
      if (diff != 0) {
        // decrypt_error is what RFC 8446 §6.2 names for a Finished that does not verify.
        // The record decrypted, so the keys agree; what failed is the proof that both
        // sides saw the same handshake.
        sealInto(toSend, c, typeAlert(), alertBody(alertDecryptError()));
        c.phase = 3;
        return result(c, toSend.take(), appData.take());
      }

      addTranscript(c, msg);
      // Both directions switch to application keys, each counting from zero again.
      c.clientSecret = c.clientAppSecret;
      c.serverSecret = c.serverAppSecret;
      c.seqIn = 0;
      c.seqOut = 0;
      c.phase = 2;
    } else if (c.phase == 2) {
      u8[] inner = openWith(c, record);
      i32 t = recordType(inner);
      if (t == typeApplicationData()) {
        appData.bytes(recordContent(inner));
      } else if (t == typeAlert()) {
        c.phase = 3;
      } else if (t == typeHandshake()) {
        u8[] msg = recordContent(inner);
        if (messageType(msg) == 24) {
          // KeyUpdate, RFC 8446 §4.6.3. The peer has moved its write key on, so our read
          // secret must follow. `request_update` of 1 means it wants ours moved too, and
          // answering is a MUST — a peer that asked and was ignored will keep using a
          // key we have stopped reading.
          u8[] body = messageBody(msg);
          if (body.len() != 1) {
            sealInto(toSend, c, typeAlert(), alertBody(alertIllegalParameter()));
            c.phase = 3;
            return result(c, toSend.take(), appData.take());
          }
          c.clientSecret = nextTrafficSecret(c.clientSecret);
          c.seqIn = 0;
          if (body[0] == 1) {
            // Reply under the *old* write key, then move ours: the peer cannot read the
            // new one until it has seen this message.
            u8[] body0 = u8[1]();
            u8[] reply = handshakeMessage(24, body0);
            sealInto(toSend, c, typeHandshake(), reply);
            c.serverSecret = nextTrafficSecret(c.serverSecret);
            c.seqOut = 0;
          }
        }
        // Anything else post-handshake — a NewSessionTicket, say — is ignored. We never
        // send tickets, so a client has no reason to expect us to act on one.
      }
    } else {
      trap;
    }
  }

  return result(c, toSend.take(), appData.take());
}

/** Seal application data for sending. Returns `[stateLen][state][recordLen][record][0]`. */
export u8[] tlsServerSend(u8[] state, u8[] data) {
  Conn c = decodeConn(state);
  if (c.phase != 2) { trap; }
  Writer out = Writer.create();
  i32 pos = 0;
  // Split at the record size limit rather than trusting the caller to.
  while (pos < data.len() || pos == 0) {
    i32 n = data.len() - pos;
    if (n > maxPlaintext()) { n = maxPlaintext(); }
    u8[] chunk = u8[n]();
    for (i32 i = 0; i < n; i++) { chunk[i] = data[pos + i]; }
    sealInto(out, c, typeApplicationData(), chunk);
    pos += n;
    if (n == 0) { pos = data.len() + 1; }
  }
  return result(c, out.take(), u8[0]());
}

/** The connection's phase, without decoding the whole state. */
export i32 tlsPhase(u8[] state) { return state[0]; }

/**
 * How many more bytes the host must read before a whole record is present, or 0 if one
 * already is.
 */
export i32 tlsRecordNeeded(u8[] buf) {
  if (buf.len() < 5) { return 5 - buf.len(); }
  i32 want = 5 + ((buf[3] << 8) | buf[4]);
  return buf.len() >= want ? 0 : want - buf.len();
}

/**
 * A `close_notify`, which is how a TLS connection ends on purpose.
 *
 * Without it a peer cannot tell an orderly shutdown from a truncated one, and a
 * truncation is exactly what an attacker cutting the connection produces — so a client
 * that cares reports an error, which is why `openssl s_client` complains about
 * "unexpected eof while reading" against a server that just closes the socket.
 */
export u8[] tlsServerClose(u8[] state) {
  Conn c = decodeConn(state);
  Writer out = Writer.create();
  if (c.phase == 2 || c.phase == 1) {
    sealInto(out, c, typeAlert(), alertBody(alertCloseNotify()));
  } else if (c.phase == 0) {
    out.bytes(plaintextAlert(alertCloseNotify()));
  }
  c.phase = 3;
  return result(c, out.take(), u8[0]());
}

/** Send a fatal alert of the caller's choosing and close. */
export u8[] tlsServerAlert(u8[] state, i32 desc) {
  Conn c = decodeConn(state);
  Writer out = Writer.create();
  if (c.phase == 1 || c.phase == 2) {
    sealInto(out, c, typeAlert(), alertBody(desc));
  } else {
    out.bytes(plaintextAlert(desc));
  }
  c.phase = 3;
  return result(c, out.take(), u8[0]());
}
