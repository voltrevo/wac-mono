// The TLS 1.3 key schedule, RFC 8446 §7.1.
//
// Every secret in a TLS 1.3 connection comes from one chain of HKDF operations. The
// chain matters more than any individual step: each extract mixes in new key material
// and each derive binds a secret to the transcript so far, so a secret is only usable by
// someone who saw the same handshake messages. Getting the transcript boundaries wrong
// produces keys that are perfectly well-formed and shared with nobody.
//
//                       0
//                       |
//     PSK ------> HKDF-Extract  = Early Secret
//                       |
//                 Derive-Secret("derived", "")
//                       |
//   (EC)DHE ----> HKDF-Extract  = Handshake Secret
//                       |         +-- Derive-Secret("c hs traffic", CH..SH)
//                       |         +-- Derive-Secret("s hs traffic", CH..SH)
//                 Derive-Secret("derived", "")
//                       |
//       0 ------> HKDF-Extract  = Master Secret
//                                 +-- Derive-Secret("c ap traffic", CH..SF)
//                                 +-- Derive-Secret("s ap traffic", CH..SF)
//                                 +-- Derive-Secret("res master",   CH..CF)
//
// This is the SHA-256 instantiation, which is what TLS_AES_128_GCM_SHA256 and
// TLS_CHACHA20_POLY1305_SHA256 both use. A SHA-384 suite would need the same shape over
// `sha384` and a 48-byte hash length; nothing here assumes 32 beyond `hashLen`.

import { sha256 } from "../../crypto/src/sha256.wac";
import { hkdfExtract, hkdfExpand } from "../../crypto/src/hkdf.wac";
import { hmacSha256 } from "../../crypto/src/hmac.wac";

/** The digest size of the handshake hash, in bytes. */
export i32 hashLen() { return 32; }

/** SHA-256 of the empty string, which "derived" and the binder labels use as context. */
export u8[] emptyHash() { return sha256(u8[0]()); }

/** A hash-length string of zero bytes, the IKM for the first and last extracts. */
export u8[] zeroKey() { return u8[hashLen()](); }

/**
 * HKDF-Expand-Label, RFC 8446 §7.1.
 *
 * The info field is a serialised struct rather than a bare label:
 *
 *   uint16 length
 *   opaque label<7..255>    = "tls13 " ++ label, length-prefixed with one byte
 *   opaque context<0..255>  = context, length-prefixed with one byte
 *
 * The "tls13 " prefix is what keeps these derivations from colliding with any other
 * protocol that expands the same secret, and the length prefixes are what stop a label
 * and a context being confusable — without them, ("ab", "c") and ("a", "bc") would
 * produce the same key.
 */
export u8[] expandLabel(u8[] secret, u8[] label, u8[] context, i32 length) {
  i32 labelLen = 6 + label.len();
  if (labelLen > 255) { trap; }
  if (context.len() > 255) { trap; }

  u8[] info = u8[2 + 1 + labelLen + 1 + context.len()]();
  info[0] = (length >> 8) & 0xFF;
  info[1] = length & 0xFF;
  info[2] = labelLen;
  info[3] = 't'; info[4] = 'l'; info[5] = 's'; info[6] = '1'; info[7] = '3'; info[8] = ' ';
  for (i32 i = 0; i < label.len(); i++) { info[9 + i] = label[i]; }
  i32 at = 9 + label.len();
  info[at] = context.len();
  for (i32 i = 0; i < context.len(); i++) { info[at + 1 + i] = context[i]; }

  return hkdfExpand(secret, info, length);
}

/**
 * Derive-Secret, RFC 8446 §7.1: expand-label with the transcript hash as context.
 *
 * `transcriptHash` is the hash of every handshake message so far — already hashed, not
 * the messages themselves, because a caller running a live handshake keeps a rolling
 * hash rather than the message bytes.
 */
export u8[] deriveSecret(u8[] secret, u8[] label, u8[] transcriptHash) {
  return expandLabel(secret, label, transcriptHash, hashLen());
}

// ── The chain ─────────────────────────────────────────────────────────────────

/**
 * The Early Secret. With no PSK the input keying material is zeros, which is the case
 * for every handshake this implementation does.
 */
export u8[] earlySecret(u8[] psk) { return hkdfExtract(u8[0](), psk); }

/** The Handshake Secret, from the Early Secret and the (EC)DHE shared secret. */
export u8[] handshakeSecret(u8[] early, u8[] dhe) {
  return hkdfExtract(deriveSecret(early, "derived".toBytes(), emptyHash()), dhe);
}

/** The Master Secret. The final extract takes zeros — the entropy is already in. */
export u8[] masterSecret(u8[] handshake) {
  return hkdfExtract(deriveSecret(handshake, "derived".toBytes(), emptyHash()), zeroKey());
}

/**
 * A traffic key and IV, from a traffic secret.
 *
 * Returned as key ++ iv in one array, because wac has no tuples and a struct here would
 * be a type crossing the bindgen boundary for no benefit. AES-128-GCM wants 16 and 12;
 * ChaCha20-Poly1305 wants 32 and 12.
 */
export u8[] trafficKeyIv(u8[] secret, i32 keyLen) {
  u8[] key = expandLabel(secret, "key".toBytes(), u8[0](), keyLen);
  u8[] iv = expandLabel(secret, "iv".toBytes(), u8[0](), 12);
  u8[] out = u8[keyLen + 12]();
  for (i32 i = 0; i < keyLen; i++) { out[i] = key[i]; }
  for (i32 i = 0; i < 12; i++) { out[keyLen + i] = iv[i]; }
  return out;
}

/**
 * The Finished message's verify_data.
 *
 * HMAC under a key derived from the sender's handshake traffic secret, over the
 * transcript up to but not including this message. It is what proves the sender holds
 * the handshake secret and saw the same messages — the signature proves possession of
 * the certificate's key, and this proves the key exchange was not tampered with.
 */
export u8[] finishedVerify(u8[] baseKey, u8[] transcriptHash) {
  u8[] finishedKey = expandLabel(baseKey, "finished".toBytes(), u8[0](), hashLen());
  return hmacSha256(finishedKey, transcriptHash);
}

/**
 * The next traffic secret after a KeyUpdate, RFC 8446 §7.2.
 *
 * Forward secrecy within a connection: the old secret cannot be recovered from the new
 * one, so a key compromised later does not decrypt earlier records.
 */
export u8[] nextTrafficSecret(u8[] secret) {
  return expandLabel(secret, "traffic upd".toBytes(), u8[0](), hashLen());
}
