// A compressed block: literals, then sequences (RFC 8878, section 3.1.1.3).
//
// The two halves are independent until the end, where the sequences say how to interleave the
// literals with matches. This file joins them, and holds the state a block may inherit from the
// one before it — which is what makes a zstd block impossible to decode in isolation:
//
//   - a **treeless** literals section sends no Huffman description and reuses the last one;
//   - a sequence code in **Repeat** mode reuses the last block's FSE table;
//   - the three recent offsets carry across blocks, though not across frames.
//
// Everything here is per frame, so the state lives in `Decoder` and is passed along rather than
// stashed somewhere a second frame could see it.

import { Buf } from "../../bytes/src/buf.wac";
import { HuffTable, decodeLiterals, readTable } from "./huffman.wac";
import { SeqTables, decodeAndExecute } from "./sequences.wac";

/** What one block leaves behind for the next. Reset for every frame. */
export struct Decoder {
  HuffTable? huff;      // the last Huffman table, for a treeless section
  SeqTables seq;        // the last sequence tables, for Repeat mode
  i32[] reps;           // the three most recent offsets

  Decoder create() {
    i32[] reps = i32[3]();
    reps[0] = 1;
    reps[1] = 4;
    reps[2] = 8;
    return Decoder(null, SeqTables.empty(), reps);
  }
}

/** The literals section's shape, before anything is decoded. */
struct LitHeader {
  i32 kind;             // 0 raw, 1 RLE, 2 compressed, 3 treeless
  i32 headerSize;
  i32 regenSize;        // literal bytes this produces
  i32 compressedSize;   // bytes it occupies after the header
  i32 streams;
}

/**
 * Read the literals section header.
 *
 * Five layouts across four kinds, and the field widths differ in each — 5, 12 or 20 bits of
 * regenerated size for the uncompressed kinds, 10, 14 or 18 bits plus a compressed size for the
 * others. The stream count is folded into the same two bits as the size format.
 */
LitHeader readLitHeader(u8[] src, i32 at, i32 end) {
  // Bounded by the *block's* end, not the frame's. A header that runs past its block but stays
  // inside the frame would otherwise be read happily, taking its sizes from whatever the next
  // block begins with.
  if (at >= end) { trap; }
  i32 b0 = src[at];
  i32 kind = b0 & 3;
  i32 fmt = (b0 >>> 2) & 3;

  if (kind < 2) {
    // Raw or RLE: one size, and RLE occupies exactly one byte whatever it regenerates.
    if ((fmt & 1) == 0) {
      i32 regen = b0 >>> 3;
      return LitHeader(kind, 1, regen, kind == 1 ? 1 : regen, 1);
    }
    if (fmt == 1) {
      if (at + 1 >= end) { trap; }
      i32 regen = (b0 >>> 4) | (src[at + 1] << 4);
      return LitHeader(kind, 2, regen, kind == 1 ? 1 : regen, 1);
    }
    if (at + 2 >= end) { trap; }
    i32 regen = (b0 >>> 4) | (src[at + 1] << 4) | (src[at + 2] << 12);
    return LitHeader(kind, 3, regen, kind == 1 ? 1 : regen, 1);
  }

  i32 streams = fmt == 0 ? 1 : 4;
  if (fmt <= 1) {
    if (at + 2 >= end) { trap; }
    i32 b1 = src[at + 1];
    i32 b2 = src[at + 2];
    i32 regen = ((b0 >>> 4) | (b1 << 4)) & 1023;
    i32 comp = ((b1 >>> 6) | (b2 << 2)) & 1023;
    return LitHeader(kind, 3, regen, comp, streams);
  }
  if (fmt == 2) {
    if (at + 3 >= end) { trap; }
    i32 b1 = src[at + 1];
    i32 b2 = src[at + 2];
    i32 b3 = src[at + 3];
    i32 regen = ((b0 >>> 4) | (b1 << 4) | (b2 << 12)) & 16383;
    i32 comp = ((b2 >>> 2) | (b3 << 6)) & 16383;
    return LitHeader(kind, 4, regen, comp, streams);
  }
  if (at + 4 >= end) { trap; }
  i32 b1 = src[at + 1];
  i32 b2 = src[at + 2];
  i32 b3 = src[at + 3];
  i32 b4 = src[at + 4];
  i32 regen = ((b0 >>> 4) | (b1 << 4) | (b2 << 12)) & 262143;
  i32 comp = ((b2 >>> 6) | (b3 << 2) | (b4 << 10)) & 262143;
  return LitHeader(kind, 5, regen, comp, streams);
}

/**
 * Decode one compressed block into `out`, carrying `d`'s state forward.
 *
 * `out` holds everything decoded so far in this frame, not just this block — a match may reach
 * back past the block boundary, which is what the window size in the frame header is about.
 */
export void decodeCompressed(u8[] src, i32 at, i32 size, Buf out, Decoder d) {
  // The caller has already checked the block fits in the frame, so `end` is within `src`.
  i32 end = at + size;
  LitHeader h = readLitHeader(src, at, end);
  i32 p = at + h.headerSize;
  if (p + h.compressedSize > end) { trap; }

  u8[] literals = u8[0]();
  if (h.kind == 0) {
    literals = u8[h.regenSize]();
    for (i32 i = 0; i < h.regenSize; i++) {
      literals[i] = src[p + i];
    }
  } else if (h.kind == 1) {
    // An RLE section always occupies one byte, so `p + 1 > end` above has already refused a
    // block that stops here.
    i32 v = src[p];
    literals = u8[h.regenSize]();
    for (i32 i = 0; i < h.regenSize; i++) {
      literals[i] = v;
    }
  } else if (h.kind == 2) {
    // The tree comes with the block, and is what a later treeless block will reuse.
    HuffTable t = readTable(src, p);
    d.huff = t;
    i32 streamsLen = h.compressedSize - t.bytesUsed;
    if (streamsLen <= 0) { trap; }
    literals = decodeLiterals(t, src, p + t.bytesUsed, streamsLen, h.regenSize, h.streams);
  } else {
    // Treeless: the tree must already exist. A frame that opens with one is malformed.
    if (d.huff is null) { trap; }
    if (h.compressedSize <= 0) { trap; }
    literals = decodeLiterals(d.huff!, src, p, h.compressedSize, h.regenSize, h.streams);
  }
  i32 seqAt = p + h.compressedSize;
  d.seq = decodeAndExecute(src, seqAt, end - seqAt, literals, out, d.seq, d.reps);
}
