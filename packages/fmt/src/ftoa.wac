// f64 -> decimal string: the shortest digit sequence that reads back as the same
// double, formatted exactly as JavaScript's Number::toString would.
//
// Algorithm is Burger & Dybvig's free-format "printing floating-point numbers
// quickly and accurately" (1996), which is Steele & White's Dragon4 restated. The
// value is held as an exact rational R/S together with the half-gaps to its
// neighbours, mPlus and mMinus; digits are produced most-significant first and the
// loop stops as soon as the digits emitted so far identify this double rather than
// either neighbour. That stopping rule is what makes the output shortest, and the
// exact arithmetic is what makes it correct — there is no approximate mode that is
// usually right.
//
// The alternative was Ryu, which is faster and needs no bignum, but wants two
// tables of ~600 128-bit constants. With no module-level constants those become a
// switch of 1200 literals, and formatting is not a hot path.
//
// Matching JavaScript is deliberate: it makes `String(x)` an oracle for every
// finite double, which is the only way to have confidence in this.

import { FixedBig } from "./bigint.wac";
import { Buf } from "../../bytes/src/buf.wac";

/**
 * What a float turned out to be.
 *
 * An enum rather than a struct with `isNaN`/`isInf` flags, because the flags made
 * nonsense representable — both set at once, or a NaN carrying digits — and every
 * reader had to know which fields were meaningful in which combination. Now the
 * cases are the type, and `writeDecimal` is exhaustive over them.
 *
 * `Zero` carries no sign: `String(-0)` is `"0"`, so the sign has nowhere to go.
 */
export enum Decimal {
  NaN,
  Inf(bool neg),
  Zero,
  // digits[0..count) are ASCII '0'..'9'; the value is 0.digits * 10^exp10.
  Digits(u8[] digits, i32 count, i32 exp10, bool neg),
}

/**
 * Decompose and generate digits. Exact for every finite double, including
 * subnormals and the boundary cases where a power of two's lower neighbour is
 * half as far away as its upper one.
 */
export Decimal decompose(f64 x) {
  u64 bits = f64.toBits(x);
  bool neg = (bits >> 63) != 0;
  i32 be = ((bits >> 52) & 2047) as@ i32;
  u64 frac = bits & 4503599627370495;          // low 52 bits
  // 11 exponent bits, bias 1075, implicit bit at 2^52.
  return decomposeFloat(neg, be, frac, 2047, 4503599627370496, 1075);
}

/** The same, for an f32: 8 exponent bits, bias 150, implicit bit at 2^23. */
export Decimal decompose32(f32 x) {
  u32 bits = f32.toBits(x);
  bool neg = (bits >> 31) != 0;
  i32 be = ((bits >> 23) & 255) as@ i32;
  u64 frac = (bits & 8388607) as u64;          // low 23 bits
  return decomposeFloat(neg, be, frac, 255, 8388608, 150);
}

/**
 * Digit generation, shared by both widths.
 *
 * Everything below the decomposition is identical for f32 and f64 — only the
 * exponent field's width, the bias and the implicit bit differ, so they are
 * parameters rather than a second copy of Burger & Dybvig.
 */
Decimal decomposeFloat(bool neg, i32 be, u64 frac, i32 maxBe, u64 implicitBit, i32 bias) {
  if (be == maxBe) {
    if (frac != 0) { return Decimal.NaN; }
    return Decimal.Inf(neg);
  }
  if (be == 0 && frac == 0) { return Decimal.Zero; }

  // Digits accumulate in locals. A variant's payload cannot be written after
  // construction — a matched subject is const within its arm, and outside a match
  // the enum has no fields — so the value is built here and constructed once at the
  // end. That was a builder in disguise before.
  u8[] digits = u8[24]();
  i32 count = 0;
  i32 exp10 = 0;

  u64 f = frac;
  i32 e = 1 - bias;
  // A normal number's implicit leading bit, and the asymmetric-gap test. The gap
  // below is half the gap above only when the significand is at its minimum and
  // the exponent is not, since at be == 1 the neighbour below is subnormal and the
  // spacing is the same on both sides.
  bool lowerCloser = false;
  // With round-half-to-even, a decimal landing exactly on the boundary between
  // this float and its neighbour reads back as this one when the significand is
  // even. So the boundary is attainable, and the stopping tests below are
  // inclusive. Getting this wrong does not produce wrong digits — it produces one
  // or two more of them than necessary, which is how it was found.
  bool boundaryOk = false;
  if (be != 0) {
    f = frac + implicitBit;
    e = be - bias;
    lowerCloser = (frac == 0 && be > 1);
  }
  boundaryOk = (f & 1) == 0;

  FixedBig r = FixedBig.fromU64(f);
  FixedBig s = FixedBig.zero();
  FixedBig mPlus = FixedBig.zero();
  FixedBig mMinus = FixedBig.zero();

  if (e >= 0) {
    // 2^e, which is both the gap to each neighbour and the factor on f.
    FixedBig pow = FixedBig.fromU64(1);
    pow.shiftLeft(e);
    // R = f * 2^e * 2 (or * 4 when the gaps differ), S = 2 (or 4).
    r.shiftLeft(e);
    if (lowerCloser) {
      r.mulSmall(4);
      s.setU64(4);
      mPlus.copyFrom(pow);
      mPlus.mulSmall(2);
      mMinus.copyFrom(pow);
    } else {
      r.mulSmall(2);
      s.setU64(2);
      mPlus.copyFrom(pow);
      mMinus.copyFrom(pow);
    }
  } else {
    // S = 2^-e * 2 (or * 4); the gaps are 1 (or 2 above, 1 below).
    s.setU64(1);
    s.shiftLeft(-e);
    if (lowerCloser) {
      r.mulSmall(4);
      s.mulSmall(4);
      mPlus.setU64(2);
      mMinus.setU64(1);
    } else {
      r.mulSmall(2);
      s.mulSmall(2);
      mPlus.setU64(1);
      mMinus.setU64(1);
    }
  }

  // Scale so that the first digit generated is the first significant one, i.e.
  // R/S lands in [1/10, 1). `k` counts the decimal point's position.
  i32 k = 0;
  FixedBig scratch = FixedBig.zero();
  while (true) {
    scratch.setSum(r, mPlus);
    i32 c = scratch.cmp(s);
    if (c > 0 || (boundaryOk && c == 0)) { s.mulSmall(10); k++; } else { break; }
  }
  while (true) {
    scratch.setSum(r, mPlus);
    scratch.mulSmall(10);
    if (scratch.cmp(s) <= 0) {
      r.mulSmall(10);
      mPlus.mulSmall(10);
      mMinus.mulSmall(10);
      k--;
    } else {
      break;
    }
  }
  exp10 = k;

  FixedBig twice = FixedBig.zero();
  while (true) {
    r.mulSmall(10);
    mPlus.mulSmall(10);
    mMinus.mulSmall(10);

    // digit = R / S, by trial subtraction: it cannot exceed 9.
    i32 digit = 0;
    while (r.cmp(s) >= 0) { r.sub(s); digit++; }

    i32 cLow = r.cmp(mMinus);
    bool low = boundaryOk ? cLow <= 0 : cLow < 0;
    scratch.setSum(r, mPlus);
    i32 cHigh = scratch.cmp(s);
    bool high = boundaryOk ? cHigh >= 0 : cHigh > 0;

    if (!low && !high) {
      digits[count] = '0' + digit;
      count++;
      continue;
    }
    // Stop: the digits so far pin this double down. Which way the last one goes
    // depends on which neighbour is still in reach.
    i32 last = digit;
    if (low && high) {
      // Both neighbours are still in reach, so take whichever the remainder is
      // nearer to. On an exact halfway remainder both candidates round-trip, and
      // ECMA-262 resolves it by choosing the even digit — not by rounding up.
      twice.copyFrom(r);
      twice.mulSmall(2);
      i32 c = twice.cmp(s);
      if (c > 0) {
        last = digit + 1;
      } else if (c == 0 && (digit % 2) != 0) {
        last = digit + 1;
      }
    } else if (high) {
      last = digit + 1;
    }
    if (last < 10) {
      digits[count] = '0' + last;
      count++;
      return Decimal.Digits(digits, count, exp10, neg);
    }

    // Rounding a 9 up carries, and it can only happen on the *first* digit, so the
    // carry always runs off the front and the value becomes a power of ten one
    // exponent higher: 9.99e22 is 1e23, not 10e22.
    //
    // Why only the first. Suppose digit k+1 is 9 and rounds up, so `high` holds
    // there: r + mPlus > s, where r and mPlus are the values after being scaled by
    // ten and r has had 9s subtracted. Substituting the previous step's values,
    // 10*(r_k + mPlus_k) - 9s > s, i.e. r_k + mPlus_k > s — which is exactly the
    // stopping condition at step k. So the loop would already have stopped there,
    // and only the first digit has no previous step to contradict.
    //
    // An earlier version walked back over the emitted digits absorbing the carry.
    // Branch coverage showed that path never taken by 60 000 random doubles nor by
    // 60 000 neighbours of round decimals, which prompted the proof above. The trap
    // is here rather than a comment because an untested branch that silently does
    // the wrong thing is worse than one that stops.
    if (count != 0) { trap; }
    digits[0] = '1';
    count = 1;
    exp10 = exp10 + 1;
    return Decimal.Digits(digits, count, exp10, neg);
  }
}

/**
 * The bytes of x, formatted as ECMA-262's Number::toString.
 *
 * That means: plain notation between 1e-6 and 1e21, exponential outside it, no
 * trailing zeros, no `+` on a positive exponent, and `-0` printed as `0`.
 */
export u8[] ftoaBytes(f64 x) {
  Buf out = Buf.create();
  writeF64(out, x);
  return out.bytes();
}

export string ftoa(f64 x) {
  Buf out = Buf.create();
  writeF64(out, x);
  return out.toStr();
}

/** The same for an f32: shortest digits that read back as the same f32. */
export string ftoa32(f32 x) {
  Buf out = Buf.create();
  writeDecimal(out, decompose32(x));
  return out.toStr();
}

export u8[] ftoa32Bytes(f32 x) {
  Buf out = Buf.create();
  writeDecimal(out, decompose32(x));
  return out.bytes();
}

export void writeF32(Buf out, f32 x) { writeDecimal(out, decompose32(x)); }

export void writeF64(Buf out, f64 x) { writeDecimal(out, decompose(x)); }

/** Exhaustive over the four things a float can be. */
void writeDecimal(Buf out, Decimal d) {
  match (d) {
    case NaN: {
      out.pushAll(u8[]('N', 'a', 'N'));
    }
    case Inf(neg): {
      if (neg) { out.push('-'); }
      out.pushAll(u8[]('I', 'n', 'f', 'i', 'n', 'i', 't', 'y'));
    }
    case Zero: {
      // Unsigned, matching String(-0) === "0".
      out.push('0');
    }
    case Digits(digits, count, exp10, neg): {
      if (neg) { out.push('-'); }
      writeDigits(out, digits, count, exp10);
    }
  }
}

/**
 * Place the decimal point, by ECMA-262's Number::toString rules.
 *
 * `count` digits with the value 0.digits * 10^exp10. Applied to f32 as well:
 * ECMA-262 defines the rules for doubles, but they are a function of the digit count
 * and the exponent, not of the width, and one set of thresholds is easier to read
 * than two.
 */
void writeDigits(Buf out, u8[] digits, i32 count, i32 exp10) {
  i32 k = count;
  i32 n = exp10;

  if (k <= n && n <= 21) {
    // Integer with trailing zeros: 1e3 prints as 1000.
    for (i32 i = 0; i < k; i++) { out.push(digits[i]); }
    for (i32 i = 0; i < n - k; i++) { out.push('0'); }
    return;
  }
  if (0 < n && n <= 21) {
    // Decimal point inside the digits.
    for (i32 i = 0; i < n; i++) { out.push(digits[i]); }
    out.push('.');
    for (i32 i = n; i < k; i++) { out.push(digits[i]); }
    return;
  }
  if (-6 < n && n <= 0) {
    // Leading zeros after the point: 1e-6 prints as 0.000001.
    out.push('0');
    out.push('.');
    for (i32 i = 0; i < -n; i++) { out.push('0'); }
    for (i32 i = 0; i < k; i++) { out.push(digits[i]); }
    return;
  }

  // Exponential. The exponent is n-1 because the point sits after the first digit.
  out.push(digits[0]);
  if (k > 1) {
    out.push('.');
    for (i32 i = 1; i < k; i++) { out.push(digits[i]); }
  }
  out.push('e');
  i32 exp = n - 1;
  if (exp < 0) { out.push('-'); exp = -exp; } else { out.push('+'); }
  writeSmallInt(out, exp);
}

/** Decimal digits of a non-negative i32. Only ever called with 0..323 here. */
void writeSmallInt(Buf out, i32 v) {
  if (v == 0) { out.push('0'); return; }
  u8[] tmp = u8[12]();
  i32 n = 0;
  i32 m = v;
  while (m > 0) {
    tmp[n] = '0' + (m % 10);
    n++;
    m = m / 10;
  }
  for (i32 i = n - 1; i >= 0; i--) { out.push(tmp[i]); }
}
