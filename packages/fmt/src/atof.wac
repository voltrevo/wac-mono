// Decimal -> f64, correctly rounded for every input.
//
// The mirror of ftoa, and it works the same way: a fast path that is *provably*
// exact, and an exact fallback for everything else. There is no approximate
// result — the answer is always the double nearest the decimal, with ties to even,
// which is what the host's own strtod produces and therefore what can be checked
// against it bit for bit.
//
// The fallback does not divide. Bit patterns of positive doubles are monotonic in
// their value, so it bisects them — 63 exact comparisons find the largest double
// not exceeding the decimal, and one more against the midpoint picks between that
// and its successor. Comparisons cross-multiply, scaling one side by a power of ten
// and the other by a power of two, so only multiply and compare are needed. That is
// the same reason bigint.wac has no division.

import { FixedBig } from "./bigint.wac";

/**
 * Limbs for the exact path.
 *
 * The comparison scales one side by 10^|exp| and the other by 2^|g|. With digits
 * capped at 800 and the value inside the f64 range, the larger side reaches about
 * 3900 bits; 160 limbs is 5120.
 */
i32 ATOF_LIMBS() { return 160; }

/**
 * Significant digits kept.
 *
 * Past this the remaining digits cannot change which double is nearest — they can
 * only break an exact midpoint tie, and `sticky` records that they existed. 800 is
 * beyond the ~767 digits an exact midpoint can have.
 */
i32 MAX_DIGITS() { return 800; }

/**
 * The cheap scan's result: no arrays, so parsing a number that takes the fast path
 * allocates nothing but this.
 *
 * `mant` holds up to 19 significant digits; `sticky` records that more followed.
 */
struct Quick {
  u64 mant;
  i32 digits;       // digits accumulated into mant
  i32 exp10;
  bool sticky;
  bool neg;
}

/** Parsed shape of a JSON number: value = (digits as an integer) * 10^exp10. */
struct Parts {
  u8[] digits;      // significant decimal digits, no leading zeros
  i32 count;
  i32 exp10;
  bool sticky;      // a nonzero digit was dropped past MAX_DIGITS
  bool neg;
}

/**
 * The f64 nearest the JSON number in `src[start..end)`.
 *
 * The span must already be a well-formed JSON number — this is called by a parser
 * that has just validated it, so there is no error return.
 */
export f64 atofSpan(u8[] src, i32 start, i32 end) {
  Quick q = quickScan(src, start, end);

  f64 mag = fastPath(q);
  // NaN is the "not exactly representable this way" signal — no JSON number can
  // produce it, so it cannot be confused with a real answer.
  if (mag != mag) {
    Parts p = scan(src, start, end);
    mag = exactMagnitude(p);
  }
  if (q.neg) { return -mag; }
  return mag;
}

/**
 * Scan without allocating anything array-shaped.
 *
 * The previous version built the full 800-digit buffer for every number, including
 * `1`. That single allocation per number was the difference between 19 MB/s and
 * the rest of the parser's 100+.
 */
Quick quickScan(u8[] src, i32 start, i32 end) {
  Quick q = Quick(0, 0, 0, false, false);
  i32 i = start;
  if (i < end && src[i] == '-') { q.neg = true; i++; }

  bool seenPoint = false;
  bool seenNonZero = false;
  i32 dropped = 0;
  i32 afterPoint = 0;

  while (i < end) {
    i32 c = src[i];
    if (c == '.') { seenPoint = true; i++; continue; }
    if (c == 'e' || c == 'E') { break; }
    if (c == '0' && !seenNonZero) {
      if (seenPoint) { q.exp10--; }
      i++;
      continue;
    }
    seenNonZero = true;
    // 19 digits is the most that always fits a u64 without wrapping.
    if (q.digits < 19) {
      q.mant = q.mant * 10 + ((c - '0') as! u64);
      q.digits++;
      if (seenPoint) { afterPoint++; }
    } else {
      if (c != '0') { q.sticky = true; }
      if (!seenPoint) { dropped++; }
    }
    i++;
  }
  q.exp10 = q.exp10 - afterPoint + dropped;

  if (i < end && (src[i] == 'e' || src[i] == 'E')) {
    i++;
    bool eneg = false;
    if (i < end && src[i] == '-') { eneg = true; i++; }
    else if (i < end && src[i] == '+') { i++; }
    i32 ev = 0;
    while (i < end) {
      if (ev < 100000) { ev = ev * 10 + (src[i] - '0'); }
      i++;
    }
    if (eneg) { q.exp10 -= ev; } else { q.exp10 += ev; }
  }
  return q;
}

/** 10^n as a u64, for n up to 19. */
u64 pow10U64(i32 n) {
  u64 r = 1;
  for (i32 i = 0; i < n; i++) { r = r * 10; }
  return r;
}

/**
 * The answer when it is provably exact, or NaN when the exact path is needed.
 *
 * Exact requires the significand to land in an f64 without rounding — at most 2^53
 * — and the power of ten to be exactly representable, which holds up to 10^22.
 * Clinger's extension covers a further stretch: when the exponent is above 22 but
 * the significand can absorb the excess and stay under 2^53, two exact operations
 * still compose. `1e30` is in that stretch; without it, it went to the bignum.
 */
f64 fastPath(Quick q) {
  if (q.digits == 0) { return 0.0; }
  if (q.sticky) { return 0.0 / 0.0; }
  // 2^53: above this a u64 significand no longer converts to f64 exactly.
  if (q.mant > 9007199254740992) { return 0.0 / 0.0; }

  f64 m = q.mant as~ f64;
  i32 e = q.exp10;
  if (e == 0) { return m; }
  if (e > 0 && e <= 22) { return m * pow10Exact(e); }
  if (e < 0 && e >= -22) { return m / pow10Exact(-e); }

  if (e > 22 && e <= 37) {
    // Push the excess into the significand while it still fits exactly.
    i32 shift = e - 22;
    u64 limit = 9007199254740992 / pow10U64(shift);
    if (q.mant <= limit) {
      return (q.mant * pow10U64(shift)) as~ f64 * 1.0e22;
    }
  }
  return 0.0 / 0.0;
}

/** Split the span into significant digits and a decimal exponent. */
Parts scan(u8[] src, i32 start, i32 end) {
  Parts p = Parts(u8[MAX_DIGITS()](), 0, 0, false, false);
  i32 i = start;
  if (i < end && src[i] == '-') { p.neg = true; i++; }

  bool seenPoint = false;
  bool seenNonZero = false;
  i32 dropped = 0;          // digits dropped from the integer part
  i32 afterPoint = 0;       // digits kept after the decimal point

  while (i < end) {
    i32 c = src[i];
    if (c == '.') { seenPoint = true; i++; continue; }
    if (c == 'e' || c == 'E') { break; }

    // Leading zeros carry no information and must not consume digit slots.
    if (c == '0' && !seenNonZero) {
      if (seenPoint) { p.exp10--; }
      i++;
      continue;
    }
    seenNonZero = true;
    if (p.count < MAX_DIGITS()) {
      p.digits[p.count] = c;
      p.count++;
      if (seenPoint) { afterPoint++; }
    } else {
      if (c != '0') { p.sticky = true; }
      if (!seenPoint) { dropped++; }
    }
    i++;
  }

  p.exp10 = p.exp10 - afterPoint + dropped;

  if (i < end && (src[i] == 'e' || src[i] == 'E')) {
    i++;
    bool eneg = false;
    if (i < end && src[i] == '-') { eneg = true; i++; }
    else if (i < end && src[i] == '+') { i++; }
    i32 ev = 0;
    while (i < end) {
      // Clamped: past this the result is already zero or infinity, and letting it
      // wrap would turn an overflow into a finite answer.
      if (ev < 100000) { ev = ev * 10 + (src[i] - '0'); }
      i++;
    }
    if (eneg) { p.exp10 -= ev; } else { p.exp10 += ev; }
  }

  // Trailing zeros in the kept digits are exponent, not information.
  while (p.count > 0 && p.digits[p.count - 1] == '0') {
    p.count--;
    p.exp10++;
  }
  return p;
}

/** The magnitude via the exact path, ignoring sign. */
f64 exactMagnitude(Parts p) {
  if (p.count == 0) { return 0.0; }

  // Decisive range checks before any work: the most significant digit sits at
  // 10^(exp10 + count - 1), and f64 spans roughly 1e-324 to 1.8e308.
  // value is in [10^(top-1), 10^top), so top >= 310 is past every finite double
  // and top < -330 is far below the smallest subnormal. Everything in between —
  // including the subnormal range and the overflow boundary itself — is decided
  // exactly below rather than by an estimate.
  i32 top = p.exp10 + p.count;
  if (top >= 310) { return 1.0 / 0.0; }
  if (top < -330) { return 0.0; }

  return bisect(p);
}

/** Exactly representable powers of ten, for the fast path. */
f64 pow10Exact(i32 n) {
  switch (n) {
    case 0:  { return 1.0; }        case 1:  { return 10.0; }
    case 2:  { return 100.0; }      case 3:  { return 1000.0; }
    case 4:  { return 10000.0; }    case 5:  { return 100000.0; }
    case 6:  { return 1000000.0; }  case 7:  { return 10000000.0; }
    case 8:  { return 100000000.0; } case 9: { return 1000000000.0; }
    case 10: { return 1.0e10; }     case 11: { return 1.0e11; }
    case 12: { return 1.0e12; }     case 13: { return 1.0e13; }
    case 14: { return 1.0e14; }     case 15: { return 1.0e15; }
    case 16: { return 1.0e16; }     case 17: { return 1.0e17; }
    case 18: { return 1.0e18; }     case 19: { return 1.0e19; }
    case 20: { return 1.0e20; }     case 21: { return 1.0e21; }
    case 22: { return 1.0e22; }
    default: { trap; }
  }
}

/**
 * Exact path: binary search the bit pattern.
 *
 * For positive doubles the bit pattern is monotonic in the value, so the largest
 * `bits` whose double does not exceed the decimal can be found by bisection — 63
 * exact comparisons, no approximation to be wrong and no walk that can fall short.
 * An earlier version started from a cheap estimate and stepped by ulps, which
 * silently failed at both ends of the range where the estimate was thousands of
 * ulps out.
 */
/**
 * Everything the comparison needs, built once per number.
 *
 * The decimal side of `digits * 10^exp10  vs  f * 2^g` does not change as the
 * bisection moves the candidate, so scaling it by the power of ten belongs out
 * here. Rebuilding it inside the loop meant up to 128 multiply passes over 120
 * limbs on every one of 63 iterations, which is why exponent-form numbers parsed
 * at 0.5 MB/s.
 */
struct Cmp {
  FixedBig dec;        // digits * 10^exp10 when exp10 >= 0, else just the digits
  FixedBig pow;        // 10^-exp10 when exp10 < 0, else unused
  FixedBig lhs;        // scratch
  FixedBig rhs;        // scratch
  FixedBig scratch;    // scratch for mulU64
  i32 exp10;
  bool sticky;
}

f64 bisect(Parts p) {
  i32 limbs = ATOF_LIMBS();
  FixedBig dec = FixedBig.withLimbs(limbs);
  for (i32 i = 0; i < p.count; i++) {
    dec.mulAddSmall(10, (p.digits[i] - '0') as@ u32);
  }
  FixedBig pow = FixedBig.withLimbs(limbs);
  if (p.exp10 > 0) {
    mulPow10(dec, p.exp10);
  } else if (p.exp10 < 0) {
    pow.setU64(1);
    mulPow10(pow, -p.exp10);
  }
  Cmp c = Cmp(dec, pow, FixedBig.withLimbs(limbs), FixedBig.withLimbs(limbs),
              FixedBig.withLimbs(limbs), p.exp10, p.sticky);

  u64 maxFinite = 9218868437227405311;    // 0x7FEFFFFFFFFFFFFF

  // Above every finite double: round to infinity or back to the largest finite,
  // whichever the midpoint says. The largest finite has an odd significand, so an
  // exact tie goes to infinity under round-half-to-even.
  if (compareValue(c, maxFinite) > 0) {
    if (compareMidpoint(c, maxFinite) >= 0) { return 1.0 / 0.0; }
    return f64.fromBits(maxFinite);
  }

  // Largest bits with value(bits) <= decimal. Zero always satisfies it, which is
  // what makes the subnormal range fall out for free.
  //
  // The bracket starts narrow, around a cheap estimate, and is *verified* by exact
  // comparison before use — if either end is wrong it widens to the full range. So
  // the estimate can only cost time, never correctness, which is the distinction
  // the first version of this file got wrong by trusting one.
  u64 lo = 0;
  u64 hi = maxFinite;
  u64 guess = approxBits(p);
  if (guess > 0 && guess < maxFinite) {
    u64 window = 4;
    u64 gLo = guess > window ? guess - window : 0;
    u64 gHi = guess + window < maxFinite ? guess + window : maxFinite;
    // value(gLo) must not exceed the decimal, and the decimal must be below
    // value(gHi + 1) — otherwise the answer lies outside and the bracket is unsafe.
    if (compareValue(c, gLo) >= 0) { lo = gLo; }
    if (gHi < maxFinite && compareValue(c, gHi + 1) < 0) { hi = gHi; }
  }
  while (lo < hi) {
    u64 mid = lo + (hi - lo + 1) / 2;
    if (compareValue(c, mid) >= 0) { lo = mid; } else { hi = mid - 1; }
  }

  i32 m = compareMidpoint(c, lo);
  if (m > 0) { return f64.fromBits(lo + 1); }
  if (m < 0) { return f64.fromBits(lo); }
  // Exactly halfway: take the even significand.
  if ((lo & 1) == 0) { return f64.fromBits(lo); }
  return f64.fromBits(lo + 1);
}

/**
 * A rough starting point for the bisection, from f64 arithmetic alone.
 *
 * Deliberately sloppy: repeated scaling by 1e22 accumulates error, and the digits
 * past 17 are ignored. Its only job is to be within a few ulps most of the time.
 * Zero or infinity means "no useful estimate", and the caller then bisects the
 * whole range.
 */
u64 approxBits(Parts p) {
  f64 m = 0.0;
  i32 used = p.count < 17 ? p.count : 17;
  for (i32 i = 0; i < used; i++) {
    m = m * 10.0 + ((p.digits[i] - '0') as f64);
  }
  i32 e = p.exp10 + (p.count - used);
  while (e > 22) {
    m = m * 1.0e22;
    e -= 22;
    if (m > 1.0e300) { return 0; }
  }
  while (e < -22) {
    m = m / 1.0e22;
    e += 22;
    if (m < 1.0e-300 && m != 0.0) { return 0; }
  }
  if (e > 0) { m = m * pow10Exact(e); } else if (e < 0) { m = m / pow10Exact(-e); }
  if (m != m || m == 0.0) { return 0; }
  if (m > 1.0e308) { return 0; }
  return f64.toBits(m);
}

/** The f32 nearest the decimal in `src[start..end)`, correctly rounded. */
export f32 atof32Span(u8[] src, i32 start, i32 end) {
  Parts p = scan(src, start, end);
  f32 mag = bisect32(p);
  if (p.neg) { return -mag; }
  return mag;
}

/**
 * The f32 version of the bisection.
 *
 * Separate rather than shared because the two return different types and wac has
 * no generics — the comparison machinery below *is* shared, since it works on a
 * significand and a binary exponent and does not care which width they came from.
 *
 * Not implemented by parsing to f64 and narrowing: that rounds twice, and the two
 * roundings disagree for values sitting near an f32 boundary.
 */
f32 bisect32(Parts p) {
  if (p.count == 0) { return 0.0 as~ f32; }
  i32 top = p.exp10 + p.count;
  if (top >= 40) { return (1.0 / 0.0) as~ f32; }
  if (top < -50) { return 0.0 as~ f32; }

  i32 limbs = ATOF_LIMBS();
  FixedBig dec = FixedBig.withLimbs(limbs);
  for (i32 i = 0; i < p.count; i++) {
    dec.mulAddSmall(10, (p.digits[i] - '0') as@ u32);
  }
  FixedBig pow = FixedBig.withLimbs(limbs);
  if (p.exp10 > 0) {
    mulPow10(dec, p.exp10);
  } else if (p.exp10 < 0) {
    pow.setU64(1);
    mulPow10(pow, -p.exp10);
  }
  Cmp c = Cmp(dec, pow, FixedBig.withLimbs(limbs), FixedBig.withLimbs(limbs),
              FixedBig.withLimbs(limbs), p.exp10, p.sticky);

  u64 maxFinite = 2139095039;              // 0x7F7FFFFF

  if (compareValue32(c, maxFinite) > 0) {
    if (compareMidpoint32(c, maxFinite) >= 0) { return (1.0 / 0.0) as~ f32; }
    return f32.fromBits(maxFinite as@ u32);
  }

  u64 lo = 0;
  u64 hi = maxFinite;
  while (lo < hi) {
    u64 mid = lo + (hi - lo + 1) / 2;
    if (compareValue32(c, mid) >= 0) { lo = mid; } else { hi = mid - 1; }
  }

  i32 m = compareMidpoint32(c, lo);
  if (m > 0) { return f32.fromBits((lo + 1) as@ u32); }
  if (m < 0) { return f32.fromBits(lo as@ u32); }
  if ((lo & 1) == 0) { return f32.fromBits(lo as@ u32); }
  return f32.fromBits((lo + 1) as@ u32);
}

/** value = f * 2^g for an f32 bit pattern: 8 exponent bits, bias 150. */
Split splitBits32(u64 bits) {
  i32 be = ((bits >> 23) & 255) as@ i32;
  u64 frac = bits & 8388607;
  if (be == 0) { return Split(frac, -149); }
  return Split(frac + 8388608, be - 150);
}

i32 compareValue32(Cmp c, u64 bits) {
  Split s = splitBits32(bits);
  return compareScaled(c, s.f, s.g);
}

i32 compareMidpoint32(Cmp c, u64 bits) {
  Split s = splitBits32(bits);
  return compareScaled(c, s.f * 2 + 1, s.g - 1);
}

/** The significand and exponent of a positive double: value = f * 2^g. */
struct Split { u64 f; i32 g; }

Split splitBits(u64 bits) {
  i32 be = ((bits >> 52) & 2047) as@ i32;
  u64 frac = bits & 4503599627370495;
  if (be == 0) { return Split(frac, -1074); }
  return Split(frac + 4503599627370496, be - 1075);
}

/** Compare the decimal against the double with these bits. */
i32 compareValue(Cmp c, u64 bits) {
  Split s = splitBits(bits);
  return compareScaled(c, s.f, s.g);
}

/**
 * Compare the decimal against the midpoint between `bits` and its successor.
 *
 * The midpoint of f*2^g and (f+1)*2^g is (2f+1)*2^(g-1), which stays exact and
 * remains correct at the top of a binade where the successor moves to the next
 * exponent.
 */
i32 compareMidpoint(Cmp c, u64 bits) {
  Split s = splitBits(bits);
  return compareScaled(c, s.f * 2 + 1, s.g - 1);
}

/**
 * Compare (digits * 10^exp10) against (f * 2^g), exactly.
 *
 * Both sides are cross-multiplied into integers, so there is no division. Only the
 * per-candidate work happens here: the power of ten was applied when the Cmp was
 * built.
 */
i32 compareScaled(Cmp c, u64 f, i32 g) {
  c.lhs.copyFrom(c.dec);
  if (c.exp10 < 0) {
    c.rhs.copyFrom(c.pow);
    c.rhs.mulU64(f, c.scratch);
  } else {
    c.rhs.setU64(f);
  }
  if (g > 0) { c.rhs.shiftLeft(g); } else if (g < 0) { c.lhs.shiftLeft(-g); }

  i32 r = c.lhs.cmp(c.rhs);
  // The digits that were dropped were nonzero, so the true value is above what was
  // compared. Only an apparent tie can be decided by that.
  if (r == 0 && c.sticky) { return 1; }
  return r;
}

void mulPow10(FixedBig b, i32 e) {
  i32 left = e;
  // 10^9 is the largest power of ten inside a u32, so nine digits at a time.
  while (left >= 9) { b.mulSmall(1000000000); left -= 9; }
  while (left > 0) { b.mulSmall(10); left--; }
}
