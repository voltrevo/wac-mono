// DEFLATE compressor (RFC 1951): fixed (BTYPE=01) and dynamic (BTYPE=10)
// Huffman blocks over a shared LZ77 pass.
//
// Fixed blocks use the code the spec defines, so nothing is transmitted about
// it. Dynamic blocks build a code fitted to the actual symbol frequencies and
// transmit it — which costs a header but usually pays for itself, because real
// data is nowhere near the uniform distribution the fixed code assumes.

import { BitWriter } from "./bitwriter.wac";
import { Tables } from "./tables.wac";
import { Huff, forceTwo } from "./huffman.wac";

i32 numLitLen() { return 286; }   // 0..255 literals, 256 end-of-block, 257..285 lengths
i32 numDist()   { return 30; }    // distance symbols 0..29
i32 numCl()     { return 19; }    // code-length alphabet 0..18
i32 maxCodeBits() { return 15; }  // literal/length and distance code limit
i32 maxClBits()   { return 7; }   // code-length code limit

i32 imin(i32 a, i32 b) {
  if (a < b) { return a; }
  return b;
}

// ── Fixed literal/length code, RFC 1951 section 3.2.6 ────────────────────────
//
//   symbol     bits   codes
//     0-143      8    00110000  through 10111111   (0x30..0xBF)
//   144-255      9    110010000 through 111111111  (0x190..0x1FF)
//   256-279      7    0000000   through 0010111    (0x00..0x17)
//   280-287      8    11000000  through 11000111   (0xC0..0xC7)

i32 fixedLitBits(i32 sym) {
  if (sym <= 143) { return 8; }
  if (sym <= 255) { return 9; }
  if (sym <= 279) { return 7; }
  return 8;
}

i32 fixedLitCode(i32 sym) {
  if (sym <= 143) { return 0x30 + sym; }
  if (sym <= 255) { return 0x190 + (sym - 144); }
  if (sym <= 279) { return sym - 256; }
  return 0xC0 + (sym - 280);
}

// ── LZ77 ──────────────────────────────────────────────────────────────────────

/**
 * The LZ77 pass, kept separate from encoding so both block types compress the
 * same symbol stream and the only difference between them is the code used to
 * write it. Frequencies are gathered here because the dynamic encoder needs
 * them before it can write anything.
 */
export struct Tokens {
  i32[] a;          // literal byte, or match length
  i32[] b;          // 0 for a literal, else the match distance
  i32 n;
  i32[] litFreq;    // over numLitLen symbols, includes end-of-block
  i32[] distFreq;   // over numDist symbols
}

i32 hashSize()   { return 32768; }  // 1 << 15, one bucket per possible distance
i32 maxDist()    { return 32768; }  // RFC 1951: 32 KiB window
i32 maxMatch()   { return 258; }    // longest length the code can express
i32 minMatch()   { return 3; }      // shorter than this costs more than literals
i32 chainLimit() { return 128; }    // candidates per position, bounds the search

// Search cutoffs, following zlib's good_match/nice_match at level 6. Once a match
// is long enough, the remaining candidates cost more time than the bits they might
// save: text compression spent most of its time walking all 128 candidates after
// a perfectly good match was already in hand.
i32 goodLength() { return 8; }      // beyond this, narrow the search
i32 niceLength() { return 128; }    // beyond this, stop looking entirely

i32 hash3(u8[] data, i32 pos) {
  return ((data[pos] << 10) ^ (data[pos + 1] << 5) ^ data[pos + 2]) & 0x7FFF;
}

void insertHash(u8[] data, i32[] head, i32[] prev, i32 pos) {
  i32 h = hash3(data, pos);
  prev[pos] = head[h];
  head[h] = pos;
}

/**
 * Greedy match finding over hash chains: hash the 3 bytes at each position, keep
 * a newest-first list per bucket, and walk back through earlier positions with
 * the same 3-byte prefix — the only candidates that can start a match.
 *
 * Greedy, not lazy: zlib defers a match by one byte to check whether the next
 * position does better, worth a few percent. That is a ratio refinement, not a
 * correctness one.
 */
Tokens lz77(u8[] data, Tables t) {
  return lz77From(data, t, 0);
}

/**
 * The same, but only the bytes from `start` onwards become tokens.
 *
 * Everything before `start` is history: hashed so matches can reach into it, never emitted.
 * That is what lets a stream compress a chunk at a time without losing the matches that
 * cross a chunk boundary — carry the last 32 KiB into the next call as history and the
 * token stream is the one a whole-input pass would have produced.
 *
 * Re-hashing the history costs one insert per carried byte per block. Making the fresh
 * region several times the window is what keeps that from mattering.
 */
export Tokens lz77From(u8[] data, Tables t, i32 start) {
  i32 n = data.len();
  // Every token consumes at least one input byte, so one slot per fresh byte suffices.
  i32 room = n - start + 1;
  Tokens tok = Tokens(i32[room](), i32[room](), 0, i32[numLitLen()](), i32[numDist()]());

  i32[] head = i32[hashSize()]();
  for (i32 i = 0; i < hashSize(); i++) {
    head[i] = -1;
  }
  i32[] prev = i32[n]();

  // The history, hashed but not emitted.
  for (i32 i = 0; i + minMatch() <= start; i++) {
    insertHash(data, head, prev, i);
  }

  i32 pos = start;
  while (pos < n) {
    i32 bestLen = 0;
    i32 bestDist = 0;

    if (pos + minMatch() <= n) {
      i32 cand = head[hash3(data, pos)];
      i32 chain = 0;
      i32 limit = chainLimit();
      while (cand >= 0 && chain < limit) {
        i32 dist = pos - cand;
        if (dist > maxDist()) {
          cand = -1;
        } else {
          i32 len = 0;
          while (len < maxMatch() && pos + len < n
                 && data[cand + len] == data[pos + len]) {
            len++;
          }
          if (len > bestLen) {
            bestLen = len;
            bestDist = dist;
            if (bestLen >= niceLength()) {
              cand = -1;                      // long enough; stop searching
            } else if (bestLen >= goodLength()) {
              limit = chainLimit() >>> 2;      // decent already; look less hard
            }
          }
          if (cand >= 0) {
            cand = prev[cand];
            chain++;
          }
        }
      }
    }

    if (bestLen >= minMatch()) {
      tok.a[tok.n] = bestLen;
      tok.b[tok.n] = bestDist;
      tok.n++;
      tok.litFreq[257 + t.lenIndex(bestLen)]++;
      tok.distFreq[t.distIndex(bestDist)]++;
      // Every covered position still needs hashing, or later matches cannot
      // reference into this one.
      for (i32 k = 0; k < bestLen; k++) {
        if (pos + k + minMatch() <= n) {
          insertHash(data, head, prev, pos + k);
        }
      }
      pos += bestLen;
    } else {
      tok.a[tok.n] = data[pos];
      tok.b[tok.n] = 0;
      tok.n++;
      tok.litFreq[data[pos]]++;
      if (pos + minMatch() <= n) {
        insertHash(data, head, prev, pos);
      }
      pos++;
    }
  }

  tok.litFreq[256]++;   // end-of-block, emitted once
  return tok;
}

/** Write the token stream using whatever literal/length and distance code. */
void writeTokens(
  BitWriter w, Tokens tok, Tables t,
  i32[] litCode, i32[] litLen, i32[] distCode, i32[] distLen
) {
  for (i32 i = 0; i < tok.n; i++) {
    if (tok.b[i] == 0) {
      i32 sym = tok.a[i];
      w.writeCode(litCode[sym], litLen[sym]);
    } else {
      i32 len = tok.a[i];
      i32 li = t.lenIndex(len);
      w.writeCode(litCode[257 + li], litLen[257 + li]);
      if (t.lenExtra[li] > 0) {
        w.writeBits(len - t.lenBase[li], t.lenExtra[li]);
      }
      i32 dist = tok.b[i];
      i32 di = t.distIndex(dist);
      w.writeCode(distCode[di], distLen[di]);
      if (t.distExtra[di] > 0) {
        w.writeBits(dist - t.distBase[di], t.distExtra[di]);
      }
    }
  }
  w.writeCode(litCode[256], litLen[256]);   // end-of-block
}

// ── Fixed Huffman ─────────────────────────────────────────────────────────────

/** Compress to a single final fixed-Huffman block. */
export u8[] deflateFixed(u8[] data) {
  BitWriter w = BitWriter.create();
  Tables t = Tables.create();
  Tokens tok = lz77(data, t);

  w.writeBits(1, 1);   // BFINAL = 1, only block
  w.writeBits(1, 2);   // BTYPE = 01, fixed Huffman

  // Materialise the fixed code as tables so writeTokens is shared.
  i32[] litCode = i32[288]();
  i32[] litLen = i32[288]();
  for (i32 s = 0; s < 288; s++) {
    litCode[s] = fixedLitCode(s);
    litLen[s] = fixedLitBits(s);
  }
  i32[] distCode = i32[numDist()]();
  i32[] distLen = i32[numDist()]();
  for (i32 d = 0; d < numDist(); d++) {
    distCode[d] = d;     // fixed distance codes are 5 bits, code == symbol
    distLen[d] = 5;
  }

  writeTokens(w, tok, t, litCode, litLen, distCode, distLen);
  w.alignByte();
  return w.bytes();
}

// ── Dynamic Huffman ───────────────────────────────────────────────────────────

/**
 * The code lengths of both trees, run-length encoded over the code-length
 * alphabet (RFC 1951 section 3.2.7):
 *
 *   0..15  a literal code length
 *   16     repeat the previous length 3-6 times   (2 extra bits)
 *   17     a run of 3-10 zero lengths             (3 extra bits)
 *   18     a run of 11-138 zero lengths           (7 extra bits)
 *
 * Zero runs are common — most of the 286 literal/length symbols go unused in
 * any given block — which is what symbols 17 and 18 exist for.
 */
struct ClSeq {
  i32[] sym;
  i32[] extra;
  i32 n;
}

void clPush(ClSeq s, i32 sym, i32 extra) {
  s.sym[s.n] = sym;
  s.extra[s.n] = extra;
  s.n++;
}

ClSeq runLengthEncode(i32[] lens, i32 total) {
  // Each input length emits at most one symbol, so `total` slots suffice.
  ClSeq s = ClSeq(i32[total + 1](), i32[total + 1](), 0);

  i32 i = 0;
  while (i < total) {
    i32 cur = lens[i];
    i32 run = 1;
    while (i + run < total && lens[i + run] == cur) {
      run++;
    }
    i += run;

    if (cur == 0) {
      while (run >= 11) {
        i32 k = imin(run, 138);
        clPush(s, 18, k - 11);
        run -= k;
      }
      while (run >= 3) {
        i32 k = imin(run, 10);
        clPush(s, 17, k - 3);
        run -= k;
      }
      while (run > 0) {
        clPush(s, 0, 0);
        run--;
      }
    } else {
      clPush(s, cur, 0);   // symbol 16 copies a previous length, so send one
      run--;
      while (run >= 3) {
        i32 k = imin(run, 6);
        clPush(s, 16, k - 3);
        run -= k;
      }
      while (run > 0) {
        clPush(s, cur, 0);
        run--;
      }
    }
  }
  return s;
}

/**
 * The order the code-length code's own lengths are transmitted in. Front-loaded
 * with the symbols most likely to be used, so trailing entries are usually zero
 * and can be dropped (that is what HCLEN counts).
 */
const i32[] CL_ORDER = i32[](16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15);

/** Extra bits carried by code-length symbols 16, 17 and 18. */
i32 clExtraBits(i32 sym) {
  if (sym == 16) { return 2; }
  if (sym == 17) { return 3; }
  if (sym == 18) { return 7; }
  return 0;
}

/** Compress to a single final dynamic-Huffman block. */
export u8[] deflateDynamic(u8[] data) {
  BitWriter w = BitWriter.create();
  Tables t = Tables.create();
  writeDynamicBlock(w, lz77(data, t), t, true);
  w.alignByte();
  return w.bytes();
}

/**
 * Write one dynamic-Huffman block for `tok` into `w`.
 *
 * Split out of `deflateDynamic` so a stream can emit a block per chunk into a bit writer
 * that spans the whole member. Everything here is per block by nature — the code tables are
 * built from this block's own symbol frequencies — so nothing had to change to make it
 * repeatable except taking `bfinal` as an argument instead of always setting it.
 */
export void writeDynamicBlock(BitWriter w, Tokens tok, Tables t, bool bfinal) {
  // A one-symbol code cannot be expressed, so pad before building.
  forceTwo(tok.litFreq, numLitLen());
  forceTwo(tok.distFreq, numDist());

  Huff lit = Huff.build(tok.litFreq, numLitLen(), maxCodeBits());
  Huff dist = Huff.build(tok.distFreq, numDist(), maxCodeBits());

  // Trailing unused symbols need not be transmitted, but the minimum counts are
  // fixed by the format: 257 literal/length lengths and 1 distance length.
  i32 hlit = numLitLen();
  while (hlit > 257 && lit.len[hlit - 1] == 0) {
    hlit--;
  }
  i32 hdist = numDist();
  while (hdist > 1 && dist.len[hdist - 1] == 0) {
    hdist--;
  }

  // Both trees' lengths are encoded as one concatenated sequence, so a repeat
  // can straddle the boundary between them.
  i32 total = hlit + hdist;
  i32[] lens = i32[total]();
  for (i32 i = 0; i < hlit; i++) {
    lens[i] = lit.len[i];
  }
  for (i32 i = 0; i < hdist; i++) {
    lens[hlit + i] = dist.len[i];
  }

  ClSeq seq = runLengthEncode(lens, total);

  i32[] clFreq = i32[numCl()]();
  for (i32 i = 0; i < seq.n; i++) {
    clFreq[seq.sym[i]]++;
  }
  forceTwo(clFreq, numCl());
  Huff cl = Huff.build(clFreq, numCl(), maxClBits());

  // Drop trailing zero lengths in the transmission order; at least 4 are sent.
  i32[] order = CL_ORDER;
  i32 hclen = numCl();
  while (hclen > 4 && cl.len[order[hclen - 1]] == 0) {
    hclen--;
  }

  w.writeBits(bfinal ? 1 : 0, 1);   // BFINAL: the last block of the member
  w.writeBits(2, 2);                // BTYPE = 10, dynamic Huffman
  w.writeBits(hlit - 257, 5); // HLIT
  w.writeBits(hdist - 1, 5);  // HDIST
  w.writeBits(hclen - 4, 4);  // HCLEN

  for (i32 i = 0; i < hclen; i++) {
    w.writeBits(cl.len[order[i]], 3);
  }

  for (i32 i = 0; i < seq.n; i++) {
    i32 sym = seq.sym[i];
    w.writeCode(cl.code[sym], cl.len[sym]);
    i32 bits = clExtraBits(sym);
    if (bits > 0) {
      w.writeBits(seq.extra[i], bits);
    }
  }

  writeTokens(w, tok, t, lit.code, lit.len, dist.code, dist.len);
}
