// Buf — a growable byte buffer.
//
// Everything downstream (the gzip container, the deflate bit writer) appends
// bytes without knowing the final length, so this is the one place that owns
// growth. Capacity doubles, so appending n bytes is amortised O(n).

export struct Buf {
  u8[] data;
  i32 len;

  Buf create() {
    return Buf(u8[16](), 0);
  }

  /**
   * A buffer pre-sized to `capacity`.
   *
   * Worth it when the final length is known up front — inflate reads it from the
   * gzip trailer — because it skips the doubling reallocations *and* lets `take`
   * hand back the array without a copy.
   */
  Buf withCapacity(i32 capacity) {
    if (capacity < 16) { capacity = 16; }
    return Buf(u8[capacity](), 0);
  }

  i32 get(const this, i32 i) {
    if (i < 0 || i >= this.len) { trap; }
    return this.data[i];
  }

  // Make room for at least one more byte.
  void reserve(this) {
    if (this.len < this.data.len()) { return; }
    i32 cap = this.data.len() * 2;
    u8[] next = u8[cap]();
    for (i32 i = 0; i < this.len; i++) {
      next[i] = this.data[i];
    }
    this.data = next;
  }

  void push(this, i32 v) {
    this.reserve();
    this.data[this.len] = v;
    this.len++;
  }

  // gzip and DEFLATE are little-endian throughout.
  void pushU16(this, i32 v) {
    this.push(v & 0xFF);
    this.push((v >>> 8) & 0xFF);
  }

  void pushU32(this, i32 v) {
    this.push(v & 0xFF);
    this.push((v >>> 8) & 0xFF);
    this.push((v >>> 16) & 0xFF);
    this.push((v >>> 24) & 0xFF);
  }

  // `start`, not `from` — `from` is a keyword (import ... from "...").
  void pushBytes(this, u8[] src, i32 start, i32 count) {
    for (i32 i = 0; i < count; i++) {
      this.push(src[start + i]);
    }
  }

  /**
   * Hand over the contents, avoiding the copy when the buffer is exactly full.
   *
   * The returned array is the buffer's own storage in that case, so the Buf must
   * not be used afterwards. That is why this is separate from `bytes()`: callers
   * that keep appending need the copy.
   */
  u8[] take(this) {
    if (this.len == this.data.len()) {
      return this.data;
    }
    return this.bytes();
  }

  // Exact-length copy — the internal array is over-allocated.
  u8[] bytes(const this) {
    u8[] out = u8[this.len]();
    for (i32 i = 0; i < this.len; i++) {
      out[i] = this.data[i];
    }
    return out;
  }
}
