// gzip container (RFC 1952) around DEFLATE stored blocks (RFC 1951 BTYPE=00).
//
// Stored blocks apply no compression at all — the output is slightly larger
// than the input. The point is that everything except the compressor is real:
// the header, the block framing, the CRC-32, the length trailer. `gunzip`
// accepts this output, which pins the container down before any Huffman work
// starts.

import { Buf } from "./buf.wac";
import { crc32 } from "./crc32.wac";
import { deflateFixed, deflateDynamic } from "./deflate.wac";

// A stored block's LEN field is 16 bits, so a block tops out at 65535 bytes.
// Longer input becomes several blocks, only the last of which is marked final.
// (wac has no top-level constants, so this is a function.)
i32 maxStored() { return 65535; }

void header(Buf out) {
  out.push(0x1F);        // magic
  out.push(0x8B);
  out.push(8);           // CM = 8, deflate
  out.push(0);           // FLG = 0, no name/comment/extra/hcrc
  out.pushU32(0);        // MTIME = 0, "no time available"
  out.push(0);           // XFL
  out.push(255);         // OS = 255, unknown
}

// One stored block: 3 header bits (BFINAL, BTYPE=00) then, because BTYPE=00
// aligns to a byte boundary, LEN / ~LEN and the raw bytes.
void storedBlock(Buf out, i8[] data, i32 start, i32 count, bool isFinal) {
  out.push(isFinal ? 1 : 0);
  out.pushU16(count);
  out.pushU16((~count) & 0xFFFF);
  out.pushBytes(data, start, count);
}

/**
 * Wrap a deflate stream in the gzip container.
 *
 * The CRC is a parameter rather than computed here, so a caller comparing several
 * block types checksums the payload once instead of once per attempt.
 */
i8[] container(i8[] body, i32 crc, i32 isize) {
  Buf out = Buf.create();
  header(out);
  out.pushBytes(body, 0, body.len());
  out.pushU32(crc);
  out.pushU32(isize);
  return out.bytes();
}

/**
 * Write the DEFLATE stored-block stream for `data` into `out`.
 *
 * Writes in place rather than returning a body, because a stored payload is the
 * whole input: handing it back for `container` to copy would walk every byte a
 * second time, which measurably halved stored-block throughput when this was
 * briefly written that way.
 */
void storedInto(Buf out, i8[] data) {
  i32 n = data.len();

  if (n == 0) {
    // Empty input still needs one final block, or the stream is truncated.
    storedBlock(out, data, 0, 0, true);
  }

  i32 pos = 0;
  while (pos < n) {
    i32 count = n - pos;
    if (count > maxStored()) { count = maxStored(); }
    storedBlock(out, data, pos, count, (pos + count) == n);
    pos += count;
  }
}

/** A complete stored-block gzip member, assembled in one pass. */
i8[] storedContainer(i8[] data, i32 crc) {
  Buf out = Buf.create();
  header(out);
  storedInto(out, data);
  out.pushU32(crc);
  out.pushU32(data.len());
  return out.bytes();
}

export i8[] gzipStored(i8[] data) {
  return storedContainer(data, crc32(data));
}

/** Same container, but the payload is a fixed-Huffman deflate stream. */
export i8[] gzipFixed(i8[] data) {
  return container(deflateFixed(data), crc32(data), data.len());
}

/** Same container, dynamic-Huffman payload. */
export i8[] gzipDynamic(i8[] data) {
  return container(deflateDynamic(data), crc32(data), data.len());
}

// Below this size a dynamic block's transmitted code table can cost more than it
// saves, so the alternatives are worth trying — and trying them is cheap when the
// input is this small.
i32 smallInput() { return 4096; }

/**
 * Compress and keep whichever block type came out smallest.
 *
 * Dynamic almost always wins, but not always: on incompressible input its code
 * header is pure overhead, and a stored block's 5 bytes per 64 KiB is the floor.
 * Trying all three costs three passes and guarantees the output is never larger
 * than stored — which is the property that matters, since expansion is the one
 * outcome a compressor should never produce.
 */
export i8[] gzipBest(i8[] data) {
  i32 crc = crc32(data);
  i32 n = data.len();

  i8[] best = container(deflateDynamic(data), crc, n);

  if (n <= smallInput()) {
    // Small enough that all three are worth pricing: a dynamic block's code table
    // is a fixed cost that a short payload cannot amortise.
    i8[] fixed = container(deflateFixed(data), crc, n);
    if (fixed.len() < best.len()) { best = fixed; }
    i8[] stored = storedContainer(data, crc);
    if (stored.len() < best.len()) { best = stored; }
    return best;
  }

  // Otherwise dynamic wins on anything compressible, and the only case it loses is
  // data that does not compress at all — where stored is the floor. Checking that
  // costs one comparison instead of two more compression passes.
  if (best.len() >= n) {
    i8[] stored = storedContainer(data, crc);
    if (stored.len() < best.len()) { return stored; }
  }
  return best;
}
