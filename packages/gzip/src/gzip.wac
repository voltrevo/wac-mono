// gzip container (RFC 1952) around DEFLATE stored blocks (RFC 1951 BTYPE=00).
//
// Stored blocks apply no compression at all — the output is slightly larger
// than the input. The point is that everything except the compressor is real:
// the header, the block framing, the CRC-32, the length trailer. `gunzip`
// accepts this output, which pins the container down before any Huffman work
// starts.

import { Buf } from "../../bytes/src/buf.wac";
import { Read } from core;
import { crc32, crc32Start, crc32Finish, crc32Update, crcTable8 } from "./crc32.wac";
import { deflateFixed, deflateDynamic, lz77Range, writeDynamicBlock, Tokens } from "./deflate.wac";
import { BitWriter } from "./bitwriter.wac";
import { Tables } from "./tables.wac";

// A stored block's LEN field is 16 bits, so a block tops out at 65535 bytes.
// Longer input becomes several blocks, only the last of which is marked final.
// (wac has no top-level constants, so this is a function.)
i32 maxStored() { return 65535; }

void header(Buf out) {
  out.push(0x1F);        // magic
  out.push(0x8B);
  out.push(8);           // CM = 8, deflate
  out.push(0);           // FLG = 0, no name/comment/extra/hcrc
  out.pushU32(0);        // MTIME = 0, "no time available"
  out.push(0);           // XFL
  out.push(255);         // OS = 255, unknown
}

// One stored block: 3 header bits (BFINAL, BTYPE=00) then, because BTYPE=00
// aligns to a byte boundary, LEN / ~LEN and the raw bytes.
void storedBlock(Buf out, u8[] data, i32 start, i32 count, bool isFinal) {
  out.push(isFinal ? 1 : 0);
  out.pushU16(count as@ u32);
  out.pushU16(((~count) & 0xFFFF) as@ u32);
  out.pushBytes(data, start, count);
}

/**
 * Wrap a deflate stream in the gzip container.
 *
 * The CRC is a parameter rather than computed here, so a caller comparing several
 * block types checksums the payload once instead of once per attempt.
 */
u8[] container(u8[] body, u32 crc, i32 isize) {
  Buf out = Buf.create();
  header(out);
  out.pushBytes(body, 0, body.len());
  out.pushU32(crc);
  out.pushU32(isize as@ u32);
  return out.bytes();
}

/**
 * Write the DEFLATE stored-block stream for `data` into `out`.
 *
 * Writes in place rather than returning a body, because a stored payload is the
 * whole input: handing it back for `container` to copy would walk every byte a
 * second time, which measurably halved stored-block throughput when it was
 * briefly written that way.
 */
void storedInto(Buf out, u8[] data) {
  i32 n = data.len();

  if (n == 0) {
    // Empty input still needs one final block, or the stream is truncated.
    storedBlock(out, data, 0, 0, true);
  }

  i32 pos = 0;
  while (pos < n) {
    i32 count = n - pos;
    if (count > maxStored()) { count = maxStored(); }
    storedBlock(out, data, pos, count, (pos + count) == n);
    pos += count;
  }
}

/** A complete stored-block gzip member, assembled in one pass. */
u8[] storedContainer(u8[] data, u32 crc) {
  Buf out = Buf.create();
  header(out);
  storedInto(out, data);
  out.pushU32(crc);
  out.pushU32(data.len() as@ u32);
  return out.bytes();
}

export u8[] gzipStored(u8[] data) {
  return storedContainer(data, crc32(data));
}

/** Same container, but the payload is a fixed-Huffman deflate stream. */
export u8[] gzipFixed(u8[] data) {
  return container(deflateFixed(data), crc32(data), data.len());
}

/** Same container, dynamic-Huffman payload. */
export u8[] gzipDynamic(u8[] data) {
  return container(deflateDynamic(data), crc32(data), data.len());
}

// Below this size a dynamic block's transmitted code table can cost more than it
// saves, so the alternatives are worth trying — and trying them is cheap when the
// input is this small.
i32 smallInput() { return 4096; }

/**
 * Compress and keep whichever block type came out smallest.
 *
 * Dynamic almost always wins, but not always: on incompressible input its code
 * header is pure overhead, and a stored block's 5 bytes per 64 KiB is the floor.
 * Trying all three costs three passes and guarantees the output is never larger
 * than stored — which is the property that matters, since expansion is the one
 * outcome a compressor should never produce.
 */
export u8[] gzipBest(u8[] data) {
  u32 crc = crc32(data);
  i32 n = data.len();

  u8[] best = container(deflateDynamic(data), crc, n);

  if (n <= smallInput()) {
    // Small enough that all three are worth pricing: a dynamic block's code table
    // is a fixed cost that a short payload cannot amortise.
    u8[] fixed = container(deflateFixed(data), crc, n);
    if (fixed.len() < best.len()) { best = fixed; }
    u8[] stored = storedContainer(data, crc);
    if (stored.len() < best.len()) { best = stored; }
    return best;
  }

  // Otherwise dynamic wins on anything compressible, and the only case it loses is
  // data that does not compress at all — where stored is the floor. Checking that
  // costs one comparison instead of two more compression passes.
  if (best.len() >= n) {
    u8[] stored = storedContainer(data, crc);
    if (stored.len() < best.len()) { return stored; }
  }
  return best;
}

// ── Streaming ─────────────────────────────────────────────────────────────────

/**
 * Fresh input compressed per block.
 *
 * The trade is ratio against memory, and it is not the block size that costs ratio — the
 * history below is carried across blocks, so matches still reach back 32 KiB regardless.
 * What a bigger figure buys is amortising the re-hash of that history: at ~128 KiB the
 * carried window is re-hashed once per four fresh windows.
 *
 * An exact multiple of `maxStored()` rather than a round power of two, so that a block that
 * comes out stored tiles into whole 64 KiB pieces with nothing left over. At 1 << 17 the
 * remaining two bytes need a third piece, and five bytes of framing with them — which is
 * how a stream ends up larger than the whole-input compressor on input that stores.
 *
 * Four pieces because both throughput and ratio improve with it and memory is what pays.
 * Measured on 1 MB of text, against 205 MB/s and 2458 bytes for the whole-input compressor:
 *
 * | chunk | MB/s | bytes | working set |
 * |---|---:|---:|---:|
 * | 1x | 94 | — | ~0.9 MB |
 * | 2x | 127 | 2553 | ~1.7 MB |
 * | **4x** | **134** | **2505** | **~3.4 MB** |
 * | 8x | 143 | 2473 | ~6.8 MB |
 *
 * The working set is about thirteen bytes per buffered byte, most of it the match chains and
 * the token arrays. Past 4x the returns flatten while the memory does not.
 */
i32 chunkBytes() { return 4 * maxStored(); }

/** History carried into the next block, which is as far as a back-reference can reach. */
i32 historyBytes() { return 32768; }

/**
 * Compress `read` into a gzip member and hand the bytes to `write` as they are produced.
 *
 * The streaming counterpart to `gzipDynamic`, and the mirror of `gunzipStream`. Input is
 * taken a chunk at a time, each chunk becomes one dynamic-Huffman block, and the last
 * 32 KiB of each chunk is carried into the next as history — so a match that spans a chunk
 * boundary is still found, and the output is what a whole-input pass would have produced
 * apart from the block boundaries themselves.
 *
 * Memory is bounded by `chunkBytes()` plus the history, not by the size of the input.
 *
 * Returns 0. Traps on nothing: any byte sequence is compressible.
 */
export i32 gzipStream(fn[Read()] read, fn[bool(u8[])] write) {
  BitWriter w = BitWriter.create();
  Tables t = Tables.create();
  header(w.out);

  u32[] table = crcTable8();
  u32 crc = crc32Start();
  i32 isize = 0;

  // The compression buffer: carried history first, then the fresh bytes after it.
  Buf buf = Buf.create();
  i32 history = 0;             // bytes of `buf` that are history rather than fresh input
  bool done = false;           // the source is spent
  bool broken = false;         // ...because it failed, not because it ended
  bool wroteFinal = false;     // the block with BFINAL set has been written

  while (!wroteFinal) {
    // Fill up to a chunk of fresh input. A short read is not end of input; only an empty
    // one is, so this keeps asking until there is enough or the source is spent.
    while (buf.len - history < chunkBytes() && !done) {
      // Three states, and `broken` is the one that used to be invisible: an empty answer meant
      // both "finished" and "the read failed", so a compressor over a dying disk produced a
      // *valid* gzip of half the input, with a CRC over half the input, and said nothing.
      match (read()) {
        case Data(bytes): {
          buf.pushAll(bytes);
          crc = crc32Update(table, crc, bytes);
          isize += bytes.len();
        }
        case End: { done = true; }
        case Failed(why): { done = true; broken = true; }
      }
    }

    // A read can overshoot — they arrive in whole pieces — so compress at most a chunk and
    // leave the rest for the next block. Letting it overshoot instead costs real bytes: a
    // block over a chunk boundary no longer tiles into whole stored pieces, and pays five
    // bytes of framing for the remnant.
    i32 fresh = buf.len - history;
    i32 take = fresh;
    if (take > chunkBytes()) { take = chunkBytes(); }
    bool last = done && take == fresh;

    // The buffer's own array, not a copy of it: `lz77Range` stops at `end`, so the bytes
    // past it — fresh input that has not been compressed yet, and whatever slack the buffer
    // is carrying — are simply not looked at.
    i32 end = history + take;
    u8[] region = buf.data;
    Tokens tok = lz77Range(region, t, history, end);

    // Which block type, decided by writing the dynamic one and measuring it.
    //
    // Expansion is the one outcome a compressor should never produce, and a dynamic block
    // over incompressible input is bigger than the input — the code table is pure overhead
    // and the literals cost more than eight bits each. `gzipBest` avoids that by trying
    // every block type over the whole input; a stream cannot look ahead, so it decides per
    // block instead, which is the same guarantee at a finer grain.
    //
    // Written into a scratch writer that *starts where the real one is*, which is what makes
    // this cost one encode rather than two. Bits are not bytes: a block written from a byte
    // boundary cannot be appended to a stream sitting three bits into a byte. Carrying the
    // pending bits into the scratch writer means its output is exactly what belongs at the
    // end of the real one, so a winning block is spliced across rather than re-encoded.
    // Doing it the obvious way — encode to measure, encode again to keep — measured 2.2x
    // slower than the whole-input compressor on text.
    BitWriter probe = BitWriter(Buf.create(), w.bitBuf, w.bitCount);
    writeDynamicBlock(probe, tok, t, last);

    if (storedCost(take) < probe.out.len) {
      storedBits(w, region, history, take, last);
    } else {
      w.out.pushBytes(probe.out.data, 0, probe.out.len);
      w.bitBuf = probe.bitBuf;
      w.bitCount = probe.bitCount;
    }
    wroteFinal = last;

    // Carry the tail of what was just compressed as the next block's history, and drop
    // everything older. Anything past `end` is fresh input that has not been compressed yet
    // and stays where it is.
    i32 keep = imin32(end, historyBytes());
    buf.dropFront(end - keep);
    history = keep;

    // Whole bytes only: the writer holds fewer than eight pending bits, so what is in its
    // buffer is always complete and safe to hand over mid-stream.
    if (w.out.len > 0) { write(w.out.take()); }
  }

  w.alignByte();
  w.out.pushU32(crc32Finish(crc));
  w.out.pushU32(isize as@ u32);
  write(w.out.take());
  // The archive is well-formed either way; `broken` is the difference between "this is your data
  // compressed" and "this is the first part of your data compressed".
  return broken ? 1 : 0;
}

i32 imin32(i32 a, i32 b) {
  if (a < b) { return a; }
  return b;
}

/** Bytes a stored block costs for `n` bytes of payload: five per piece, and never no piece. */
i32 storedCost(i32 n) {
  i32 pieces = (n + maxStored() - 1) / maxStored();
  if (pieces < 1) { pieces = 1; }
  return n + 5 * pieces;
}

/**
 * Stored blocks for `count` bytes of `data` at `start`, into a bit writer that may be
 * mid-byte.
 *
 * The byte-aligned `storedBlock` above cannot be used here: it writes its header as a whole
 * byte, which is only right at the start of a member. A stored block *is* byte-aligned, but
 * the three bits that introduce it are not — they go wherever the bit stream had got to.
 */
void storedBits(BitWriter w, u8[] data, i32 start, i32 count, bool isFinal) {
  i32 sent = 0;
  bool first = true;
  while (sent < count || first) {
    i32 piece = count - sent;
    if (piece > maxStored()) { piece = maxStored(); }
    bool last = isFinal && (sent + piece) == count;

    w.writeBits(last ? 1 : 0, 1);
    w.writeBits(0, 2);                  // BTYPE = 00, stored
    w.alignByte();                      // the payload is byte-aligned; the header bits are not
    w.out.pushU16(piece as@ u32);
    w.out.pushU16(((~piece) & 0xFFFF) as@ u32);
    w.out.pushBytes(data, start + sent, piece);

    sent += piece;
    first = false;
  }
}
