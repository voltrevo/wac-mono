// The wac parser, in wac. Port of wac/atoms/wac/wacParse.ts.
//
// Recursive descent over the token array the lexer produces, building the sum-type
// AST in ast.wac. Structured as a `P` struct threaded through every function, since
// wac has no closures to capture the position the way the reference does.
//
// The reference takes positions at very specific points — a binary node's position is
// its *operator*, a ternary's is the `?`, not the start of the condition — and this
// mirrors that exactly, because the differential test compares them. Where a `pos()`
// call looks oddly placed here, it is placed where the reference places it.
//
// Scope so far: types, the whole expression precedence ladder, and lvalues.
// Statements and declarations are next; `parseExprEntry` is the tested entry point
// until then.

import { Ty, TyKind, tyPrim, tyNamed, tyArr, tyNullable, tyFuncref,
  Expr, ExprKind, NamedArg, Lvalue, LvalueKind,
  Stmt, StmtKind, Case, Arm,
  Decl, DeclKind, Param, Field, Method, Variant, ImportItem, Program } from "./ast.wac";
import { tokenStride } from "./lex.wac";
import {
  kInt, kFloat, kString, kIdent, kEof, kTrue, kFalse, kNull, kVoid, kFn, kThis,
  kIs, kNot, kAs, kAsBang, kAsTilde, kAsAt,
  kConst, kExport, kIf, kElse, kWhile, kFor, kDo, kSwitch, kCase, kDefault,
  kReturn, kBreak, kContinue, kTrap, kStruct, kEnum, kMatch, kImport, kFrom,
  kOverride, kAssign,
  kPlusEq, kMinusEq, kStarEq, kSlashEq, kPercentEq,
  kAndEq, kOrEq, kCaretEq, kShlEq, kShrEq, kShrUEq,
  kPlus, kMinus, kStar, kSlash, kPercent, kEq, kNe,
  kLt, kLe, kGt, kGe, kAndAnd, kOrOr, kBang, kAnd, kOr, kCaret, kTilde,
  kShl, kShr, kShrU, kInc, kDec,
  kLparen, kRparen, kLbrace, kRbrace, kLbrack, kRbrack,
  kSemi, kColon, kComma, kDot, kQuestion,
} from "./kinds.wac";

/** Parse errors, as (code, line, col) triples like the lexer's. */
export i32 perrExpected()    { return 20; }
export i32 perrBadType()     { return 21; }
export i32 perrBadPrimary()  { return 22; }
export i32 perrBadLvalue()   { return 23; }
export i32 perrTopLevel()    { return 24; }
export i32 perrFieldName()   { return 25; }
export i32 perrMethodName()  { return 26; }
export i32 perrCtorBrace()   { return 27; }
export i32 perrFnArray()     { return 28; }

export struct P {
  u8[] src;
  i32[] toks;      // flat quintuples from lex
  i32 tokCount;
  i32 at;          // token index
  i32[] errors;    // (code, line, col) triples
  i32 errorCount;

  P create(u8[] src, i32[] toks, i32 tokCount) {
    return P(src, toks, tokCount, 0, i32[192](), 0);
  }

  // ── Token access ────────────────────────────────────────────────────────────
  //
  // Reading past the end yields the eof token rather than trapping, which is what
  // lets every lookahead below be written without a bounds check.

  i32 idx(const this, i32 offset) {
    i32 i = this.at + offset;
    if (i >= this.tokCount) { return this.tokCount - 1; }
    return i;
  }

  i32 kindAt(const this, i32 offset) {
    return this.toks[this.idx(offset) * tokenStride()];
  }
  i32 startAt(const this, i32 offset) {
    return this.toks[this.idx(offset) * tokenStride() + 1];
  }
  i32 lenAt(const this, i32 offset) {
    return this.toks[this.idx(offset) * tokenStride() + 2];
  }
  i32 lineAt(const this, i32 offset) {
    return this.toks[this.idx(offset) * tokenStride() + 3];
  }
  i32 colAt(const this, i32 offset) {
    return this.toks[this.idx(offset) * tokenStride() + 4];
  }

  /** Absolute token index — what the AST stores. */
  i32 abs(const this, i32 offset) { return this.idx(offset); }

  bool at1(const this, i32 kind) { return this.kindAt(0) == kind; }
  bool at2(const this, i32 kind, i32 offset) { return this.kindAt(offset) == kind; }

  /** Consume the current token, returning its absolute index. */
  i32 advance(this) {
    i32 i = this.at;
    if (this.at < this.tokCount - 1) { this.at++; }
    return i;
  }

  bool eat(this, i32 kind) {
    if (this.at1(kind)) { this.advance(); return true; }
    return false;
  }

  i32 expect(this, i32 kind) {
    if (this.at1(kind)) { return this.advance(); }
    this.fail(perrExpected());
    return this.at;
  }

  void fail(this, i32 code) {
    i32 slot = this.errorCount * 3;
    if (slot + 3 > this.errors.len()) { return; }
    this.errors[slot] = code;
    this.errors[slot + 1] = this.lineAt(0);
    this.errors[slot + 2] = this.colAt(0);
    this.errorCount++;
  }
}

// ── Growable lists ────────────────────────────────────────────────────────────
//
// One of these per element type, because there are no generics. They are identical
// but for the type name, and this is the clearest measurement of that gap in the
// repo so far: a parser needs a list of every AST node type it collects, and there
// is no way to write the pattern once. Scratch slots are nullable so an unwritten
// slot is null rather than a default-constructed node with an invalid tag.

struct ExprList {
  Expr?[] items;
  i32 n;

  ExprList create() { return ExprList(Expr?[4](), 0); }

  void push(this, Expr e) {
    if (this.n == this.items.len()) {
      Expr?[] next = Expr?[this.items.len() == 0 ? 4 : this.items.len() * 2]();
      for (i32 i = 0; i < this.n; i++) { next[i] = this.items[i]; }
      this.items = next;
    }
    this.items[this.n] = e;
    this.n++;
  }

  Expr[] take(const this) {
    // `Expr[n]()` would need `Expr` to have a default value, and anything reachable from an
    // enum has none. The first collected element serves as the fill; every slot is then
    // overwritten, so the sharing `fill:` implies is invisible here.
    if (this.n == 0) { return Expr[](); }
    Expr[] out = Expr[this.n](fill: this.items[0]!);
    for (i32 i = 1; i < this.n; i++) { out[i] = this.items[i]!; }
    return out;
  }
}

struct TyList {
  Ty?[] items;
  i32 n;

  TyList create() { return TyList(Ty?[4](), 0); }

  void push(this, Ty t) {
    if (this.n == this.items.len()) {
      Ty?[] next = Ty?[this.items.len() == 0 ? 4 : this.items.len() * 2]();
      for (i32 i = 0; i < this.n; i++) { next[i] = this.items[i]; }
      this.items = next;
    }
    this.items[this.n] = t;
    this.n++;
