// Internals tested in wac, asserting on the parsed tree directly.
//
// The host-side tests are the ones that matter for conformance — their oracle is
// the host's own JSON, which cannot exist inside wasm. But they can only ever
// observe bytes, because a JsonValue is a GC reference and bindgen marshals only
// primitives and primitive arrays. So everything they check about the tree is
// really a check on its re-serialization, and a bug that cancelled itself out
// between parse and stringify would pass.
//
// These reach the tree: kinds, member ordering, unescaped string contents and the
// growth of json's own ref-element containers. The shared byte buffer has its own
// tests in packages/bytes.

import { T } from "../../../wactest/src/assert.wac";
import { JsonValue, JsonNumber, JsonString, JsonArray, JsonObject, bytesEqual } from "../../src/value.wac";
import { Parser, parseDocument, hexDigit, scaleByPow10, ERR_NONE, ERR_TRAILING, ERR_CONTROL } from "../../src/parse.wac";

JsonValue? parseStr(string src) {
  // `string.toBytes()` replaced a 40-line ASCII lookup table here. The table
  // existed only because nothing converted text to bytes, and it could not
  // represent a non-ASCII character at all — which is what this test file needs
  // for a multi-byte key.
  Parser p = Parser.create(src.toBytes());
  return parseDocument(p);
}

// ── Small helpers ────────────────────────────────────────────────────────────

export string test_hex_digit() {
  T t = T.create();
  t.eqI32(hexDigit(0x30), 0, "'0'");
  t.eqI32(hexDigit(0x39), 9, "'9'");
  t.eqI32(hexDigit(0x61), 10, "'a'");
  t.eqI32(hexDigit(0x66), 15, "'f'");
  t.eqI32(hexDigit(0x41), 10, "'A'");
  t.eqI32(hexDigit(0x46), 15, "'F'");
  t.eqI32(hexDigit(0x67), -1, "'g' is not hex");
  t.eqI32(hexDigit(0x2F), -1, "'/' is not hex");
  t.eqI32(hexDigit(0x47), -1, "'G' is not hex");
  return t.report();
}

export string test_bytes_equal() {
  T t = T.create();
  t.isTrue(bytesEqual(u8[](1, 2, 3), u8[](1, 2, 3)), "identical");
  t.isTrue(bytesEqual(u8[0](), u8[0]()), "both empty");
  t.isFalse(bytesEqual(u8[](1, 2), u8[](1, 2, 3)), "prefix is not equal");
  t.isFalse(bytesEqual(u8[](1, 2, 3), u8[](1, 2, 4)), "last byte differs");
  t.isFalse(bytesEqual(u8[](1), u8[0]()), "one empty");
  return t.report();
}

export string test_scale_by_pow10() {
  T t = T.create();
  // No float assertion in wactest — with no float-to-string there is no way to
  // put the actual value in a message — so these compare through isTrue.
  t.isTrue(scaleByPow10(1.0, 0) == 1.0, "10^0 is identity");
  t.isTrue(scaleByPow10(1.5, 2) == 150.0, "1.5e2");
  t.isTrue(scaleByPow10(15.0, -1) == 1.5, "15e-1");
  t.isTrue(scaleByPow10(1.0, 22) == 1.0e22, "the largest exact power");
  t.isTrue(scaleByPow10(1.0, 23) == 1.0e23, "one past the exact table");
  t.isTrue(scaleByPow10(0.0, 999) == 0.0, "zero scales to zero, not NaN");
  t.isTrue(scaleByPow10(-0.0, 999) == 0.0, "negative zero likewise");
  t.isTrue(scaleByPow10(1.0, 400) > 1.0e300, "overflow goes to infinity");
  t.isTrue(scaleByPow10(1.0, -400) == 0.0, "underflow goes to zero");
  return t.report();
}

// ── Containers ───────────────────────────────────────────────────────────────

export string test_json_array_growth() {
  T t = T.create();
  JsonArray a = JsonArray.create();
  t.eqI32(a.len(), 0, "starts empty");
  for (i32 i = 0; i < 50; i++) {
    a.push(JsonNumber.of(1.0, u8[](0x31)));
  }
  t.eqI32(a.len(), 50, "length after 50 pushes");
  t.eqI32(a.at(0).kind, 2, "element kind survives growth");
  t.eqI32(a.at(49).kind, 2, "last element too");
  return t.report();
}

export string test_json_object_lookup() {
  T t = T.create();
  JsonObject o = JsonObject.create();
  o.push(u8[](0x61), JsonNumber.of(1.0, u8[](0x31)));           // a: 1
  o.push(u8[](0x62), JsonNumber.of(2.0, u8[](0x32)));           // b: 2
  t.eqI32(o.len(), 2, "two members");

  JsonValue? found = o.get(u8[](0x62));
  t.isTrue(found is not null, "b is found");
  t.eqI32(found!.kind, 2, "b is a number");

  t.isTrue(o.get(u8[](0x63)) is null, "c is absent");
  t.isTrue(o.get(u8[0]()) is null, "empty key is absent");

  // Duplicates are retained, and lookup returns the first.
  o.push(u8[](0x61), JsonNumber.of(9.0, u8[](0x39)));
  t.eqI32(o.len(), 3, "duplicate key is kept as a third member");
  JsonNumber first = o.get(u8[](0x61))! as! JsonNumber;
  t.isTrue(first.value == 1.0, "lookup returns the first of a duplicated key");
  return t.report();
}

// ── The tree the host tests cannot see ───────────────────────────────────────

export string test_tree_shape() {
  T t = T.create();
  JsonValue? v = parseStr("{\"a\":[1,true],\"b\":null}");
  t.isTrue(v is not null, "document parses");
  t.eqI32(v!.kind, 5, "root is an object");

  JsonObject o = v! as! JsonObject;
  t.eqI32(o.len(), 2, "two members");
  t.eqBytes(o.at(0).key, u8[](0x61), "first key is a");
  t.eqBytes(o.at(1).key, u8[](0x62), "second key is b");
  t.eqI32(o.at(1).value.kind, 0, "b is null");

  JsonArray arr = o.at(0).value as! JsonArray;
  t.eqI32(arr.len(), 2, "a has two elements");
  t.eqI32(arr.at(0).kind, 2, "first is a number");
  t.eqI32(arr.at(1).kind, 1, "second is a bool");
  return t.report();
}

export string test_string_accessors() {
  T t = T.create();
  JsonValue? v = parseStr("{\"name\":\"wac\",\"n\":1}");
  t.isTrue(v is not null, "parses");
  JsonObject o = v! as! JsonObject;

  // Lookup by a string key is what calling code actually has, and it must agree
  // with the byte-keyed form rather than being a separate code path.
  JsonValue? byStr = o.getStr("name");
  t.isTrue(byStr is not null, "getStr finds the member");
  t.eqStr((byStr! as! JsonString).str(), "wac", "and its value comes back as a string");
  JsonValue? byBytes = o.get(u8[]('n', 'a', 'm', 'e'));
  t.isTrue(byBytes is not null, "the byte-keyed form finds it too");
  t.isTrue(byStr! is byBytes!, "and both return the same object");

  t.isTrue(o.getStr("nope") is null, "a missing key is null");
  t.isTrue(o.getStr("") is null, "so is the empty key");
  // A prefix of a real key must not match — bytesEqual compares lengths first.
  t.isTrue(o.getStr("nam") is null, "a prefix does not match");
  t.eqStr(o.at(0).keyStr(), "name", "keyStr reads the member key");
  t.eqStr(o.at(1).keyStr(), "n", "including a one-character one");
  return t.report();
}

export string test_string_accessors_handle_utf8() {
  T t = T.create();
  // The interesting case for a byte/string boundary: a key and a value that are
  // multi-byte, plus one built from an escape rather than from literal bytes.
  JsonValue? v = parseStr("{\"日\":\"caf\\u00e9\"}");
  t.isTrue(v is not null, "parses");
  JsonObject o = v! as! JsonObject;
  t.eqStr(o.at(0).keyStr(), "日", "a multi-byte key round-trips");
  JsonValue? found = o.getStr("日");
  t.isTrue(found is not null, "and can be looked up by that string");
  t.eqStr((found! as! JsonString).str(), "café",
    "a value assembled from a \\u escape comes back as the right string");
  return t.report();
}

export string test_member_order_is_source_order() {
  T t = T.create();
  // The host cannot check this: JS hoists integer-like keys to the front of its
  // own output, so a re-serialized comparison would disagree for reasons that
  // have nothing to do with this parser.
  JsonValue? v = parseStr("{\"2\":0,\"b\":0,\"1\":0}");
  t.isTrue(v is not null, "parses");
  JsonObject o = v! as! JsonObject;
  t.eqBytes(o.at(0).key, u8[](0x32), "first key is 2");
  t.eqBytes(o.at(1).key, u8[](0x62), "second key is b");
  t.eqBytes(o.at(2).key, u8[](0x31), "third key is 1");
  return t.report();
}

export string test_unescaped_string_contents() {
  T t = T.create();
  JsonValue? v = parseStr("\"a\\u0041\\n\\\\b\"");
  t.isTrue(v is not null, "parses");
  JsonString s = v! as! JsonString;
  t.eqBytes(s.bytes, u8[]('a', 'A', '\n', '\\', 'b'), "escapes are decoded in place");
  return t.report();
}

export string test_surrogate_pair_decodes_to_one_scalar() {
  T t = T.create();
  JsonValue? v = parseStr("\"\\ud83d\\ude00\"");
  t.isTrue(v is not null, "parses");
  JsonString s = v! as! JsonString;
  t.eqBytes(s.bytes, u8[](0xF0, 0x9F, 0x98, 0x80), "pair becomes U+1F600");
  return t.report();
}

export string test_unpaired_surrogate_becomes_replacement() {
  T t = T.create();
  JsonValue? v = parseStr("\"\\ud83d\"");
  t.isTrue(v is not null, "parses");
  JsonString s = v! as! JsonString;
  t.eqBytes(s.bytes, u8[](0xEF, 0xBF, 0xBD), "lone high surrogate becomes U+FFFD");
  return t.report();
}

export string test_number_keeps_its_source_span() {
  T t = T.create();
  JsonValue? v = parseStr("[1e2,-0]");
  t.isTrue(v is not null, "parses");
  JsonArray a = v! as! JsonArray;
  JsonNumber n = a.at(0) as! JsonNumber;
  t.eqBytes(n.raw, u8[](0x31, 0x65, 0x32), "raw span is 1e2, not 100");
  t.isTrue(n.value == 100.0, "value is still 100");
  JsonNumber z = a.at(1) as! JsonNumber;
  t.eqBytes(z.raw, u8[](0x2D, 0x30), "negative zero keeps its sign in the span");
  return t.report();
}

export string test_error_codes_and_positions() {
  T t = T.create();

  Parser p1 = Parser.create("[1] junk".toBytes());
  t.isTrue(parseDocument(p1) is null, "trailing content fails");
  t.eqI32(p1.err, ERR_TRAILING(), "reported as trailing");
  t.eqI32(p1.errPos, 4, "position is where the junk starts");

  Parser p2 = Parser.create(u8[](0x22, 0x0A, 0x22));   // "\n" raw newline
  t.isTrue(parseDocument(p2) is null, "raw control byte fails");
  t.eqI32(p2.err, ERR_CONTROL(), "reported as a control byte");
  t.eqI32(p2.errPos, 1, "position is the control byte");

  Parser p3 = Parser.create("[1]".toBytes());
  t.isTrue(parseDocument(p3) is not null, "valid input succeeds");
  t.eqI32(p3.err, ERR_NONE(), "no error recorded");

  return t.report();
}
