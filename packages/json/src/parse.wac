// JSON parser (RFC 8259), byte-oriented.
//
// Input is UTF-8 bytes rather than `string` — see value.wac for why. That turns
// the scanner into comparisons on i32, which is what wac is good at.
//
// wac has no exceptions and no sum types, so errors travel as a code on the
// Parser plus a null return. Every parse entry point returns `T?`; null always
// means "check p.err".

import { JsonValue, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject, jsonNull } from "./value.wac";
import { ByteBuf } from "./bytes.wac";

export i32 ERR_NONE()         { return 0; }
export i32 ERR_UNEXPECTED()   { return 1; }  // wrong byte for the position
export i32 ERR_EOF()          { return 2; }  // ran out of input mid-value
export i32 ERR_NUMBER()       { return 3; }  // malformed number
export i32 ERR_STRING()       { return 4; }  // malformed string body
export i32 ERR_ESCAPE()       { return 5; }  // bad \ escape
export i32 ERR_CONTROL()      { return 6; }  // raw control byte in a string
export i32 ERR_TRAILING()     { return 7; }  // non-whitespace after the value
export i32 ERR_DEPTH()        { return 8; }  // nesting limit exceeded

// Bounded so a hostile input cannot exhaust the wasm stack. Real JSON is
// nowhere near this deep.
i32 MAX_DEPTH() { return 400; }

export struct Parser {
  u8[] src;
  i32 pos;
  i32 err;
  i32 errPos;
  i32 depth;

  Parser create(u8[] src) { return Parser(src, 0, 0, 0, 0); }

  // -1 rather than a bool+out-param: every caller compares against a byte
  // value anyway, and no real byte is negative.
  i32 peek(const this) {
    if (this.pos >= this.src.len()) { return -1; }
    return this.src[this.pos];
  }

  void fail(this, i32 code) {
    // Keep the first failure: it is the one nearest the actual mistake.
    if (this.err == 0) {
      this.err = code;
      this.errPos = this.pos;
    }
  }

  void skipWs(this) {
    while (this.pos < this.src.len()) {
      i32 c = this.src[this.pos];
      if (c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D) {
        this.pos++;
      } else {
        return;
      }
    }
  }

  // Match an ASCII keyword at the cursor without allocating.
  bool eatWord(this, u8[] word) {
    if (this.pos + word.len() > this.src.len()) { return false; }
    for (i32 i = 0; i < word.len(); i++) {
      if (this.src[this.pos + i] != word[i]) { return false; }
    }
    this.pos += word.len();
    return true;
  }

  JsonValue? parseValue(this) {
    if (this.depth >= MAX_DEPTH()) { this.fail(ERR_DEPTH()); return null; }
    i32 c = this.peek();
    if (c < 0) { this.fail(ERR_EOF()); return null; }

    switch (c) {
      case 0x7B: { return this.parseObject(); }        // {
      case 0x5B: { return this.parseArray(); }         // [
      case 0x22: {                                     // "
        u8[]? b = this.parseStringBytes();
        if (b is null) { return null; }
        return JsonString.of(b!);
      }
      case 0x74: {                                     // t
        if (this.eatWord(u8[](116, 114, 117, 101))) { return JsonBool.of(true); }
        this.fail(ERR_UNEXPECTED());
        return null;
      }
      case 0x66: {                                     // f
        if (this.eatWord(u8[](102, 97, 108, 115, 101))) { return JsonBool.of(false); }
        this.fail(ERR_UNEXPECTED());
        return null;
      }
      case 0x6E: {                                     // n
        if (this.eatWord(u8[](110, 117, 108, 108))) { return jsonNull(); }
        this.fail(ERR_UNEXPECTED());
        return null;
      }
      default: {
        if (c == 0x2D || (c >= 0x30 && c <= 0x39)) {   // '-' or digit
          return this.parseNumber();
        }
        this.fail(ERR_UNEXPECTED());
        return null;
      }
    }
  }

  JsonValue? parseArray(this) {
    this.pos++;                                        // consume [
    this.depth++;
    JsonArray arr = JsonArray.create();
    this.skipWs();
    if (this.peek() == 0x5D) {                         // ]
      this.pos++;
      this.depth--;
      return arr;
    }
    while (true) {
      this.skipWs();
      JsonValue? item = this.parseValue();
      if (item is null) { return null; }
      arr.push(item!);
      this.skipWs();
      i32 c = this.peek();
      if (c == 0x2C) { this.pos++; continue; }         // ,
      if (c == 0x5D) {                                 // ]
        this.pos++;
        this.depth--;
        return arr;
      }
      if (c < 0) { this.fail(ERR_EOF()); } else { this.fail(ERR_UNEXPECTED()); }
      return null;
    }
  }

  JsonValue? parseObject(this) {
    this.pos++;                                        // consume {
    this.depth++;
    JsonObject obj = JsonObject.create();
    this.skipWs();
    if (this.peek() == 0x7D) {                         // }
      this.pos++;
      this.depth--;
      return obj;
    }
    while (true) {
      this.skipWs();
      if (this.peek() != 0x22) {                       // "
        if (this.peek() < 0) { this.fail(ERR_EOF()); } else { this.fail(ERR_UNEXPECTED()); }
        return null;
      }
      u8[]? key = this.parseStringBytes();
      if (key is null) { return null; }
      this.skipWs();
      if (this.peek() != 0x3A) {                       // :
        if (this.peek() < 0) { this.fail(ERR_EOF()); } else { this.fail(ERR_UNEXPECTED()); }
        return null;
      }
      this.pos++;
      this.skipWs();
      JsonValue? v = this.parseValue();
      if (v is null) { return null; }
      obj.push(key!, v!);
      this.skipWs();
      i32 c = this.peek();
      if (c == 0x2C) { this.pos++; continue; }         // ,
      if (c == 0x7D) {                                 // }
        this.pos++;
        this.depth--;
        return obj;
      }
      if (c < 0) { this.fail(ERR_EOF()); } else { this.fail(ERR_UNEXPECTED()); }
      return null;
    }
  }

  // Returns the unescaped UTF-8 bytes of a string, cursor left after the
  // closing quote.
  u8[]? parseStringBytes(this) {
    this.pos++;                                        // consume opening "
    ByteBuf out = ByteBuf.create();
    while (true) {
      if (this.pos >= this.src.len()) { this.fail(ERR_EOF()); return null; }
      i32 c = this.src[this.pos];
      if (c == 0x22) {                                 // closing "
        this.pos++;
        return out.toBytes();
      }
      if (c == 0x5C) {                                 // backslash
        this.pos++;
        if (!this.readEscape(out)) { return null; }
        continue;
      }
      // RFC 8259: unescaped bytes below 0x20 are not allowed in a string.
      if (c < 0x20) { this.fail(ERR_CONTROL()); return null; }
      out.push(c);
      this.pos++;
    }
  }

  bool readEscape(this, ByteBuf out) {
    i32 e = this.peek();
    if (e < 0) { this.fail(ERR_EOF()); return false; }
    switch (e) {
      case 0x22: { out.push(0x22); this.pos++; return true; }   // \"
      case 0x5C: { out.push(0x5C); this.pos++; return true; }   // \\
      case 0x2F: { out.push(0x2F); this.pos++; return true; }   // \/
      case 0x62: { out.push(0x08); this.pos++; return true; }   // \b
      case 0x66: { out.push(0x0C); this.pos++; return true; }   // \f
      case 0x6E: { out.push(0x0A); this.pos++; return true; }   // \n
      case 0x72: { out.push(0x0D); this.pos++; return true; }   // \r
      case 0x74: { out.push(0x09); this.pos++; return true; }   // \t
      case 0x75: { return this.readUnicodeEscape(out); }        // \uXXXX
      default: { this.fail(ERR_ESCAPE()); return false; }
    }
  }

  // \uXXXX, joining a surrogate pair into one scalar. This is the routine that
  // cannot be written against the built-in `string` type at all: there is no
  // operation anywhere in wac that turns a codepoint into a character.
  bool readUnicodeEscape(this, ByteBuf out) {
    this.pos++;                                        // consume 'u'
    i32 hi = this.readHex4();
    if (hi < 0) { return false; }

    // Not a high surrogate — emit as-is, replacing a stray low surrogate.
    if (hi < 0xD800 || hi > 0xDBFF) {
      if (hi >= 0xDC00 && hi <= 0xDFFF) {
        out.pushCodepoint(0xFFFD);
      } else {
        out.pushCodepoint(hi);
      }
      return true;
    }

    // High surrogate: a following \uDC00-\uDFFF completes the pair. Anything
    // else leaves it unpaired, which has no UTF-8 form, so it becomes U+FFFD.
    if (this.pos + 1 < this.src.len()
        && this.src[this.pos] == 0x5C
        && this.src[this.pos + 1] == 0x75) {
      i32 save = this.pos;
      this.pos += 2;
      i32 lo = this.readHex4();
      if (lo < 0) { return false; }
      if (lo >= 0xDC00 && lo <= 0xDFFF) {
        i32 cp = 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00);
        out.pushCodepoint(cp);
        return true;
      }
      // Valid \u but not a low surrogate: the first is unpaired, and the
      // second still has to be emitted on its own terms.
      out.pushCodepoint(0xFFFD);
      this.pos = save;
      return true;
    }

    out.pushCodepoint(0xFFFD);
    return true;
  }

  // Four hex digits as a value, or -1 having recorded the failure.
  i32 readHex4(this) {
    if (this.pos + 4 > this.src.len()) { this.fail(ERR_EOF()); return -1; }
    i32 v = 0;
    for (i32 i = 0; i < 4; i++) {
      i32 d = hexDigit(this.src[this.pos + i]);
      if (d < 0) { this.fail(ERR_ESCAPE()); return -1; }
      v = (v << 4) | d;
    }
    this.pos += 4;
    return v;
  }

  // number = '-'? ('0' | [1-9][0-9]*) ('.' [0-9]+)? ([eE] [+-]? [0-9]+)?
  //
  // Significant digits accumulate into an i64 with a decimal exponent, then one
  // scaling gives the f64. Exact while the mantissa stays under 2^53 and the
  // exponent within the exactly-representable powers of ten; beyond that it is
  // correctly rounded only to within an ulp or so. A conformant strtod needs
  // wide-integer fallback, which is its own project.
  JsonValue? parseNumber(this) {
    i32 start = this.pos;
    bool neg = false;
    if (this.peek() == 0x2D) { neg = true; this.pos++; }   // -

    i64 mant = 0 as i64;
    i32 digits = 0;      // significant digits taken into mant
    i32 exp10 = 0;       // decimal point offset to apply to mant
    bool any = false;

    i32 c = this.peek();
    if (c == 0x30) {                                       // leading 0
      this.pos++;
      any = true;
      // A second digit after a leading zero is invalid JSON (01, 00).
      i32 n = this.peek();
      if (n >= 0x30 && n <= 0x39) { this.fail(ERR_NUMBER()); return null; }
    } else if (c >= 0x31 && c <= 0x39) {
      while (true) {
        i32 d = this.peek();
        if (d < 0x30 || d > 0x39) { break; }
        this.pos++;
        any = true;
        if (digits < 18) {
          mant = mant * (10 as i64) + ((d - 0x30) as i64);
          digits++;
        } else {
          // Past what an i64 holds without wrapping — 18 digits always fit, 19
          // sometimes do not, and wac wraps silently with no checked add. The
          // digit still moves the magnitude.
          exp10++;
        }
      }
    } else {
      this.fail(ERR_NUMBER());
      return null;
    }
    if (!any) { this.fail(ERR_NUMBER()); return null; }

    if (this.peek() == 0x2E) {                             // .
      this.pos++;
      i32 fracDigits = 0;
      while (true) {
        i32 d = this.peek();
        if (d < 0x30 || d > 0x39) { break; }
        this.pos++;
        fracDigits++;
        if (digits < 18) {
          mant = mant * (10 as i64) + ((d - 0x30) as i64);
          digits++;
          exp10--;
        }
        // Digits beyond 19 are below the f64's resolution; dropping them is
        // what rounding would do anyway.
      }
      if (fracDigits == 0) { this.fail(ERR_NUMBER()); return null; }
    }

    i32 e = this.peek();
    if (e == 0x65 || e == 0x45) {                          // e E
      this.pos++;
      bool expNeg = false;
      i32 s = this.peek();
      if (s == 0x2B) { this.pos++; }
      else if (s == 0x2D) { expNeg = true; this.pos++; }
      i32 expDigits = 0;
      i32 expVal = 0;
      while (true) {
        i32 d = this.peek();
        if (d < 0x30 || d > 0x39) { break; }
        this.pos++;
        expDigits++;
        // Clamp: past this the result is already 0 or infinity.
        if (expVal < 100000) { expVal = expVal * 10 + (d - 0x30); }
      }
      if (expDigits == 0) { this.fail(ERR_NUMBER()); return null; }
      if (expNeg) { exp10 -= expVal; } else { exp10 += expVal; }
    }

    f64 value = scaleByPow10(mant as~ f64, exp10);
    if (neg) { value = -value; }

    // Keep the source span: it lets the serializer round-trip a number without
    // a shortest-representation float formatter, which wac does not have.
    u8[] raw = u8[this.pos - start]();
    for (i32 i = 0; i < raw.len(); i++) {
      raw[i] = this.src[start + i];
    }
    return JsonNumber.of(value, raw);
  }
}

export i32 hexDigit(i32 b) {
  if (b >= 0x30 && b <= 0x39) { return b - 0x30; }        // 0-9
  if (b >= 0x61 && b <= 0x66) { return b - 0x61 + 10; }   // a-f
  if (b >= 0x41 && b <= 0x46) { return b - 0x41 + 10; }   // A-F
  return -1;
}

// 10^e applied to a mantissa.
//
// Powers up to 1e22 are exactly representable in an f64, so one multiply by a
// table entry is correctly rounded — that case is exact whenever the mantissa
// is also under 2^53. Past 1e22 the power is decomposed as 10^(22k + r) so the
// result costs three roundings rather than one per factor of 1e22.
//
// It is still not a correctly-rounded conversion. Being exact for every input
// needs either 128-bit intermediates (Eisel-Lemire) or a big-decimal fallback,
// and wac's widest integer is i64. See README for the measured error.
export f64 scaleByPow10(f64 m, i32 e) {
  if (e == 0) { return m; }
  // Zero scales to itself, and short-circuiting keeps 0 * infinity (NaN) out of
  // the overflow path for inputs like "0e999".
  if (m == 0.0) { return m; }

  if (e > 0) {
    if (e <= 22) { return m * pow10Exact(e); }
    i32 k = e / 22;
    i32 r = e % 22;
    return m * pow10Exact(r) * pow10Coarse(k);
  }

  i32 n = -e;
  if (n <= 22) { return m / pow10Exact(n); }
  i32 k2 = n / 22;
  i32 r2 = n % 22;
  return m / pow10Exact(r2) / pow10Coarse(k2);
}

// 10^(22k), correctly rounded, for the decomposition above. Beyond 10^308 the
// result is out of f64 range, and returning infinity lets the caller's multiply
// or divide produce the infinity or zero the input asked for.
f64 pow10Coarse(i32 k) {
  switch (k) {
    case 1:  { return 1.0e22; }
    case 2:  { return 1.0e44; }
    case 3:  { return 1.0e66; }
    case 4:  { return 1.0e88; }
    case 5:  { return 1.0e110; }
    case 6:  { return 1.0e132; }
    case 7:  { return 1.0e154; }
    case 8:  { return 1.0e176; }
    case 9:  { return 1.0e198; }
    case 10: { return 1.0e220; }
    case 11: { return 1.0e242; }
    case 12: { return 1.0e264; }
    case 13: { return 1.0e286; }
    case 14: { return 1.0e308; }
    default: { return 1.0 / 0.0; }
  }
}

// The exactly-representable powers of ten. A literal table because wac has no
// module-level constants to hold an f64[] and building one per call would
// allocate on every number parsed.
f64 pow10Exact(i32 n) {
  switch (n) {
    case 0:  { return 1.0; }
    case 1:  { return 10.0; }
    case 2:  { return 100.0; }
    case 3:  { return 1000.0; }
    case 4:  { return 10000.0; }
    case 5:  { return 100000.0; }
    case 6:  { return 1000000.0; }
    case 7:  { return 10000000.0; }
    case 8:  { return 100000000.0; }
    case 9:  { return 1000000000.0; }
    case 10: { return 1.0e10; }
    case 11: { return 1.0e11; }
    case 12: { return 1.0e12; }
    case 13: { return 1.0e13; }
    case 14: { return 1.0e14; }
    case 15: { return 1.0e15; }
    case 16: { return 1.0e16; }
    case 17: { return 1.0e17; }
    case 18: { return 1.0e18; }
    case 19: { return 1.0e19; }
    case 20: { return 1.0e20; }
    case 21: { return 1.0e21; }
    case 22: { return 1.0e22; }
    default: { trap; }
  }
}

// Parse a complete document: one value, optional surrounding whitespace,
// nothing else.
export JsonValue? parseDocument(Parser p) {
  p.skipWs();
  JsonValue? v = p.parseValue();
  if (v is null) { return null; }
  p.skipWs();
  if (p.pos < p.src.len()) {
    p.fail(ERR_TRAILING());
    return null;
  }
  return v;
}
