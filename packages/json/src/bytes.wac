// Growable byte buffer.
//
// The third growable container in this project, after JsonArray.items and
// JsonObject.members. All three are the same double-when-full logic; without
// generics they cannot be one type.
//
// It exists at all because `string` is immutable and `+` allocates, so building
// output by concatenation is quadratic. Bytes accumulate here instead.

export struct ByteBuf {
  i8[] data;
  i32 count;

  ByteBuf create() { return ByteBuf(i8[0](), 0); }

  ByteBuf withCapacity(i32 cap) { return ByteBuf(i8[cap](), 0); }

  i32 len(const this) { return this.count; }

  void reserve(this, i32 extra) {
    i32 need = this.count + extra;
    if (need <= this.data.len()) { return; }
    i32 next = this.data.len() * 2;
    if (next < 8) { next = 8; }
    while (next < need) { next = next * 2; }
    i8[] grown = i8[next]();
    for (i32 i = 0; i < this.count; i++) {
      grown[i] = this.data[i];
    }
    this.data = grown;
  }

  void push(this, i32 b) {
    this.reserve(1);
    this.data[this.count] = b;
    this.count++;
  }

  void pushBytes(this, i8[] src) {
    this.reserve(src.len());
    for (i32 i = 0; i < src.len(); i++) {
      this.data[this.count + i] = src[i];
    }
    this.count += src.len();
  }

  i32 at(const this, i32 i) {
    if (i < 0 || i >= this.count) { trap; }
    return this.data[i];
  }

  // Encode a Unicode scalar as UTF-8. Callers must have already resolved
  // surrogate pairs — a raw surrogate has no UTF-8 form.
  void pushCodepoint(this, i32 cp) {
    if (cp < 0x80) {
      this.push(cp);
    } else if (cp < 0x800) {
      this.push(0xC0 | (cp >> 6));
      this.push(0x80 | (cp & 0x3F));
    } else if (cp < 0x10000) {
      this.push(0xE0 | (cp >> 12));
      this.push(0x80 | ((cp >> 6) & 0x3F));
      this.push(0x80 | (cp & 0x3F));
    } else {
      this.push(0xF0 | (cp >> 18));
      this.push(0x80 | ((cp >> 12) & 0x3F));
      this.push(0x80 | ((cp >> 6) & 0x3F));
      this.push(0x80 | (cp & 0x3F));
    }
  }

  // Trim to exactly `count` bytes. Callers hand these out as owned values, so
  // the spare capacity must not come along.
  i8[] toBytes(const this) {
    i8[] out = i8[this.count]();
    for (i32 i = 0; i < this.count; i++) {
      out[i] = this.data[i];
    }
    return out;
  }
}
