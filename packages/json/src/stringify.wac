// Serializer: JSON value tree -> UTF-8 bytes.
//
// Numbers are written from the source span kept on JsonNumber rather than from
// its f64. That is not laziness about canonical form so much as necessity: wac
// has no float-to-string operation, so printing an f64 would mean implementing
// shortest-round-trip formatting (Ryu or Grisu) first.
//
// Dispatch is a switch on the kind tag followed by a downcast. With no virtual
// dispatch, this is the shape every fold over the tree has to take.

import { JsonValue, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject } from "./value.wac";
import { Buf } from "../../bytes/src/buf.wac";
import { writeF64 } from "../../fmt/src/ftoa.wac";

export void writeValue(Buf out, JsonValue v) {
  switch (v.kind) {
    case 0: {                                  // null
      out.pushAll(u8[]('n', 'u', 'l', 'l'));
    }
    case 1: {                                  // bool
      JsonBool b = v as! JsonBool;
      if (b.value) {
        out.pushAll(u8[]('t', 'r', 'u', 'e'));
      } else {
        out.pushAll(u8[]('f', 'a', 'l', 's', 'e'));
      }
    }
    case 2: {                                  // number
      JsonNumber n = v as! JsonNumber;
      // A parsed number is written back exactly as it was read; one built by hand
      // has no span and is formatted to its shortest round-tripping decimal.
      if (n.hasRaw()) {
        out.pushAll(n.raw);
      } else {
        writeF64(out, n.value);
      }
    }
    case 3: {                                  // string
      JsonString s = v as! JsonString;
      writeString(out, s.bytes);
    }
    case 4: {                                  // array
      JsonArray a = v as! JsonArray;
      out.push('[');
      for (i32 i = 0; i < a.len(); i++) {
        if (i > 0) { out.push(','); }
        writeValue(out, a.at(i));
      }
      out.push(']');
    }
    case 5: {                                  // object
      JsonObject o = v as! JsonObject;
      out.push('{');
      for (i32 i = 0; i < o.len(); i++) {
        if (i > 0) { out.push(','); }
        writeString(out, o.at(i).key);
        out.push(':');
        writeValue(out, o.at(i).value);
      }
      out.push('}');
    }
    default: { trap; }
  }
}

// Quote and escape a UTF-8 byte string. Only the characters JSON requires are
// escaped — quote, backslash, and anything below a space — so multi-byte UTF-8
// passes through untouched, which matches what JSON.stringify emits.
export void writeString(Buf out, u8[] bytes) {
  out.push('"');
  for (i32 i = 0; i < bytes.len(); i++) {
    i32 c = bytes[i];
    switch (c) {
      case '"':  { out.push('\\'); out.push('"'); }
      case '\\': { out.push('\\'); out.push('\\'); }
      // 0x08 and 0x0C stay numeric: wac has no \b or \f character escape.
      case 0x08: { out.push('\\'); out.push('b'); }
      case 0x0C: { out.push('\\'); out.push('f'); }
      case '\n': { out.push('\\'); out.push('n'); }
      case '\r': { out.push('\\'); out.push('r'); }
      case '\t': { out.push('\\'); out.push('t'); }
      default: {
        if (c < ' ') {
          writeUnicodeEscape(out, c);
        } else {
          out.push(c);
        }
      }
    }
  }
  out.push('"');
}

void writeUnicodeEscape(Buf out, i32 c) {
  out.push('\\');
  out.push('u');
  out.push(hexChar((c >> 12) & 0xF));
  out.push(hexChar((c >> 8) & 0xF));
  out.push(hexChar((c >> 4) & 0xF));
  out.push(hexChar(c & 0xF));
}

// Lowercase, matching JSON.stringify.
i32 hexChar(i32 nibble) {
  if (nibble < 10) { return '0' + nibble; }
  return 'a' + (nibble - 10);
}
