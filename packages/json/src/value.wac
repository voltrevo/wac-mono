// JSON value tree.
//
// A JSON value is the textbook tagged union, so it is an enum. It used to be a base
// struct with an `i32 kind`, a subtype per case, a `switch` on the tag and an `as!`
// downcast in every arm — four constructs standing in for one, and the compiler
// could not tell you when a fold forgot a case.
//
// Two things the enum cannot do, which shape what is below.
//
// Variants carry no methods, so the two growable cases keep their storage and
// growth in ordinary structs — `JsonArray` and `JsonObject` — and the variant holds
// one of those. That recursion runs enum -> struct -> array-of-enum and neither
// declaration precedes the other, which is `[§enum-recursive-via-struct]`.
//
// `match` is a statement rather than an expression, so a fold assigns into a local
// or returns from each arm rather than yielding a value.
//
// Strings are held as UTF-8 `u8[]`, not the built-in `string`. That began as a
// necessity and stays because bytes are right *inside* a parser: scanning is a
// `switch` over `i32`, and a document's strings accumulate in a buffer instead of
// allocating a `string` per token. The edge is where they become text —
// `JsonString.str()`, `JsonMember.keyStr()`, `JsonObject.getStr()`.

export enum JsonValue {
  Null,
  Bool(bool value),
  // `raw` holds the number exactly as it appeared in the source, and is empty for a
  // number that was never parsed. Keeping the span makes a round-trip byte-exact:
  // `1e2` comes back as `1e2` and `-0` keeps its sign, neither of which survives a
  // trip through the shortest decimal. With no span — a tree built by hand — the
  // serializer formats `value` with packages/fmt, which was written for this.
  Number(f64 value, u8[] raw),
  Str(u8[] bytes),
  Array(JsonArray items),
  Object(JsonObject members),
}

/** A number with no source span, to be formatted on output rather than copied. */
export JsonValue numberOf(f64 v) { return JsonValue.Number(v, u8[0]()); }

// Growable array of values. wac has no generics, so this and JsonObject's member
// list are the same double-when-full logic written twice, differing only in element
// type — the standing argument for generics, and the reason packages/bytes exists
// for the one case whose element type is fixed.
export struct JsonArray {
  JsonValue?[] items;
  i32 count;

  JsonArray create() { return JsonArray(JsonValue?[0](), 0); }

  void push(this, JsonValue v) {
    if (this.count == this.items.len()) {
      i32 next = this.items.len() * 2;
      if (next == 0) { next = 4; }
      JsonValue?[] grown = JsonValue?[next]();
      for (i32 i = 0; i < this.count; i++) {
        grown[i] = this.items[i];
      }
      this.items = grown;
    }
    this.items[this.count] = v;
    this.count++;
  }

  i32 len(const this) { return this.count; }

  JsonValue at(const this, i32 i) {
    if (i < 0 || i >= this.count) { trap; }
    return this.items[i]!;
  }
}

export struct JsonMember {
  const u8[] key;
  const JsonValue value;

  string keyStr(const this) { return string.fromBytes(this.key); }
}

export struct JsonObject {
  JsonMember?[] members;
  i32 count;

  JsonObject create() { return JsonObject(JsonMember?[0](), 0); }

  void push(this, u8[] key, JsonValue v) {
    if (this.count == this.members.len()) {
      i32 next = this.members.len() * 2;
      if (next == 0) { next = 4; }
      JsonMember?[] grown = JsonMember?[next]();
      for (i32 i = 0; i < this.count; i++) {
        grown[i] = this.members[i];
      }
      this.members = grown;
    }
    this.members[this.count] = JsonMember(key, v);
    this.count++;
  }

  i32 len(const this) { return this.count; }

  JsonMember at(const this, i32 i) {
    if (i < 0 || i >= this.count) { trap; }
    return this.members[i]!;
  }

  // Linear scan. A hash map would want generics over the value type; with none,
  // every JSON object lookup is O(n) until a string-keyed map is hand-written.
  JsonValue? get(const this, u8[] key) {
    for (i32 i = 0; i < this.count; i++) {
      JsonMember m = this.members[i]!;
      if (bytesEqual(m.key, key)) { return m.value; }
    }
    return null;
  }

  /**
   * Lookup by a `string` key, which is what calling code actually has.
   *
   * The conversion happens once, outside the loop — `key.toBytes()` allocates, so
   * doing it per member would make an O(n) scan an O(n)-allocation scan.
   */
  JsonValue? getStr(const this, string key) {
    return this.get(key.toBytes());
  }
}

export bool bytesEqual(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}
