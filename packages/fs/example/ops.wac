// The same filesystem operations against memory or against the host, so the two can be compared.
//
//   ops mem                 # everything in this program's own memory
//   ops host /tmp/whatever  # the host's filesystem, under that directory
//
// One operation per line on standard input, one line of answer each. The point is the *comparison*: the
// host is the oracle for what a filesystem does, and running the same script both ways turns "I think
// `rm` on a non-empty directory reports not-empty" into something a test can check against Deno.
//
// `test/host.test.ts` drives it. Keeping the script a text protocol rather than a wac test means the two
// runs share nothing but the bytes, which is the same reason `packages/wacc`'s rungs project both sides
// onto a printed form.

import { Cli, Core, FAULT_NONE } from "../../platform/src/platform.wac";
import { Fs } from "../src/fs.wac";
import { Sink } from "../../platform/src/stream.wac";
import { Vec } from "../../std/src/vec.wac";

export i32 main(Core core, Cli cli) {
  i32 n = cli.argCount().wait();
  if (n < 1) {
    core.warn("usage: ops mem | ops host <root>");
    return 2;
  }
  string kind = cli.arg(0).wait();
  string prefix = "";
  Fs fs = Fs.inMemory(0);
  if (kind == "host") {
    if (n < 2) {
      core.warn("ops host needs a root directory");
      return 2;
    }
    prefix = cli.arg(1).wait();
    fs = Fs.onHost(cli, 0);
  } else if (kind != "mem") {
    core.warn("ops: unknown backing '" + kind + "'");
    return 2;
  }

  Sink out = Sink.toOutput(cli);
  u8[] script = cli.readStdin().wait();
  Vec<string> lines = splitLines(string.fromBytes(script));
  for (i32 i = 0; i < lines.len(); i++) {
    string line = lines.get(i);
    if (line == "") { continue; }
    out.line(answer(fs, prefix, line));
  }
  out.flush();
  return 0;
}

/**
 * One operation, and what it answered.
 *
 * Faults are printed as their category number rather than their message, because the message is the
 * host's own words and the category is the thing both sides must agree on — the same reason the
 * differential tests for `mkdir` and `rm` compare GNU's reason rather than a runtime's errno text.
 */
string answer(Fs fs, string prefix, string line) {
  Vec<string> words = splitSpaces(line);
  string op = words.get(0);
  string a = words.len() > 1 ? prefix + words.get(1) : "";
  string b = words.len() > 2 ? prefix + words.get(2) : "";

  if (op == "write") {
    // The rest of the line is the content, so a file can hold a space.
    string body = words.len() > 2 ? rest(line, words.get(0).len() + 1 + words.get(1).len() + 1) : "";
    return "write " + itoa(fs.writeFile(a, body.toBytes()).fault);
  }
  if (op == "read") {
    if (!fs.readFile(a).ok) { return "read fault " + itoa(fs.readFile(a).fault); }
    return "read [" + string.fromBytes(fs.readFile(a).bytes) + "]";
  }
  if (op == "mkdir") { return "mkdir " + itoa(fs.mkdir(a, false).fault); }
  if (op == "mkdirp") { return "mkdirp " + itoa(fs.mkdir(a, true).fault); }
  if (op == "rm") { return "rm " + itoa(fs.remove(a, false).fault); }
  if (op == "rmr") { return "rmr " + itoa(fs.remove(a, true).fault); }
  if (op == "mv") { return "mv " + itoa(fs.rename(a, b).fault); }
  if (op == "stat") {
    if (!fs.stat(a).exists) { return "stat absent"; }
    // A *file's* size is a fact; a directory's is the host's block size — 4096 on the ext4 under this
    // container, and something else elsewhere. Imitating that number would be cargo-culting a detail no
    // program should read, so it is left out of the transcript rather than matched.
    if (fs.stat(a).isDir) { return "stat dir"; }
    return "stat file " + itoa(fs.stat(a).size as~ i32);
  }
  if (op == "ls") {
    string[]? names = fs.readDir(a);
    if (names is null) { return "ls absent"; }
    string joined = "";
    for (i32 i = 0; i < names!.len(); i++) {
      joined = joined + (i == 0 ? "" : " ") + names![i];
    }
    return "ls [" + joined + "]";
  }
  return "unknown " + op;
}

/** The line from `at` on. */
string rest(string line, i32 at) {
  if (at >= line.len()) { return ""; }
  return line.slice(at, line.len());
}

Vec<string> splitLines(string text) {
  Vec<string> out = Vec.create();
  i32 from = 0;
  for (i32 i = 0; i <= text.len(); i++) {
    bool end = i == text.len();
    if (!end && text.slice(i, i + 1) != "\n") { continue; }
    out.push(text.slice(from, i));
    from = i + 1;
  }
  return out;
}

Vec<string> splitSpaces(string text) {
  Vec<string> out = Vec.create();
  i32 from = 0;
  for (i32 i = 0; i <= text.len(); i++) {
    bool end = i == text.len();
    if (!end && text.slice(i, i + 1) != " ") { continue; }
    if (i > from) { out.push(text.slice(from, i)); }
    from = i + 1;
  }
  if (out.len() == 0) { out.push(""); }
  return out;
}

string itoa(i32 v) {
  if (v == 0) { return "0"; }
  string out = "";
  i32 x = v < 0 ? 0 - v : v;
  while (x > 0) {
    out = string.fromCodepoint('0' + (x % 10)) + out;
    x = x / 10;
  }
  return (v < 0 ? "-" : "") + out;
}
