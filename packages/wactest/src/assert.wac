// Assertions for tests written in wac.
//
// The shape is dictated by what wac provides. There is no top-level mutable
// state, so failures accumulate in a value the test owns and hands back. `trap`
// carries no message, so assertions record instead of trapping — which also means
// one test reports every failure rather than only the first.
//
// A test is an exported function returning `string`: empty means pass, anything
// else is the failure report. Nothing needs to know the test exists beyond that,
// because a runner can enumerate exports named `test*` from the compiled module's
// export list.
//
//   import { T } from "../../wactest/src/assert.wac";
//
//   export string test_adds() {
//     T t = T.create();
//     t.eqI32(2 + 2, 4, "two plus two");
//     return t.report();
//   }
//
// What this deliberately does not cover: anything needing an external oracle.
// Differential tests against another implementation, or interop with a real tool,
// cannot run inside wasm and belong in a host-side test.

import { itoa } from "../../fmt/src/itoa.wac";
import { itoa64 } from "./itoa64.wac";
import { utoa64 } from "./utoa64.wac";
import { ftoa } from "../../fmt/src/ftoa.wac";

// Decimal for a u32. itoa cannot serve: it takes an i32, and every value above
// 2147483647 would arrive as a negative. Unsigned `/` and `%` make this the
// obvious loop it looks like — with i32 the same code would go wrong at exactly
// the values that need it.
string utoa(u32 v) {
  if (v == 0) { return "0"; }
  string out = "";
  u32 n = v;
  while (n > 0) {
    out = itoa((n % 10) as@ i32) + out;
    n = n / 10;
  }
  return out;
}

export struct T {
  i32 failed;
  string messages;

  T create() {
    return T(0, "");
  }

  // ── Recording ───────────────────────────────────────────────────────────────

  /** Record a failure. Assertions funnel through here. */
  void fail(this, string what) {
    this.failed++;
    if (this.messages.len() > 0) {
      this.messages += "; ";
    }
    this.messages += what;
  }

  /** Fail unconditionally — for a branch that should be unreachable. */
  void failNow(this, string what) {
    this.fail(what);
  }

  // ── Assertions ──────────────────────────────────────────────────────────────

  void isTrue(this, bool cond, string what) {
    if (!cond) {
      this.fail(what + ": expected true");
    }
  }

  void isFalse(this, bool cond, string what) {
    if (cond) {
      this.fail(what + ": expected false");
    }
  }

  void eqI32(this, i32 got, i32 want, string what) {
    if (got != want) {
      this.fail(what + ": got " + itoa(got) + ", want " + itoa(want));
    }
  }

  // A u32 above i32's range would print as a negative through itoa, so it gets
  // its own formatter.
  void eqU32(this, u32 got, u32 want, string what) {
    if (got != want) {
      this.fail(what + ": got " + utoa64(got as u64) + ", want " + utoa64(want as u64));
    }
  }

  void neI32(this, i32 got, i32 unwanted, string what) {
    if (got == unwanted) {
      this.fail(what + ": got " + itoa(got) + ", wanted anything else");
    }
  }

  /**
   * Bit-exact float equality.
   *
   * Compared through the bits rather than `==` so that NaN equals NaN and -0.0 is
   * distinct from 0.0 — the two cases a float assertion most needs to pin down,
   * and the two that `==` gets wrong for this purpose. Use `nearF64` when a
   * tolerance is what you mean.
   */
  void eqF64(this, f64 got, f64 want, string what) {
    if (f64.toBits(got) != f64.toBits(want)) {
      this.fail(what + ": got " + ftoa(got) + ", want " + ftoa(want));
    }
  }

  void eqI64(this, i64 got, i64 want, string what) {
    if (got != want) {
      this.fail(what + ": got " + itoa64(got) + ", want " + itoa64(want));
    }
  }

  void eqU64(this, u64 got, u64 want, string what) {
    if (got != want) {
      this.fail(what + ": got " + utoa64(got) + ", want " + utoa64(want));
    }
  }

  /** Within `tol` of `want`, inclusive. NaN on either side always fails. */
  void nearF64(this, f64 got, f64 want, f64 tol, string what) {
    f64 diff = got - want;
    if (diff < 0.0) { diff = -diff; }
    // A NaN comparison is false either way, so this also rejects NaN.
    if (!(diff <= tol)) {
      this.fail(what + ": got " + ftoa(got) + ", want " + ftoa(want)
        + " within " + ftoa(tol));
    }
  }

  void eqStr(this, string got, string want, string what) {
    if (got != want) {
      this.fail(what + ": got \"" + got + "\", want \"" + want + "\"");
    }
  }

  /** Every element must match, and the lengths must agree. */
  void eqI32Array(this, i32[] got, i32[] want, string what) {
    if (got.len() != want.len()) {
      this.fail(what + ": length " + itoa(got.len()) + ", want " + itoa(want.len()));
      return;
    }
    for (i32 i = 0; i < got.len(); i++) {
      if (got[i] != want[i]) {
        this.fail(what + ": element " + itoa(i) + " is " + itoa(got[i])
          + ", want " + itoa(want[i]));
        return;   // one differing element is enough; the rest is noise
      }
    }
  }

  /** Same, for byte arrays. Reads are zero-extended, so these compare as 0..255. */
  void eqBytes(this, u8[] got, u8[] want, string what) {
    if (got.len() != want.len()) {
      this.fail(what + ": length " + itoa(got.len()) + ", want " + itoa(want.len()));
      return;
    }
    for (i32 i = 0; i < got.len(); i++) {
      if (got[i] != want[i]) {
        this.fail(what + ": byte " + itoa(i) + " is " + itoa(got[i])
          + ", want " + itoa(want[i]));
        return;
      }
    }
  }

  // ── Result ──────────────────────────────────────────────────────────────────

  /** Empty when everything passed, otherwise the accumulated failures. */
  string report(const this) {
    if (this.failed == 0) {
      return "";
    }
    return itoa(this.failed) + " failed: " + this.messages;
  }
}
