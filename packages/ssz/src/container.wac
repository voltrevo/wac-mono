// `hash_tree_root` for composite SSZ types, driven by a type descriptor rather than hand-written per
// container.
//
// A container's root is `merkleize([hash_tree_root(field) for each field], limit = field count)`, and
// its *serialization* interleaves fixed-size fields with 4-byte offsets pointing at the variable ones.
// So computing a root needs the type, not just the bytes — which is the whole difficulty, and why
// this file exists instead of nine hand-written functions.
//
// ## The descriptor
//
// A type is four `i32`s in a flat table, `stride 4`, so the whole thing crosses the JS boundary as an
// `i32[]` and needs no struct marshalling:
//
//     kind   one of the KIND_* below
//     param  basic: bytes. bitvector/bitlist: N. vector/list: length or limit
//     child  element type index, or index into `fields` of the first field
//     count  container: how many fields
//
// Recursive types are just indices into the same table, so `Vector[VarTestStruct, 2]` is one entry
// pointing at another. There is no cycle check because a descriptor is written by a caller, not
// parsed from input — a cyclic one is a bug in the caller, and SSZ has no recursive types.
//
// ## Where the bodies are buried
//
// **Offsets are relative to the container, not the message.** A nested container's fields are
// numbered from its own first byte, so every recursive call carries its own `start`.
//
// **The first offset is a checkable invariant.** It must equal the size of the fixed part, because
// that is where the variable part begins. A serialization claiming otherwise is malformed rather than
// unusual, and checking it costs one comparison — this is the class of bug that lets a decoder read a
// field's bytes from somewhere the encoder never put them.
//
// **A variable field's extent comes from the *next* offset**, not from any length prefix. The last
// one runs to the end of the container. Get that wrong and every root is right until a container has
// two variable fields.
//
// Progressive lists (`ProgressiveList`, `ProgressiveBitList`) are **not** handled. They merkleize
// under a different scheme, an Altair light client does not use them, and 100 of the vendored
// container cases are theirs — see the package README.

import { merkleize, mixInLength, padToChunks, chunkCount, rootBasic, rootBitvector,
         rootBitlist, rootBasicVector, rootBasicList } from "./merkle.wac";

export const i32 KIND_BASIC = 0;
export const i32 KIND_BITVECTOR = 1;
export const i32 KIND_BITLIST = 2;
export const i32 KIND_VECTOR = 3;
export const i32 KIND_LIST = 4;
export const i32 KIND_CONTAINER = 5;

const i32 STRIDE = 4;
const i32 CHUNK = 32;
/** An SSZ offset is a 4-byte little-endian uint32. */
const i32 OFFSET_BYTES = 4;

i32 kindOf(i32[] t, i32 i) { return t[i * STRIDE + 0]; }
i32 paramOf(i32[] t, i32 i) { return t[i * STRIDE + 1]; }
i32 childOf(i32[] t, i32 i) { return t[i * STRIDE + 2]; }
i32 countOf(i32[] t, i32 i) { return t[i * STRIDE + 3]; }

/**
 * Whether a type serializes to a length known from the type alone.
 *
 * This is what decides whether a field appears inline or behind an offset, so it is the hinge the
 * whole decoder turns on. A container is fixed only if *every* field is.
 */
export bool isFixed(i32[] t, i32[] fields, i32 i) {
  i32 k = kindOf(t, i);
  if (k == KIND_BASIC || k == KIND_BITVECTOR) { return true; }
  if (k == KIND_BITLIST || k == KIND_LIST) { return false; }
  if (k == KIND_VECTOR) { return isFixed(t, fields, childOf(t, i)); }
  for (i32 f = 0; f < countOf(t, i); f++) {
    if (!isFixed(t, fields, fields[childOf(t, i) + f])) { return false; }
  }
  return true;
}

/** The serialized size of a fixed type. Meaningless for a variable one; guard with `isFixed`. */
export i32 fixedSize(i32[] t, i32[] fields, i32 i) {
  i32 k = kindOf(t, i);
  if (k == KIND_BASIC) { return paramOf(t, i); }
  if (k == KIND_BITVECTOR) { return (paramOf(t, i) + 7) / 8; }
  if (k == KIND_VECTOR) { return paramOf(t, i) * fixedSize(t, fields, childOf(t, i)); }
  if (k == KIND_CONTAINER) {
    i32 total = 0;
    for (i32 f = 0; f < countOf(t, i); f++) {
      i32 ft = fields[childOf(t, i) + f];
      // A variable field occupies only its offset in the fixed part.
      total = total + (isFixed(t, fields, ft) ? fixedSize(t, fields, ft) : OFFSET_BYTES);
    }
    return total;
  }
  return 0;
}

/** How many chunks a full basic vector or list of `n` elements of `size` bytes occupies. */
i32 basicChunkLimit(i32 n, i32 size) { return chunkCount(n * size); }

u32 readOffset(u8[] d, i32 at) {
  u32 v = 0;
  for (i32 b = OFFSET_BYTES - 1; b >= 0; b--) { v = (v << 8) | (d[at + b] as@ u32); }
  return v;
}

/**
 * `hash_tree_root` of the value of type `i` occupying `data[start..end)`.
 *
 * Null for anything malformed — a span that does not match a fixed size, an offset outside the
 * container, offsets that go backwards, a bitlist without its delimiter. Those are refusals rather
 * than traps because this reads attacker-supplied bytes: a light client is handed a
 * `LightClientUpdate` by whoever it is talking to.
 */
export u8[]? rootAt(i32[] t, i32[] fields, i32 i, u8[] data, i32 start, i32 end) {
  if (start < 0 || end > data.len() || start > end) { return null; }
  i32 k = kindOf(t, i);
  i32 span = end - start;

  if (k == KIND_BASIC) {
    if (span != paramOf(t, i)) { return null; }
    return rootBasic(slice(data, start, end));
  }
  if (k == KIND_BITVECTOR) {
    if (span != (paramOf(t, i) + 7) / 8) { return null; }
    return rootBitvector(slice(data, start, end), paramOf(t, i));
  }
  if (k == KIND_BITLIST) {
    return rootBitlist(slice(data, start, end), paramOf(t, i));
  }

  if (k == KIND_VECTOR || k == KIND_LIST) {
    i32 elem = childOf(t, i);
    i32 limit = paramOf(t, i);
    bool isList = k == KIND_LIST;

    if (isFixed(t, fields, elem) && kindOf(t, elem) == KIND_BASIC) {
      // Basic elements are packed, so the bytes are already the chunks.
      i32 size = paramOf(t, elem);
      if (span % size != 0) { return null; }
      i32 n = span / size;
      // Delegated rather than reimplemented. These two lines were the same expressions as
      // `rootBasicList` and `rootBasicVector`, written out again — which mutation testing found by
      // gutting `rootBasicList` and nothing noticing, because nothing called it.
      if (isList) {
        if (n > limit) { return null; }
        return rootBasicList(slice(data, start, end), basicChunkLimit(limit, size), n);
      }
      if (n != limit) { return null; }
      return rootBasicVector(slice(data, start, end), basicChunkLimit(limit, size));
    }

    // Composite elements: one leaf per element, merkleized over the type's own length or limit.
    i32[]? bounds = elementBounds(t, fields, i, data, start, end);
    if (bounds is null) { return null; }
    i32 n = bounds!.len() - 1;
    if (isList && n > limit) { return null; }
    if (!isList && n != limit) { return null; }
    u8[] leaves = u8[n * CHUNK]();
    for (i32 e = 0; e < n; e++) {
      u8[]? r = rootAt(t, fields, elem, data, bounds![e], bounds![e + 1]);
      if (r is null) { return null; }
      for (i32 b = 0; b < CHUNK; b++) { leaves[e * CHUNK + b] = r![b]; }
    }
    u8[] root = merkleize(leaves, limit);
    return isList ? mixInLength(root, n) : root;
  }

  if (k != KIND_CONTAINER) { return null; }

  // ── A container ─────────────────────────────────────────────────────────────
  i32 nf = countOf(t, i);
  if (nf == 0) { return null; }               // SSZ has no empty containers
  i32 fixedPart = 0;
  for (i32 f = 0; f < nf; f++) {
    i32 ft = fields[childOf(t, i) + f];
    fixedPart = fixedPart + (isFixed(t, fields, ft) ? fixedSize(t, fields, ft) : OFFSET_BYTES);
  }
  if (span < fixedPart) { return null; }

  // Pass one: walk the fixed part, recording where each field's bytes are. A variable field's
  // extent is not known until the *next* offset is seen, so ends are filled in afterwards.
  i32[] begin = i32[nf]();
  i32[] finish = i32[nf]();
  i32 pos = start;
  i32 prevVar = -1;
  bool sawVar = false;
  for (i32 f = 0; f < nf; f++) {
    i32 ft = fields[childOf(t, i) + f];
    if (isFixed(t, fields, ft)) {
      i32 sz = fixedSize(t, fields, ft);
      begin[f] = pos;
      finish[f] = pos + sz;
      pos = pos + sz;
    } else {
      u32 off = readOffset(data, pos);
      i32 abs = start + (off as@ i32);
      if (off > (span as@ u32)) { return null; }            // points outside the container
      if (!sawVar) {
        // The variable part starts exactly where the fixed part ends. Anything else is malformed.
        if ((off as@ i32) != fixedPart) { return null; }
        sawVar = true;
      } else {
        // Against the previous variable field's *start*, not its provisional end — that end is still
        // the container's end and is exactly what this offset is about to narrow. Comparing with it
        // rejects every well-formed container that has two variable fields, which is how this was
        // found: `BitsStruct` offsets are 11 then 12, and 12 < 13 looked backwards.
        if (abs < begin[prevVar]) { return null; }
        finish[prevVar] = abs;
      }
      begin[f] = abs;
      finish[f] = end;                                      // provisional; the next offset narrows it
      prevVar = f;
      pos = pos + OFFSET_BYTES;
    }
  }
  // A container with no variable fields must be exactly its fixed size.
  if (!sawVar && span != fixedPart) { return null; }

  u8[] leaves = u8[nf * CHUNK]();
  for (i32 f = 0; f < nf; f++) {
    i32 ft = fields[childOf(t, i) + f];
    u8[]? r = rootAt(t, fields, ft, data, begin[f], finish[f]);
    if (r is null) { return null; }
    for (i32 b = 0; b < CHUNK; b++) { leaves[f * CHUNK + b] = r![b]; }
  }
  return merkleize(leaves, nf);
}

/**
 * Where each element of a vector or list of *composite* elements begins, as `n+1` boundaries.
 *
 * Fixed-size elements divide the span evenly. Variable-size ones are preceded by a table of offsets,
 * and the count is read from the first offset — `offsets[0] / 4` — since the table's own size is
 * exactly four bytes per element. That is the only place the element count comes from, so a first
 * offset that is not a multiple of four, or that overruns the span, means there is no valid count and
 * the value is refused.
 */
i32[]? elementBounds(i32[] t, i32[] fields, i32 i, u8[] data, i32 start, i32 end) {
  i32 elem = childOf(t, i);
  i32 span = end - start;
  if (isFixed(t, fields, elem)) {
    i32 sz = fixedSize(t, fields, elem);
    if (sz <= 0 || span % sz != 0) { return null; }
    i32 n = span / sz;
    i32[] b = i32[n + 1]();
    for (i32 e = 0; e <= n; e++) { b[e] = start + e * sz; }
    return b;
  }
  if (span == 0) {
    i32[] b = i32[1]();
    b[0] = start;
    return b;                                   // an empty list of variable elements
  }
  if (span < OFFSET_BYTES) { return null; }
  u32 first = readOffset(data, start);
  if (first == 0 || (first as@ i32) % OFFSET_BYTES != 0) { return null; }
  if ((first as@ i32) > span) { return null; }
  i32 n = (first as@ i32) / OFFSET_BYTES;
  i32[] b = i32[n + 1]();
  for (i32 e = 0; e < n; e++) {
    u32 off = readOffset(data, start + e * OFFSET_BYTES);
    if ((off as@ i32) > span) { return null; }
    b[e] = start + (off as@ i32);
    if (e > 0 && b[e] < b[e - 1]) { return null; }
  }
  b[n] = end;
  return b;
}

/** `data[from..to)`. */
u8[] slice(u8[] data, i32 from, i32 to) {
  i32 n = to - from;
  u8[] out = u8[(n > 0) ? n : 0]();
  for (i32 i = 0; i < n; i++) { out[i] = data[from + i]; }
  return out;
}

/** The whole value: `hash_tree_root` of type `root` over all of `data`. */
export u8[]? hashTreeRoot(i32[] t, i32[] fields, i32 root, u8[] data) {
  return rootAt(t, fields, root, data, 0, data.len());
}
