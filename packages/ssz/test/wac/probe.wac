// Every export of `packages/ssz` reachable from TypeScript, so the tests drive the real code.

import { hashPair, zeroHash, merkleize, mixInLength, padToChunks, chunkCount, nextPowerOfTwo,
         depthFor, rootBasic, rootBasicVector, rootBitvector, rootBitlist, rootBasicList,
         bitlistLength, floorLog2, subtreeIndex, isValidMerkleBranch,
         isValidNormalizedMerkleBranch } from "../../src/merkle.wac";
import { hashTreeRoot, isFixed, fixedSize } from "../../src/container.wac";
import { beaconTypes, beaconFields, TY_UINT8, TY_UINT64, TY_BYTES32, TY_BYTES48, TY_BYTES96,
         TY_PUBKEY_VECTOR, TY_SYNC_COMMITTEE_BITS, TY_SYNC_BRANCH, TY_FINALITY_BRANCH,
         TY_BEACON_BLOCK_HEADER, TY_SIGNING_DATA, TY_SYNC_COMMITTEE,
         TY_SYNC_AGGREGATE, TY_LIGHT_CLIENT_HEADER, TY_LIGHT_CLIENT_BOOTSTRAP,
         TY_LIGHT_CLIENT_UPDATE, TY_LIGHT_CLIENT_FINALITY_UPDATE,
         TY_LIGHT_CLIENT_OPTIMISTIC_UPDATE } from "../../src/beacon.wac";

export u8[] sszHashPair(u8[] a, u8[] b) { return hashPair(a, b); }
export u8[] sszZeroHash(i32 d) { return zeroHash(d); }
export u8[] sszMerkleize(u8[] data, i32 limit) { return merkleize(data, limit); }
export u8[] sszMixInLength(u8[] root, i32 n) { return mixInLength(root, n); }
export u8[] sszPadToChunks(u8[] d) { return padToChunks(d); }
export i32 sszChunkCount(i32 n) { return chunkCount(n); }
export i32 sszNextPowerOfTwo(i32 n) { return nextPowerOfTwo(n); }
export i32 sszDepthFor(i32 n) { return depthFor(n); }

export u8[] sszRootBasic(u8[] s) { return rootBasic(s); }
export u8[] sszRootBasicVector(u8[] s, i32 limit) { return rootBasicVector(s, limit); }
export u8[] sszRootBitvector(u8[] s, i32 n) { return rootBitvector(s, n); }
export u8[] sszRootBitlist(u8[] s, i32 limit) {
  u8[]? r = rootBitlist(s, limit);
  return (r is null) ? u8[0]() : r!;
}
export u8[] sszRootBasicList(u8[] s, i32 limit, i32 count) { return rootBasicList(s, limit, count); }
export i32 sszBitlistLength(u8[] s) { return bitlistLength(s); }

export i32 sszFloorLog2(i32 x) { return floorLog2(x as! u64); }
export i32 sszSubtreeIndex(i32 g) { return subtreeIndex(g as! u64) as! i32; }
export bool sszValidBranch(u8[] leaf, u8[] branch, i32 depth, i32 index, u8[] root) {
  return isValidMerkleBranch(leaf, branch, depth, index as! u64, root);
}
export bool sszValidNormalizedBranch(u8[] leaf, u8[] branch, i32 gindex, u8[] root) {
  return isValidNormalizedMerkleBranch(leaf, branch, gindex as! u64, root);
}

/** `hash_tree_root` over a flat type descriptor; empty when the value is refused. */
export u8[] sszHashTreeRoot(i32[] types, i32[] fields, i32 root, u8[] data) {
  u8[]? r = hashTreeRoot(types, fields, root, data);
  return (r is null) ? u8[0]() : r!;
}

export bool sszIsFixed(i32[] types, i32[] fields, i32 i) { return isFixed(types, fields, i); }
export i32 sszFixedSize(i32[] types, i32[] fields, i32 i) { return fixedSize(types, fields, i); }

/** `hash_tree_root` of a beacon type, named by index; empty when refused. */
export u8[] sszBeaconRoot(i32 ty, u8[] data) {
  u8[]? r = hashTreeRoot(beaconTypes(), beaconFields(), ty, data);
  return (r is null) ? u8[0]() : r!;
}

export i32 sszBeaconFixedSize(i32 ty) {
  return fixedSize(beaconTypes(), beaconFields(), ty);
}
export bool sszBeaconIsFixed(i32 ty) { return isFixed(beaconTypes(), beaconFields(), ty); }

/** The type index for each container name the fixtures use. */
export i32 sszTyFor(i32 which) {
  if (which == 0) { return TY_BEACON_BLOCK_HEADER(); }
  if (which == 1) { return TY_SIGNING_DATA(); }
  if (which == 2) { return TY_SYNC_COMMITTEE(); }
  if (which == 3) { return TY_SYNC_AGGREGATE(); }
  if (which == 4) { return TY_LIGHT_CLIENT_HEADER(); }
  if (which == 5) { return TY_LIGHT_CLIENT_BOOTSTRAP(); }
  if (which == 6) { return TY_LIGHT_CLIENT_UPDATE(); }
  if (which == 7) { return TY_LIGHT_CLIENT_FINALITY_UPDATE(); }
  return TY_LIGHT_CLIENT_OPTIMISTIC_UPDATE();
}

/**
 * Every `TY_*` accessor, by position, so each one is reachable from a test.
 *
 * They exist for `packages/lightclient` to name intermediate types with — a branch is
 * `Vector[Bytes32, N]` and a proof needs to say so — but until that exists they are exported and
 * uncalled, which a mutation sweep reported as eight uncovered functions. An index typed one out
 * would then have gone unnoticed until the light client misbehaved.
 */
export i32 sszTyAt(i32 which) {
  if (which == 0) { return TY_UINT8(); }
  if (which == 1) { return TY_UINT64(); }
  if (which == 2) { return TY_BYTES32(); }
  if (which == 3) { return TY_BYTES48(); }
  if (which == 4) { return TY_BYTES96(); }
  if (which == 5) { return TY_PUBKEY_VECTOR(); }
  if (which == 6) { return TY_SYNC_COMMITTEE_BITS(); }
  if (which == 7) { return TY_SYNC_BRANCH(); }
  return TY_FINALITY_BRANCH();
}

/** `kind, param, child, count` for a type, so a test can assert its shape rather than its index. */
export i32[] sszTypeRow(i32 ty) {
  i32[] t = beaconTypes();
  i32[] row = i32[4]();
  for (i32 i = 0; i < 4; i++) { row[i] = t[ty * 4 + i]; }
  return row;
}
