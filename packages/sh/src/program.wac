// External programs — or rather, what stands in for them.
//
// `packages/platform` cannot start a process (issue 0015), so this shell cannot run `/bin/ls`.
// Rather than pretend otherwise, external commands go through **one function**, `run`, backed
// today by a table of programs implemented here in wac.
//
// That single function is the point of this file. When the capability lands, `run` gains a branch
// that calls it and everything above — pipelines, redirections, exit statuses, `&&` — is already
// written against the same shape and does not change. The stubs then become what they should have
// been all along: a fallback for when the real program is absent.
//
// **The signature is the design decision.** Bytes in, bytes out, a status, and `found` to
// distinguish "ran and failed" from "no such command" — because a shell must report 127 for one
// and the program's own code for the other, and a single integer cannot say both.
//
// Capturing rather than streaming is the honest limitation of doing it this way: a stage runs to
// completion before the next begins, so `yes | head -1` does not terminate here where it does in
// bash. Real processes will not fix that on their own — it needs the shell to run stages
// concurrently, which needs more than one thread. Noted in the README rather than hidden.

import { Vec } from "../../std/src/vec.wac";
import { resolvePath } from "./path.wac";
import { Buf } from "../../bytes/src/buf.wac";
import { Cli, FileResult } from "../../platform/src/platform.wac";

export struct Output {
  u8[] out;
  u8[] err;
  i32 status;
  /** False when no program of that name exists, which the shell reports as 127. */
  bool found;

  Output ok(u8[] out) { return Output(out, u8[0](), 0, true); }
  Output fail(u8[] err, i32 status) { return Output(u8[0](), err, status, true); }
  Output missing() { return Output(u8[0](), u8[0](), 127, false); }
}

/**
 * Run an external program.
 *
 * The one place that knows external commands are not real processes. Everything above it is
 * written as though they were.
 */
export Output run(Cli cli, string cwd, Vec<string> argv, u8[] stdin) {
  if (argv.len() == 0) { return Output.missing(); }
  string name = argv.get(0);

  if (name == "cat") { return cat(cli, cwd, argv, stdin); }
  if (name == "wc") { return wc(argv, stdin); }
  if (name == "head") { return head(argv, stdin); }
  if (name == "tail") { return tail(argv, stdin); }
  if (name == "rev") { return rev(stdin); }
  if (name == "sort") { return sort(argv, stdin); }
  if (name == "uniq") { return uniq(stdin); }
  if (name == "grep") { return grep(argv, stdin); }
  if (name == "tr") { return tr(argv, stdin); }
  if (name == "seq") { return seq(argv); }
  if (name == "nl") { return nl(stdin); }
  if (name == "printf") { return printf(argv); }

  return Output.missing();
}

/** Every name `run` will answer to, so `help` and the tests do not have to guess. */
export Vec<string> names() {
  Vec<string> out = Vec.create();
  out.push("cat"); out.push("wc"); out.push("head"); out.push("tail"); out.push("rev");
  out.push("sort"); out.push("uniq"); out.push("grep"); out.push("tr"); out.push("seq");
  out.push("nl"); out.push("printf");
  return out;
}

// ── The programs ──────────────────────────────────────────────────────────────

/**
 * `printf FORMAT [ARGS]` — the only one of these with a language of its own.
 *
 * Three rules do most of the work and none of them is guessable:
 *
 *   **The format is reused until the arguments run out.** `printf "%s-%s\n" a b c d` prints two
 *   lines, not one. Only a format that actually consumed something repeats, or one with no
 *   conversions in it would loop for ever.
 *
 *   **A missing argument is not an error.** `printf "%s-%s\n" a` prints `a-` — the second
 *   conversion gets the empty string, and `%d` gets zero. That is what makes a format safe to
 *   write once and feed a variable number of values.
 *
 *   **A bad number is reported and then used anyway.** `printf "%d" abc` writes `0` to standard
 *   output, complains on standard error, and exits 1. All three, not one of them.
 *
 * A bad *format* is different from a bad argument: an unknown conversion character, or a `%` with
 * nothing after it, stops the whole thing. What was already produced still goes out — bash prints
 * the `ab` of `printf "ab%z"` and then gives up — so this is an abort, not a discard.
 *
 * Escapes are processed in the *format*, which is why `printf` is the way to emit a line with no
 * trailing newline and `echo` is not.
 */
Output printf(Vec<string> argv) {
  if (argv.len() < 2) {
    return Output.fail("printf: usage: printf format [arguments]\n".toBytes(), 2);
  }
  u8[] f = argv.get(1).toBytes();
  Buf out = Buf.create();
  Buf err = Buf.create();
  i32 status = 0;
  i32 arg = 2;
  bool again = true;
  bool fatal = false;

  while (again && !fatal) {
    again = false;
    i32 consumedThisPass = 0;
    i32 i = 0;
    while (i < f.len() && !fatal) {
      if (f[i] == 0x5c) { i = escapeInto(out, f, i); continue; }
      if (f[i] != 0x25) { out.push(f[i]); i++; continue; }

      i32 j = i + 1;
      if (j < f.len() && f[j] == 0x25) { out.push(0x25); i = j + 1; continue; }

      bool left = false;
      bool zero = false;
      while (j < f.len() && (f[j] == 0x2d || f[j] == 0x30)) {
        if (f[j] == 0x2d) { left = true; } else { zero = true; }
        j++;
      }
      i32 width = 0;
      while (j < f.len() && f[j] >= 0x30 && f[j] <= 0x39) { width = width * 10 + (f[j] - 0x30); j++; }
      i32 prec = -1;
      if (j < f.len() && f[j] == 0x2e) {
        j++;
        prec = 0;
        while (j < f.len() && f[j] >= 0x30 && f[j] <= 0x39) { prec = prec * 10 + (f[j] - 0x30); j++; }
      }
      // A `%` with nothing after it is a format error, not a literal `%`.
      if (j >= f.len()) {
        err.pushAll("printf: `%': missing format character\n".toBytes());
        status = 1;
        fatal = true;
        continue;
      }

      i32 conv = f[j];
      string a = arg < argv.len() ? argv.get(arg) : "";
      string text = "";
      bool numeric = false;
      bool known = true;

      if (conv == 0x73) {                                   // 's'
        text = (prec >= 0 && prec < a.len()) ? a.slice(0, prec) : a;
      } else if (conv == 0x63) {                            // 'c'
        text = a.len() > 0 ? a.slice(0, 1) : "";
      } else if (conv == 0x64 || conv == 0x69) {            // 'd', 'i'
        numeric = true;
        if (a != "" && !isNumber(a)) {
          err.pushAll(("printf: " + a + ": invalid number\n").toBytes());
          status = 1;
        }
        text = itoa(atoi(a));
      } else if (conv == 0x78 || conv == 0x58 || conv == 0x6f) {   // 'x', 'X', 'o'
        numeric = true;
        if (a != "" && !isNumber(a)) {
          err.pushAll(("printf: " + a + ": invalid number\n").toBytes());
          status = 1;
        }
        text = inBase(atoi(a), conv == 0x6f ? 8 : 16, conv == 0x58);
      } else {
        known = false;
      }

      if (!known) {
        err.pushAll(("printf: `%" + charFor(conv) + "': invalid format character\n").toBytes());
        status = 1;
        fatal = true;
        continue;
      }
      arg++;
      consumedThisPass++;
      // Zero-padding is a numeric thing: `%05s` pads with spaces, as it does in bash.
      padInto(out, text, width, left, zero && numeric);
      i = j + 1;
    }
    if (!fatal && consumedThisPass > 0 && arg < argv.len()) { again = true; }
  }
  return Output(out.take(), err.take(), status, true);
}

/** One backslash escape from the format, appended. Returns the index after it. */
i32 escapeInto(Buf out, u8[] f, i32 at) {
  if (at + 1 >= f.len()) { out.push(0x5c); return at + 1; }
  i32 c = f[at + 1];
  if (c == 0x6e) { out.push(10); return at + 2; }            // \n
  if (c == 0x74) { out.push(9); return at + 2; }             // \t
  if (c == 0x72) { out.push(13); return at + 2; }            // \r
  if (c == 0x5c) { out.push(0x5c); return at + 2; }          // \\
  if (c == 0x61) { out.push(7); return at + 2; }             // \a
  if (c == 0x62) { out.push(8); return at + 2; }             // \b
  if (c == 0x66) { out.push(12); return at + 2; }            // \f
  if (c == 0x76) { out.push(11); return at + 2; }            // \v
  if (c == 0x65) { out.push(27); return at + 2; }            // \e
  if (c == 0x78) {                                           // \xHH
    i32 p = at + 2;
    i32 v = 0;
    i32 n = 0;
    while (p < f.len() && n < 2 && hexValue(f[p]) >= 0) { v = v * 16 + hexValue(f[p]); p++; n++; }
    if (n == 0) { out.push(0x5c); out.push(0x78); return at + 2; }
    out.push(v);
    return p;
  }
  if (c >= 0x30 && c <= 0x37) {                              // \NNN, and \0NNN for the same thing
    i32 p = at + 1;
    if (f[p] == 0x30 && p + 1 < f.len() && f[p + 1] >= 0x30 && f[p + 1] <= 0x37) { p++; }
    i32 v = 0;
    i32 n = 0;
    while (p < f.len() && n < 3 && f[p] >= 0x30 && f[p] <= 0x37) { v = v * 8 + (f[p] - 0x30); p++; n++; }
    out.push(v & 0xFF);
    return p;
  }
  // Anything else keeps its backslash, as bash does — `\q` is two characters.
  out.push(0x5c);
  return at + 1;
}

i32 hexValue(i32 c) {
  if (c >= 0x30 && c <= 0x39) { return c - 0x30; }
  if (c >= 0x61 && c <= 0x66) { return c - 0x61 + 10; }
  if (c >= 0x41 && c <= 0x46) { return c - 0x41 + 10; }
  return -1;
}

/** Whether the whole string is a number, so `%d` can say so before using it as zero. */
bool isNumber(string s) {
  u8[] b = s.toBytes();
  i32 i = 0;
  if (i < b.len() && (b[i] == 0x2d || b[i] == 0x2b)) { i++; }
  if (i >= b.len()) { return false; }
  for (; i < b.len(); i++) {
    if (b[i] < 0x30 || b[i] > 0x39) { return false; }
  }
  return true;
}

/** A non-negative number in base 8 or 16. Negatives keep their sign rather than wrapping. */
string inBase(i32 v, i32 base, bool upper) {
  if (v == 0) { return "0"; }
  bool neg = v < 0;
  i32 n = neg ? 0 - v : v;
  string out = "";
  while (n > 0) {
    i32 d = n % base;
    i32 c = d < 10 ? 0x30 + d : (upper ? 0x41 + d - 10 : 0x61 + d - 10);
    out = charFor(c) + out;
    n = n / base;
  }
  return neg ? "-" + out : out;
}

string charFor(i32 c) {
  u8[] one = u8[1]();
  one[0] = c;
  return string.fromBytes(one);
}

/** `text` padded to `width`, on the right if `left`, with zeros if `zero`. */
void padInto(Buf out, string text, i32 width, bool left, bool zero) {
  i32 gap = width - text.len();
  if (gap <= 0) { out.pushAll(text.toBytes()); return; }
  if (left) {
    out.pushAll(text.toBytes());
    for (i32 i = 0; i < gap; i++) { out.push(32); }
    return;
  }
  // A zero-padded negative number keeps its sign in front of the zeros: `-007`, not `00-7`.
  u8[] b = text.toBytes();
  i32 from = 0;
  if (zero && b.len() > 0 && b[0] == 0x2d) { out.push(0x2d); from = 1; }
  for (i32 i = 0; i < gap; i++) { out.push(zero ? 0x30 : 32); }
  for (i32 i = from; i < b.len(); i++) { out.push(b[i]); }
}

Output cat(Cli cli, string cwd, Vec<string> argv, u8[] stdin) {
  if (argv.len() == 1) { return Output.ok(stdin); }
  Buf out = Buf.create();
  for (i32 i = 1; i < argv.len(); i++) {
    string path = argv.get(i);
    if (path == "-") { out.pushAll(stdin); continue; }
    // Through the shell's working directory, not the host's. `cat` is the only thing here that
    // opens a file, and it is the reason `run` takes a `cwd` at all: without it, `cd sub; cat f`
    // looked in whichever directory the process had started in.
    FileResult f = cli.readFile(resolvePath(cwd, path)).wait();
    if (!f.ok) {
      return Output.fail(("cat: " + path + ": " + f.error + "\n").toBytes(), 1);
    }
    out.pushAll(f.bytes);
  }
  return Output.ok(out.take());
}

Output wc(Vec<string> argv, u8[] stdin) {
  i32 lines = 0;
  i32 words = 0;
  bool inWord = false;
  for (i32 i = 0; i < stdin.len(); i++) {
    i32 c = stdin[i];
    if (c == 10) { lines++; }
    bool blank = c == 32 || c == 9 || c == 10;
    if (blank) { inWord = false; }
    else if (!inWord) { inWord = true; words++; }
  }

  bool wantLines = false;
  bool wantWords = false;
  bool wantBytes = false;
  for (i32 i = 1; i < argv.len(); i++) {
    string a = argv.get(i);
    if (a == "-l") { wantLines = true; }
    if (a == "-w") { wantWords = true; }
    if (a == "-c") { wantBytes = true; }
  }
  if (!wantLines && !wantWords && !wantBytes) {
    wantLines = true; wantWords = true; wantBytes = true;
  }

  // bash's wc pads its columns; this does not, and a test comparing the two must ask for one
  // count at a time. Said here because it is the sort of difference that looks like a bug.
  string s = "";
  if (wantLines) { s = s + itoa(lines); }
  if (wantWords) { s = (s == "" ? "" : s + " ") + itoa(words); }
  if (wantBytes) { s = (s == "" ? "" : s + " ") + itoa(stdin.len()); }
  return Output.ok((s + "\n").toBytes());
}

Output head(Vec<string> argv, u8[] stdin) {
  i32 n = countArg(argv, 10);
  return Output.ok(firstLines(stdin, n));
}

Output tail(Vec<string> argv, u8[] stdin) {
  i32 n = countArg(argv, 10);
  Vec<u8[]> lines = splitLines(stdin);
  Buf out = Buf.create();
  i32 from = lines.len() - n;
  if (from < 0) { from = 0; }
  for (i32 i = from; i < lines.len(); i++) {
    out.pushAll(lines.get(i));
    out.push(10);
  }
  return Output.ok(out.take());
}

Output rev(u8[] stdin) {
  Buf out = Buf.create();
  Vec<u8[]> lines = splitLines(stdin);
  for (i32 i = 0; i < lines.len(); i++) {
    u8[] line = lines.get(i);
    for (i32 j = line.len() - 1; j >= 0; j--) { out.push(line[j]); }
    out.push(10);
  }
  return Output.ok(out.take());
}

Output sort(Vec<string> argv, u8[] stdin) {
  bool reverse = false;
  for (i32 i = 1; i < argv.len(); i++) {
    if (argv.get(i) == "-r") { reverse = true; }
  }
  Vec<u8[]> lines = splitLines(stdin);
  // Insertion sort: the inputs here are a shell pipeline's worth, and a reader can check it.
  for (i32 i = 1; i < lines.len(); i++) {
    u8[] v = lines.get(i);
    i32 j = i - 1;
    while (j >= 0 && after(lines.get(j), v, reverse)) {
      lines.set(j + 1, lines.get(j));
      j--;
    }
    lines.set(j + 1, v);
  }
  Buf out = Buf.create();
  for (i32 i = 0; i < lines.len(); i++) {
    out.pushAll(lines.get(i));
    out.push(10);
  }
  return Output.ok(out.take());
}

Output uniq(u8[] stdin) {
  Vec<u8[]> lines = splitLines(stdin);
  Buf out = Buf.create();
  for (i32 i = 0; i < lines.len(); i++) {
    if (i > 0 && sameBytes(lines.get(i), lines.get(i - 1))) { continue; }
    out.pushAll(lines.get(i));
    out.push(10);
  }
  return Output.ok(out.take());
}

/** Substring matching, not a regex — `packages/regex` is the obvious next step and is not wired. */
Output grep(Vec<string> argv, u8[] stdin) {
  bool invert = false;
  string pattern = "";
  for (i32 i = 1; i < argv.len(); i++) {
    string a = argv.get(i);
    if (a == "-v") { invert = true; continue; }
    if (pattern == "") { pattern = a; }
  }
  if (pattern == "") { return Output.fail("grep: no pattern\n".toBytes(), 2); }

  u8[] needle = pattern.toBytes();
  Vec<u8[]> lines = splitLines(stdin);
  Buf out = Buf.create();
  i32 hits = 0;
  for (i32 i = 0; i < lines.len(); i++) {
    bool hit = contains(lines.get(i), needle);
    if (hit != invert) {
      out.pushAll(lines.get(i));
      out.push(10);
      hits++;
    }
  }
  // grep's exit status is its answer, not an error: 1 means "no lines matched", which is what
  // makes `grep x f && echo found` work.
  return Output(out.take(), u8[0](), hits > 0 ? 0 : 1, true);
}

Output tr(Vec<string> argv, u8[] stdin) {
  // `--` ends the options, which is the only way to pass a set that begins with a `-`.
  i32 first = 1;
  if (argv.len() > 1 && argv.get(1) == "--") { first = 2; }
  // 1, not the 2 most usage errors use: the real `tr` exits 1 and it is the oracle here.
  if (argv.len() < first + 2) { return Output.fail("tr: needs two sets\n".toBytes(), 1); }

  u8[] set1 = argv.get(first).toBytes();
  u8[] set2 = argv.get(first + 1).toBytes();

  // Two refusals the real one makes, both worth copying because both are silent otherwise. A
  // descending range is far more likely to be a transposition than an intention, and an empty
  // second set with a non-empty first has no answer that is not a guess.
  if (descendingRange(set1) || descendingRange(set2)) {
    return Output.fail("tr: range-endpoints are in reverse collating sequence order\n".toBytes(), 1);
  }
  if (set1.len() > 0 && set2.len() == 0) {
    return Output.fail("tr: when not truncating set1, string2 must be non-empty\n".toBytes(), 1);
  }

  // Ranges next, or `a-z` is the three-character set `{a, -, z}` and the commonest use of `tr`
  // in existence silently does almost nothing — issue 0019, which is exactly what happened.
  u8[] from = expandSet(set1);
  u8[] to = expandSet(set2);

  // A 256-entry table, so the inner work is one lookup per byte rather than a scan of the set.
  // With ranges expanded the sets are large enough for that to be the difference.
  u8[] map = u8[256](fill: 0);
  for (i32 i = 0; i < 256; i++) { map[i] = i; }
  for (i32 i = 0; i < from.len(); i++) {
    // A short second set repeats its last character, as tr does. An *empty* one translates
    // nothing, which is why this cannot just index `to`.
    if (to.len() > 0) { map[from[i]] = i < to.len() ? to[i] : to[to.len() - 1]; }
  }

  u8[] out = u8[stdin.len()]();
  for (i32 i = 0; i < stdin.len(); i++) { out[i] = map[stdin[i]]; }
  return Output.ok(out);
}

/**
 * `a-z` becomes the twenty-six bytes it names; everything else is itself.
 *
 * A `-` that cannot begin a range — first, last, or with a descending pair around it — is an
 * ordinary character, which is what makes `tr -d` and `tr a-` mean anything at all.
 */
u8[] expandSet(u8[] set) {
  i32 n = 0;
  for (i32 i = 0; i < set.len(); i++) {
    if (isRangeAt(set, i)) { n = n + (set[i + 2] - set[i] + 1); i += 2; }
    else { n++; }
  }
  u8[] out = u8[n](fill: 0);
  i32 at = 0;
  for (i32 i = 0; i < set.len(); i++) {
    if (isRangeAt(set, i)) {
      for (i32 c = set[i]; c <= set[i + 2]; c++) { out[at] = c; at++; }
      i += 2;
    } else {
      out[at] = set[i];
      at++;
    }
  }
  return out;
}

bool isRangeAt(u8[] set, i32 i) {
  return i + 2 < set.len() && set[i + 1] == '-' && set[i + 2] >= set[i];
}

/** Whether the set contains an `x-y` with y below x, which the real `tr` refuses outright. */
bool descendingRange(u8[] set) {
  for (i32 i = 0; i + 2 < set.len(); i++) {
    if (set[i + 1] == '-' && set[i + 2] < set[i]) { return true; }
  }
  return false;
}

Output seq(Vec<string> argv) {
  i32 from = 1;
  i32 to = 0;
  if (argv.len() == 2) { to = atoi(argv.get(1)); }
  else if (argv.len() >= 3) { from = atoi(argv.get(1)); to = atoi(argv.get(2)); }
  else { return Output.fail("seq: needs a count\n".toBytes(), 2); }

  Buf out = Buf.create();
  for (i32 i = from; i <= to; i++) {
    out.pushAll(itoa(i).toBytes());
    out.push(10);
  }
  return Output.ok(out.take());
}

Output nl(u8[] stdin) {
  Vec<u8[]> lines = splitLines(stdin);
  Buf out = Buf.create();
  for (i32 i = 0; i < lines.len(); i++) {
    // GNU `nl` right-aligns the number in six columns and then a tab. Matched exactly so this can
    // be compared against the real one rather than only against itself.
    string num = itoa(i + 1);
    string pad = "";
    for (i32 j = num.len(); j < 6; j++) { pad = pad + " "; }
    out.pushAll((pad + num + "\t").toBytes());
    out.pushAll(lines.get(i));
    out.push(10);
  }
  return Output.ok(out.take());
}

// ── Shared ────────────────────────────────────────────────────────────────────

/**
 * Split into lines, dropping a single trailing newline.
 *
 * Text with a final newline and text without it must produce the same lines, or every filter in a
 * pipeline gains or loses a blank line at the end depending on what fed it.
 */
Vec<u8[]> splitLines(u8[] data) {
  Vec<u8[]> out = Vec.create();
  i32 start = 0;
  for (i32 i = 0; i < data.len(); i++) {
    if (data[i] == 10) {
      out.push(sliceOf(data, start, i));
      start = i + 1;
    }
  }
  if (start < data.len()) { out.push(sliceOf(data, start, data.len())); }
  return out;
}

u8[] firstLines(u8[] data, i32 n) {
  Buf out = Buf.create();
  i32 seen = 0;
  i32 start = 0;
  for (i32 i = 0; i < data.len() && seen < n; i++) {
    if (data[i] == 10) {
      out.pushBytes(data, start, i - start + 1);
      start = i + 1;
      seen++;
    }
  }
  if (seen < n && start < data.len()) {
    out.pushBytes(data, start, data.len() - start);
    out.push(10);
  }
  return out.take();
}

/**
 * How many lines `head` and `tail` were asked for: `-n N`, or the traditional `-N`.
 *
 * Both, because GNU accepts both and `head -2` is the form people type — it is in this repo's own
 * documentation and in `packages/box`'s usage line. Only `-n N` was read here, so `seq 1 5 | head -2`
 * printed all five lines: a flag ignored rather than refused, which is the failure mode that looks like
 * the program working. Found by running the differential corpus through the Node build and noticing that
 * *both* builds disagreed with bash — the corpus had no `-N` case in it, so nothing had ever asked.
 *
 * A digit is what distinguishes the count from a flag. `-n` is not a count and neither is `-r`; only
 * `-` followed by digits is, which is exactly what GNU accepts — and that is the same thing as being
 * spelled like a negative number, which `isNumber` already answers.
 */
i32 countArg(Vec<string> argv, i32 fallback) {
  for (i32 i = 1; i < argv.len(); i++) {
    string a = argv.get(i);
    if (a == "-n" && i + 1 < argv.len()) { return atoi(argv.get(i + 1)); }
    // `-2` reads as -2, so the count is its negation. `-` alone is not a number, and `-n` is not
    // either, so neither reaches here.
    if (a.len() > 1 && a.slice(0, 1) == "-" && isNumber(a)) { return -atoi(a); }
  }
  return fallback;
}

bool after(u8[] a, u8[] b, bool reverse) {
  i32 c = compare(a, b);
  return reverse ? c < 0 : c > 0;
}

i32 compare(u8[] a, u8[] b) {
  i32 n = a.len() < b.len() ? a.len() : b.len();
  for (i32 i = 0; i < n; i++) {
    if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1; }
  }
  if (a.len() == b.len()) { return 0; }
  return a.len() < b.len() ? -1 : 1;
}

bool contains(u8[] haystack, u8[] needle) {
  if (needle.len() == 0) { return true; }
  if (needle.len() > haystack.len()) { return false; }
  for (i32 i = 0; i + needle.len() <= haystack.len(); i++) {
    bool hit = true;
    for (i32 j = 0; j < needle.len(); j++) {
      if (haystack[i + j] != needle[j]) { hit = false; break; }
    }
    if (hit) { return true; }
  }
  return false;
}

bool sameBytes(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

u8[] sliceOf(u8[] s, i32 from, i32 to) {
  if (to <= from) { return u8[0](); }
  u8[] out = u8[to - from]();
  out.copyFrom(s, from, 0, to - from);
  return out;
}

export string itoa(i32 v) {
  if (v == 0) { return "0"; }
  bool negative = v < 0;
  i32 x = negative ? -v : v;
  string out = "";
  while (x > 0) {
    out = string.fromCodepoint(0x30 + (x % 10)) + out;
    x = x / 10;
  }
  return negative ? "-" + out : out;
}

export i32 atoi(string s) {
  i32 v = 0;
  bool negative = false;
  i32 start = 0;
  if (s.len() > 0 && s.slice(0, 1) == "-") { negative = true; start = 1; }
  for (i32 i = start; i < s.len(); i++) {
    u8[] b = s.slice(i, i + 1).toBytes();
    if (b.len() != 1 || b[0] < 0x30 || b[0] > 0x39) { return 0; }
    v = v * 10 + (b[0] - 0x30);
  }
  return negative ? -v : v;
}
