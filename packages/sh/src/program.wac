// External programs — or rather, what stands in for them.
//
// `packages/platform` cannot start a process (issue 0015), so this shell cannot run `/bin/ls`.
// Rather than pretend otherwise, external commands go through **one function**, `run`, backed
// today by a table of programs implemented here in wac.
//
// That single function is the point of this file. When the capability lands, `run` gains a branch
// that calls it and everything above — pipelines, redirections, exit statuses, `&&` — is already
// written against the same shape and does not change. The stubs then become what they should have
// been all along: a fallback for when the real program is absent.
//
// **The signature is the design decision.** Bytes in, bytes out, a status, and `found` to
// distinguish "ran and failed" from "no such command" — because a shell must report 127 for one
// and the program's own code for the other, and a single integer cannot say both.
//
// Capturing rather than streaming is the honest limitation of doing it this way: a stage runs to
// completion before the next begins, so `yes | head -1` does not terminate here where it does in
// bash. Real processes will not fix that on their own — it needs the shell to run stages
// concurrently, which needs more than one thread. Noted in the README rather than hidden.

import { Vec } from "../../std/src/vec.wac";
import { resolvePath } from "./path.wac";
import { Buf } from "../../bytes/src/buf.wac";
import { Cli, FAULT_DENIED, FAULT_NOT_EMPTY, FAULT_NOT_FOUND, FAULT_NOT_REPRESENTABLE,
  FileResult }
  from "../../platform/src/platform.wac";
import { Feed, Line, Lines, Sink, emitTo, nextLine } from "../../platform/src/stream.wac";
// One implementation of each, in the package whose job it is. This file had its own `itoa` and
// `atoi`: the `itoa` answered `"-"` for i32's minimum, because negating it wraps back to itself and
// the digit loop never ran — so `echo $((-2147483648))` printed a bare minus sign where bash prints
// the number. Three other copies existed, and the correct one was already in `fmt`. wac-mono 0072.
import { atoi, itoa, itoa64 } from "../../fmt/src/itoa.wac";

export struct Output {
  u8[] out;
  u8[] err;
  i32 status;
  /** False when no program of that name exists, which the shell reports as 127. */
  bool found;

  Output ok(u8[] out) { return Output(out, u8[0](), 0, true); }
  Output fail(u8[] err, i32 status) { return Output(u8[0](), err, status, true); }
  Output missing() { return Output(u8[0](), u8[0](), 127, false); }
}

/**
 * Run an external program.
 *
 * The one place that knows external commands are not real processes. Everything above it is
 * written as though they were.
 */
/**
 * The seam, for a caller that has the input as bytes and wants the output as bytes.
 *
 * Unchanged in signature and in behaviour: a shell that cannot spawn calls this, and the sinks it
 * passes collect rather than write. What changed is underneath — a program now *writes as it goes*, so
 * the same body streams when it is spawned as a worker. wac-mono 0061.
 */
export Output run(Cli cli, string cwd, Vec<string> argv, u8[] stdin) {
  if (argv.len() == 0) { return Output.missing(); }
  if (!isProgram(argv.get(0))) { return Output.missing(); }
  Sink sink = Sink.toBuffer(cli);
  Sink errs = Sink.toBuffer(cli);
  Feed fed = Feed.of(cli, stdin);
  i32 status = dispatchProgram(cli, cwd, argv, fed, sink, errs);
  return Output(sink.taken(), errs.taken(), status, true);
}

/**
 * The same programs, streaming: input pulled a chunk at a time, output written as it is produced.
 *
 * This is what a *spawned* one runs. `sh.wac`'s `main` dispatches to it when its first argument names
 * one of these, which makes the shell a multi-call program — `packages/box` is one already — and that is
 * what lets the shell run its own twelve as real children. Two entry points over one dispatcher rather
 * than two implementations, which is the whole reason `Sink` can also collect.
 */
export i32 runStreaming(Cli cli, string cwd, Vec<string> argv) {
  if (argv.len() == 0) { return 127; }
  if (!isProgram(argv.get(0))) { return 127; }
  Sink sink = Sink.toOutput(cli);
  Sink errs = Sink.toErr(cli);
  Feed fed = Feed.fromStdin(cli);
  i32 status = dispatchProgram(cli, cwd, argv, fed, sink, errs);
  sink.flush();
  errs.flush();
  return status;
}

/** Whether this name is one of the twelve. */
export bool isProgram(string name) {
  Vec<string> mine = names();
  for (i32 i = 0; i < mine.len(); i++) {
    if (mine.get(i) == name) { return true; }
  }
  return false;
}

i32 dispatchProgram(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  string name = argv.get(0);
  if (name == "cat") { return cat(cli, cwd, argv, fed, sink, errs); }
  if (name == "wc") { return wc(cli, cwd, argv, fed, sink, errs); }
  if (name == "head") { return head(cli, cwd, argv, fed, sink, errs); }
  if (name == "tail") { return tail(cli, cwd, argv, fed, sink, errs); }
  if (name == "rev") { return rev(cli, cwd, argv, fed, sink, errs); }
  if (name == "sort") { return sort(cli, cwd, argv, fed, sink, errs); }
  if (name == "uniq") { return uniq(cli, cwd, argv, fed, sink, errs); }
  if (name == "grep") { return grep(cli, cwd, argv, fed, sink, errs); }
  if (name == "tr") { return tr(argv, fed, sink, errs); }
  if (name == "seq") { return seq(argv, sink, errs); }
  if (name == "nl") { return nl(cli, cwd, argv, fed, sink, errs); }
  if (name == "printf") { return printf(argv, sink, errs); }
  return 127;
}

/**
 * The same twelve as a `string[]`, which is the shape `Shell.externalNames` wants.
 *
 * Two spellings of one list rather than a conversion at the call site: `names()` is what the tests and
 * `isProgram` read, and a funcref field cannot take a `Vec`-returning function.
 */
export string[] programNames() {
  Vec<string> mine = names();
  string[] out = string[mine.len()](fill: "");
  for (i32 i = 0; i < mine.len(); i++) { out[i] = mine.get(i); }
  return out;
}

/** Every name `run` will answer to, so `help` and the tests do not have to guess. */
export Vec<string> names() {
  Vec<string> out = Vec.create();
  out.push("cat"); out.push("wc"); out.push("head"); out.push("tail"); out.push("rev");
  out.push("sort"); out.push("uniq"); out.push("grep"); out.push("tr"); out.push("seq");
  out.push("nl"); out.push("printf");
  return out;
}

// ── The programs ──────────────────────────────────────────────────────────────

/**
 * `printf FORMAT [ARGS]` — the only one of these with a language of its own.
 *
 * Three rules do most of the work and none of them is guessable:
 *
 *   **The format is reused until the arguments run out.** `printf "%s-%s\n" a b c d` prints two
 *   lines, not one. Only a format that actually consumed something repeats, or one with no
 *   conversions in it would loop for ever.
 *
 *   **A missing argument is not an error.** `printf "%s-%s\n" a` prints `a-` — the second
 *   conversion gets the empty string, and `%d` gets zero. That is what makes a format safe to
 *   write once and feed a variable number of values.
 *
 *   **A bad number is reported and then used anyway.** `printf "%d" abc` writes `0` to standard
 *   output, complains on standard error, and exits 1. All three, not one of them.
 *
 * A bad *format* is different from a bad argument: an unknown conversion character, or a `%` with
 * nothing after it, stops the whole thing. What was already produced still goes out — bash prints
 * the `ab` of `printf "ab%z"` and then gives up — so this is an abort, not a discard.
 *
 * Escapes are processed in the *format*, which is why `printf` is the way to emit a line with no
 * trailing newline and `echo` is not.
 */
i32 printf(Vec<string> argv, Sink sink, Sink errs) {
  if (argv.len() < 2) {
    { errs.bytes("printf: usage: printf format [arguments]\n".toBytes()); errs.flush(); sink.flush(); return 2; }
  }
  u8[] f = argv.get(1).toBytes();
  Buf out = Buf.create();
  Buf err = Buf.create();
  i32 status = 0;
  i32 arg = 2;
  bool again = true;
  bool fatal = false;

  while (again && !fatal) {
    again = false;
    i32 consumedThisPass = 0;
    i32 i = 0;
    while (i < f.len() && !fatal) {
      if (f[i] == 0x5c) { i = escapeInto(out, f, i); continue; }
      if (f[i] != 0x25) { out.push(f[i]); i++; continue; }

      i32 j = i + 1;
      if (j < f.len() && f[j] == 0x25) { out.push(0x25); i = j + 1; continue; }

      bool left = false;
      bool zero = false;
      while (j < f.len() && (f[j] == 0x2d || f[j] == 0x30)) {
        if (f[j] == 0x2d) { left = true; } else { zero = true; }
        j++;
      }
      i32 width = 0;
      while (j < f.len() && f[j] >= 0x30 && f[j] <= 0x39) { width = width * 10 + (f[j] - 0x30); j++; }
      i32 prec = -1;
      if (j < f.len() && f[j] == 0x2e) {
        j++;
        prec = 0;
        while (j < f.len() && f[j] >= 0x30 && f[j] <= 0x39) { prec = prec * 10 + (f[j] - 0x30); j++; }
      }
      // A `%` with nothing after it is a format error, not a literal `%`.
      if (j >= f.len()) {
        err.pushAll("printf: `%': missing format character\n".toBytes());
        status = 1;
        fatal = true;
        continue;
      }

      i32 conv = f[j];
      string a = arg < argv.len() ? argv.get(arg) : "";
      string text = "";
      bool numeric = false;
      bool known = true;

      if (conv == 0x73) {                                   // 's'
        text = (prec >= 0 && prec < a.len()) ? a.slice(0, prec) : a;
      } else if (conv == 0x63) {                            // 'c'
        text = a.len() > 0 ? a.slice(0, 1) : "";
      } else if (conv == 0x64 || conv == 0x69) {            // 'd', 'i'
        numeric = true;
        if (a != "" && !isNumber(a)) {
          err.pushAll(("printf: " + a + ": invalid number\n").toBytes());
          status = 1;
        }
        text = itoa(atoi(a));
      } else if (conv == 0x78 || conv == 0x58 || conv == 0x6f) {   // 'x', 'X', 'o'
        numeric = true;
        if (a != "" && !isNumber(a)) {
          err.pushAll(("printf: " + a + ": invalid number\n").toBytes());
          status = 1;
        }
        text = inBase(atoi(a), conv == 0x6f ? 8 : 16, conv == 0x58);
      } else {
        known = false;
      }

      if (!known) {
        err.pushAll(("printf: `%" + charFor(conv) + "': invalid format character\n").toBytes());
        status = 1;
        fatal = true;
        continue;
      }
      arg++;
      consumedThisPass++;
      // Zero-padding is a numeric thing: `%05s` pads with spaces, as it does in bash.
      padInto(out, text, width, left, zero && numeric);
      i = j + 1;
    }
    if (!fatal && consumedThisPass > 0 && arg < argv.len()) { again = true; }
  }
  { sink.bytes(out.take()); errs.bytes(err.take()); sink.flush(); errs.flush(); return status; }
}

/** One backslash escape from the format, appended. Returns the index after it. */
i32 escapeInto(Buf out, u8[] f, i32 at) {
  if (at + 1 >= f.len()) { out.push(0x5c); return at + 1; }
  i32 c = f[at + 1];
  if (c == 0x6e) { out.push(10); return at + 2; }            // \n
  if (c == 0x74) { out.push(9); return at + 2; }             // \t
  if (c == 0x72) { out.push(13); return at + 2; }            // \r
  if (c == 0x5c) { out.push(0x5c); return at + 2; }          // \\
  if (c == 0x61) { out.push(7); return at + 2; }             // \a
  if (c == 0x62) { out.push(8); return at + 2; }             // \b
  if (c == 0x66) { out.push(12); return at + 2; }            // \f
  if (c == 0x76) { out.push(11); return at + 2; }            // \v
  if (c == 0x65) { out.push(27); return at + 2; }            // \e
  if (c == 0x78) {                                           // \xHH
    i32 p = at + 2;
    i32 v = 0;
    i32 n = 0;
    while (p < f.len() && n < 2 && hexValue(f[p]) >= 0) { v = v * 16 + hexValue(f[p]); p++; n++; }
    if (n == 0) { out.push(0x5c); out.push(0x78); return at + 2; }
    out.push(v);
    return p;
  }
  if (c >= 0x30 && c <= 0x37) {                              // \NNN, and \0NNN for the same thing
    i32 p = at + 1;
    if (f[p] == 0x30 && p + 1 < f.len() && f[p + 1] >= 0x30 && f[p + 1] <= 0x37) { p++; }
    i32 v = 0;
    i32 n = 0;
    while (p < f.len() && n < 3 && f[p] >= 0x30 && f[p] <= 0x37) { v = v * 8 + (f[p] - 0x30); p++; n++; }
    out.push(v & 0xFF);
    return p;
  }
  // Anything else keeps its backslash, as bash does — `\q` is two characters.
  out.push(0x5c);
  return at + 1;
}

i32 hexValue(i32 c) {
  if (c >= 0x30 && c <= 0x39) { return c - 0x30; }
  if (c >= 0x61 && c <= 0x66) { return c - 0x61 + 10; }
  if (c >= 0x41 && c <= 0x46) { return c - 0x41 + 10; }
  return -1;
}

/** Whether the whole string is a number, so `%d` can say so before using it as zero. */
bool isNumber(string s) {
  u8[] b = s.toBytes();
  i32 i = 0;
  if (i < b.len() && (b[i] == 0x2d || b[i] == 0x2b)) { i++; }
  if (i >= b.len()) { return false; }
  for (; i < b.len(); i++) {
    if (b[i] < 0x30 || b[i] > 0x39) { return false; }
  }
  return true;
}

/** A non-negative number in base 8 or 16. Negatives keep their sign rather than wrapping. */
string inBase(i32 v, i32 base, bool upper) {
  if (v == 0) { return "0"; }
  bool neg = v < 0;
  i32 n = neg ? 0 - v : v;
  string out = "";
  while (n > 0) {
    i32 d = n % base;
    i32 c = d < 10 ? 0x30 + d : (upper ? 0x41 + d - 10 : 0x61 + d - 10);
    out = charFor(c) + out;
    n = n / base;
  }
  return neg ? "-" + out : out;
}

string charFor(i32 c) {
  u8[] one = u8[1]();
  one[0] = c;
  return string.fromBytes(one);
}

/** `text` padded to `width`, on the right if `left`, with zeros if `zero`. */
void padInto(Buf out, string text, i32 width, bool left, bool zero) {
  i32 gap = width - text.len();
  if (gap <= 0) { out.pushAll(text.toBytes()); return; }
  if (left) {
    out.pushAll(text.toBytes());
    for (i32 i = 0; i < gap; i++) { out.push(32); }
    return;
  }
  // A zero-padded negative number keeps its sign in front of the zeros: `-007`, not `00-7`.
  u8[] b = text.toBytes();
  i32 from = 0;
  if (zero && b.len() > 0 && b[0] == 0x2d) { out.push(0x2d); from = 1; }
  for (i32 i = 0; i < gap; i++) { out.push(zero ? 0x30 : 32); }
  for (i32 i = from; i < b.len(); i++) { out.push(b[i]); }
}

// ── Operands ──────────────────────────────────────────────────────────────────

/**
 * One input: the bytes, and the name to print for it.
 *
 * Every program here except `cat` used to ignore its operands and read standard input regardless.
 * `wc -l f` printed `0` and exited `0`. `grep pattern f` printed nothing and exited 1, which a script
 * reads as "no match" rather than "the file was never opened". Nine programs, every one of them
 * silent, and bash is what said so.
 */
struct Reading {
  bool ok;
  /** The operand, or "" for standard input. A `-` keeps its name, because GNU prints it. */
  string name;
  u8[] bytes;
  /** The host's own reason, when `ok` is false. */
  string error;
}

/** The names to read: the operands, or one empty name standing for standard input. */
Vec<string> inputsOf(Vec<string> operands) {
  Vec<string> out = Vec.create();
  if (operands.len() == 0) { out.push(""); return out; }
  for (i32 i = 0; i < operands.len(); i++) { out.push(operands.get(i)); }
  return out;
}

/** One input, through the shell's working directory rather than the host's. */
Reading readOne(Cli cli, string cwd, string name, u8[] stdin) {
  if (name == "" || name == "-") { return Reading(true, name, stdin, ""); }
  FileResult f = cli.readFile(resolvePath(cwd, name)).wait();
  if (!f.ok) { return Reading(false, name, u8[0](), whyUnread(f)); }
  return Reading(true, name, f.bytes, "");
}

/**
 * Why a file could not be read, in GNU's words where the category is one GNU has a phrase for.
 *
 * The host's own sentence carried an errno and an absolute path — "No such file or directory (os error
 * 2): readfile '/tmp/x/missing'" — and differed by runtime, where GNU says four words. `FileResult`
 * carries the category now (wac-mono 0062), so this is the same translation `reasonOf` does for a
 * mutation, on the side that reads. Anything uncategorised keeps the host's sentence, which is the only
 * text left that says anything.
 */
string whyUnread(FileResult f) {
  if (f.fault == FAULT_NOT_FOUND()) { return "No such file or directory"; }
  // GNU has no phrase for this because a filesystem it can name every file in needs none. wac-mono 0065.
  if (f.fault == FAULT_NOT_REPRESENTABLE()) { return "cannot be named on this host"; }
  if (f.fault == FAULT_DENIED()) { return "Permission denied"; }
  if (f.fault == FAULT_NOT_EMPTY()) { return "Directory not empty"; }
  return f.error;
}

/**
 * Every operand that could be read, in order, and the ones that could not.
 *
 * For the programs whose answer does not depend on which file a line came from: GNU's `sort`, `uniq`,
 * `rev` and `nl` treat several operands as exactly a concatenation, including `nl`'s numbering, which
 * runs on across the boundary rather than restarting.
 *
 * A failure does not end it, because for three of those four it does not end GNU either: `nl missing f`
 * numbers `f` and exits 1, and only `sort` gives up on the first unreadable operand. Both are possible
 * from here — the caller decides by looking at `failed`.
 */
struct Gathered {
  u8[] bytes;
  Vec<string> failed;
  Vec<string> reasons;
}

Gathered gather(Cli cli, string cwd, Vec<string> operands, u8[] stdin) {
  Vec<string> names = inputsOf(operands);
  Buf out = Buf.create();
  Vec<string> failed = Vec.create();
  Vec<string> reasons = Vec.create();
  for (i32 i = 0; i < names.len(); i++) {
    Reading r = readOne(cli, cwd, names.get(i), stdin);
    if (!r.ok) {
      failed.push(r.name);
      reasons.push(r.error);
      continue;
    }
    out.pushAll(r.bytes);
  }
  return Gathered(out.take(), failed, reasons);
}

/**
 * Whether GNU's version of this program has this option — which decides what a refusal *says*.
 *
 * Two messages, because they are two different facts. A letter GNU does not have either is a mistake in
 * the command and gets GNU's own wording. A letter GNU *has* and this does not is a gap in this program,
 * and "invalid option" blames the wrong side: the caller wrote a real flag and was told it was not one.
 * Saying plainly that it is not implemented is the difference between "you are wrong" and "I am
 * incomplete", and only the second is true.
 *
 * The letters are the real tools', read out of `--help` rather than remembered. `test/gaps.test.ts`
 * checks the list against the installed coreutils, so it cannot quietly drift out of date.
 */
bool gnuHas(string name, i32 letter) {
  string letters = "";
  if (name == "wc") { letters = "cmlLw"; }
  else if (name == "head") { letters = "cnqvz"; }
  else if (name == "tail") { letters = "cfFnqsvz"; }
  else if (name == "sort") { letters = "bdfgiMhnRrVcCkmosStTuz"; }
  else if (name == "uniq") { letters = "cdDfisuzw"; }
  else if (name == "nl") { letters = "bdfhilnpsvw"; }
  else if (name == "rev") { letters = "hV"; }
  else if (name == "grep") { letters = "EFGPefiwxzsvVmbnHhoqaIdDrRLlcTZBACU"; }
  else if (name == "tr") { letters = "cdst"; }
  else if (name == "seq") { letters = "fsw"; }
  else if (name == "cat") { letters = "AbeEnstTuv"; }
  u8[] b = letters.toBytes();
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] == letter) { return true; }
  }
  return false;
}

/** What to say about an option this program does not take, and whose gap it is. */
string optionRefusal(string name, string letter) {
  u8[] b = letter.toBytes();
  if (b.len() == 1 && gnuHas(name, b[0])) {
    // Our gap, so our words: GNU's "Try --help" would be pointing at the wrong manual.
    return name + ": -" + letter + " is not implemented\n";
  }
  return name + ": invalid option -- '" + letter + "'\n" + tryHelp(name);
}

/**
 * The second line GNU prints after a usage error, which it prints after *every* one.
 *
 * Only on the branches that are GNU's message rather than ours. It is derivable, so it is compared
 * against the real tool's stderr rather than against an expectation written here.
 */
string tryHelp(string name) {
  return "Try '" + name + " --help' for more information.\n";
}

/** A program's arguments, split: the options it was given, its operands, and the first it refuses. */
struct Options {
  /** The letters seen, in order — `sawOption` asks about one. */
  string seen;
  Vec<string> operands;
  /** The first letter this program does not accept, or "". */
  string bad;
}

/**
 * Split `argv` into single-letter options and operands.
 *
 * `accept` is the letters a program has: `wc` passes "lwc", `sort` passes "r". Bundles work (`-lw`),
 * `--` ends the options, and a bare `-` is an operand, being standard input.
 *
 * The refusal is the point. An option nobody implemented used to fall through to whatever the program
 * did with a stray argument — `grep -c a` searched for `-c` and reported "no match", `sort -n` sorted
 * as text, `wc -m` counted everything. Answering the wrong question with a status of 0 is worse than
 * refusing to answer.
 */
Options options(Vec<string> argv, string accept) {
  string seen = "";
  Vec<string> operands = Vec.create();
  bool more = true;
  for (i32 i = 1; i < argv.len(); i++) {
    string a = argv.get(i);
    if (more && a == "--") { more = false; continue; }
    u8[] b = a.toBytes();
    if (!more || b.len() < 2 || b[0] != '-') { operands.push(a); continue; }
    for (i32 j = 1; j < b.len(); j++) {
      u8[] one = u8[1](fill: b[j]);
      string letter = string.fromBytes(one);
      if (indexOfLetter(accept, letter) < 0) { return Options(seen, operands, letter); }
      seen = seen + letter;
    }
  }
  return Options(seen, operands, "");
}

bool sawOption(Options o, string letter) { return indexOfLetter(o.seen, letter) >= 0; }

i32 indexOfLetter(string s, string letter) {
  for (i32 i = 0; i < s.len(); i++) {
    if (s.slice(i, i + 1) == letter) { return i; }
  }
  return -1;
}

/** `head`/`tail`'s arguments: how many lines, which files, and the first option refused. */
struct Counted {
  i32 n;
  Vec<string> operands;
  string bad;
}

/**
 * `-n N`, the traditional `-N`, and everything else is an operand — or a refusal.
 *
 * This replaces a `countArg` that scanned for `-n` and ignored everything else, which is how `head -2`
 * printed all five lines of `seq 1 5` — a flag ignored rather than refused — and how `head -q f` read
 * standard input while `f` sat there unopened. GNU takes both spellings of the count, and `-2` is the
 * one people type; a `-` followed by digits is exactly what `isNumber` already answers.
 */
Counted countOf(Vec<string> argv, i32 fallback) {
  i32 n = fallback;
  Vec<string> operands = Vec.create();
  bool more = true;
  for (i32 i = 1; i < argv.len(); i++) {
    string a = argv.get(i);
    if (more && a == "--") { more = false; continue; }
    if (!more) { operands.push(a); continue; }
    if (a == "-n" && i + 1 < argv.len()) { n = atoi(argv.get(i + 1)); i++; continue; }
    u8[] b = a.toBytes();
    if (b.len() < 2 || b[0] != '-') { operands.push(a); continue; }
    // `-2` reads as -2, so the count is its negation; `-q` is an option this does not have.
    if (isNumber(a)) { n = -atoi(a); continue; }
    u8[] one = u8[1](fill: b[1]);
    return Counted(n, operands, string.fromBytes(one));
  }
  return Counted(n, operands, "");
}

/**
 * `cat [-AbeEnstTuv] [file…]` — copy, and hold nothing.
 *
 * Four things it got wrong, all found by comparing with GNU rather than by reading it:
 *
 * - **It stopped at the first file it could not open.** `cat missing f` printed the complaint and
 *   nothing else, where GNU prints `f` and exits 1. A `cat` that silently drops the rest of its
 *   arguments after a bad one is a hard failure to debug: the status is right and the output is short.
 * - **Options were filenames.** `cat -n f` reported "cat: -n: No such file or directory", which blames
 *   the caller for writing a real GNU flag; `cat -Q f` said the same where GNU says "invalid option".
 *   The flags are implemented now — all nine of them, since they are line transforms and the
 *   comparison against GNU is exact — and an unknown letter gets GNU's own refusal.
 * - **It held everything.** Standard input was read whole and every file appended to one buffer, so
 *   `cat` — the one program in a pipeline that needs no state at all — was bounded by memory. It
 *   copies a chunk at a time now, and numbering costs one line.
 * - **A complaint overtook the output.** See `complain`.
 *
 * `-u` is accepted and does nothing, which is what GNU's own manual says of it: "(ignored)". That is
 * not a gap.
 */
i32 cat(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  Options o = options(argv, "AbeEnstTuv");
  if (o.bad != "") {
    { errs.bytes(optionRefusal("cat", o.bad).toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  // `-A` is `-vET`, `-e` is `-vE`, `-t` is `-vT`: GNU's own bundles, spelled out here.
  bool all = sawOption(o, "A");
  Style style = Style(
    sawOption(o, "n"),
    sawOption(o, "b"),
    sawOption(o, "s"),
    sawOption(o, "E") || all || sawOption(o, "e"),
    sawOption(o, "T") || all || sawOption(o, "t"),
    sawOption(o, "v") || all || sawOption(o, "e") || sawOption(o, "t"));

  // Numbering and squeezing run *across* the operands, as GNU's do: `cat -n f g` keeps counting.
  Counter state = Counter(0, false);
  Vec<string> names = o.operands.len() == 0 ? inputsOf(o.operands) : o.operands;

  i32 status = 0;
  for (i32 i = 0; i < names.len(); i++) {
    string path = names.get(i);
    if (path == "" || path == "-") {
      // Standard input, in its place among the operands: `cat f - g` is GNU's own shape.
      catCopy(fed, sink, style, state);
      continue;
    }
    // Through the shell's working directory, not the host's. Without it, `cd sub; cat f` looked in
    // whichever directory the process had started in.
    FileResult f = cli.readFile(resolvePath(cwd, path)).wait();
    if (!f.ok) {
      // Reported and carried on, as GNU does, with the status remembered for the end.
      complain(sink, errs, "cat: " + path + ": " + whyUnread(f) + "\n");
      status = 1;
      continue;
    }
    // A file is bounded by the file, so it is read whole and then *fed* through the same path standard
    // input takes. One implementation of `cat`, whichever the input is.
    if (!catCopy(Feed.of(cli, f.bytes), sink, style, state)) { break; }
  }
  { sink.flush(); errs.flush(); return status; }
}

/** Which of `cat`'s transformations are on. */
struct Style {
  bool number;        // -n
  bool numberFilled;  // -b, which numbers only the lines with something on them and overrides -n
  bool squeeze;       // -s
  bool ends;          // -E, a `$` at the end of every line
  bool tabs;          // -T, a tab as `^I`
  bool nonPrinting;   // -v, everything else unprintable as `^X` or `M-X`

  /** Whether anything at all is being done to the bytes, in which case they can go straight through. */
  bool plain(const this) {
    return !this.number && !this.numberFilled && !this.squeeze && !this.ends && !this.tabs &&
           !this.nonPrinting;
  }
}

/** What `cat` carries from one operand to the next: the line number, and whether the last was blank. */
struct Counter {
  i32 lines;
  bool wasBlank;
}

/** One input into the sink, transformed if anything is on. False when the reader has gone. */
bool catCopy(Feed fed, Sink sink, Style style, Counter state) {
  if (style.plain()) {
    while (true) {
      u8[] chunk = fed.next();
      if (chunk.len() == 0) { return true; }
      // A refused write is the reader having gone — `cat big | head -1`. Stopping is the answer.
      if (!sink.bytes(chunk)) { return false; }
    }
    return true;
  }

  Lines lines = Lines.create();
  while (true) {
    Line l = nextLine(lines, fed);
    if (!l.ok) { return true; }
    bool blank = l.bytes.len() == 0;
    // `-s`: one blank line stands for a run of them. The *second* onwards is dropped, so the state is
    // "was the previous line blank" and not a count.
    if (style.squeeze && blank && state.wasBlank) { continue; }
    state.wasBlank = blank;

    Buf out = Buf.create();
    if (style.numberFilled) {
      // `-b` overrides `-n` and numbers only the lines with something on them. A blank line gets
      // nothing at all — not even the width — which is GNU's layout and not the one I guessed.
      if (!blank) {
        state.lines++;
        out.pushAll(numberField(state.lines).toBytes());
      }
    } else if (style.number) {
      state.lines++;
      out.pushAll(numberField(state.lines).toBytes());
    }
    for (i32 i = 0; i < l.bytes.len(); i++) {
      i32 c = l.bytes[i];
      if (c == 9) {
        // A tab is only touched by -T; -v leaves it alone, which is why this is checked first.
        if (style.tabs) { out.pushAll("^I".toBytes()); } else { out.push(9); }
        continue;
      }
      if (!style.nonPrinting || c >= 32 && c < 127) { out.push(c); continue; }
      // `M-` for the high half, then the same rule again for what is left of the byte.
      i32 low = c;
      if (c >= 128) {
        out.pushAll("M-".toBytes());
        low = c - 128;
      }
      if (low < 32) { out.push('^'); out.push(low + 64); }
      else if (low == 127) { out.pushAll("^?".toBytes()); }
      else { out.push(low); }
    }
    // The `$` marks the *newline*, so a last line without one does not get it. GNU's `cat -A` on a
    // file with no final newline is the case that says which of the two this is.
    if (style.ends && l.nl) { out.push('$'); }
    if (!emitTo(sink, out.take(), l.nl)) { return false; }
  }
  return true;
}

/** `cat -n`'s number: right-aligned in six columns, then a tab. GNU's layout, matched exactly. */
string numberField(i32 n) {
  return rightAlign(itoa(n), 6) + "\t";
}

/**
 * A complaint, in its place among the output.
 *
 * **The output sink is flushed first**, and that is the whole point of this existing. A `Sink` holds up
 * to 64 KiB before it writes, so a program that reports a failure straight to standard error while its
 * own output is still in the buffer puts the two in the wrong order: `cat f missing` printed the
 * complaint *before* `f`'s contents, where GNU prints them as they happen. Nothing in the shell can fix
 * that from outside — by the time the shell sees the two streams, the order is already wrong.
 */
void complain(Sink sink, Sink errs, string line) {
  sink.flush();
  errs.bytes(line.toBytes());
  errs.flush();
}

/** Everything left of a feed, a chunk at a time, holding a chunk. */
i32 catStream(Feed fed, Sink sink) {
  while (true) {
    u8[] chunk = fed.next();
    if (chunk.len() == 0) { break; }
    // A refused write is the reader having gone — `cat big | head -1`. Stopping is the answer, and
    // the status is still 0: nothing failed.
    if (!sink.bytes(chunk)) { return 0; }
  }
  sink.flush();
  return 0;
}

/**
 * `wc [-lwc] [file…]`.
 *
 * The name is printed beside the counts when there is an operand, and a `total` line follows when
 * there is more than one — both of which GNU does, and neither of which could show up before, because
 * the operands were ignored and this always counted standard input.
 *
 * A file that cannot be read is reported and the rest are still counted, with a status of 1 at the
 * end: GNU prints the `total` line even then, over the files it managed.
 */
i32 wc(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  Options o = options(argv, "lwc");
  if (o.bad != "") {
    { errs.bytes(optionRefusal("wc", o.bad).toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  bool wantLines = sawOption(o, "l");
  bool wantWords = sawOption(o, "w");
  bool wantBytes = sawOption(o, "c");
  if (!wantLines && !wantWords && !wantBytes) {
    wantLines = true; wantWords = true; wantBytes = true;
  }

  // Standard input and nothing else takes the streaming path, as `head` and `tail` do. Counting is
  // the case where holding the input is *purely* waste — the answer is three integers whatever the
  // size — and holding it is what made `seq 1 200000000 | wc -c` fail where bash prints
  // 1888888898: 1.9 GB does not fit in one wasm array, so the child trapped and the pipeline
  // reported 126. Now it counts a chunk at a time and holds a chunk.
  if (o.operands.len() == 0) {
    return wcStream(fed, sink, wantLines, wantWords, wantBytes);
  }

  u8[] stdin = fed.rest();
  Vec<string> names = inputsOf(o.operands);
  Buf err = Buf.create();
  i32 status = 0;
  i64 allLines = 0;
  i64 allWords = 0;
  i64 allBytes = 0;
  bool anyStdin = false;

  // Counted first, printed second, because the width of the columns depends on the total — see
  // `countWidth`. GNU knows the total in advance from the sizes on disk; the only way to know it here
  // is to have read them, and every input is read whole on this path anyway.
  Vec<i64> eachLines = Vec.create();
  Vec<i64> eachWords = Vec.create();
  Vec<i64> eachBytes = Vec.create();
  Vec<string> eachName = Vec.create();

  for (i32 f = 0; f < names.len(); f++) {
    if (names.get(f) == "" || names.get(f) == "-") { anyStdin = true; }
    Reading r = readOne(cli, cwd, names.get(f), stdin);
    if (!r.ok) {
      err.pushAll(("wc: " + r.name + ": " + r.error + "\n").toBytes());
      status = 1;
      continue;
    }
    i64 lines = 0;
    i64 words = 0;
    bool inWord = false;
    for (i32 i = 0; i < r.bytes.len(); i++) {
      i32 c = r.bytes[i];
      if (c == 10) { lines++; }
      bool blank = c == 32 || c == 9 || c == 10;
      if (blank) { inWord = false; }
      else if (!inWord) { inWord = true; words++; }
    }
    allLines += lines;
    allWords += words;
    allBytes += r.bytes.len() as i64;
    eachLines.push(lines);
    eachWords.push(words);
    eachBytes.push(r.bytes.len() as i64);
    eachName.push(r.name);
  }

  i32 columns = (wantLines ? 1 : 0) + (wantWords ? 1 : 0) + (wantBytes ? 1 : 0);
  i32 width = countWidth(columns, !anyStdin, allBytes);
  Buf out = Buf.create();
  for (i32 f = 0; f < eachName.len(); f++) {
    out.pushAll(countLine(wantLines, wantWords, wantBytes, eachLines.get(f), eachWords.get(f),
                          eachBytes.get(f), eachName.get(f), width).toBytes());
  }
  if (names.len() > 1) {
    out.pushAll(countLine(wantLines, wantWords, wantBytes, allLines, allWords, allBytes, "total",
                          width).toBytes());
  }
  { sink.bytes(out.take()); errs.bytes(err.take()); sink.flush(); errs.flush(); return status; }
}

/**
 * Counting a chunk at a time, holding a chunk.
 *
 * The one piece of state a chunk boundary threatens is `inWord`: a word split across two chunks is
 * one word, so the flag carries over rather than being reset per chunk. A test for that is cheap and
 * the bug would be silent — `wc -w` over a pipe would count *more* words the smaller the chunks got.
 */
i32 wcStream(Feed fed, Sink sink, bool wantLines, bool wantWords, bool wantBytes) {
  // **i64, because a stream has no size limit.** These were i32 and nothing said so: 2.6 GB through a
  // pipe answered `-1306078398`, a negative byte count, quietly. That became reachable the moment `wc`
  // started streaming — before, an input that large trapped long before it could be miscounted, and a
  // trap is a better wrong answer than a negative one. wac-mono 0072.
  i64 lines = 0;
  i64 words = 0;
  i64 bytes = 0;
  bool inWord = false;
  while (true) {
    u8[] chunk = fed.next();
    if (chunk.len() == 0) { break; }
    bytes += chunk.len() as i64;
    for (i32 i = 0; i < chunk.len(); i++) {
      i32 c = chunk[i];
      if (c == 10) { lines++; }
      bool blank = c == 32 || c == 9 || c == 10;
      if (blank) { inWord = false; }
      else if (!inWord) { inWord = true; words++; }
    }
  }
  i32 columns = (wantLines ? 1 : 0) + (wantWords ? 1 : 0) + (wantBytes ? 1 : 0);
  // A stream has no size to ask for, so the columns are GNU's fallback width whatever arrives. It
  // is the *count* that is unknown in advance here, not merely unmeasured: this path exists because
  // the input may be larger than memory.
  sink.bytes(countLine(wantLines, wantWords, wantBytes, lines, words, bytes, "",
                       countWidth(columns, false, 0)).toBytes());
  sink.flush();
  return 0;
}

/**
 * How wide GNU makes each of `wc`'s columns: one count is bare, and more than one is right-aligned.
 *
 * GNU takes the width from the digits of the *total size* of its inputs when it knows them, and 7
 * when it does not — so `wc f` on a 108894-byte file prints counts six wide, and `seq 1 5 | wc`
 * prints them seven wide. Matched because it is derivable, and because the corpus could not see it:
 * every `wc` case with a file was small enough that one digit and one space happened to agree, and
 * every case with a pipe asked for a single count.
 *
 * **One divergence, and it is a gap rather than a choice.** `wc - < f` prints six-wide columns in
 * GNU, because it asks the descriptor how big it is; nothing here can, so it prints seven. Both of
 * this shell's paths agree with each other about that, which is the property worth keeping — a
 * `wc` that answered differently depending on whether the shell could spawn would be worse than one
 * that is consistently narrower than GNU. `packages/sh/README.md` records it.
 */
i32 countWidth(i32 columns, bool sizeKnown, i64 totalBytes) {
  if (columns < 2) { return 1; }
  if (!sizeKnown) { return 7; }
  i32 width = itoa64(totalBytes).len();
  return width < 1 ? 1 : width;
}

/**
 * One line of counts, in `wc`'s order whichever subset was asked for, right-aligned in `width`.
 *
 * `countWidth` decides the width and says why it is what it is.
 */
string countLine(bool l, bool w, bool c, i64 lines, i64 words, i64 bytes, string name, i32 width) {
  string s = "";
  if (l) { s = rightAlign(itoa64(lines), width); }
  if (w) { s = (s == "" ? "" : s + " ") + rightAlign(itoa64(words), width); }
  if (c) { s = (s == "" ? "" : s + " ") + rightAlign(itoa64(bytes), width); }
  if (name != "") { s = s + " " + name; }
  return s + "\n";
}

/** `n` in a field of `width`, spaces first. A number wider than the field is printed whole. */
string rightAlign(string n, i32 width) {
  string pad = "";
  for (i32 i = n.len(); i < width; i++) { pad = pad + " "; }
  return pad + n;
}

/**
 * `head [-n N | -N] [file…]` and `tail`, which differ only in which end they keep.
 *
 * With more than one operand each block carries a `==> name <==` header and a blank line between them,
 * as GNU's do. A file that cannot be opened is reported and the others are still printed.
 */
i32 head(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  return headOrTail(cli, cwd, argv, fed, sink, errs, true);
}

i32 tail(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  return headOrTail(cli, cwd, argv, fed, sink, errs, false);
}

i32 headOrTail(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs, bool front) {
  string who = front ? "head" : "tail";
  Counted c = countOf(argv, 10);
  if (c.bad != "") {
    errs.bytes(optionRefusal(who, c.bad).toBytes());
    errs.flush();
    sink.flush();
    return 1;
  }

  // Standard input and nothing else — which is what a pipeline stage is — takes the streaming path.
  // `head` stops reading as soon as it has its lines, and that is what stops the stage feeding it;
  // `tail` holds `n` lines rather than the whole input. With an operand the file is read whole, which
  // is bounded by the file and is not what 0061 was reported against.
  if (c.operands.len() == 0) {
    return front ? headStream(fed, sink, c.n) : tailStream(fed, sink, c.n);
  }

  u8[] stdin = fed.rest();
  Vec<string> names = inputsOf(c.operands);
  Buf out = Buf.create();
  Buf err = Buf.create();
  i32 status = 0;
  bool printed = false;
  for (i32 f = 0; f < names.len(); f++) {
    Reading r = readOne(cli, cwd, names.get(f), stdin);
    if (!r.ok) {
      err.pushAll((who + ": cannot open '" + r.name + "' for reading: " + r.error + "\n").toBytes());
      status = 1;
      continue;
    }
    if (names.len() > 1) {
      if (printed) { out.push(10); }
      out.pushAll(("==> " + r.name + " <==\n").toBytes());
    }
    out.pushAll(front ? firstLines(r.bytes, c.n) : lastLines(r.bytes, c.n));
    printed = true;
  }
  { sink.bytes(out.take()); errs.bytes(err.take()); sink.flush(); errs.flush(); return status; }
}

/**
 * The first `n` lines, and then *stop*.
 *
 * Stopping is the point. `seq 1 2000000000 | head -1` printed one line in bash and trapped here, and
 * the reason was not the pipeline — it was that this asked for every line before answering. A producer
 * learns that nobody is reading when its own write is refused, so the sooner this stops reading the
 * sooner that happens.
 */
i32 headStream(Feed fed, Sink sink, i32 n) {
  Lines lines = Lines.create();
  i32 seen = 0;
  while (seen < n) {
    Line l = nextLine(lines, fed);
    if (!l.ok) { break; }
    if (!emitTo(sink, l.bytes, l.nl)) { return 0; }
    seen++;
  }
  sink.flush();
  return 0;
}

/**
 * The last `n` lines, holding only those.
 *
 * A ring of `n`, so `tail -1` of a hundred million lines costs one line of memory rather than a hundred
 * million. It still has to *read* all of them — that is what "last" means — but reading is not holding.
 */
i32 tailStream(Feed fed, Sink sink, i32 n) {
  if (n <= 0) {
    sink.flush();
    return 0;
  }
  u8[][] ring = u8[][n](fill: u8[0]());
  u8[] ended = u8[n](fill: 0);
  i32 count = 0;
  Lines lines = Lines.create();
  while (true) {
    Line l = nextLine(lines, fed);
    if (!l.ok) { break; }
    ring[count % n] = l.bytes;
    ended[count % n] = l.nl ? 1 : 0;
    count++;
  }
  i32 first = count > n ? count - n : 0;
  for (i32 i = first; i < count; i++) {
    if (!emitTo(sink, ring[i % n], ended[i % n] != 0)) { return 0; }
  }
  sink.flush();
  return 0;
}

/** The last `n` lines, each with its newline. */
u8[] lastLines(u8[] data, i32 n) {
  Vec<u8[]> lines = splitLines(data);
  Buf out = Buf.create();
  i32 from = lines.len() - n;
  if (from < 0) { from = 0; }
  for (i32 i = from; i < lines.len(); i++) {
    out.pushAll(lines.get(i));
    out.push(10);
  }
  return out.take();
}

i32 rev(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  Options o = options(argv, "");
  if (o.bad != "") {
    { errs.bytes(optionRefusal("rev", o.bad).toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  // One implementation, over a `Feed`, whichever the input is — the shape `cat` took first. Reading
  // everything and splitting it was two things at once: a stage that could not survive its input
  // (0071), and a `rev` that *added* a newline to a last line that arrived without one, because
  // `splitLines` cannot tell the two apart and the buffered loop pushed 10 after every line.
  if (o.operands.len() == 0) { revFeed(fed, sink); return 0; }
  i32 status = 0;
  for (i32 i = 0; i < o.operands.len(); i++) {
    // **No `-` here.** `cat`, `nl` and `uniq` all read standard input for it; GNU's `rev` does not,
    // and answers "rev: cannot open -: No such file or directory". Measured rather than assumed —
    // the three that do take it made it look like a convention.
    string path = o.operands.get(i);
    FileResult f = cli.readFile(resolvePath(cwd, path)).wait();
    if (!f.ok) {
      complain(sink, errs, "rev: cannot open " + path + ": " + whyUnread(f) + "\n");
      status = 1;
      continue;
    }
    if (!revFeed(Feed.of(cli, f.bytes), sink)) { break; }
  }
  { sink.flush(); errs.flush(); return status; }
}

/** Each line backwards, one line at a time. False when the reader has gone. */
bool revFeed(Feed fed, Sink sink) {
  Lines lines = Lines.create();
  while (true) {
    Line l = nextLine(lines, fed);
    if (!l.ok) { return true; }
    u8[] back = u8[l.bytes.len()](fill: 0);
    for (i32 i = 0; i < l.bytes.len(); i++) { back[i] = l.bytes[l.bytes.len() - 1 - i]; }
    // Terminated only if the line it came from was: `printf ab | rev` is `ba` with no newline in GNU.
    if (!emitTo(sink, back, l.nl)) { return false; }
  }
  return true;
}

/**
 * `sort [-r] [file…]` — the one here that genuinely has to hold its input.
 *
 * It is the exception to 0071 and it is worth being precise about *what* it holds. Sorting needs every
 * line before it can answer, so the lines are held — but they are held as lines, in a vector, rather
 * than as one array of bytes. That distinction is the difference between "bounded by memory" and
 * "bounded by one wasm array", which is 1.9 GB and was where `seq 1 200000000 | sort` trapped.
 *
 * The sort itself was an insertion sort, with a comment saying the inputs here are a shell pipeline's
 * worth. A pipeline's worth turned out to be 100,000 lines in four seconds against GNU's none — n²
 * where the input is the user's, which is not a trade-off anybody chose. It is a bottom-up merge sort
 * now: stable, which `sort` has to be for equal lines, and n log n.
 */
i32 sort(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  Options o = options(argv, "r");
  if (o.bad != "") {
    // 2, not 1: GNU sort's usage status is its own, and a script testing for it is testing for that.
    { errs.bytes(optionRefusal("sort", o.bad).toBytes()); errs.flush(); sink.flush(); return 2; }
  }
  bool reverse = sawOption(o, "r");

  Vec<u8[]> lines = Vec.create();
  Vec<string> names = inputsOf(o.operands);
  for (i32 i = 0; i < names.len(); i++) {
    string name = names.get(i);
    if (name == "" || name == "-") {
      collectLines(fed, lines);
      continue;
    }
    FileResult r = cli.readFile(resolvePath(cwd, name)).wait();
    if (!r.ok) {
      // `sort` is the one that gives up rather than sorting what it managed to read.
      { errs.bytes(("sort: cannot read: " + name + ": " + whyUnread(r) + "\n").toBytes()); errs.flush(); sink.flush(); return 2; }
    }
    collectLines(Feed.of(cli, r.bytes), lines);
  }

  u8[][] all = u8[][lines.len()](fill: u8[0]());
  for (i32 i = 0; i < lines.len(); i++) { all[i] = lines.get(i); }
  mergeSort(all, reverse);
  for (i32 i = 0; i < all.len(); i++) {
    // Terminated whether or not the line was, as GNU's `sort` does.
    if (!sink.lineBytes(all[i])) { return 0; }
  }
  { sink.flush(); return 0; }
}

/** Every line of a feed, appended. Lines rather than one array: see `sort`. */
void collectLines(Feed fed, Vec<u8[]> into) {
  Lines lines = Lines.create();
  while (true) {
    Line l = nextLine(lines, fed);
    if (!l.ok) { return; }
    into.push(l.bytes);
  }
}

/**
 * Bottom-up merge sort, stable.
 *
 * Bottom-up rather than recursive because the passes are a loop and the scratch array is allocated
 * once; stable because `sort` must not reorder lines that compare equal, and `after` answering false
 * for equals is what keeps the left run first.
 */
void mergeSort(u8[][] a, bool reverse) {
  i32 n = a.len();
  if (n < 2) { return; }
  u8[][] scratch = u8[][n](fill: u8[0]());
  i32 width = 1;
  while (width < n) {
    i32 at = 0;
    while (at < n) {
      i32 mid = at + width < n ? at + width : n;
      i32 end = at + width + width < n ? at + width + width : n;
      i32 l = at;
      i32 r = mid;
      i32 w = at;
      while (l < mid || r < end) {
        if (l >= mid) { scratch[w] = a[r]; r++; }
        else if (r >= end) { scratch[w] = a[l]; l++; }
        else if (after(a[l], a[r], reverse)) { scratch[w] = a[r]; r++; }
        else { scratch[w] = a[l]; l++; }
        w++;
      }
      at = end;
    }
    for (i32 i = 0; i < n; i++) { a[i] = scratch[i]; }
    width = width + width;
  }
}

/**
 * `uniq [file]` — adjacent duplicates, once each.
 *
 * One operand only. GNU's *second* one is an output file, which it writes: guessing that from an
 * argument this program never read before would be a write nobody asked for, so it is refused.
 */
i32 uniq(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  Options o = options(argv, "");
  if (o.bad != "") {
    { errs.bytes(optionRefusal("uniq", o.bad).toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  if (o.operands.len() > 1) {
    // GNU's second operand is an output *file*, which it writes. Not implemented rather than refused on
    // principle: the distinction matters to whoever reads this next, and "not supported" reads as a
    // decision somebody made.
    { errs.bytes("uniq: writing to a second operand is not implemented\n".toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  // Adjacent duplicates need one line of memory, not all of them: the comparison is with the line
  // before, which is the whole of the state. 0071.
  if (o.operands.len() == 0 || o.operands.get(0) == "-") { uniqFeed(fed, sink); return 0; }
  string path = o.operands.get(0);
  FileResult f = cli.readFile(resolvePath(cwd, path)).wait();
  if (!f.ok) {
    { errs.bytes(("uniq: " + path + ": " + whyUnread(f) + "\n").toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  uniqFeed(Feed.of(cli, f.bytes), sink);
  { sink.flush(); errs.flush(); return 0; }
}

/** Adjacent duplicates once each, holding one line. */
bool uniqFeed(Feed fed, Sink sink) {
  Lines lines = Lines.create();
  u8[] previous = u8[0]();
  bool first = true;
  while (true) {
    Line l = nextLine(lines, fed);
    if (!l.ok) { break; }
    if (!first && sameBytes(l.bytes, previous)) { continue; }
    first = false;
    previous = l.bytes;
    // Terminated whether or not the line was: GNU's `uniq` adds the newline a last line arrived
    // without, where its `rev` does not. Two tools, two answers, and the only way to know is to ask.
    if (!sink.lineBytes(l.bytes)) { return false; }
  }
  sink.flush();
  return true;
}

/**
 * `grep [-cinqvx] pattern [file…]` — substring matching, not a regex. `packages/regex` is the obvious
 * next step and is not wired.
 *
 * The flags are why this is more than a loop. `-v` was the only one read, and an option this did not
 * have became the *pattern*: `grep -c a f` searched for `-c`, found nothing, and exited 1 — which a
 * script reads as "no match" rather than "you asked for something I do not do". With several operands
 * each line is labelled with the file it came from, as GNU's is, and `-c` counts per file.
 */
i32 grep(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  Options o = options(argv, "cinqvx");
  if (o.bad != "") {
    { errs.bytes(optionRefusal("grep", o.bad).toBytes()); errs.flush(); sink.flush(); return 2; }
  }
  if (o.operands.len() == 0) { { errs.bytes("grep: no pattern\n".toBytes()); errs.flush(); sink.flush(); return 2; } }

  Match how = Match(
    sawOption(o, "v"),
    sawOption(o, "i"),
    sawOption(o, "c"),
    sawOption(o, "n"),
    sawOption(o, "q"),
    sawOption(o, "x"),
    sawOption(o, "i") ? lowered(o.operands.get(0).toBytes()) : o.operands.get(0).toBytes());

  Vec<string> files = Vec.create();
  for (i32 i = 1; i < o.operands.len(); i++) { files.push(o.operands.get(i)); }
  Vec<string> names = inputsOf(files);
  // The label is a question of how many operands there are, not of how many matched: `grep a f` is
  // bare and `grep a f g` labels both, even when only one of them has a line.
  bool labelled = names.len() > 1;

  i32 hits = 0;
  i32 status = 0;
  for (i32 f = 0; f < names.len(); f++) {
    string name = names.get(f);
    string label = labelled ? name + ":" : "";
    i32 here = 0;
    if (name == "" || name == "-") {
      here = grepFeed(fed, sink, how, label);
    } else {
      FileResult r = cli.readFile(resolvePath(cwd, name)).wait();
      if (!r.ok) {
        complain(sink, errs, "grep: " + name + ": " + whyUnread(r) + "\n");
        status = 2;
        continue;
      }
      here = grepFeed(Feed.of(cli, r.bytes), sink, how, label);
    }
    hits += here;
    // **`-q` stops at the first match**, which is what makes `seq 1 2000000000 | grep -q 1` answer
    // instead of counting to two billion: the sink is never written, so nothing else would ever stop
    // the stage feeding it. GNU exits 0 the moment it has one.
    if (how.quiet && hits > 0) { break; }
  }

  // grep's exit status is its answer, not an error: 1 means "no lines matched", which is what makes
  // `grep x f && echo found` work. A file it could not read is a real error and outranks both.
  { sink.flush(); errs.flush(); }
  if (status != 0) { return status; }
  return hits > 0 ? 0 : 1;
}

/** What `grep` was asked for, so one input's worth of matching needs one argument rather than seven. */
struct Match {
  bool invert;
  bool fold;
  bool counting;
  bool numbering;
  bool quiet;
  bool whole;
  /** Already lower-cased when `-i` is on, so the input is the only thing folded per line. */
  u8[] needle;
}

/** One input's matching lines, written as they are found. Answers how many matched. */
i32 grepFeed(Feed fed, Sink sink, Match how, string label) {
  Lines lines = Lines.create();
  i32 here = 0;
  i32 n = 0;
  while (true) {
    Line l = nextLine(lines, fed);
    if (!l.ok) { break; }
    n++;
    u8[] against = how.fold ? lowered(l.bytes) : l.bytes;
    bool hit = how.whole ? sameBytes(against, how.needle) : contains(against, how.needle);
    if (hit == how.invert) { continue; }
    here++;
    if (how.quiet) { break; }
    if (how.counting) { continue; }
    Buf out = Buf.create();
    out.pushAll(label.toBytes());
    if (how.numbering) { out.pushAll((itoa(n) + ":").toBytes()); }
    out.pushAll(l.bytes);
    // GNU terminates a matching last line that arrived without a newline.
    if (!sink.lineBytes(out.take())) { break; }
  }
  if (how.counting && !how.quiet) { sink.bytes((label + itoa(here) + "\n").toBytes()); }
  return here;
}

/** ASCII lower case, for `-i`. The C locale is what the shell and its tests run in. */
u8[] lowered(u8[] b) {
  u8[] out = u8[b.len()](fill: 0);
  for (i32 i = 0; i < b.len(); i++) {
    out[i] = (b[i] >= 'A' && b[i] <= 'Z') ? b[i] + 32 : b[i];
  }
  return out;
}

i32 tr(Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  bool del = false;
  bool squeeze = false;
  bool comp = false;
  bool trunc = false;

  // `--` ends the options, which is the only way to pass a set that begins with a `-`. A bare `-` is
  // a set, not an option, which is why the length is checked before the dash.
  i32 first = 1;
  while (first < argv.len()) {
    string a = argv.get(first);
    if (a == "--") { first++; break; }
    u8[] b = a.toBytes();
    if (b.len() < 2 || b[0] != '-') { break; }
    for (i32 i = 1; i < b.len(); i++) {
      if (b[i] == 'd') { del = true; }
      else if (b[i] == 's') { squeeze = true; }
      else if (b[i] == 'c' || b[i] == 'C') { comp = true; }
      else if (b[i] == 't') { trunc = true; }
      else {
        u8[] one = u8[1](fill: b[i]);
        { errs.bytes(optionRefusal("tr", string.fromBytes(one)).toBytes()); errs.flush(); sink.flush(); return 1; }
      }
    }
    first++;
  }

  i32 sets = argv.len() - first;
  if (sets == 0) { { errs.bytes("tr: missing operand\n".toBytes()); errs.flush(); sink.flush(); return 1; } }
  if (sets > 2) {
    { errs.bytes(("tr: extra operand '" + argv.get(first + 2) + "'\n").toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  // Two sets to translate, one to delete or squeeze on its own, and two to do both.
  if (!del && !squeeze && sets != 2) {
    { errs.bytes(("tr: missing operand after '" + argv.get(first) + "'\n").toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  if (del && !squeeze && sets != 1) {
    { errs.bytes(("tr: extra operand '" + argv.get(first + 1) + "'\n").toBytes()); errs.flush(); sink.flush(); return 1; }
  }

  Set s1 = parseSet(argv.get(first), -1);
  if (!s1.ok) { { errs.bytes(s1.message.toBytes()); errs.flush(); sink.flush(); return 1; } }
  // Set2 is parsed knowing set1's length, which is what `[x*]` pads out to.
  Set s2 = sets == 2 ? parseSet(argv.get(first + 1), s1.bytes.len()) : Set(true, u8[0](), "");
  if (!s2.ok) { { errs.bytes(s2.message.toBytes()); errs.flush(); sink.flush(); return 1; } }

  u8[] from = comp ? complementOf(s1.bytes) : s1.bytes;
  u8[] to = s2.bytes;
  if (!del && s1.bytes.len() > 0 && sets == 2 && to.len() == 0) {
    { errs.bytes("tr: when not truncating set1, string2 must be non-empty\n".toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  // `-t`: the pairs stop where set2 does, instead of set2's last character standing in for the rest.
  if (trunc && to.len() < from.len()) {
    u8[] cut = u8[to.len()](fill: 0);
    cut.copyFrom(from, 0, 0, to.len());
    from = cut;
  }

  // 256-entry tables, so the loop over the input is lookups rather than a scan of the set for each
  // byte. With ranges and classes expanded the sets are big enough for that to be the difference.
  u8[] map = u8[256](fill: 0);
  for (i32 i = 0; i < 256; i++) { map[i] = i; }
  u8[] drop = u8[256](fill: 0);
  u8[] runs = u8[256](fill: 0);

  if (del) {
    for (i32 i = 0; i < from.len(); i++) { drop[from[i]] = 1; }
  } else if (sets == 2) {
    for (i32 i = 0; i < from.len(); i++) {
      // A short second set repeats its last character, as tr does.
      if (to.len() > 0) { map[from[i]] = i < to.len() ? to[i] : to[to.len() - 1]; }
    }
  }
  if (squeeze) {
    // The *last* set given is the one squeezed: `tr -s ab` collapses runs of a and b, and
    // `tr -s ab x` collapses runs of x — after the translation, which is what produced them.
    u8[] runsOf = sets == 2 ? to : from;
    for (i32 i = 0; i < runsOf.len(); i++) { runs[runsOf[i]] = 1; }
  }

  // A chunk at a time, holding a chunk. The tables above are the whole of the state that depends on
  // the *arguments*; the only thing that depends on the input is `previous`, the last byte written,
  // which is what `-s` needs and which has to carry across a chunk boundary — a run of `aaa` split
  // between two reads is still one run. 0071.
  i32 previous = -1;
  while (true) {
    u8[] chunk = fed.next();
    if (chunk.len() == 0) { break; }
    Buf out = Buf.create();
    for (i32 i = 0; i < chunk.len(); i++) {
      i32 c = chunk[i];
      if (drop[c] != 0) { continue; }
      i32 v = map[c];
      if (runs[v] != 0 && v == previous) { continue; }
      out.push(v);
      previous = v;
    }
    if (!sink.bytes(out.take())) { return 0; }
  }
  { sink.flush(); return 0; }
}

/** A parsed set: the bytes it names, or why it could not be read. */
struct Set {
  bool ok;
  u8[] bytes;
  string message;
}

/**
 * One of `tr`'s sets: escapes, classes, repeats, equivalence classes, then ranges.
 *
 * Each of the first two was silently something else. `tr : '\n'` translated colons to a backslash and
 * an `n` — the *shell* does not interpret `\n` in `'…'` and neither did this, so the commonest way to
 * split a line on a delimiter produced two wrong characters where one was wanted. `[:digit:]` was eight
 * literal characters, so `tr '[:digit:]' x` turned brackets and colons into `x` and left the digits
 * alone.
 *
 * The other two were *refused*, which was better than pretending and worse than working: GNU has them,
 * so a refusal named a gap in this program as though it were a mistake in the command. `[c*n]` is `n`
 * copies of `c` — octal if `n` has a leading zero, as GNU reads it — and `[c*]` pads set2 out to set1's
 * length, which is how `tr abc '[x*]'` means `xxx`. `[=c=]` is `c` itself, there being one character in
 * an equivalence class in the C locale.
 *
 * `targetLen` is set1's length when this is set2, and -1 when this *is* set1 — which is also what makes
 * `[c*]` an error there, as it is in GNU: there is nothing for it to pad to.
 *
 * **Ranges form from literal text only.** A `-` that arrived from an escape or a class is a character,
 * not a range: `tr 'a\-b' xyz` translates three characters, and `[:punct:]` contains a dash that used
 * to be able to swallow its neighbours. The mask is what tells them apart, and it is why ranges are
 * expanded here rather than by a pass over the finished bytes.
 */
Set parseSet(string set, i32 targetLen) {
  u8[] raw = set.toBytes();
  Buf lit = Buf.create();
  Buf plain = Buf.create();     // 1 where a byte was written literally, so a range may form from it
  i32 padChar = -1;
  i32 padAt = -1;

  for (i32 i = 0; i < raw.len(); i++) {
    if (raw[i] == '[' && i + 1 < raw.len() && raw[i + 1] == ':') {
      i32 close = classEnd(raw, i);
      if (close < 0) { return Set(false, u8[0](), "tr: unterminated character class\n"); }
      string name = string.fromBytes(sliceBytes(raw, i + 2, close - 1));
      u8[] members = classBytes(name);
      if (members.len() == 0) {
        return Set(false, u8[0](), "tr: invalid character class '" + name + "'\n");
      }
      pushExpanded(lit, plain, members);
      i = close;
      continue;
    }
    if (raw[i] == '[' && i + 1 < raw.len() && raw[i + 1] == '=') {
      i32 close = equivEnd(raw, i);
      if (close < 0) { return Set(false, u8[0](), "tr: unterminated equivalence class\n"); }
      u8[] inside = sliceBytes(raw, i + 2, close - 1);
      if (inside.len() != 1) {
        return Set(false, u8[0](), "tr: " + string.fromBytes(inside) +
          ": equivalence class operand must be a single character\n");
      }
      pushExpanded(lit, plain, inside);
      i = close;
      continue;
    }
    i32 star = repeatEnd(raw, i);
    if (star > 0) {
      u8[] count = sliceBytes(raw, i + 3, star);
      if (count.len() == 0 || allZero(count)) {
        // `[c*]` and `[c*0]` both mean "as many as it takes", which only set2 can answer.
        if (targetLen < 0) {
          return Set(false, u8[0](), "tr: the [c*] repeat construct may not appear in string1\n");
        }
        padChar = raw[i + 1];
        padAt = lit.bytes().len();
        i = star;
        continue;
      }
      i32 n = repeatCount(count);
      if (n < 0) {
        return Set(false, u8[0](), "tr: invalid repeat count '" + string.fromBytes(count) +
          "' in [c*n] construct\n");
      }
      u8[] copies = u8[n](fill: raw[i + 1]);
      pushExpanded(lit, plain, copies);
      i = star;
      continue;
    }
    if (raw[i] == 0x5c && i + 1 < raw.len()) {                     // '\'
      i32 was = lit.bytes().len();
      i32 next = trEscape(lit, raw, i);
      // Whatever the escape produced is a character rather than range material.
      for (i32 k = was; k < lit.bytes().len(); k++) { plain.push(0); }
      i = next - 1;                                                // the loop's own `i++` follows
      continue;
    }
    lit.push(raw[i]);
    plain.push(1);
  }

  Set ranged = expandRanges(lit.bytes(), plain.bytes());
  if (!ranged.ok) { return ranged; }
  if (padChar < 0) { return ranged; }

  // The pad is however many characters set2 still needs, which is why it is applied last: the count
  // depends on everything else in the set, before it and after it.
  i32 short = targetLen - ranged.bytes.len();
  if (short < 0) { short = 0; }
  Buf out = Buf.create();
  for (i32 i = 0; i < padAt; i++) { out.push(ranged.bytes[i]); }
  for (i32 i = 0; i < short; i++) { out.push(padChar); }
  for (i32 i = padAt; i < ranged.bytes.len(); i++) { out.push(ranged.bytes[i]); }
  return Set(true, out.bytes(), "");
}

/** Bytes that came from an expansion: characters, never a range's endpoints or its dash. */
void pushExpanded(Buf lit, Buf plain, u8[] bytes) {
  lit.pushAll(bytes);
  for (i32 i = 0; i < bytes.len(); i++) { plain.push(0); }
}

/**
 * `a-z` becomes the twenty-six bytes it names, where all three characters were written literally.
 *
 * Ranges last, or `a-z` is the three-character set `{a, -, z}` and the commonest use of `tr` in
 * existence silently does almost nothing — issue 0019, which is exactly what happened.
 */
Set expandRanges(u8[] b, u8[] plain) {
  Buf out = Buf.create();
  for (i32 i = 0; i < b.len(); i++) {
    bool range = i + 2 < b.len() && b[i + 1] == '-' &&
      plain[i] != 0 && plain[i + 1] != 0 && plain[i + 2] != 0;
    if (!range) { out.push(b[i]); continue; }
    if (b[i + 2] < b[i]) {
      // Named, as GNU names it: with two sets on one command line, "which range" is the question a
      // person actually has.
      u8[] pair = u8[3](fill: 0);
      pair[0] = b[i];
      pair[1] = '-';
      pair[2] = b[i + 2];
      return Set(false, u8[0](), "tr: range-endpoints of '" + string.fromBytes(pair) +
        "' are in reverse collating sequence order\n");
    }
    for (i32 c = b[i]; c <= b[i + 2]; c++) { out.push(c); }
    i += 2;
  }
  return Set(true, out.bytes(), "");
}

/** Whether every byte is `0` — `[c*0]` is the pad form, not a repeat of zero. */
bool allZero(u8[] b) {
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] != '0') { return false; }
  }
  return true;
}

/** A repeat count: octal with a leading zero, decimal otherwise, and -1 for anything else. */
i32 repeatCount(u8[] b) {
  i32 base = b[0] == '0' ? 8 : 10;
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < '0' || b[i] >= '0' + base) { return -1; }
    v = v * base + (b[i] - '0');
  }
  return v;
}

/** Where a `[=c=]` ends, or -1. */
i32 equivEnd(u8[] b, i32 at) {
  for (i32 i = at + 2; i + 1 < b.len(); i++) {
    if (b[i] == '=' && b[i + 1] == ']') { return i + 1; }
  }
  return -1;
}

/**
 * One of `tr`'s escapes, appended. Returns the index after it.
 *
 * Not `escapeInto`, which is `printf`'s and is a different language: that one knows `\e` and `\xHH`
 * and keeps the backslash before anything it does not know. `tr` has neither, and drops the backslash
 * instead — `tr '\q' X` translates a `q` and `tr '\x41' X` translates an `x`, a `4` and a `1`. Sharing
 * the printf one would have made `\x41` an `A` here, silently, which is the class of bug this whole
 * function exists to remove.
 */
i32 trEscape(Buf out, u8[] b, i32 at) {
  i32 c = b[at + 1];
  if (c == 0x6e) { out.push(10); return at + 2; }            // \n
  if (c == 0x74) { out.push(9); return at + 2; }             // \t
  if (c == 0x72) { out.push(13); return at + 2; }            // \r
  if (c == 0x5c) { out.push(0x5c); return at + 2; }          // \\
  if (c == 0x61) { out.push(7); return at + 2; }             // \a
  if (c == 0x62) { out.push(8); return at + 2; }             // \b
  if (c == 0x66) { out.push(12); return at + 2; }            // \f
  if (c == 0x76) { out.push(11); return at + 2; }            // \v
  if (c >= 0x30 && c <= 0x37) {                              // \NNN, up to three octal digits
    i32 p = at + 1;
    i32 v = 0;
    i32 n = 0;
    while (p < b.len() && n < 3 && b[p] >= 0x30 && b[p] <= 0x37) { v = v * 8 + (b[p] - 0x30); p++; n++; }
    out.push(v & 0xFF);
    return p;
  }
  // Anything else loses its backslash and keeps its character, which is what GNU's does.
  out.push(c);
  return at + 2;
}

/** Where a `[:name:]` ends, or -1. */
i32 classEnd(u8[] b, i32 at) {
  for (i32 i = at + 2; i + 1 < b.len(); i++) {
    if (b[i] == ':' && b[i + 1] == ']') { return i + 1; }
  }
  return -1;
}

/**
 * Where a `[c*n]` ends, or -1.
 *
 * The count is *not* validated here — anything up to the `]` counts as one — because `[x*a]` is a
 * malformed repeat rather than five literal characters, and GNU says so. Requiring digits made it
 * literal text and printed `[x*`, which is the shape of answer this file exists to stop producing.
 * An unterminated `[x*` really is literal, in both.
 */
i32 repeatEnd(u8[] b, i32 at) {
  if (b[at] != '[' || at + 3 >= b.len() || b[at + 2] != '*') { return -1; }
  for (i32 i = at + 3; i < b.len(); i++) {
    if (b[i] == ']') { return i; }
  }
  return -1;
}

/** The bytes of a POSIX character class in the C locale, or none for a name that is not one. */
u8[] classBytes(string name) {
  Buf out = Buf.create();
  for (i32 c = 0; c < 128; c++) {
    bool upper = c >= 'A' && c <= 'Z';
    bool lower = c >= 'a' && c <= 'z';
    bool digit = c >= '0' && c <= '9';
    bool blank = c == 32 || c == 9;
    bool space = blank || (c >= 10 && c <= 13);
    bool cntrl = c < 32 || c == 127;
    bool graph = c > 32 && c < 127;
    bool member = false;
    if (name == "alpha") { member = upper || lower; }
    else if (name == "digit") { member = digit; }
    else if (name == "alnum") { member = upper || lower || digit; }
    else if (name == "upper") { member = upper; }
    else if (name == "lower") { member = lower; }
    else if (name == "space") { member = space; }
    else if (name == "blank") { member = blank; }
    else if (name == "cntrl") { member = cntrl; }
    else if (name == "graph") { member = graph; }
    else if (name == "print") { member = c >= 32 && c < 127; }
    else if (name == "punct") { member = graph && !(upper || lower || digit); }
    else if (name == "xdigit") { member = digit || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'); }
    if (member) { out.push(c); }
  }
  return out.bytes();
}

/** Every byte *not* in `set`, ascending — which is the order the pairing with set2 assumes. */
u8[] complementOf(u8[] set) {
  u8[] present = u8[256](fill: 0);
  for (i32 i = 0; i < set.len(); i++) { present[set[i]] = 1; }
  Buf out = Buf.create();
  for (i32 c = 0; c < 256; c++) {
    if (present[c] == 0) { out.push(c); }
  }
  return out.bytes();
}

/** `b[from..to]`, inclusive of `from` and exclusive of `to`. */
u8[] sliceBytes(u8[] b, i32 from, i32 to) {
  if (to <= from) { return u8[0](); }
  u8[] out = u8[to - from](fill: 0);
  out.copyFrom(b, from, 0, to - from);
  return out;
}

/**
 * `seq [from] to` — the program 0061 was reported against.
 *
 * It used to build every line in memory and hand back the lot: `seq 1 2000000000` ran for five seconds
 * and trapped with "requested new array is too large", and `seq 1 2000000000 | head -1` did the same
 * where bash prints one line. Writing through the sink fixes both halves — the memory is one 64 KiB
 * block, and **the answer is checked**, so when the reader has gone this stops instead of counting to
 * two billion into nothing. That check is the whole of what `head` closing its input does to a producer
 * in a real shell.
 */
/**
 * `seq [FIRST [INCREMENT]] LAST` — whole numbers, counting up or down.
 *
 * **The third argument used to be read and thrown away.** `seq 1 2 9` printed `1 2`: it took the first
 * two as FIRST and LAST and never looked at the increment, so a script asking for the odd numbers to
 * nine got two lines and a status of 0. That is the shape this shell keeps finding and the reason the
 * corpus exists — the case was simply never written, because `seq` was here to *produce* input for the
 * cases about other programs.
 *
 * Everything GNU refuses is refused with GNU's own words, since they are derivable and comparable: a
 * missing operand, a fourth one, an argument that is not a number, a zero increment. What is a gap is
 * announced as a gap: GNU counts in fractions and reads hexadecimal, this counts in whole decimals, and
 * `-f`, `-s` and `-w` are real flags that are not implemented rather than invalid.
 */
i32 seq(Vec<string> argv, Sink sink, Sink errs) {
  Vec<string> operands = Vec.create();
  bool more = true;
  for (i32 i = 1; i < argv.len(); i++) {
    string a = argv.get(i);
    if (more && a == "--") { more = false; continue; }
    u8[] b = a.toBytes();
    // **A negative number is an operand.** `seq -1 1` counts from minus one, and a shell that read
    // `-1` as a bundle of options would refuse the most ordinary way of writing it. GNU decides the
    // same way: a `-` followed by a digit or a decimal point is a number.
    bool numeric = b.len() >= 2 && (b[1] >= '0' && b[1] <= '9' || b[1] == '.');
    if (!more || b.len() < 2 || b[0] != '-' || numeric) { operands.push(a); continue; }
    if (b[1] == '-') {
      { errs.bytes(("seq: unrecognized option '" + a + "'\n" + tryHelp("seq")).toBytes()); errs.flush(); sink.flush(); return 1; }
    }
    u8[] one = u8[1](fill: b[1]);
    { errs.bytes(optionRefusal("seq", string.fromBytes(one)).toBytes()); errs.flush(); sink.flush(); return 1; }
  }

  if (operands.len() == 0) {
    { errs.bytes(("seq: missing operand\n" + tryHelp("seq")).toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  if (operands.len() > 3) {
    { errs.bytes(("seq: extra operand '" + operands.get(3) + "'\n" + tryHelp("seq")).toBytes()); errs.flush(); sink.flush(); return 1; }
  }

  // LAST; or FIRST LAST; or FIRST INCREMENT LAST — GNU's order, with the increment in the middle.
  i32 from = 1;
  i32 step = 1;
  string last = operands.get(operands.len() - 1);
  string firstText = operands.len() > 1 ? operands.get(0) : "1";
  string stepText = operands.len() > 2 ? operands.get(1) : "1";

  Numeral f = numeralOf(firstText);
  Numeral t = numeralOf(last);
  Numeral st = numeralOf(stepText);
  string bad = f.kind != 0 ? firstText : (st.kind != 0 ? stepText : (t.kind != 0 ? last : ""));
  i32 badKind = f.kind != 0 ? f.kind : (st.kind != 0 ? st.kind : t.kind);
  if (bad != "") {
    if (badKind == 1) {
      // A number GNU would count in and this cannot: a fraction, an exponent, hexadecimal, an
      // infinity. Naming the gap rather than calling the argument invalid, because it is not.
      { errs.bytes(("seq: only whole decimal numbers are implemented: '" + bad + "'\n").toBytes()); errs.flush(); sink.flush(); return 1; }
    }
    { errs.bytes(("seq: invalid floating point argument: '" + bad + "'\n" + tryHelp("seq")).toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  from = f.value;
  step = st.value;
  i32 to = t.value;
  if (step == 0) {
    // GNU's capital Z, which is GNU's, and this is compared against it.
    { errs.bytes(("seq: invalid Zero increment value: '" + stepText + "'\n" + tryHelp("seq")).toBytes()); errs.flush(); sink.flush(); return 1; }
  }

  // An increment that cannot reach LAST prints nothing and succeeds, which is what `seq 3 1` does.
  if (step > 0) {
    for (i32 i = from; i <= to; i += step) {
      if (!sink.line(itoa(i))) { return 0; }
    }
  } else {
    for (i32 i = from; i >= to; i += step) {
      if (!sink.line(itoa(i))) { return 0; }
    }
  }
  sink.flush();
  return 0;
}

/** What an argument to `seq` is: a whole number this can count in, a number it cannot, or not a number. */
struct Numeral {
  /** 0 a whole decimal number, 1 a number this does not implement, 2 not a number at all. */
  i32 kind;
  i32 value;
}

/**
 * Classify one of `seq`'s arguments.
 *
 * The three answers are three different messages, which is the whole reason this is a classification
 * and not a parse: `1.5` is a number GNU counts in and this does not, `abc` is not a number at all,
 * and telling a caller their `1.5` is invalid would be blaming them for a gap here.
 *
 * "A number this does not implement" is judged loosely on purpose — anything with a decimal point, an
 * exponent, a `0x` prefix, or the words `inf` and `nan`, which is what `strtold` accepts and GNU takes.
 * Being too generous here costs a "not implemented" where GNU would have said "invalid"; being too
 * strict costs the reverse, and that is the one that lies.
 */
Numeral numeralOf(string text) {
  u8[] b = text.toBytes();
  i32 at = 0;
  if (b.len() > 0 && (b[0] == '-' || b[0] == '+')) { at = 1; }
  if (at >= b.len()) { return Numeral(2, 0); }

  bool digits = false;
  bool whole = true;
  for (i32 i = at; i < b.len(); i++) {
    if (b[i] >= '0' && b[i] <= '9') { digits = true; continue; }
    whole = false;
  }
  if (digits && whole) { return Numeral(0, atoi(text)); }

  string lower = string.fromBytes(lowered(b));
  bool hex = b.len() > at + 1 && b[at] == '0' && (b[at + 1] == 'x' || b[at + 1] == 'X');
  bool word = lower == "inf" || lower == "-inf" || lower == "+inf" || lower == "infinity" ||
              lower == "-infinity" || lower == "+infinity" || lower == "nan" || lower == "-nan" ||
              lower == "+nan";
  if (hex || word) { return Numeral(1, 0); }

  // A decimal fraction or an exponent: digits, with at most one point and one `e`, and nothing else.
  bool point = false;
  bool exponent = false;
  bool ok = digits;
  for (i32 i = at; i < b.len(); i++) {
    // i32, not u8: a packed type cannot be a local in wac.
    i32 c = b[i];
    if (c >= '0' && c <= '9') { continue; }
    if (c == '.' && !point && !exponent) { point = true; continue; }
    if ((c == 'e' || c == 'E') && !exponent && digits) {
      exponent = true;
      if (i + 1 < b.len() && (b[i + 1] == '-' || b[i + 1] == '+')) { i++; }
      continue;
    }
    ok = false;
  }
  return Numeral(ok ? 1 : 2, 0);
}

i32 nl(Cli cli, string cwd, Vec<string> argv, Feed fed, Sink sink, Sink errs) {
  Options o = options(argv, "");
  if (o.bad != "") {
    { errs.bytes(optionRefusal("nl", o.bad).toBytes()); errs.flush(); sink.flush(); return 1; }
  }
  // The count runs on across the operands, as GNU's does, so it is state carried between them rather
  // than a local. Nothing else is held: numbering costs one integer. 0071.
  Counter state = Counter(0, false);
  if (o.operands.len() == 0) { nlFeed(fed, sink, state); return 0; }
  i32 status = 0;
  for (i32 i = 0; i < o.operands.len(); i++) {
    string path = o.operands.get(i);
    if (path == "-") { nlFeed(fed, sink, state); continue; }
    FileResult f = cli.readFile(resolvePath(cwd, path)).wait();
    if (!f.ok) {
      complain(sink, errs, "nl: " + path + ": " + whyUnread(f) + "\n");
      status = 1;
      continue;
    }
    if (!nlFeed(Feed.of(cli, f.bytes), sink, state)) { break; }
  }
  { sink.flush(); errs.flush(); return status; }
}

/**
 * Numbered lines, one at a time.
 *
 * **A blank line is not numbered**, which is GNU's default body type (`-b t`) and was wrong here: this
 * numbered every line, so any input with a blank line in it came out with different numbers from GNU's
 * from that point on. An unnumbered line is padded to the same width — six columns and the separator,
 * which is seven spaces, because GNU pads by the number width *plus* the length of the separator
 * rather than printing the separator itself.
 */
bool nlFeed(Feed fed, Sink sink, Counter state) {
  Lines lines = Lines.create();
  while (true) {
    Line l = nextLine(lines, fed);
    if (!l.ok) { break; }
    Buf out = Buf.create();
    if (l.bytes.len() == 0) {
      out.pushAll("       ".toBytes());
    } else {
      state.lines++;
      out.pushAll((rightAlign(itoa(state.lines), 6) + "\t").toBytes());
    }
    out.pushAll(l.bytes);
    // As `uniq` does, and unlike `rev`: GNU's `nl` terminates the last line even when its input did
    // not.
    if (!sink.lineBytes(out.take())) { return false; }
  }
  sink.flush();
  return true;
}


// ── Shared ────────────────────────────────────────────────────────────────────

/**
 * Split into lines, dropping a single trailing newline.
 *
 * Text with a final newline and text without it must produce the same lines, or every filter in a
 * pipeline gains or loses a blank line at the end depending on what fed it.
 */
Vec<u8[]> splitLines(u8[] data) {
  Vec<u8[]> out = Vec.create();
  i32 start = 0;
  for (i32 i = 0; i < data.len(); i++) {
    if (data[i] == 10) {
      out.push(sliceOf(data, start, i));
      start = i + 1;
    }
  }
  if (start < data.len()) { out.push(sliceOf(data, start, data.len())); }
  return out;
}

u8[] firstLines(u8[] data, i32 n) {
  Buf out = Buf.create();
  i32 seen = 0;
  i32 start = 0;
  for (i32 i = 0; i < data.len() && seen < n; i++) {
    if (data[i] == 10) {
      out.pushBytes(data, start, i - start + 1);
      start = i + 1;
      seen++;
    }
  }
  if (seen < n && start < data.len()) {
    out.pushBytes(data, start, data.len() - start);
    out.push(10);
  }
  return out.take();
}

bool after(u8[] a, u8[] b, bool reverse) {
  i32 c = compare(a, b);
  return reverse ? c < 0 : c > 0;
}

i32 compare(u8[] a, u8[] b) {
  i32 n = a.len() < b.len() ? a.len() : b.len();
  for (i32 i = 0; i < n; i++) {
    if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1; }
  }
  if (a.len() == b.len()) { return 0; }
  return a.len() < b.len() ? -1 : 1;
}

bool contains(u8[] haystack, u8[] needle) {
  if (needle.len() == 0) { return true; }
  if (needle.len() > haystack.len()) { return false; }
  for (i32 i = 0; i + needle.len() <= haystack.len(); i++) {
    bool hit = true;
    for (i32 j = 0; j < needle.len(); j++) {
      if (haystack[i + j] != needle[j]) { hit = false; break; }
    }
    if (hit) { return true; }
  }
  return false;
}

bool sameBytes(u8[] a, u8[] b) {
  if (a.len() != b.len()) { return false; }
  for (i32 i = 0; i < a.len(); i++) {
    if (a[i] != b[i]) { return false; }
  }
  return true;
}

u8[] sliceOf(u8[] s, i32 from, i32 to) {
  if (to <= from) { return u8[0](); }
  u8[] out = u8[to - from]();
  out.copyFrom(s, from, 0, to - from);
  return out;
}


