// `sh` — the shell as a program, entire, in wac.
//
//   deno task app packages/sh/src/sh.wac --allow-read --allow-env -- -c 'echo hi | rev'
//   deno task app:build packages/sh/src/sh.wac --allow-read --allow-write --allow-env -o wacsh
//   ./wacsh script.sh
//
// Usage:
//
//   sh -c 'script'      run the argument
//   sh file             run the file
//   sh                  run standard input
//
// External commands are a spawned `$WACPATH` program, then whatever was wired into
// `Shell.external`, then the small table in `program.wac`. This entry wires nothing, so it is the
// third — `help` lists what there is. `packages/box/src/bin/sh.wac` is the same shell with sixty
// applets wired in, and it is four lines, because the shell being handed its programs rather than
// containing them is the point of the seam.

import { Cli, Core } from "../../platform/src/platform.wac";
import { Shell } from "./exec.wac";
import { shellMain } from "./entry.wac";

export i32 main(Core core, Cli cli) {
  return shellMain(core, cli, Shell.create(core, cli), 0);
}
