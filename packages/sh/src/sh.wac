// `sh` — the shell as a program, entire, in wac.
//
//   deno task app packages/sh/src/sh.wac --allow-read --allow-env -- -c 'echo hi | rev'
//   deno task app:build packages/sh/src/sh.wac --allow-read --allow-write --allow-env -o wacsh
//   ./wacsh script.sh
//
// Usage:
//
//   sh -c 'script'      run the argument
//   sh file             run the file
//   sh                  run standard input
//
// External commands are a spawned `$WACPATH` program, then whatever was wired into
// `Shell.external`, then the small table in `program.wac`. This entry wires nothing, so it is the
// third — `help` lists what there is. `packages/box/src/bin/sh.wac` is the same shell with sixty
// applets wired in, and it is four lines, because the shell being handed its programs rather than
// containing them is the point of the seam.

import { Cli, Core } from "../../platform/src/platform.wac";
import { Vec } from "../../std/src/vec.wac";
import { Shell } from "./exec.wac";
import { shellMain } from "./entry.wac";
import { isProgram, programNames, runStreaming } from "./program.wac";

/**
 * A shell, or one of its own twelve programs — decided by the first argument.
 *
 * This is what a multi-call binary is, and `packages/box` has been one for a while: `box sort` is `box`
 * with `sort` as its first argument. The shell needs to be one so that it can run its *own* programs as
 * real children — `spawnSelf(["seq", "1", "5"])` re-enters here, `runStreaming` answers, and the child
 * writes through the capability as it goes rather than handing back every byte at once. Without it the
 * twelve could only ever be called in process, which is why `seq 1 2000000000 | head -1` trapped where
 * bash prints one line. wac-mono 0061.
 *
 * Deciding by argv rather than by a flag keeps the two spellings identical for the shell's own dispatch
 * and for a person: `wacsh seq 1 5` works, and so does `wacsh -c 'seq 1 5'`.
 */
export i32 main(Core core, Cli cli) {
  i32 n = cli.argCount().wait();
  if (n >= 1 && isProgram(cli.arg(0).wait())) {
    Vec<string> argv = Vec.create();
    for (i32 i = 0; i < n; i++) { argv.push(cli.arg(i).wait()); }
    return runStreaming(cli, cli.cwd().wait(), argv);
  }

  Shell sh = Shell.create(core, cli);
  // The twelve are programs of this very bundle, so the shell *could* spawn them rather than call them
  // — `sh.externalSpawnable = true` is the one line — and that is what makes a pipeline's stages run at
  // once and lets `head` stop `seq`. It is off, because turning it on made two differential scripts
  // disagree with bash and both are platform bugs rather than shell bugs:
  //
  //   * a non-UTF-8 argument does not survive a spawn. `cat $(printf '\xff\xfe')` names the file with
  //     two replacement characters, because the wire format decodes arguments as text — wac-mono 0065.
  //   * a spawned child does not receive what the shell has left of its standard input, so
  //     `{ read a; cat; } <<EOF` prints nothing where bash prints the rest — wac-mono 0066.
  //
  // Both are reachable today by anything that wires `Shell.external` — `packages/box`'s terminal spawns
  // sixty applets — so they are worth fixing rather than routing around, and this line is what turns the
  // fix on. Until then the twelve are called in process, which is where they were.
  sh.externalNames = programNames;
  return shellMain(core, cli, sh, 0);
}
