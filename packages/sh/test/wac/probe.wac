// The shell at the coverage boundary.
//
// Running the shell needs a `Core` and a `Cli`, which normally come from the host. Building them
// here instead keeps the whole thing inside wac, so `instrument` can drive scripts through the
// lexer, parser and executor with one call and no capability plumbing on the TypeScript side.
//
// **The fake capabilities are pure functions**, because wac has no mutable module-level state and
// a funcref cannot close over anything. That is not the limitation it sounds like: a fixed answer
// per path reaches both sides of every branch that asks. `readFile` succeeds for two names and
// fails for everything else, `writeFile` succeeds for one and fails otherwise, `readDir` answers
// for one directory and not for others — which is all coverage needs, and all a test of the
// *shell* should depend on anyway.


// ── Faking a capability world ─────────────────────────────────────────────────
//
// Every capability that produces a value now hands back a `Pending<T>` — a ticket carrying its
// own resolver, because a struct method cannot reach the `Cli` it came from and wac has no
// closures.
//
// That last point is what shapes this file. A fake cannot capture the answer it wants to give,
// so **the answer is encoded in the ticket's id** and a top-level resolver decodes it. `readFile`
// picks an id from the path; `resolveFile` turns the id back into a `FileResult`. It reads
// oddly and it is the only way to build a resolved ticket without state.

import { Captured, Change, Child, Cli, Core, FAULT_DENIED, FAULT_NONE, FAULT_NOT_FOUND, FileResult,
  Pending, Socket, Stat } from "../../../platform/src/platform.wac";
import { Read } from "../../../bytes/src/read.wac";
import { Shell, runScript } from "../../src/exec.wac";

/** A ticket is always ready here, and dropping one does nothing. */
bool alwaysSettled(i32 id) { return true; }
void ignoreDrop(i32 id) {}

// ── Core ──────────────────────────────────────────────────────────────────────

i64 resolveZero(i32 id) { return 0; }
u8[] resolveBytes(i32 id) { return u8[id](); }

Pending<i64> fakeNow() { return Pending.of(0, resolveZero, alwaysSettled, ignoreDrop); }
Pending<i64> fakeMonotonic() { return Pending.of(0, resolveZero, alwaysSettled, ignoreDrop); }
Pending<u8[]> fakeRandom(i32 n) { return Pending.of(n, resolveBytes, alwaysSettled, ignoreDrop); }
/** Time does not pass here, so a sleep is already over. The shell never asks for one anyway. */
Pending<i64> fakeSleep(i32 millis) { return Pending.of(0, resolveZero, alwaysSettled, ignoreDrop); }
void fakeLog(string s) {}
void fakeWarn(string s) {}

Core fakeCore() {
  return Core.of(fakeNow, fakeMonotonic, fakeSleep, fakeRandom, fakeLog, fakeWarn,
                 fakeWaitAny);
}

// ── Cli ───────────────────────────────────────────────────────────────────────

i32 resolveZeroI32(i32 id) { return 0; }
string resolveEmpty(i32 id) { return ""; }
bool resolveTrue(i32 id) { return true; }
bool resolveFromId(i32 id) { return id != 0; }
u8[] resolveStdin(i32 id) { return "piped\n".toBytes(); }

Pending<i32> fakeArgCount() { return Pending.of(0, resolveZeroI32, alwaysSettled, ignoreDrop); }
Pending<string> fakeArg(i32 i) { return Pending.of(0, resolveEmpty, alwaysSettled, ignoreDrop); }
Pending<u8[]> fakeStdin() { return Pending.of(0, resolveStdin, alwaysSettled, ignoreDrop); }
bool fakeWrite(u8[] data) { return true; }
bool fakeWriteErr(u8[] data) { return true; }

/** One name is set and one is not, so both sides of the environment fallback are reachable. */
string? resolveEnv(i32 id) {
  if (id == 1) { return "from-env"; }
  return null;
}
Pending<string?> fakeEnv(string name) {
  return Pending.of(name == "SET_IN_ENV" ? 1 : 0, resolveEnv, alwaysSettled, ignoreDrop);
}

/** `in.txt`, `words.txt` and `out.txt` exist; nothing else does. */
FileResult resolveFile(i32 id) {
  if (id == 1) { return FileResult.of(true, "alpha\nbeta\n".toBytes(), "", FAULT_NONE()); }
  if (id == 2) { return FileResult.of(true, "b\na\nc\n".toBytes(), "", FAULT_NONE()); }
  if (id == 3) { return FileResult.of(true, "existing\n".toBytes(), "", FAULT_NONE()); }
  // Two "worker bundles", distinguished only by their contents, so `fakeSpawn` can start one and
  // refuse the other without holding any state. See the spawn section below.
  if (id == 4) { return FileResult.of(true, "runnable".toBytes(), "", FAULT_NONE()); }
  if (id == 5) { return FileResult.of(true, "unrunnable".toBytes(), "", FAULT_NONE()); }
  if (id == 6) { return FileResult.of(true, "vanishing".toBytes(), "", FAULT_NONE()); }
  if (id == 7) { return FileResult.of(true, "nospawnworld".toBytes(), "", FAULT_NONE()); }
  // The category as well as the message, as a host answers now: a program that phrases
  // "No such file or directory" from the *fault* would otherwise see FAULT_NONE here and print the
  // double's own words instead. wac-mono 0062.
  return FileResult.of(false, u8[0](), "no such file", FAULT_NOT_FOUND());
}
Pending<FileResult> fakeReadFile(string path) {
  i32 which = 0;
  if (path == "in.txt") { which = 1; }
  if (path == "words.txt") { which = 2; }
  if (path == "out.txt") { which = 3; }
  if (path == "/bin/prog") { which = 4; }
  if (path == "/bin/badprog") { which = 5; }
  if (path == "/bin/goneprog") { which = 6; }
  // A name that also exists as one of the shell's own implementations, so that falling through can
  // be told from failing: in a world with no `spawn` this must run `echo`, not report 126.
  if (path == "/bin/echo") { which = 7; }
  // `/bin/ghost` exists as far as `stat` is concerned and cannot be read, which is not a
  // contrived case: another process removing it between the two calls is the ordinary race, and
  // the shell has to answer "no such command" rather than treat it as a failure to execute.
  return Pending.of(which, resolveFile, alwaysSettled, ignoreDrop);
}

/** `out.txt` is writable and `readonly.txt` is not, so both paths through a redirection run. */
/**
 * The write outcome, as a `Change`.
 *
 * `readonly.txt` fails, so both branches of every caller are reachable — the fake cannot hold the
 * answer itself, so it goes in the ticket's id and `resolveChange` decodes it.
 */
Pending<Change> fakeWriteFile(string path, u8[] data) {
  return Pending.of(path == "readonly.txt" ? 2 : 0, resolveChange, alwaysSettled, ignoreDrop);
}

/**
 * A change, by id: 0 worked, 1 was not there, 2 was refused.
 *
 * The ids are the fault numbers themselves, so this is the identity on the category and only the
 * words are invented — a fake host is entitled to its own wording but not to its own taxonomy.
 */
Change resolveChange(i32 id) {
  if (id == FAULT_NOT_FOUND()) { return Change.of(id, "no such file or directory"); }
  if (id == FAULT_DENIED()) { return Change.of(id, "permission denied"); }
  return Change.of(FAULT_NONE(), "");
}

/** Only the two programs under `/bin` exist, which is what makes a `$WACPATH` search decide. */
Stat resolveStat(i32 id) { return Stat.of(id == 1, id == 1, false, 0, 0, false); }

/** Nothing here is a symbolic link, which a fake filesystem is entitled to say. */
Pending<Stat> fakeLinkStat(string path) { return fakeStat(path); }

/** Nothing went wrong with the last write, and nothing with the last recv. */
Pending<string> fakeOutputError() { return Pending.of(0, resolveEmpty, alwaysSettled, ignoreDrop); }
Pending<Stat> fakeStat(string path) {
  return Pending.of(present(path) ? 1 : 0, resolveStat, alwaysSettled, ignoreDrop);
}

/** What this filesystem has, in one place, so `stat` and `remove` cannot disagree. */
bool present(string path) {
  return path == "/bin/prog" || path == "/bin/badprog" || path == "/bin/goneprog"
      || path == "/bin/ghost" || path == "/bin/echo";
}

string[]? resolveDir(i32 id) {
  if (id == 0) { return null; }
  // Deliberately out of order and with a dotfile: a glob sorts its matches and excludes names
  // beginning with a dot unless the pattern does too, and neither branch runs against a tidy
  // directory of two sorted names.
  string[] names = string[4]();
  names[0] = "two";
  names[1] = "one";
  names[2] = ".hidden";
  names[3] = "three";
  return names;
}
Pending<string[]?> fakeReadDir(string path) {
  return Pending.of(path == "dir" ? 1 : 0, resolveDir, alwaysSettled, ignoreDrop);
}

Pending<Change> fakeMkdir(string path, bool parents) {
  return Pending.of(FAULT_NONE(), resolveChange, alwaysSettled, ignoreDrop);
}

/**
 * Removing something this fake filesystem does not have is `NotFound`, exactly as `stat` reports it.
 *
 * Kept consistent with `fakeStat` on purpose: `rm -f` asks the *answer* whether the path was merely
 * absent rather than asking `stat` first, so a fake that removed anything successfully would hide
 * the branch that matters.
 */
Pending<Change> fakeRemove(string path, bool recursive) {
  return Pending.of(present(path) ? FAULT_NONE() : FAULT_NOT_FOUND(), resolveChange, alwaysSettled,
                    ignoreDrop);
}
Pending<Change> fakeRename(string from, string to) {
  return Pending.of(FAULT_NONE(), resolveChange, alwaysSettled, ignoreDrop);
}
Pending<string> fakeOpenInput(string path) {
  return Pending.of(0, resolveEmpty, alwaysSettled, ignoreDrop);
}
/**
 * A `Read`, always `End` — this fake filesystem has nothing to stream.
 *
 * The answer is built by a top-level resolver because a funcref cannot close over anything, which is
 * the constraint this whole file is shaped by. `End` rather than `Data(empty)`: an empty `Data` is
 * not a state the type admits.
 */
Read fakeReadChunk() { return Read.End; }
Pending<string> fakeOpenOutput(string path) {
  return Pending.of(0, resolveEmpty, alwaysSettled, ignoreDrop);
}

Socket resolveSocket(i32 id) { return Socket(-1, "no network", "", 0); }
Pending<Socket> fakeConnect(string host, i32 port) {
  return Pending.of(0, resolveSocket, alwaysSettled, ignoreDrop);
}
Pending<Socket> fakeListen(string address, i32 port) {
  return Pending.of(0, resolveSocket, alwaysSettled, ignoreDrop);
}
Pending<Socket> fakeAccept(i32 handle) {
  return Pending.of(0, resolveSocket, alwaysSettled, ignoreDrop);
}
Read resolveEnd(i32 id) { return Read.End; }
Pending<Read> fakeRecv(i32 handle) {
  return Pending.of(0, resolveEnd, alwaysSettled, ignoreDrop);
}
Pending<bool> fakeSend(i32 handle, u8[] data) {
  return Pending.of(0, resolveFromId, alwaysSettled, ignoreDrop);
}
void fakeCloseSocket(i32 handle) {}

// ── Spawning ──────────────────────────────────────────────────────────────────
//
// Nothing can actually run here, so what is faked is the *decision*: `runnable` starts and gets a
// handle, `unrunnable` does not, and the shell's two answers — a status from a child, and 126 for
// a child that would not start — are both reached. Which one it is comes from the source text,
// because a fake cannot hold state and the source is the only thing it is handed.
//
// **What this cannot reach is a child that says anything.** `fakeRecv` is stateless, so it can
// only answer end-of-input; a fake that returned bytes would return them for ever and the read
// loop would not finish. The branch that appends a chunk is covered by `test/spawn.test.ts`
// against the real host instead, which is the only place a child can actually speak.
/**
 * A child, by id — and two ways of failing, because the shell must tell them apart.
 *
 * -1 is "it would not start", which is 126. -2 is "this world has no `spawn`", which is not a fact
 * about the program at all: the shell falls through to its own implementations, as it does in a
 * browser tab where a page cannot spawn.
 */
Child resolveChild(i32 id) {
  // The error stream is a handle of its own; this fake answers end-of-input on every handle, so one
  // more of them changes nothing here and keeps the shape honest.
  if (id > 0) { return Child(id, id + 100, ""); }
  if (id == -2) { return Child(-2, -2, "no spawn in this world"); }
  return Child(-1, -1, "spawn not available");
}
i32 resolveId(i32 id) { return id; }

Pending<Child> fakeSpawn(string source, string[] argv, i32 grants, string cwd, bool inheritIn) {
  i32 handle = -1;
  if (source == "runnable") { handle = 7; }
  // Starts, then never reports a status — `exitCode` answers negative for it. The shell calls that
  // 126 rather than success, because by then it is a host problem and not the program's answer.
  if (source == "vanishing") { handle = 8; }
  // A world with no `spawn` at all, which every host but Deno currently is.
  if (source == "nospawnworld") { handle = -2; }
  return Pending.of(handle, resolveChild, alwaysSettled, ignoreDrop);
}
/**
 * Running this program again, which the fake world cannot do — so it says so rather than pretending.
 *
 * -2 is "there is no `spawn` here", the answer every world that cannot gives, and the one a caller is
 * expected to have another route for.
 */
Pending<Child> fakeSpawnSelf(string[] argv, i32 grants, string cwd, bool inheritIn) {
  return Pending.of(-2, resolveChild, alwaysSettled, ignoreDrop);
}
void fakeCloseFeed(i32 handle) {}
i32 resolveNegative(i32 id) { return -1; }
Pending<i32> fakeExitCode(i32 handle) {
  if (handle == 8) { return Pending.of(0, resolveNegative, alwaysSettled, ignoreDrop); }
  return Pending.of(0, resolveId, alwaysSettled, ignoreDrop);
}

/**
 * Every fake ticket is settled the moment it is made, so the first id is as true as any.
 *
 * `waitAny` moved from `Cli` to `Core` and grew a deadline argument; neither matters here, since
 * nothing is ever outstanding.
 */
i32 fakeWaitAny(i32[] ids, i32 deadlineMillis) { return ids.len() > 0 ? ids[0] : -1; }

/**
 * The shell asks once, at startup, where relative paths land.
 *
 * A root, because a fake filesystem has no better answer and because it makes every path the
 * probe resolves absolute and predictable — `resolvePath("/", "f")` is `/f`.
 */
Pending<string> fakeCwd() { return Pending.of(0, resolveRoot, alwaysSettled, ignoreDrop); }
string resolveRoot(i32 id) { return "/"; }

/**
 * A child pushed here runs and writes nothing, which is what the shell alone should see.
 *
 * The probe has no `box` to hand the shell — that wiring is in `box/example/term.wac` — so the
 * hook is never installed and these are reached only if something calls them directly. Answering
 * with two empty streams keeps that a no-op rather than a crash.
 */
Pending<bool> fakePushChild(string[] argv, u8[] stdin, string cwd) {
  return Pending.of(1, resolveFromId, alwaysSettled, ignoreDrop);
}
Captured resolveNothing(i32 id) { return Captured.of(u8[0](), u8[0]()); }
Pending<Captured> fakePopChild() {
  return Pending.of(0, resolveNothing, alwaysSettled, ignoreDrop);
}

Cli fakeCli() {
  return Cli.of(fakeArgCount, fakeArg, fakeEnv, fakeStdin, fakeWrite, fakeWriteErr, fakeReadFile, fakeWriteFile,
                fakeStat, fakeLinkStat, fakeReadDir, fakeMkdir, fakeRemove, fakeRename, fakeOpenInput,
                fakeReadChunk, fakeOutputError, fakeOpenOutput, fakeConnect, fakeListen, fakeAccept, fakeRecv,
                fakeSend, fakeCloseSocket, fakeSpawn, fakeSpawnSelf, fakeCloseFeed, fakeExitCode,
                fakeCwd, fakePushChild, fakePopChild);
}

// ── What the coverage driver calls ────────────────────────────────────────────

/** Run a script and hand back what it wrote to standard output. */
export u8[] shOut(string src) {
  Shell sh = Shell.capturing(fakeCore(), fakeCli());
  runScript(sh, src);
  return sh.outBuf.take();
}

/** Run a script and hand back its exit status. */
export i32 shStatus(string src) {
  Shell sh = Shell.capturing(fakeCore(), fakeCli());
  return runScript(sh, src);
}

/** Run a script and hand back what it wrote to standard error. */
export u8[] shErr(string src) {
  Shell sh = Shell.capturing(fakeCore(), fakeCli());
  runScript(sh, src);
  return sh.errOut.take();
}

/** The same, writing through the capability rather than collecting — the other branch. */
export i32 shWritten(string src) {
  Shell sh = Shell.create(fakeCore(), fakeCli());
  return runScript(sh, src);
}

/**
 * Call the capabilities the shell never uses.
 *
 * `Cli.of` needs all twenty-one and the shell touches five, so the rest are unreachable through a
 * script. They are scaffolding rather than code under test, and exercising them once costs
 * nothing and keeps the report honest about what has actually run.
 */
export i32 shTouchStubs() {
  Cli c = fakeCli();
  i32 n = c.argCount().wait() + c.arg(0).wait().len() + c.readStdin().wait().len();
  // Every state of a read, so the coverage driver touches all three arms rather than whichever one
  // the fake happens to produce.
  match (c.readChunk()) {
    case Data(bytes): { n = n + bytes.len(); }
    case End: { n++; }
    case Failed(why): { n = n + why.len(); }
  }
  match (c.recv(1).wait()) {
    case Data(bytes): { n = n + bytes.len(); }
    case End: { n++; }
    case Failed(why): { n = n + why.len(); }
  }
  if (c.env("SET_IN_ENV").wait() is not null) { n++; }
  if (c.env("NOT_SET").wait() is null) { n++; }
  if (c.write(u8[0]())) { n++; }
  if (c.stat("x").wait().exists) { n++; }
  if (c.readDir("dir").wait() is not null) { n++; }
  if (c.readDir("nope").wait() is null) { n++; }
  // The three answer a `Change`: a fault category beside the host's own words.
  if (c.mkdir("d", true).wait().ok()) { n++; }
  if (c.remove("d", true).wait().ok()) { n++; }
  if (c.rename("a", "b").wait().ok()) { n++; }
  n += c.openInput("x").wait().len() + c.openOutput("x").wait().len();
  n += c.connect("h", 1).wait().handle + c.listen("127.0.0.1", 1).wait().handle + c.accept(1).wait().handle;
  if (c.send(1, u8[0]()).wait()) { n++; }
  c.closeSocket(1);

  Core k = fakeCore();
  n += (k.nowMillis().wait() + k.monotonicNanos().wait()) as~ i32;
  n += k.randomBytes(2).wait().len();
  k.log("");
  k.warn("");
  return n;
}
