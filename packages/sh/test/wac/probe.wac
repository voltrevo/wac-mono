// The shell at the coverage boundary.
//
// Running the shell needs a `Core` and a `Cli`, which normally come from the host. Building them
// here instead keeps the whole thing inside wac, so `instrument` can drive scripts through the
// lexer, parser and executor with one call and no capability plumbing on the TypeScript side.
//
// **The fake capabilities are pure functions**, because wac has no mutable module-level state and
// a funcref cannot close over anything. That is not the limitation it sounds like: a fixed answer
// per path reaches both sides of every branch that asks. `readFile` succeeds for two names and
// fails for everything else, `writeFile` succeeds for one and fails otherwise, `readDir` answers
// for one directory and not for others — which is all coverage needs, and all a test of the
// *shell* should depend on anyway.


// ── Faking a capability world ─────────────────────────────────────────────────
//
// Every capability that produces a value now hands back a `Pending<T>` — a ticket carrying its
// own resolver, because a struct method cannot reach the `Cli` it came from and wac has no
// closures.
//
// That last point is what shapes this file. A fake cannot capture the answer it wants to give,
// so **the answer is encoded in the ticket's id** and a top-level resolver decodes it. `readFile`
// picks an id from the path; `resolveFile` turns the id back into a `FileResult`. It reads
// oddly and it is the only way to build a resolved ticket without state.

import { Cli, Core, FileResult, Pending, Socket, Stat } from "../../../platform/src/platform.wac";
import { Shell, runScript } from "../../src/exec.wac";

/** A ticket is always ready here, and dropping one does nothing. */
bool alwaysSettled(i32 id) { return true; }
void ignoreDrop(i32 id) {}

// ── Core ──────────────────────────────────────────────────────────────────────

i64 resolveZero(i32 id) { return 0; }
u8[] resolveBytes(i32 id) { return u8[id](); }

Pending<i64> fakeNow() { return Pending.of(0, resolveZero, alwaysSettled, ignoreDrop); }
Pending<i64> fakeMonotonic() { return Pending.of(0, resolveZero, alwaysSettled, ignoreDrop); }
Pending<u8[]> fakeRandom(i32 n) { return Pending.of(n, resolveBytes, alwaysSettled, ignoreDrop); }
void fakeLog(string s) {}
void fakeWarn(string s) {}

Core fakeCore() {
  return Core.of(fakeNow, fakeMonotonic, fakeRandom, fakeLog, fakeWarn);
}

// ── Cli ───────────────────────────────────────────────────────────────────────

i32 resolveZeroI32(i32 id) { return 0; }
string resolveEmpty(i32 id) { return ""; }
bool resolveTrue(i32 id) { return true; }
bool resolveFromId(i32 id) { return id != 0; }
u8[] resolveStdin(i32 id) { return "piped\n".toBytes(); }

Pending<i32> fakeArgCount() { return Pending.of(0, resolveZeroI32, alwaysSettled, ignoreDrop); }
Pending<string> fakeArg(i32 i) { return Pending.of(0, resolveEmpty, alwaysSettled, ignoreDrop); }
Pending<u8[]> fakeStdin() { return Pending.of(0, resolveStdin, alwaysSettled, ignoreDrop); }
bool fakeWrite(u8[] data) { return true; }

/** One name is set and one is not, so both sides of the environment fallback are reachable. */
string? resolveEnv(i32 id) {
  if (id == 1) { return "from-env"; }
  return null;
}
Pending<string?> fakeEnv(string name) {
  return Pending.of(name == "SET_IN_ENV" ? 1 : 0, resolveEnv, alwaysSettled, ignoreDrop);
}

/** `in.txt`, `words.txt` and `out.txt` exist; nothing else does. */
FileResult resolveFile(i32 id) {
  if (id == 1) { return FileResult.of(true, "alpha\nbeta\n".toBytes(), ""); }
  if (id == 2) { return FileResult.of(true, "b\na\nc\n".toBytes(), ""); }
  if (id == 3) { return FileResult.of(true, "existing\n".toBytes(), ""); }
  return FileResult.of(false, u8[0](), "no such file");
}
Pending<FileResult> fakeReadFile(string path) {
  i32 which = 0;
  if (path == "in.txt") { which = 1; }
  if (path == "words.txt") { which = 2; }
  if (path == "out.txt") { which = 3; }
  return Pending.of(which, resolveFile, alwaysSettled, ignoreDrop);
}

/** `out.txt` is writable and `readonly.txt` is not, so both paths through a redirection run. */
Pending<bool> fakeWriteFile(string path, u8[] data) {
  return Pending.of(path == "readonly.txt" ? 0 : 1, resolveFromId, alwaysSettled, ignoreDrop);
}

Stat resolveStat(i32 id) { return Stat.of(false, false, false, 0, 0); }
Pending<Stat> fakeStat(string path) { return Pending.of(0, resolveStat, alwaysSettled, ignoreDrop); }

string[]? resolveDir(i32 id) {
  if (id == 0) { return null; }
  // Deliberately out of order and with a dotfile: a glob sorts its matches and excludes names
  // beginning with a dot unless the pattern does too, and neither branch runs against a tidy
  // directory of two sorted names.
  string[] names = string[4]();
  names[0] = "two";
  names[1] = "one";
  names[2] = ".hidden";
  names[3] = "three";
  return names;
}
Pending<string[]?> fakeReadDir(string path) {
  return Pending.of(path == "dir" ? 1 : 0, resolveDir, alwaysSettled, ignoreDrop);
}

Pending<bool> fakeMkdir(string path, bool parents) {
  return Pending.of(1, resolveTrue, alwaysSettled, ignoreDrop);
}
Pending<bool> fakeRemove(string path, bool recursive) {
  return Pending.of(1, resolveTrue, alwaysSettled, ignoreDrop);
}
Pending<bool> fakeRename(string from, string to) {
  return Pending.of(1, resolveTrue, alwaysSettled, ignoreDrop);
}
Pending<string> fakeOpenInput(string path) {
  return Pending.of(0, resolveEmpty, alwaysSettled, ignoreDrop);
}
u8[] fakeReadChunk() { return u8[0](); }
Pending<string> fakeOpenOutput(string path) {
  return Pending.of(0, resolveEmpty, alwaysSettled, ignoreDrop);
}

Socket resolveSocket(i32 id) { return Socket(-1, "no network"); }
Pending<Socket> fakeConnect(string host, i32 port) {
  return Pending.of(0, resolveSocket, alwaysSettled, ignoreDrop);
}
Pending<Socket> fakeListen(i32 port) {
  return Pending.of(0, resolveSocket, alwaysSettled, ignoreDrop);
}
Pending<Socket> fakeAccept(i32 handle) {
  return Pending.of(0, resolveSocket, alwaysSettled, ignoreDrop);
}
Pending<u8[]> fakeRecv(i32 handle) { return Pending.of(0, resolveBytes, alwaysSettled, ignoreDrop); }
Pending<bool> fakeSend(i32 handle, u8[] data) {
  return Pending.of(0, resolveFromId, alwaysSettled, ignoreDrop);
}
void fakeCloseSocket(i32 handle) {}

/** Every fake ticket is settled the moment it is made, so the first id is as true as any. */
i32 fakeWaitAny(i32[] ids) { return ids.len() > 0 ? ids[0] : -1; }

Cli fakeCli() {
  return Cli.of(fakeArgCount, fakeArg, fakeEnv, fakeStdin, fakeWrite, fakeReadFile, fakeWriteFile,
                fakeStat, fakeReadDir, fakeMkdir, fakeRemove, fakeRename, fakeOpenInput,
                fakeReadChunk, fakeOpenOutput, fakeConnect, fakeListen, fakeAccept, fakeRecv,
                fakeSend, fakeCloseSocket, fakeWaitAny);
}

// ── What the coverage driver calls ────────────────────────────────────────────

/** Run a script and hand back what it wrote to standard output. */
export u8[] shOut(string src) {
  Shell sh = Shell.capturing(fakeCore(), fakeCli());
  runScript(sh, src);
  return sh.outBuf.take();
}

/** Run a script and hand back its exit status. */
export i32 shStatus(string src) {
  Shell sh = Shell.capturing(fakeCore(), fakeCli());
  return runScript(sh, src);
}

/** Run a script and hand back what it wrote to standard error. */
export u8[] shErr(string src) {
  Shell sh = Shell.capturing(fakeCore(), fakeCli());
  runScript(sh, src);
  return sh.errOut.take();
}

/** The same, writing through the capability rather than collecting — the other branch. */
export i32 shWritten(string src) {
  Shell sh = Shell.create(fakeCore(), fakeCli());
  return runScript(sh, src);
}

/**
 * Call the capabilities the shell never uses.
 *
 * `Cli.of` needs all twenty-one and the shell touches five, so the rest are unreachable through a
 * script. They are scaffolding rather than code under test, and exercising them once costs
 * nothing and keeps the report honest about what has actually run.
 */
export i32 shTouchStubs() {
  Cli c = fakeCli();
  i32 n = c.argCount().wait() + c.arg(0).wait().len() + c.readStdin().wait().len()
        + c.readChunk().len();
  if (c.env("SET_IN_ENV").wait() is not null) { n++; }
  if (c.env("NOT_SET").wait() is null) { n++; }
  if (c.write(u8[0]())) { n++; }
  if (c.stat("x").wait().exists) { n++; }
  if (c.readDir("dir").wait() is not null) { n++; }
  if (c.readDir("nope").wait() is null) { n++; }
  if (c.mkdir("d", true).wait()) { n++; }
  if (c.remove("d", true).wait()) { n++; }
  if (c.rename("a", "b").wait()) { n++; }
  n += c.openInput("x").wait().len() + c.openOutput("x").wait().len();
  n += c.connect("h", 1).wait().handle + c.listen(1).wait().handle + c.accept(1).wait().handle;
  n += c.recv(1).wait().len();
  if (c.send(1, u8[0]()).wait()) { n++; }
  c.closeSocket(1);

  Core k = fakeCore();
  n += (k.nowMillis().wait() + k.monotonicNanos().wait()) as~ i32;
  n += k.randomBytes(2).wait().len();
  k.log("");
  k.warn("");
  return n;
}
