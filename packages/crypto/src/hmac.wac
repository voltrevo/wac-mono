// HMAC-SHA-256, as specified in RFC 2104 / FIPS 198-1.
//
//   HMAC(K, m) = H((K' ^ opad) || H((K' ^ ipad) || m))
//
// where K' is the key padded to the hash's block size, or the hash of the key
// when it is longer than that.

import { sha256 } from "./sha256.wac";

i32 blockSize() { return 64; }

/** The key, reduced and zero-padded to one block. */
u8[] normalizeKey(u8[] key) {
  u8[] k = u8[blockSize()]();
  // A key longer than the block is hashed first — otherwise two different long
  // keys sharing a prefix would authenticate identically.
  u8[] src = key.len() > blockSize() ? sha256(key) : key;
  for (i32 i = 0; i < src.len(); i++) { k[i] = src[i]; }
  return k;
}

/** HMAC-SHA-256 of `msg` under `key`, 32 bytes. */
export u8[] hmacSha256(u8[] key, u8[] msg) {
  u8[] k = normalizeKey(key);
  i32 bs = blockSize();

  u8[] inner = u8[bs + msg.len()]();
  for (i32 i = 0; i < bs; i++) { inner[i] = k[i] ^ 0x36; }
  for (i32 i = 0; i < msg.len(); i++) { inner[bs + i] = msg[i]; }

  u8[] innerHash = sha256(inner);

  u8[] outer = u8[bs + 32]();
  for (i32 i = 0; i < bs; i++) { outer[i] = k[i] ^ 0x5c; }
  for (i32 i = 0; i < 32; i++) { outer[bs + i] = innerHash[i]; }

  return sha256(outer);
}
