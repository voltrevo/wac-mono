// NIST P-256: ECDH and ECDSA.
//
// The curve is y^2 = x^3 - 3x + b over the field in fieldp256.wac. It is a short
// Weierstrass curve, which means — unlike Curve25519 — the addition law has exceptional
// cases: adding a point to itself needs a different formula, and adding a point to its
// own negation gives the point at infinity, which has no affine coordinates at all.
// Those cases are why this is longer than x25519.wac despite doing the same job.
//
// Points are kept in Jacobian coordinates (X:Y:Z) standing for (X/Z^2, Y/Z^3), which is
// what makes doubling and addition free of inversions; one inversion at the end converts
// back. The point at infinity is Z = 0, which is why it needs no special representation.
//
// ## Two moduli again
//
// Coordinates are mod p. Scalars — private keys, ECDSA's r and s — are mod n, the order
// of the group, which is a different prime. The scalar arithmetic here is deliberately
// plain: ECDSA needs one modular inversion mod n per verification, and it is done by
// square-and-multiply over n-2 rather than by anything clever.
//
// ## Not constant-time
//
// The scalar multiplication below branches on bits of the scalar. For ECDSA verification
// that is fine — everything involved is public. For ECDH and for signing it is not, and
// the package README says so.

import { sha256 } from "./sha256.wac";
import {
  fpAdd, fpCopy, fpEquals, fpFromBytes, fpInvert, fpIsZero, fpMul, fpNeg, fpOne,
  fpSquare, fpSub, fpToBytes, fpZero, fpInRange,
} from "./fieldp256.wac";

/** b, the curve's constant term. From FIPS 186-4, written in decimal — see issue 0054. */
i64[] curveB() {
  return fpFromBytes(u8[](
    0x5a, 0xc6, 0x35, 0xd8, 0xaa, 0x3a, 0x93, 0xe7, 0xb3, 0xeb, 0xbd, 0x55, 0x76, 0x98,
    0x86, 0xbc, 0x65, 0x1d, 0x06, 0xb0, 0xcc, 0x53, 0xb0, 0xf6, 0x3b, 0xce, 0x3c, 0x3e,
    0x27, 0xd2, 0x60, 0x4b));
}

/** The base point G, as its uncompressed affine coordinates. */
u8[] gxBytes() {
  return u8[](
    0x6b, 0x17, 0xd1, 0xf2, 0xe1, 0x2c, 0x42, 0x47, 0xf8, 0xbc, 0xe6, 0xe5, 0x63, 0xa4,
    0x40, 0xf2, 0x77, 0x03, 0x7d, 0x81, 0x2d, 0xeb, 0x33, 0xa0, 0xf4, 0xa1, 0x39, 0x45,
    0xd8, 0x98, 0xc2, 0x96);
}
u8[] gyBytes() {
  return u8[](
    0x4f, 0xe3, 0x42, 0xe2, 0xfe, 0x1a, 0x7f, 0x9b, 0x8e, 0xe7, 0xeb, 0x4a, 0x7c, 0x0f,
    0x9e, 0x16, 0x2b, 0xce, 0x33, 0x57, 0x6b, 0x31, 0x5e, 0xce, 0xcb, 0xb6, 0x40, 0x68,
    0x37, 0xbf, 0x51, 0xf5);
}

/** n, the group order, as 32 big-endian bytes. */
export u8[] p256Order() {
  return u8[](
    0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xbc, 0xe6, 0xfa, 0xad, 0xa7, 0x17, 0x9e, 0x84, 0xf3, 0xb9, 0xca, 0xc2,
    0xfc, 0x63, 0x25, 0x51);
}

/** A point in Jacobian coordinates. Z = 0 is the point at infinity. */
export struct Jac {
  i64[] x;
  i64[] y;
  i64[] z;
}

export Jac jacInfinity() { return Jac(fpOne(), fpOne(), fpZero()); }
export bool jacIsInfinity(Jac p) { return fpIsZero(p.z); }

Jac jacFromAffine(i64[] x, i64[] y) { return Jac(fpCopy(x), fpCopy(y), fpOne()); }

export Jac p256Base() { return jacFromAffine(fpFromBytes(gxBytes()), fpFromBytes(gyBytes())); }

/**
 * 2P, by the a = -3 doubling formula.
 *
 * The curve's `a` being exactly -3 is not a coincidence; NIST chose it because it makes
 * `3(X - Z^2)(X + Z^2)` stand in for the general `3X^2 + aZ^4`, saving two squarings per
 * doubling. Using the general formula here would be correct and slower.
 */
export Jac jacDouble(Jac p) {
  if (jacIsInfinity(p)) { return jacInfinity(); }
  i64[] zz = fpSquare(p.z);
  i64[] m = fpMul(fpAdd(fpAdd(fpOne(), fpOne()), fpOne()),
                  fpMul(fpSub(p.x, zz), fpAdd(p.x, zz)));      // 3(X - Z^2)(X + Z^2)
  i64[] yy = fpSquare(p.y);
  i64[] s = fpMul(fpAdd(fpAdd(fpOne(), fpOne()), fpAdd(fpOne(), fpOne())),
                  fpMul(p.x, yy));                              // 4XY^2
  i64[] x3 = fpSub(fpSquare(m), fpAdd(s, s));
  i64[] yy2 = fpSquare(yy);
  i64[] eight = fpAdd(fpAdd(fpAdd(fpOne(), fpOne()), fpAdd(fpOne(), fpOne())),
                      fpAdd(fpAdd(fpOne(), fpOne()), fpAdd(fpOne(), fpOne())));
  i64[] y3 = fpSub(fpMul(m, fpSub(s, x3)), fpMul(eight, yy2));
  i64[] z3 = fpMul(fpAdd(p.y, p.y), p.z);
  return Jac(x3, y3, z3);
}

/**
 * P + Q.
 *
 * The exceptional cases are what make this longer than it looks: either operand may be
 * the identity, the two may be equal — in which case the general formula divides by zero
 * and doubling is meant — and they may be negations of each other, giving the identity.
 * Getting any of these wrong produces a scalar multiplication that is right for almost
 * every input, which is the worst kind of wrong.
 */
export Jac jacAdd(Jac p, Jac q) {
  if (jacIsInfinity(p)) { return Jac(fpCopy(q.x), fpCopy(q.y), fpCopy(q.z)); }
  if (jacIsInfinity(q)) { return Jac(fpCopy(p.x), fpCopy(p.y), fpCopy(p.z)); }

  i64[] z1z1 = fpSquare(p.z);
  i64[] z2z2 = fpSquare(q.z);
  i64[] u1 = fpMul(p.x, z2z2);
  i64[] u2 = fpMul(q.x, z1z1);
  i64[] s1 = fpMul(p.y, fpMul(q.z, z2z2));
  i64[] s2 = fpMul(q.y, fpMul(p.z, z1z1));

  if (fpEquals(u1, u2)) {
    if (fpEquals(s1, s2)) { return jacDouble(p); }
    return jacInfinity();                       // Q = -P
  }

  i64[] h = fpSub(u2, u1);
  i64[] r = fpSub(s2, s1);
  i64[] hh = fpSquare(h);
  i64[] hhh = fpMul(h, hh);
  i64[] u1hh = fpMul(u1, hh);
  i64[] x3 = fpSub(fpSub(fpSquare(r), hhh), fpAdd(u1hh, u1hh));
  i64[] y3 = fpSub(fpMul(r, fpSub(u1hh, x3)), fpMul(s1, hhh));
  i64[] z3 = fpMul(fpMul(p.z, q.z), h);
  return Jac(x3, y3, z3);
}

/** scalar * P, most significant bit first. `scalar` is 32 big-endian bytes. */
export Jac jacMul(u8[] scalar, Jac p) {
  Jac acc = jacInfinity();
  for (i32 i = 0; i < 256; i++) {
    acc = jacDouble(acc);
    i32 bit = (scalar[i / 8] >> (7 - (i % 8))) & 1;
    if (bit == 1) { acc = jacAdd(acc, p); }
  }
  return acc;
}

/** The affine coordinates of a point, as x ++ y. Traps on the identity, which has none. */
export u8[] jacToAffine(Jac p) {
  if (jacIsInfinity(p)) { trap; }
  i64[] zi = fpInvert(p.z);
  i64[] zi2 = fpSquare(zi);
  i64[] zi3 = fpMul(zi2, zi);
  u8[] x = fpToBytes(fpMul(p.x, zi2));
  u8[] y = fpToBytes(fpMul(p.y, zi3));
  u8[] out = u8[64]();
  for (i32 i = 0; i < 32; i++) { out[i] = x[i]; out[32 + i] = y[i]; }
  return out;
}

/** Whether an affine point satisfies the curve equation. */
bool onCurve(i64[] x, i64[] y) {
  i64[] three = fpAdd(fpAdd(fpOne(), fpOne()), fpOne());
  i64[] lhs = fpSquare(y);
  i64[] rhs = fpAdd(fpSub(fpMul(fpSquare(x), x), fpMul(three, x)), curveB());
  return fpEquals(lhs, rhs);
}

/**
 * Decode an uncompressed point: 0x04 followed by x and y, 65 bytes.
 *
 * Every check here matters. A point off the curve, or with a coordinate at or above p,
 * lets an attacker run the scalar multiplication in a group they chose — which for ECDH
 * leaks the private key a few bits at a time. This is the invalid-curve attack, and
 * skipping the validation is how implementations fall to it.
 */
export Jac p256Decode(u8[] s) {
  if (s.len() != 65) { trap; }
  if (s[0] != 4) { trap; }
  u8[] xb = u8[32]();
  u8[] yb = u8[32]();
  for (i32 i = 0; i < 32; i++) { xb[i] = s[1 + i]; yb[i] = s[33 + i]; }
  if (!fpInRange(xb)) { trap; }
  if (!fpInRange(yb)) { trap; }
  i64[] x = fpFromBytes(xb);
  i64[] y = fpFromBytes(yb);
  // No separate check for (0, 0): the curve equation already rejects it, since 0 = b is
  // false for P-256's b. An explicit one was here and coverage showed it could not be
  // reached — the trap above always fires first.
  if (!onCurve(x, y)) { trap; }
  return jacFromAffine(x, y);
}

/** Encode a point uncompressed: 0x04 ++ x ++ y. */
export u8[] p256Encode(Jac p) {
  u8[] xy = jacToAffine(p);
  u8[] out = u8[65]();
  out[0] = 4;
  for (i32 i = 0; i < 64; i++) { out[1 + i] = xy[i]; }
  return out;
}

// ── Scalars, modulo the group order n ─────────────────────────────────────────

/** Compare two 32-byte big-endian scalars. */
i32 cmpBE(u8[] a, u8[] b) {
  for (i32 i = 0; i < 32; i++) {
    if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1; }
  }
  return 0;
}

bool isZeroBE(u8[] a) {
  i32 acc = 0;
  for (i32 i = 0; i < 32; i++) { acc = acc | a[i]; }
  return acc == 0;
}

/** (a + b) mod n. */
u8[] scAdd(u8[] a, u8[] b) {
  u8[] n = p256Order();
  u8[] out = u8[32]();
  i32 carry = 0;
  for (i32 i = 31; i >= 0; i--) {
    i32 s = a[i] + b[i] + carry;
    out[i] = s & 0xFF;
    carry = s >> 8;
  }
  if (carry != 0 || cmpBE(out, n) >= 0) {
    i32 borrow = 0;
    for (i32 i = 31; i >= 0; i--) {
      i32 d = out[i] - n[i] - borrow;
      borrow = d < 0 ? 1 : 0;
      out[i] = d & 0xFF;
    }
  }
  return out;
}

/**
 * (a * b) mod n, by double-and-add over the bits of b.
 *
 * 256 rounds of a modular doubling and a conditional modular addition. Far slower than a
 * Montgomery multiplication and about a tenth the code, which is the right trade for
 * something that runs twice per signature.
 */
u8[] scMul(u8[] a, u8[] b) {
  u8[] acc = u8[32]();
  u8[] addend = u8[32]();
  for (i32 i = 0; i < 32; i++) { addend[i] = a[i]; }
  for (i32 i = 255; i >= 0; i--) {
    // Process b's bits from the bottom, doubling the addend each time.
    i32 bit = (b[i / 8] >> (7 - (i % 8))) & 1;
    if (bit == 1) { acc = scAdd(acc, addend); }
    addend = scAdd(addend, addend);
  }
  return acc;
}

/** 1/a mod n, by Fermat. n is prime, so a^(n-2) is the inverse. */
u8[] scInvert(u8[] a) {
  u8[] n = p256Order();
  // n - 2
  u8[] e = u8[32]();
  for (i32 i = 0; i < 32; i++) { e[i] = n[i]; }
  i32 i2 = 31;
  while (i2 >= 0) {
    if (e[i2] >= 2) { e[i2] -= 2; i2 = -1; } else { e[i2] = e[i2] + 254; i2--; }
  }
  u8[] result = u8[32]();
  result[31] = 1;
  u8[] base = u8[32]();
  for (i32 i = 0; i < 32; i++) { base[i] = a[i]; }
  for (i32 bit = 255; bit >= 0; bit--) {
    i32 b = (e[bit / 8] >> (7 - (bit % 8))) & 1;
    if (b == 1) { result = scMul(result, base); }
    base = scMul(base, base);
  }
  return result;
}

/** Reduce a 32-byte big-endian value mod n, by conditional subtraction. */
u8[] scReduce(u8[] a) {
  u8[] n = p256Order();
  u8[] out = u8[32]();
  for (i32 i = 0; i < 32; i++) { out[i] = a[i]; }
  while (cmpBE(out, n) >= 0) {
    i32 borrow = 0;
    for (i32 i = 31; i >= 0; i--) {
      i32 d = out[i] - n[i] - borrow;
      borrow = d < 0 ? 1 : 0;
      out[i] = d & 0xFF;
    }
  }
  return out;
}

// ── ECDH ──────────────────────────────────────────────────────────────────────

/** The public key for a private scalar: 65 uncompressed bytes. */
export u8[] p256PublicKey(u8[] priv) {
  if (priv.len() != 32) { trap; }
  if (isZeroBE(priv) || cmpBE(priv, p256Order()) >= 0) { trap; }
  return p256Encode(jacMul(priv, p256Base()));
}

/**
 * The ECDH shared secret: the x-coordinate of priv * peerPublic, 32 bytes.
 *
 * `p256Decode` validates the peer's point, which is the whole defence against an
 * invalid-curve attack — the multiplication itself cannot tell it is working in the
 * wrong group.
 */
export u8[] p256Ecdh(u8[] priv, u8[] peerPublic) {
  if (priv.len() != 32) { trap; }
  if (isZeroBE(priv) || cmpBE(priv, p256Order()) >= 0) { trap; }
  Jac peer = p256Decode(peerPublic);
  Jac shared = jacMul(priv, peer);
  if (jacIsInfinity(shared)) { trap; }
  u8[] xy = jacToAffine(shared);
  u8[] out = u8[32]();
  for (i32 i = 0; i < 32; i++) { out[i] = xy[i]; }
  return out;
}

// ── ECDSA ─────────────────────────────────────────────────────────────────────

/**
 * Verify an ECDSA-P256 signature over SHA-256 of `msg`.
 *
 * `sig` is r ++ s, 64 bytes, which is how TLS carries it inside a DER wrapper the caller
 * has already unwrapped. Both must be in [1, n).
 */
export bool p256Verify(u8[] publicKey, u8[] msg, u8[] sig) {
  if (sig.len() != 64) { return false; }
  u8[] r = u8[32]();
  u8[] s = u8[32]();
  for (i32 i = 0; i < 32; i++) { r[i] = sig[i]; s[i] = sig[32 + i]; }
  u8[] n = p256Order();
  if (isZeroBE(r) || cmpBE(r, n) >= 0) { return false; }
  if (isZeroBE(s) || cmpBE(s, n) >= 0) { return false; }

  u8[] e = scReduce(sha256(msg));
  u8[] sInv = scInvert(s);
  u8[] u1 = scMul(e, sInv);
  u8[] u2 = scMul(r, sInv);

  Jac pub = p256Decode(publicKey);
  Jac point = jacAdd(jacMul(u1, p256Base()), jacMul(u2, pub));
  if (jacIsInfinity(point)) { return false; }

  u8[] xy = jacToAffine(point);
  u8[] x = u8[32]();
  for (i32 i = 0; i < 32; i++) { x[i] = xy[i]; }
  return cmpBE(scReduce(x), r) == 0;
}

/**
 * Sign SHA-256 of `msg`, with the caller supplying `k`.
 *
 * `k` is a parameter rather than generated here because wac has no randomness, and
 * because a k that repeats across two signatures reveals the private key outright — so
 * it belongs where the caller can see the responsibility. Returns r ++ s, or an empty
 * array if this k does not work, in which case the caller must try another.
 */
export u8[] p256Sign(u8[] priv, u8[] msg, u8[] k) {
  if (priv.len() != 32 || k.len() != 32) { trap; }
  u8[] n = p256Order();
  if (isZeroBE(k) || cmpBE(k, n) >= 0) { return u8[0](); }

  Jac point = jacMul(k, p256Base());
  if (jacIsInfinity(point)) { return u8[0](); }
  u8[] xy = jacToAffine(point);
  u8[] r = u8[32]();
  for (i32 i = 0; i < 32; i++) { r[i] = xy[i]; }
  r = scReduce(r);
  if (isZeroBE(r)) { return u8[0](); }

  u8[] e = scReduce(sha256(msg));
  u8[] s = scMul(scInvert(k), scAdd(e, scMul(r, priv)));
  if (isZeroBE(s)) { return u8[0](); }

  u8[] out = u8[64]();
  for (i32 i = 0; i < 32; i++) { out[i] = r[i]; out[32 + i] = s[i]; }
  return out;
}
