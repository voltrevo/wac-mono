// NIST P-256: ECDH and ECDSA.
//
// The curve is y^2 = x^3 - 3x + b, a short Weierstrass curve, which means — unlike
// Curve25519 — the addition law has exceptional cases: adding a point to itself needs a
// different formula, and adding a point to its own negation gives the point at infinity,
// which has no affine coordinates at all. All of that lives in weierstrass.wac, which
// P-384 shares; this file is the constants and the named API.
//
// ## Two moduli
//
// Coordinates are mod p, handled by fieldp.wac. Scalars — private keys, ECDSA's r and s —
// are mod n, the order of the group, which is a different prime.
//
// ## Not constant-time
//
// The scalar multiplication branches on bits of the scalar. For ECDSA verification that
// is fine, since everything involved is public. For ECDH and for signing it is not, and
// the package README says so.

import { sha256 } from "./sha256.wac";
import { fpFromBytes } from "./fieldp.wac";
import {
  Curve, Jac, curveBase, curveDecode, curveEncode, curveEcdh, curvePublicKey,
  ecdsaSign, ecdsaVerify, jacMul,
} from "./weierstrass.wac";

/** n, the group order, as 32 big-endian bytes. */
export u8[] p256Order() {
  return u8[](
    0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0xbc, 0xe6, 0xfa, 0xad, 0xa7, 0x17, 0x9e, 0x84,
    0xf3, 0xb9, 0xca, 0xc2, 0xfc, 0x63, 0x25, 0x51);
}

/** b, the curve's constant term, from FIPS 186-4. */
u8[] bBytes() {
  return u8[](
    0x5a, 0xc6, 0x35, 0xd8, 0xaa, 0x3a, 0x93, 0xe7, 0xb3, 0xeb, 0xbd, 0x55,
    0x76, 0x98, 0x86, 0xbc, 0x65, 0x1d, 0x06, 0xb0, 0xcc, 0x53, 0xb0, 0xf6,
    0x3b, 0xce, 0x3c, 0x3e, 0x27, 0xd2, 0x60, 0x4b);
}

/** The base point G, as its affine coordinates. */
u8[] gxBytes() {
  return u8[](
    0x6b, 0x17, 0xd1, 0xf2, 0xe1, 0x2c, 0x42, 0x47, 0xf8, 0xbc, 0xe6, 0xe5,
    0x63, 0xa4, 0x40, 0xf2, 0x77, 0x03, 0x7d, 0x81, 0x2d, 0xeb, 0x33, 0xa0,
    0xf4, 0xa1, 0x39, 0x45, 0xd8, 0x98, 0xc2, 0x96);
}
u8[] gyBytes() {
  return u8[](
    0x4f, 0xe3, 0x42, 0xe2, 0xfe, 0x1a, 0x7f, 0x9b, 0x8e, 0xe7, 0xeb, 0x4a,
    0x7c, 0x0f, 0x9e, 0x16, 0x2b, 0xce, 0x33, 0x57, 0x6b, 0x31, 0x5e, 0xce,
    0xcb, 0xb6, 0x40, 0x68, 0x37, 0xbf, 0x51, 0xf5);
}

export Curve p256() { return Curve(fpFromBytes(bBytes()), p256Order(), gxBytes(), gyBytes()); }

/** The public key for a private scalar: 65 uncompressed bytes. */
export u8[] p256PublicKey(u8[] priv) { return curvePublicKey(p256(), priv); }

/** The ECDH shared secret: the x-coordinate of priv * peerPublic, 32 bytes. */
export u8[] p256Ecdh(u8[] priv, u8[] peerPublic) { return curveEcdh(p256(), priv, peerPublic); }

/** Verify an ECDSA-P256 signature over SHA-256 of `msg`. `sig` is r ++ s, 64 bytes. */
export bool p256Verify(u8[] publicKey, u8[] msg, u8[] sig) {
  return ecdsaVerify(p256(), publicKey, sha256(msg), sig);
}

/** Verify against a digest the caller has already computed, which certificates need. */
export bool p256VerifyDigest(u8[] publicKey, u8[] digest, u8[] sig) {
  return ecdsaVerify(p256(), publicKey, digest, sig);
}

/** Sign SHA-256 of `msg` with the caller's `k`. Empty on a k that does not work. */
export u8[] p256Sign(u8[] priv, u8[] msg, u8[] k) {
  return ecdsaSign(p256(), priv, sha256(msg), k);
}

/** k * G, encoded uncompressed. */
export u8[] p256ScalarBase(u8[] k) {
  return curveEncode(p256(), jacMul(p256(), k, curveBase(p256())));
}

/** Validate and re-encode an uncompressed point, which is a decode the host can see. */
export u8[] p256Reencode(u8[] point) {
  return curveEncode(p256(), curveDecode(p256(), point));
}
