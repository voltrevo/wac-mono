// SHA-512 and SHA-384, as specified in FIPS 180-4.
//
// Structurally SHA-256 in 64 bits: same compression shape, wider words, 80
// rounds instead of 64, a 128-byte block, and different rotation amounts. It is
// here as much for what it exercises as for the algorithm — every operation is
// u64, so it covers the half of the unsigned work that SHA-256 does not.
//
// SHA-384 is the same computation with a different initial state, truncated to
// 48 bytes. It is not a shortened SHA-512: the initial values differ precisely
// so that one is not a prefix of the other.

import { beWord64, storeBE64 } from "./layout.wac";

/** Rotate right, 64-bit. */
u64 rotr(u64 x, u64 n) { return (x >> n) | (x << (64 - n)); }

u64 ch(u64 x, u64 y, u64 z)  { return (x & y) ^ (~x & z); }
u64 maj(u64 x, u64 y, u64 z) { return (x & y) ^ (x & z) ^ (y & z); }

u64 bigSigma0(u64 x)   { return rotr(x, 28) ^ rotr(x, 34) ^ rotr(x, 39); }
u64 bigSigma1(u64 x)   { return rotr(x, 14) ^ rotr(x, 18) ^ rotr(x, 41); }
u64 smallSigma0(u64 x) { return rotr(x, 1) ^ rotr(x, 8) ^ (x >> 7); }
u64 smallSigma1(u64 x) { return rotr(x, 19) ^ rotr(x, 61) ^ (x >> 6); }

/**
 * The 80 round constants: the first 64 bits of the fractional parts of the cube
 * roots of the first 80 primes. Generated rather than typed — 80 sixteen-digit
 * values is exactly the sort of table where a transcription slip is
 * indistinguishable from a bug.
 */
const u64[] K = u64[](
  0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
  0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
  0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
  0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
  0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
  0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
  0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
  0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
  0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
  0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
  0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
  0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
  0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
  0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
  0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
  0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
  0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
  0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
  0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
  0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
);

/** Initial state for SHA-512: square roots of the first eight primes. */
const u64[] H512 = u64[](0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179);

/** Initial state for SHA-384: square roots of the *ninth* through sixteenth. */
const u64[] H384 = u64[](0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939, 0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4);

/**
 * The compression, shared by both digest sizes: returns the eight-word state
 * after absorbing every block of the padded message.
 */
/**
 * One 128-byte block, folded into `h` in place.
 *
 * `w` is passed in rather than allocated here: a streaming hash calls this once per block,
 * and eighty 64-bit words per block of a large file is a garbage collector benchmark
 * rather than a hash.
 */
void compressBlock(u64[] h, u8[] m, i32 off, u64[] w) {
  for (i32 t = 0; t < 16; t++) { w[t] = beWord64(m, off + t * 8); }
  for (i32 t = 16; t < 80; t++) {
    w[t] = smallSigma1(w[t - 2]) + w[t - 7] + smallSigma0(w[t - 15]) + w[t - 16];
  }

  u64 a = h[0]; u64 b1 = h[1]; u64 c = h[2]; u64 d = h[3];
  u64 e = h[4]; u64 f = h[5]; u64 g = h[6]; u64 hh = h[7];

  for (i32 t = 0; t < 80; t++) {
    u64 t1 = hh + bigSigma1(e) + ch(e, f, g) + K[t] + w[t];
    u64 t2 = bigSigma0(a) + maj(a, b1, c);
    hh = g; g = f; f = e;
    e = d + t1;
    d = c; c = b1; b1 = a;
    a = t1 + t2;
  }

  h[0] += a; h[1] += b1; h[2] += c; h[3] += d;
  h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
}

/**
 * SHA-512 over input that arrives a piece at a time, and SHA-384 with it.
 *
 * The same shape as `Sha256`, over 128-byte blocks: the two differ only in the block
 * size, the word width and where the length field goes. `digest(64)` is SHA-512 and
 * `digest(48)` is SHA-384 — they are the same computation from different starting words,
 * which is why the truncation is a parameter rather than a second struct.
 */
export struct Sha512 {
  u64[] h;
  u8[] block;     // input not yet forming a whole 128-byte block
  i32 filled;
  i64 total;
  u64[] w;

  Sha512 create() { return start(H512); }
  Sha512 create384() { return start(H384); }

  void update(this, u8[] data) {
    this.total += data.len() as i64;
    i32 at = 0;
    if (this.filled > 0) {
      i32 want = 128 - this.filled;
      i32 take = data.len() < want ? data.len() : want;
      this.block.copyFrom(data, 0, this.filled, take);
      this.filled = this.filled + take;
      at = take;
      if (this.filled < 128) { return; }
      compressBlock(this.h, this.block, 0, this.w);
      this.filled = 0;
    }
    while (data.len() - at >= 128) {
      compressBlock(this.h, data, at, this.w);
      at = at + 128;
    }
    i32 rest = data.len() - at;
    if (rest > 0) {
      this.block.copyFrom(data, at, 0, rest);
      this.filled = rest;
    }
  }

  /** The digest, truncated to `bytes` — 64 for SHA-512, 48 for SHA-384. */
  u8[] digest(this, i32 bytes) {
    // The length field is 128 bits here, of which only the low 64 are ever non-zero, so
    // the padding lands the total on a multiple of 128 with 16 bytes reserved for it.
    i32 pad = this.filled < 112 ? 112 - this.filled : 240 - this.filled;
    u8[] tail = u8[pad + 16]();
    tail[0] = 0x80;
    storeBE64((this.total * 8) as@ u64, tail, pad + 8);
    this.update(tail);
    return serialize(this.h, bytes);
  }
}

Sha512 start(u64[] iv) {
  u64[] h = u64[8]();
  for (i32 i = 0; i < 8; i++) { h[i] = iv[i]; }
  return Sha512(h, u8[128](), 0, 0, u64[80]());
}

/** Serialise the first `bytes` bytes of the state, big-endian. */
u8[] serialize(u64[] h, i32 bytes) {
  u8[] out = u8[bytes]();
  for (i32 i = 0; i < bytes; i++) {
    u64 word = h[i / 8];
    u64 shift = ((7 - (i % 8)) * 8) as! u64;
    out[i] = ((word >> shift) & 255) as! i32;
  }
  return out;
}

/** SHA-512 of `msg`, 64 bytes. */
export u8[] sha512(u8[] msg) { return oneShot(Sha512.create(), msg, 64); }

/** SHA-384 of `msg`, 48 bytes. */
export u8[] sha384(u8[] msg) { return oneShot(Sha512.create384(), msg, 48); }

/**
 * A whole message through the streaming form.
 *
 * `compress` used to live here: it allocated a padded duplicate of the message and copied it element-wise
 * before compressing a byte, so hashing 36 MB allocated 36 MB and read it twice. `update` compresses whole
 * blocks straight out of the caller's array and holds nothing but the 128-byte remainder, which is what
 * the one-shot form always was underneath (wac-mono 0034). `deno task bench:hash --quick`, 4 MB: 19.2 ms
 * before, 16.3 ms after — 209 MB/s to 246 MB/s.
 */
u8[] oneShot(Sha512 s, u8[] msg, i32 bytes) {
  s.update(msg);
  return s.digest(bytes);
}
