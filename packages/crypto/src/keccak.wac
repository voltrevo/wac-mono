// Keccak-f[1600], and the SHA-3 and SHAKE functions built on it (FIPS 202).
//
// Needed here because ML-KEM is defined entirely in terms of SHAKE and SHA-3 — the
// matrix is sampled from SHAKE128, the noise from SHAKE256, and the key derivation uses
// SHA3-256 and SHA3-512. None of SHA-2 will do; they are different functions.
//
// ## The state
//
// 1600 bits as twenty-five 64-bit lanes, indexed `x + 5y`. Five steps per round, done
// twenty-four times:
//
//   theta  each lane is xored with the parities of two neighbouring columns
//   rho    each lane is rotated by its own fixed amount
//   pi     the lanes are permuted
//   chi    the only non-linear step: a row is combined with the two lanes to its right
//   iota   one round constant is xored into lane zero, which is what stops every round
//          being identical and the whole thing collapsing
//
// ## The tables are computed, not transcribed
//
// The rho offsets and the pi permutation both come from the same walk over the state —
// `(x, y) -> (y, 2x + 3y)` — and the offsets are the triangular numbers modulo 64. FIPS
// 202 prints them as a 5x5 grid, and copying a 5x5 grid of rotation amounts into a flat
// array indexed the other way round is exactly the sort of transcription that produces a
// hash which is wrong for every input. Deriving them is four lines and is the definition.
//
// The round constants cannot be derived so cheaply — they come from an LFSR — so those
// are written out, with a wrinkle: five of the twenty-four sit in [2^31, 2^32), where a
// hex literal is sign-extended into a 64-bit target (wac issue 0054). Every constant
// below 2^32 is masked to undo that. The mask is harmless on the ones that do not need
// it and applying it uniformly is easier to check than a list of exceptions.

/** The 24 round constants, from FIPS 202 Table 1. */
const u64[] RC = u64[](
  0x0000000000000001 & 4294967295,
  0x0000000000008082 & 4294967295,
  0x800000000000808A,
  0x8000000080008000,
  0x000000000000808B & 4294967295,
  0x0000000080000001 & 4294967295,
  0x8000000080008081,
  0x8000000000008009,
  0x000000000000008A & 4294967295,
  0x0000000000000088 & 4294967295,
  0x0000000080008009 & 4294967295,
  0x000000008000000A & 4294967295,
  0x000000008000808B & 4294967295,
  0x800000000000008B,
  0x8000000000008089,
  0x8000000000008003,
  0x8000000000008002,
  0x8000000000000080,
  0x000000000000800A & 4294967295,
  0x800000008000000A,
  0x8000000080008081,
  0x8000000000008080,
  0x0000000080000001 & 4294967295,
  0x8000000080008008,
);

u64 rotl(u64 x, u64 n) { return n == 0 ? x : ((x << n) | (x >> (64 - n))); }

/**
 * The permutation, in place over twenty-five lanes.
 *
 * ## Why this is written out
 *
 * It was five nested loops over the state array, with the rho offsets and the pi destinations in a
 * fifty-element table computed at entry, and `(x + 1) % 5 + 5 * y` as an index. That is the spec on the
 * page — and every one of those reads is `array.get` plus a bounds check, several of them behind a
 * division, against a `local.get` for a value the compiler can keep in a register.
 *
 * So the twenty-five lanes are twenty-five locals for the whole permutation, loaded once at entry and
 * stored once at exit, and one round is written out. **The twenty-four rounds are still a loop** — the
 * repeating unit here is a round, exactly as ChaCha20's is a double round (wac-mono 0035), so nothing is
 * unrolled by hand and nothing is generated.
 *
 * What that costs is that the rho offsets and the pi permutation are now constants in the source rather
 * than derived from the spec's `(x, y) -> (y, 2x + 3y)` walk. The old comment argued for deriving them,
 * and it was right about the risk: copying a 5x5 grid of rotation amounts indexed the other way round is
 * exactly how you get a hash that is wrong for every input. They were not copied — the walk that used to
 * run at startup emitted them, and what pins them is that `keccak256`, `sha3_256`, `sha3_512`, `shake128`
 * and `shake256` are all checked against published vectors and against `node:crypto`, which no wrong
 * offset survives.
 *
 * Measured on 4 MB with `deno task bench:hash --quick`, on an idle machine, twice each way:
 * **104.5 ms before, 15.4 ms after** — 38 MB/s to 260 MB/s, **6.8x**. That takes keccak256 from 7.1x
 * slower than OpenSSL's SHA3-256 to **1.1x**, and it is the same edit as ChaCha20's: the state stopped
 * being an array.
 */
export void keccakF(u64[] a) {
  u64 a00 = a[0]; u64 a01 = a[1]; u64 a02 = a[2]; u64 a03 = a[3]; u64 a04 = a[4];
  u64 a05 = a[5]; u64 a06 = a[6]; u64 a07 = a[7]; u64 a08 = a[8]; u64 a09 = a[9];
  u64 a10 = a[10]; u64 a11 = a[11]; u64 a12 = a[12]; u64 a13 = a[13]; u64 a14 = a[14];
  u64 a15 = a[15]; u64 a16 = a[16]; u64 a17 = a[17]; u64 a18 = a[18]; u64 a19 = a[19];
  u64 a20 = a[20]; u64 a21 = a[21]; u64 a22 = a[22]; u64 a23 = a[23]; u64 a24 = a[24];

  for (i32 round = 0; round < 24; round++) {
    // theta: each lane xored with the parities of two neighbouring columns.
    u64 c0 = a00 ^ a05 ^ a10 ^ a15 ^ a20;
    u64 c1 = a01 ^ a06 ^ a11 ^ a16 ^ a21;
    u64 c2 = a02 ^ a07 ^ a12 ^ a17 ^ a22;
    u64 c3 = a03 ^ a08 ^ a13 ^ a18 ^ a23;
    u64 c4 = a04 ^ a09 ^ a14 ^ a19 ^ a24;
    u64 d0 = c4 ^ rotl(c1, 1);
    u64 d1 = c0 ^ rotl(c2, 1);
    u64 d2 = c1 ^ rotl(c3, 1);
    u64 d3 = c2 ^ rotl(c4, 1);
    u64 d4 = c3 ^ rotl(c0, 1);
    a00 ^= d0; a05 ^= d0; a10 ^= d0; a15 ^= d0; a20 ^= d0;
    a01 ^= d1; a06 ^= d1; a11 ^= d1; a16 ^= d1; a21 ^= d1;
    a02 ^= d2; a07 ^= d2; a12 ^= d2; a17 ^= d2; a22 ^= d2;
    a03 ^= d3; a08 ^= d3; a13 ^= d3; a18 ^= d3; a23 ^= d3;
    a04 ^= d4; a09 ^= d4; a14 ^= d4; a19 ^= d4; a24 ^= d4;

    // rho and pi: each lane rotated by its own fixed amount and placed where pi says.
    u64 b00 = a00;
    u64 b10 = rotl(a01, 1);
    u64 b20 = rotl(a02, 62);
    u64 b05 = rotl(a03, 28);
    u64 b15 = rotl(a04, 27);
    u64 b16 = rotl(a05, 36);
    u64 b01 = rotl(a06, 44);
    u64 b11 = rotl(a07, 6);
    u64 b21 = rotl(a08, 55);
    u64 b06 = rotl(a09, 20);
    u64 b07 = rotl(a10, 3);
    u64 b17 = rotl(a11, 10);
    u64 b02 = rotl(a12, 43);
    u64 b12 = rotl(a13, 25);
    u64 b22 = rotl(a14, 39);
    u64 b23 = rotl(a15, 41);
    u64 b08 = rotl(a16, 45);
    u64 b18 = rotl(a17, 15);
    u64 b03 = rotl(a18, 21);
    u64 b13 = rotl(a19, 8);
    u64 b14 = rotl(a20, 18);
    u64 b24 = rotl(a21, 2);
    u64 b09 = rotl(a22, 61);
    u64 b19 = rotl(a23, 56);
    u64 b04 = rotl(a24, 14);

    // chi: the only non-linear step — a row combined with the two lanes to its right.
    a00 = b00 ^ (~b01 & b02);
    a01 = b01 ^ (~b02 & b03);
    a02 = b02 ^ (~b03 & b04);
    a03 = b03 ^ (~b04 & b00);
    a04 = b04 ^ (~b00 & b01);
    a05 = b05 ^ (~b06 & b07);
    a06 = b06 ^ (~b07 & b08);
    a07 = b07 ^ (~b08 & b09);
    a08 = b08 ^ (~b09 & b05);
    a09 = b09 ^ (~b05 & b06);
    a10 = b10 ^ (~b11 & b12);
    a11 = b11 ^ (~b12 & b13);
    a12 = b12 ^ (~b13 & b14);
    a13 = b13 ^ (~b14 & b10);
    a14 = b14 ^ (~b10 & b11);
    a15 = b15 ^ (~b16 & b17);
    a16 = b16 ^ (~b17 & b18);
    a17 = b17 ^ (~b18 & b19);
    a18 = b18 ^ (~b19 & b15);
    a19 = b19 ^ (~b15 & b16);
    a20 = b20 ^ (~b21 & b22);
    a21 = b21 ^ (~b22 & b23);
    a22 = b22 ^ (~b23 & b24);
    a23 = b23 ^ (~b24 & b20);
    a24 = b24 ^ (~b20 & b21);

    // iota: one round constant, which is what stops every round being identical.
    a00 ^= RC[round];
  }

  a[0] = a00; a[1] = a01; a[2] = a02; a[3] = a03; a[4] = a04;
  a[5] = a05; a[6] = a06; a[7] = a07; a[8] = a08; a[9] = a09;
  a[10] = a10; a[11] = a11; a[12] = a12; a[13] = a13; a[14] = a14;
  a[15] = a15; a[16] = a16; a[17] = a17; a[18] = a18; a[19] = a19;
  a[20] = a20; a[21] = a21; a[22] = a22; a[23] = a23; a[24] = a24;
}

/**
 * The sponge: absorb `input` at `rate` bytes a block, then squeeze `outLen`.
 *
 * `domain` is the padding's first byte — 0x06 for SHA-3, 0x1F for the SHAKEs. It is the
 * only difference between them apart from the rate, and it is what stops SHA3-256 and a
 * SHAKE128 truncated to 32 bytes being the same function.
 *
 * The padding is `pad10*1`: the domain byte, zeros, and a final bit at the top of the
 * last rate byte. When the message ends exactly one byte short of a block, those two
 * land in the same byte and are ored together — a special case that a padding written as
 * "append the domain byte, then zeros, then 0x80" gets wrong for exactly that length.
 */
export u8[] sponge(u8[] input, i32 rate, i32 domain, i32 outLen) {
  if (rate <= 0 || rate > 200) { trap; }
  u64[] state = u64[25]();

  // **Whole blocks are absorbed where they lie.** `absorb` takes an offset for the same reason
  // `compressBlock` in `sha256.wac` does: copying each rate-sized block into scratch first is a second
  // pass over every byte of the message, and the absorb reads each byte exactly once anyway. Only the
  // final partial block needs an array of its own, because only that one is padded (wac-mono 0034).
  //
  // Worth **2%** here and 15% in `sha256`, which is the interesting part: this permutation costs 24 rounds
  // over 25 lanes for every 136 bytes, so the copy was never where the time went. Same edit, same argument,
  // an order of magnitude apart in what it bought — a copy loop is worth removing where it is a meaningful
  // share of the work, and measuring is the only way to know which one you are looking at.
  i32 at = 0;
  while (at + rate <= input.len()) {
    absorb(state, input, at, rate);
    at += rate;
  }

  // The final, partial block, with the padding.
  u8[] block = u8[rate]();
  i32 tail = input.len() - at;
  block.copyFrom(input, at, 0, tail);
  block[tail] = block[tail] | domain;
  block[rate - 1] = block[rate - 1] | 0x80;
  absorb(state, block, 0, rate);

  // Squeeze: read a block, then permute if more is wanted. Reading first is what makes
  // this correct — the absorb of the padded block already permuted, so the state is
  // ready. Permuting first instead would work for a single output block and quietly
  // shift every byte of a longer one, which is the shape SHAKE is always used in.
  u8[] out = u8[outLen]();
  i32 produced = 0;
  while (true) {
    for (i32 i = 0; i < rate && produced < outLen; i++) {
      out[produced] = ((state[i / 8] >> (((i % 8) * 8) as! u64)) & 255) as! i32;
      produced++;
    }
    if (produced >= outLen) { return out; }
    keccakF(state);
  }
  return out;
}

/** Xor one rate-sized block into the state, little-endian by lane, then permute. */
void absorb(u64[] state, u8[] block, i32 off, i32 rate) {
  for (i32 i = 0; i < rate; i++) {
    state[i / 8] ^= (block[off + i] as! u64) << (((i % 8) * 8) as! u64);
  }
  keccakF(state);
}

/**
 * keccak256 — Ethereum's hash, and **not** SHA3-256.
 *
 * Same permutation, same rate, same capacity, same output length. One byte of padding differs: the
 * original Keccak submission appends `0x01` where NIST's SHA-3 appends `0x06`, and the two therefore agree
 * on no input at all. Every address, every ABI selector, every ENS namehash and every Merkle-Patricia key
 * is this function and not the one beside it (wac-mono 0083, design/0003).
 *
 * The empty message is where the difference is *entirely* visible: with no input, the padding is the whole
 * of what the permutation sees, so `keccak256("")` being `c5d24601…` and `sha3_256("")` being something
 * else is a check on this line specifically. That vector is in `test/wac/keccak_test.wac` along with two
 * others whose lengths differ, and the sponge underneath is already checked against `node:crypto` for two
 * other domain bytes.
 *
 * **There is no streaming form.** `Sha3_256` below hashes incrementally and hardcodes SHA-3's domain byte;
 * nothing in this repo hashes a keccak256 input it cannot hold, so a `Keccak256` beside it would be a
 * shape with no caller. Said here rather than left for somebody to assume `Sha3_256` can be repointed.
 */
export u8[] keccak256(u8[] msg) { return sponge(msg, 136, 0x01, 32); }

export u8[] sha3_256(u8[] msg) { return sponge(msg, 136, 0x06, 32); }
export u8[] sha3_512(u8[] msg) { return sponge(msg, 72, 0x06, 64); }
export u8[] shake128(u8[] msg, i32 outLen) { return sponge(msg, 168, 0x1F, outLen); }
export u8[] shake256(u8[] msg, i32 outLen) { return sponge(msg, 136, 0x1F, outLen); }

/**
 * SHA3-256 as a running hash: absorb in pieces, and take a digest without ending the hash.
 *
 * The one-shot `sha3_256` above is what almost everything wants. This exists for Tor's relay-cell
 * digest, which is a *running* hash over every cell ever sent on a hop: each cell's digest field
 * carries the first four bytes of the hash of everything so far, and the hash keeps going. tor-spec
 * uses SHA-1 for that, and rend-spec-v3 §3.3.2 says the hop between a client and a hidden service
 * uses SHA3-256 instead.
 *
 * `peek` is the operation that makes this awkward and is the reason it cannot be built from
 * `sponge`: it needs the digest of the message so far while leaving the sponge able to absorb more.
 * So it copies the state, pads the copy, and squeezes that — the live state never sees the padding.
 * `Sha1` in `packages/crypto/src/sha1.wac` has exactly this shape and for exactly this reason.
 */
export struct Sha3_256 {
  u64[] state;
  /** Bytes buffered but not yet absorbed; always fewer than `RATE`. */
  u8[] pending;
  i32 pendingLen;

  Sha3_256 create() { return Sha3_256(u64[25](), u8[136](), 0); }

  /** Absorb more of the message. */
  void update(this, u8[] data) {
    i32 at = 0;
    while (at < data.len()) {
      i32 take = 136 - this.pendingLen;
      if (take > data.len() - at) { take = data.len() - at; }
      for (i32 i = 0; i < take; i++) { this.pending[this.pendingLen + i] = data[at + i]; }
      this.pendingLen = this.pendingLen + take;
      at = at + take;
      if (this.pendingLen == 136) {
        absorb(this.state, this.pending, 0, 136);
        this.pendingLen = 0;
      }
    }
  }

  /** An independent copy, for taking a trial digest without disturbing this one. */
  Sha3_256 clone(const this) {
    u64[] state = u64[25]();
    for (i32 i = 0; i < 25; i++) { state[i] = this.state[i]; }
    u8[] pending = u8[136]();
    for (i32 i = 0; i < 136; i++) { pending[i] = this.pending[i]; }
    return Sha3_256(state, pending, this.pendingLen);
  }

  /**
   * The digest of everything absorbed so far, **without ending the hash**.
   *
   * The live state is untouched: a copy is padded and squeezed. Ending the hash here instead would
   * mean the next cell's digest was taken over a sponge that had already been finalised, which is a
   * different function and desynchronises the circuit rather than failing.
   */
  u8[] peek(const this) {
    u64[] copy = u64[25]();
    for (i32 i = 0; i < 25; i++) { copy[i] = this.state[i]; }
    u8[] block = u8[136]();
    for (i32 i = 0; i < this.pendingLen; i++) { block[i] = this.pending[i]; }
    block[this.pendingLen] = block[this.pendingLen] | 0x06;
    block[135] = block[135] | 0x80;
    absorb(copy, block, 0, 136);
    u8[] out = u8[32]();
    for (i32 i = 0; i < 32; i++) {
      out[i] = ((copy[i / 8] >> (((i % 8) * 8) as! u64)) & 255) as! i32;
    }
    return out;
  }
}
