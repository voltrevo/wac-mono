// bcrypt_pbkdf — OpenBSD's password-based KDF, and what OpenSSH encrypts a private key with.
//
// PBKDF2's shape with bcrypt as the underlying hash, so the work factor is bcrypt's expensive key
// schedule rather than a repeated cheap hash. That is the point of it: a GPU can run SHA-512
// enormously faster than it can run 129 Blowfish key expansions, each of which rewrites 4 KB of
// state with no parallelism available inside it.
//
// It is *not* PBKDF2, and the differences are the parts worth stating because each one silently
// produces a plausible wrong answer:
//
//   - The bcrypt hash writes its output **little-endian**, while everything else in Blowfish is
//     big-endian. This is the famous one; it is a bug in the original that became the standard.
//
//   - The key material is written **striped**, not concatenated. Block `count` supplies bytes
//     `count - 1`, `count - 1 + stride`, `count - 1 + 2 * stride`, … rather than a contiguous
//     run. So getting this wrong still fills the key with the right bytes in the wrong places,
//     and only fails when you try to use it.
//
//   - The salt for round 1 is `salt || count` as a 32-bit big-endian counter; for every later
//     round it is SHA-512 of the *previous round's output*, not of the salt.
//
// Reference: `bcrypt_pbkdf.c` in OpenBSD, which OpenSSH vendors verbatim.

import { sha512 } from "./sha512.wac";
import { Blowfish } from "./blowfish.wac";

/** Bytes of output per bcrypt hash, and the size of the magic block. */
i32 hashSize() { return 32; }

/**
 * The plaintext the bcrypt hash encrypts, 32 bytes exactly.
 *
 * "OxychromaticBlowfishSwatDynamite" — arbitrary, but it has to match byte for byte, so it is
 * spelled out as bytes rather than built from a string to keep any encoding question out of it.
 */
const u8[] MAGIC = u8[](
  0x4f, 0x78, 0x79, 0x63, 0x68, 0x72, 0x6f, 0x6d,      // Oxychrom
  0x61, 0x74, 0x69, 0x63, 0x42, 0x6c, 0x6f, 0x77,      // aticBlow
  0x66, 0x69, 0x73, 0x68, 0x53, 0x77, 0x61, 0x74,      // fishSwat
  0x44, 0x79, 0x6e, 0x61, 0x6d, 0x69, 0x74, 0x65);     // Dynamite

/**
 * One bcrypt hash: 32 bytes out, from a 64-byte hashed password and a 64-byte hashed salt.
 *
 * Both inputs are SHA-512 digests and nothing else — the caller has already hashed them, which is
 * how a password of any length reaches the fixed-size key schedule.
 */
u8[] bcryptHash(u8[] sha2pass, u8[] sha2salt) {
  Blowfish state = Blowfish.create();
  state.expandState(sha2salt, sha2pass);
  // 64 rounds alternating which of the two acts as the key. This is the expensive part, and the
  // reason both are folded in repeatedly rather than once is to keep the schedule dependent on
  // the whole of each.
  for (i32 i = 0; i < 64; i++) {
    state.expand0State(sha2salt);
    state.expand0State(sha2pass);
  }

  // The magic block as eight big-endian words, then 64 passes of the cipher over all four of its
  // 64-bit halves.
  i32[] cdata = i32[8]();
  for (i32 i = 0; i < 8; i++) {
    cdata[i] = (MAGIC[i * 4] << 24) | (MAGIC[i * 4 + 1] << 16)
             | (MAGIC[i * 4 + 2] << 8) | MAGIC[i * 4 + 3];
  }
  for (i32 i = 0; i < 64; i++) {
    for (i32 b = 0; b < 4; b++) {
      state.encipher(cdata, b * 2);
    }
  }

  // Little-endian, against the big-endian read above. Not a typo.
  u8[] out = u8[hashSize()]();
  for (i32 i = 0; i < 8; i++) {
    out[i * 4] = cdata[i] & 255;
    out[i * 4 + 1] = (cdata[i] >>> 8) & 255;
    out[i * 4 + 2] = (cdata[i] >>> 16) & 255;
    out[i * 4 + 3] = (cdata[i] >>> 24) & 255;
  }
  return out;
}

/**
 * Derive `keylen` bytes from `pass` and `salt` with `rounds` of bcrypt.
 *
 * `rounds` is a straight iteration count, not a log2 cost factor as in bcrypt proper — OpenSSH
 * writes 16 by default and `ssh-keygen -a N` sets it.
 */
export u8[] bcryptPbkdf(u8[] pass, u8[] salt, i32 keylen, i32 rounds) {
  if (rounds < 1) { trap; }
  if (pass.len() == 0 || salt.len() == 0) { trap; }
  // The original's bound: the striping indexes by `count - 1` up to `stride`, and beyond this
  // there is no room left to place a block.
  if (keylen <= 0 || keylen > hashSize() * hashSize()) { trap; }

  i32 origKeylen = keylen;
  i32 stride = (keylen + hashSize() - 1) / hashSize();
  i32 amt = (keylen + stride - 1) / stride;

  u8[] key = u8[origKeylen]();
  u8[] sha2pass = sha512(pass);
  u8[] out = u8[hashSize()]();
  u8[] tmpout = u8[hashSize()]();

  i32 count = 1;
  i32 left = keylen;
  while (left > 0) {
    // Round one salts with `salt || count`, big-endian.
    u8[] counted = u8[salt.len() + 4]();
    counted.copyFrom(salt, 0, 0, salt.len());
    counted[salt.len()] = (count >>> 24) & 255;
    counted[salt.len() + 1] = (count >>> 16) & 255;
    counted[salt.len() + 2] = (count >>> 8) & 255;
    counted[salt.len() + 3] = count & 255;

    tmpout = bcryptHash(sha2pass, sha512(counted));
    out.copyFrom(tmpout, 0, 0, hashSize());

    // Later rounds salt with the previous *output*, and xor accumulates so that every round
    // contributes — stopping early would otherwise be as good as the full count.
    for (i32 i = 1; i < rounds; i++) {
      tmpout = bcryptHash(sha2pass, sha512(tmpout));
      for (i32 j = 0; j < hashSize(); j++) {
        out[j] = out[j] ^ tmpout[j];
      }
    }

    // The striped write. `amt` shrinks with what is left so the last block does not overrun.
    i32 take = amt;
    if (take > left) { take = left; }
    i32 written = 0;
    for (i32 i = 0; i < take; i++) {
      i32 dest = i * stride + (count - 1);
      if (dest >= origKeylen) { break; }
      key[dest] = out[i];
      written++;
    }
    if (written == 0) { break; }        // nothing placeable left; without this the loop hangs
    left -= written;
    count++;
  }
  return key;
}
