// AES-CTR (NIST SP 800-38A).
//
// The block cipher becomes a stream cipher: encrypt successive counter blocks
// and xor the keystream with the data. Encryption and decryption are the same
// operation, as with ChaCha20.
//
// The counter is the full 128-bit block, incremented as a big-endian integer —
// the convention WebCrypto uses with `length: 128`, so the two agree byte for
// byte. Narrower counter fields exist in the standard and are not implemented.
//
// A counter value must never repeat under one key. Nothing here can enforce
// that, and reusing one is the way CTR fails catastrophically.

import { aesExpandKey, aesEncryptBlock, aesRounds } from "./aes.wac";

/** Increment a 16-byte big-endian counter in place, wrapping at 2^128. */
void increment(u8[] ctr) {
  for (i32 i = 15; i >= 0; i--) {
    i32 v = ctr[i] + 1;
    ctr[i] = v & 0xFF;
    if (v < 256) { return; }
  }
}

/**
 * Encrypt or decrypt `data` under `key`, starting from counter block `iv`.
 *
 * The final block is truncated to the data length, so the output is exactly as
 * long as the input and no padding is involved.
 */
export u8[] aesCtr(u8[] key, u8[] iv, u8[] data) {
  if (iv.len() != 16) { trap; }

  u8[] w = aesExpandKey(key);
  i32 nr = aesRounds(key.len());

  u8[] ctr = u8[16]();
  for (i32 i = 0; i < 16; i++) { ctr[i] = iv[i]; }

  i32 n = data.len();
  u8[] out = u8[n]();
  i32 pos = 0;
  while (pos < n) {
    u8[] ks = aesEncryptBlock(w, ctr, nr);
    i32 take = n - pos < 16 ? n - pos : 16;
    for (i32 j = 0; j < take; j++) { out[pos + j] = data[pos + j] ^ ks[j]; }
    increment(ctr);
    pos += 16;
  }
  return out;
}

/**
 * One long keystream, consumed a piece at a time.
 *
 * `aesCtr` starts from the counter it is given, so calling it twice reuses the keystream —
 * which under CTR is not a degraded result but a total loss of confidentiality, since
 * xoring the two ciphertexts cancels the key out. It is the right shape for encrypting one
 * message and the wrong shape for a session.
 *
 * Tor is the case that needs this: a circuit's cells in one direction are one continuous
 * keystream, and a cell payload is 509 bytes — not a multiple of 16 — so a cell begins
 * eleven bytes into a block that the cell before it started. Keeping the counter alone
 * would not be enough; the offset within the current block has to survive too.
 */
export struct CtrStream {
  u8[] key;     // kept so the stream can be written down and picked up again
  u8[] w;
  i32 nr;
  u8[] ctr;
  u8[] block;   // the current keystream block
  i32 used;     // how much of it has been consumed: 16 means "generate the next one"

  CtrStream create(u8[] key, u8[] iv) {
    if (iv.len() != 16) { trap; }
    u8[] ctr = u8[16]();
    for (i32 i = 0; i < 16; i++) { ctr[i] = iv[i]; }
    u8[] k = u8[key.len()]();
    for (i32 i = 0; i < key.len(); i++) { k[i] = key[i]; }
    return CtrStream(k, aesExpandKey(key), aesRounds(key.len()), ctr, u8[16](), 16);
  }

  /**
   * Resume a stream that was written down mid-block.
   *
   * The counter alone is not the position: 509-byte cells leave the stream part-way through
   * a block, so the current keystream block and how much of it is spent have to come back
   * too. Reconstructing from the counter only would silently skip to the next block.
   */
  CtrStream resume(u8[] key, u8[] ctr, u8[] block, i32 used) {
    if (ctr.len() != 16 || block.len() != 16) { trap; }
    u8[] k = u8[key.len()]();
    for (i32 i = 0; i < key.len(); i++) { k[i] = key[i]; }
    u8[] c = u8[16]();
    for (i32 i = 0; i < 16; i++) { c[i] = ctr[i]; }
    u8[] b = u8[16]();
    for (i32 i = 0; i < 16; i++) { b[i] = block[i]; }
    return CtrStream(k, aesExpandKey(key), aesRounds(key.len()), c, b, used);
  }

  /** Encrypt or decrypt `data`, advancing the keystream by exactly its length. */
  u8[] apply(this, u8[] data) {
    u8[] out = u8[data.len()]();
    for (i32 i = 0; i < data.len(); i++) {
      if (this.used == 16) {
        this.block = aesEncryptBlock(this.w, this.ctr, this.nr);
        increment(this.ctr);
        this.used = 0;
      }
      out[i] = data[i] ^ this.block[this.used];
      this.used++;
    }
    return out;
  }
}
