// Arithmetic modulo the NIST P-256 prime.
//
//   p = 2^256 - 2^224 + 2^192 + 2^96 - 1
//
// Nothing like Curve25519's prime, and the difference decides the whole implementation.
// 2^255-19 is a power of two minus a small number, so anything overflowing folds back in
// as one small multiply. P-256's prime is a *Solinas* prime: a sum of a few powers of
// 2^32, chosen so that reduction is a handful of 32-bit word shuffles and additions with
// no multiplication at all. Neither trick works for the other prime.
//
// ## Eight limbs of 32 bits
//
// The reduction below is defined on 32-bit words, so the representation is too. Products
// of two 32-bit limbs are 64 bits, which is exactly an i64 with nothing to spare — so
// the multiply accumulates into a 16-word product with explicit carries rather than
// deferring them the way field25519 can.
//
// ## The reduction
//
// FIPS 186-4 D.2.3. Given the 512-bit product as sixteen 32-bit words c15..c0, form nine
// 256-bit values by selecting words, then combine:
//
//   r = s1 + 2*s2 + 2*s3 + s4 + s5 - s6 - s7 - s8 - s9   (mod p)
//
// Each s is a permutation of product words with zeros filling the gaps. There is no
// insight to be had by staring at it — it falls out of writing 2^256, 2^288, ... modulo
// p and collecting terms — so the table below is transcribed from the standard and
// checked against BigInt over random inputs, which is the only review that can find a
// slip in it.

/**
 * p, as eight 32-bit limbs, least significant first.
 *
 * In decimal, not hex, and not by choice: `i64 v = 0xFFFFFFFF` is -1 in wac today,
 * because a hex literal that fits in 32 bits is sign-extended when the target is 64-bit
 * (wac issue 0054). Written in hex this table has six limbs of -1, which made the
 * comparison against p wrong, which made `reduceOnce` subtract p from zero, which meant
 * zero did not survive a round trip through the encoder. Decimal takes the expected type
 * correctly. 4294967295 is 0xFFFFFFFF.
 */
i64[] pLimbs() {
  return i64[](4294967295, 4294967295, 4294967295, 0, 0, 0, 1, 4294967295);
}

export i64[] fpZero() { return i64[8](); }

export i64[] fpOne() {
  i64[] h = i64[8]();
  h[0] = 1;
  return h;
}

export i64[] fpCopy(i64[] a) {
  i64[] h = i64[8]();
  for (i32 i = 0; i < 8; i++) { h[i] = a[i]; }
  return h;
}

/** a < b, on eight-limb values in range. */
bool lessThan(i64[] a, i64[] b) {
  for (i32 i = 7; i >= 0; i--) {
    if (a[i] != b[i]) { return a[i] < b[i]; }
  }
  return false;
}

/** a - b, assuming a >= b. Returns the borrow, which must be zero for a valid result. */
i64 subInto(i64[] out, i64[] a, i64[] b) {
  i64 borrow = 0;
  for (i32 i = 0; i < 8; i++) {
    i64 d = a[i] - b[i] - borrow;
    borrow = d < 0 ? 1 : 0;
    out[i] = d & 4294967295;
  }
  return borrow;
}

/** a + b, returning the carry out of the top limb. */
i64 addInto(i64[] out, i64[] a, i64[] b) {
  i64 carry = 0;
  for (i32 i = 0; i < 8; i++) {
    i64 s = a[i] + b[i] + carry;
    out[i] = s & 4294967295;
    carry = s >> 32;
  }
  return carry;
}

/** Conditionally subtract p, so a value in [0, 2p) lands in [0, p). */
void reduceOnce(i64[] h) {
  i64[] p = pLimbs();
  if (!lessThan(h, p)) {
    i64[] t = i64[8]();
    subInto(t, h, p);
    for (i32 i = 0; i < 8; i++) { h[i] = t[i]; }
  }
}

export i64[] fpAdd(i64[] a, i64[] b) {
  i64[] h = i64[8]();
  i64 carry = addInto(h, a, b);
  // A carry out means the sum is at least 2^256, which is more than 2p — subtract p
  // twice, once for the carry and once for the possible remainder above p.
  if (carry != 0) {
    i64[] p = pLimbs();
    i64[] t = i64[8]();
    subInto(t, h, p);
    for (i32 i = 0; i < 8; i++) { h[i] = t[i]; }
  }
  reduceOnce(h);
  return h;
}

export i64[] fpSub(i64[] a, i64[] b) {
  i64[] h = i64[8]();
  i64 borrow = subInto(h, a, b);
  if (borrow != 0) {
    i64[] p = pLimbs();
    i64[] t = i64[8]();
    addInto(t, h, p);
    for (i32 i = 0; i < 8; i++) { h[i] = t[i]; }
  }
  return h;
}

export i64[] fpNeg(i64[] a) { return fpSub(fpZero(), a); }

export bool fpIsZero(i64[] a) {
  i64 acc = 0;
  for (i32 i = 0; i < 8; i++) { acc = acc | a[i]; }
  return acc == 0;
}

export bool fpEquals(i64[] a, i64[] b) {
  i64 acc = 0;
  for (i32 i = 0; i < 8; i++) { acc = acc | (a[i] ^ b[i]); }
  return acc == 0;
}

/** One word of the 512-bit product, or zero when the index is out of range. */
i64 w(i64[] c, i32 i) { return i < 0 || i > 15 ? 0 : c[i]; }

/** Build one of the nine reduction terms from a list of product-word indices. */
i64[] pick(i64[] c, i32[] idx) {
  i64[] s = i64[8]();
  for (i32 i = 0; i < 8; i++) { s[i] = w(c, idx[i]); }
  return s;
}

/**
 * Reduce a 512-bit product modulo p, by FIPS 186-4 D.2.3.
 *
 * The index tables are written least-significant word first, which is the reverse of how
 * the standard prints them — the standard writes s1 = (c7, c6, ..., c0) with the high
 * word leftmost. Reversing while transcribing is exactly the sort of thing that produces
 * an implementation which is wrong for every input, so it is done once here and the
 * result is checked against BigInt.
 */
i64[] solinas(i64[] c) {
  i64[] s1 = pick(c, i32[](0, 1, 2, 3, 4, 5, 6, 7));
  i64[] s2 = pick(c, i32[](-1, -1, -1, 11, 12, 13, 14, 15));
  i64[] s3 = pick(c, i32[](-1, -1, -1, 12, 13, 14, 15, -1));
  i64[] s4 = pick(c, i32[](8, 9, 10, -1, -1, -1, 14, 15));
  i64[] s5 = pick(c, i32[](9, 10, 11, 13, 14, 15, 13, 8));
  i64[] s6 = pick(c, i32[](11, 12, 13, -1, -1, -1, 8, 10));
  i64[] s7 = pick(c, i32[](12, 13, 14, 15, -1, -1, 9, 11));
  i64[] s8 = pick(c, i32[](13, 14, 15, 8, 9, 10, -1, 12));
  i64[] s9 = pick(c, i32[](14, 15, -1, 9, 10, 11, -1, 13));

  // Work in a wider accumulator so the additions and subtractions can be done before
  // any reduction: nine 256-bit terms with coefficients in [-1, 2] stay well inside an
  // i64 per limb, and one normalisation at the end is cheaper and clearer than nine.
  i64[] acc = i64[9]();
  for (i32 i = 0; i < 8; i++) {
    acc[i] = s1[i] + 2 * s2[i] + 2 * s3[i] + s4[i] + s5[i] - s6[i] - s7[i] - s8[i] - s9[i];
  }

  // Normalise: propagate carries and borrows into a signed multiple of 2^256, then fold
  // that multiple back in. 2^256 = 2^224 - 2^192 - 2^96 + 1 (mod p), so a leftover k at
  // the top costs k times that, which is itself a small eight-limb value.
  i64 carry = 0;
  for (i32 i = 0; i < 8; i++) {
    i64 v = acc[i] + carry;
    carry = v >> 32;
    acc[i] = v & 4294967295;
  }
  i64 k = carry;

  i64[] h = i64[8]();
  for (i32 i = 0; i < 8; i++) { h[i] = acc[i]; }

  // Fold k * 2^256 back in, whichever sign it has. Repeating until k is zero terminates
  // quickly because each round shrinks |k| by a factor of about 2^224.
  while (k != 0) {
    i64[] fold = i64[8]();
    // k * (2^224 - 2^192 - 2^96 + 1), limb by limb, as a signed value.
    i64[] tmp = i64[9]();
    tmp[0] += k;
    tmp[3] -= k;
    tmp[6] -= k;
    tmp[7] += k;
    i64 c2 = 0;
    for (i32 i = 0; i < 8; i++) {
      i64 v = tmp[i] + c2;
      c2 = v >> 32;
      fold[i] = v & 4294967295;
    }
    k = c2;
    i64 carry3 = addInto(h, h, fold);
    k += carry3;
  }

  // h is now in [0, 2^256) and congruent; bring it below p. Several subtractions may be
  // needed because the fold above can leave a value a few multiples of p too large.
  for (i32 i = 0; i < 6; i++) { reduceOnce(h); }
  return h;
}

/** a * b (mod p). */
export i64[] fpMul(i64[] a, i64[] b) {
  i64[] c = i64[16]();
  for (i32 i = 0; i < 8; i++) {
    i64 carry = 0;
    for (i32 j = 0; j < 8; j++) {
      i64 t = c[i + j] + a[i] * b[j] + carry;
      c[i + j] = t & 4294967295;
      carry = (t >> 32) & 4294967295;
    }
    c[i + 8] += carry;
  }
  return solinas(c);
}

export i64[] fpSquare(i64[] a) { return fpMul(a, a); }

/**
 * 1/a, by Fermat: a^(p-2).
 *
 * Plain square-and-multiply over the exponent's bits rather than an addition chain. P-256
 * inversion happens twice per signature verification, so the fifty or so multiplications
 * an optimal chain would save are not worth the transcription risk of writing one.
 */
export i64[] fpInvert(i64[] a) {
  // p - 2. Decimal for the same reason as pLimbs: 4294967293 is 0xFFFFFFFD.
  i64[] e = i64[](4294967293, 4294967295, 4294967295, 0, 0, 0, 1, 4294967295);
  i64[] result = fpOne();
  i64[] base = fpCopy(a);
  for (i32 limb = 0; limb < 8; limb++) {
    for (i32 bit = 0; bit < 32; bit++) {
      if (((e[limb] >> (bit as i64)) & 1) != 0) { result = fpMul(result, base); }
      base = fpSquare(base);
    }
  }
  return result;
}

/** The 32-byte big-endian encoding, which is what P-256 uses everywhere. */
export u8[] fpToBytes(i64[] a) {
  i64[] h = fpCopy(a);
  reduceOnce(h);
  u8[] out = u8[32]();
  for (i32 i = 0; i < 8; i++) {
    i64 v = h[7 - i];
    for (i32 b = 0; b < 4; b++) {
      out[i * 4 + b] = ((v >> (((3 - b) * 8) as i64)) & 255) as! i32;
    }
  }
  return out;
}

/** Decode 32 big-endian bytes. Values at or above p are not valid field elements. */
export i64[] fpFromBytes(u8[] s) {
  if (s.len() != 32) { trap; }
  i64[] h = i64[8]();
  for (i32 i = 0; i < 8; i++) {
    i64 v = 0;
    for (i32 b = 0; b < 4; b++) { v = (v << 8) | (s[i * 4 + b] as i64); }
    h[7 - i] = v;
  }
  return h;
}

/** Whether 32 big-endian bytes are a canonical field element, i.e. below p. */
export bool fpInRange(u8[] s) {
  i64[] h = fpFromBytes(s);
  return lessThan(h, pLimbs());
}
