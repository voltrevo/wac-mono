// AES (FIPS 197), all three key sizes.
//
// Byte-oriented rather than table-driven. The 4 KiB T-box form is faster, but it
// is also the form whose cache behaviour leaks the key, and nothing here is
// constant-time anyway — so the version that reads like the specification is the
// better trade. SubBytes, ShiftRows, MixColumns and AddRoundKey appear as
// themselves.
//
// The S-box is generated from its definition — inverse in GF(2^8) followed by
// the affine map — rather than transcribed. 256 values is well past the point
// where a typo and a bug look the same.
//
// The generator is checked against a structural invariant, not just spot values:
// the table must be a permutation of 0..255 and mutually inverse with INV_SBOX.
// The first attempt had exactly one wrong entry, S[0x01], from an index that
// needed to be modulo 255 — three spot checks all missed it, and the resulting
// cipher was right for most inputs and wrong for some, which is the worst way
// for a cipher to be wrong.

/** The S-box. */
const u8[] SBOX = u8[](
  0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
  0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
  0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
  0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
  0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
  0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
  0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
  0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
  0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
  0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
  0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
  0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
  0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
  0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
  0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
  0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16
);

/** Its inverse, for decryption. */
const u8[] INV_SBOX = u8[](
  0x52, 0x09, 0x6a, 0xd5, 0x30, 0x36, 0xa5, 0x38, 0xbf, 0x40, 0xa3, 0x9e, 0x81, 0xf3, 0xd7, 0xfb,
  0x7c, 0xe3, 0x39, 0x82, 0x9b, 0x2f, 0xff, 0x87, 0x34, 0x8e, 0x43, 0x44, 0xc4, 0xde, 0xe9, 0xcb,
  0x54, 0x7b, 0x94, 0x32, 0xa6, 0xc2, 0x23, 0x3d, 0xee, 0x4c, 0x95, 0x0b, 0x42, 0xfa, 0xc3, 0x4e,
  0x08, 0x2e, 0xa1, 0x66, 0x28, 0xd9, 0x24, 0xb2, 0x76, 0x5b, 0xa2, 0x49, 0x6d, 0x8b, 0xd1, 0x25,
  0x72, 0xf8, 0xf6, 0x64, 0x86, 0x68, 0x98, 0x16, 0xd4, 0xa4, 0x5c, 0xcc, 0x5d, 0x65, 0xb6, 0x92,
  0x6c, 0x70, 0x48, 0x50, 0xfd, 0xed, 0xb9, 0xda, 0x5e, 0x15, 0x46, 0x57, 0xa7, 0x8d, 0x9d, 0x84,
  0x90, 0xd8, 0xab, 0x00, 0x8c, 0xbc, 0xd3, 0x0a, 0xf7, 0xe4, 0x58, 0x05, 0xb8, 0xb3, 0x45, 0x06,
  0xd0, 0x2c, 0x1e, 0x8f, 0xca, 0x3f, 0x0f, 0x02, 0xc1, 0xaf, 0xbd, 0x03, 0x01, 0x13, 0x8a, 0x6b,
  0x3a, 0x91, 0x11, 0x41, 0x4f, 0x67, 0xdc, 0xea, 0x97, 0xf2, 0xcf, 0xce, 0xf0, 0xb4, 0xe6, 0x73,
  0x96, 0xac, 0x74, 0x22, 0xe7, 0xad, 0x35, 0x85, 0xe2, 0xf9, 0x37, 0xe8, 0x1c, 0x75, 0xdf, 0x6e,
  0x47, 0xf1, 0x1a, 0x71, 0x1d, 0x29, 0xc5, 0x89, 0x6f, 0xb7, 0x62, 0x0e, 0xaa, 0x18, 0xbe, 0x1b,
  0xfc, 0x56, 0x3e, 0x4b, 0xc6, 0xd2, 0x79, 0x20, 0x9a, 0xdb, 0xc0, 0xfe, 0x78, 0xcd, 0x5a, 0xf4,
  0x1f, 0xdd, 0xa8, 0x33, 0x88, 0x07, 0xc7, 0x31, 0xb1, 0x12, 0x10, 0x59, 0x27, 0x80, 0xec, 0x5f,
  0x60, 0x51, 0x7f, 0xa9, 0x19, 0xb5, 0x4a, 0x0d, 0x2d, 0xe5, 0x7a, 0x9f, 0x93, 0xc9, 0x9c, 0xef,
  0xa0, 0xe0, 0x3b, 0x4d, 0xae, 0x2a, 0xf5, 0xb0, 0xc8, 0xeb, 0xbb, 0x3c, 0x83, 0x53, 0x99, 0x61,
  0x17, 0x2b, 0x04, 0x7e, 0xba, 0x77, 0xd6, 0x26, 0xe1, 0x69, 0x14, 0x63, 0x55, 0x21, 0x0c, 0x7d
);

/** Round constants: successive powers of 2 in GF(2^8). */
const u8[] RCON = u8[](0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36, 0x6c, 0xd8, 0xab, 0x4d);

/** Multiply by 2 in GF(2^8): a shift, and the reduction polynomial when it overflows. */
i32 xtime(i32 a) {
  i32 s = (a << 1) & 0xFF;
  if ((a & 0x80) != 0) { return s ^ 0x1B; }
  return s;
}

/** Multiply in GF(2^8), by the schoolbook method over the bits of `b`. */
i32 gmul(i32 a, i32 b) {
  i32 result = 0;
  i32 x = a;
  i32 y = b;
  for (i32 i = 0; i < 8; i++) {
    if ((y & 1) != 0) { result ^= x; }
    x = xtime(x);
    y = y >> 1;
  }
  return result;
}

/** Rounds for a key length: 10, 12 or 14 for 128, 192 and 256 bits. */
export i32 aesRounds(i32 keyBytes) {
  if (keyBytes == 16) { return 10; }
  if (keyBytes == 24) { return 12; }
  if (keyBytes == 32) { return 14; }
  trap;
}

/**
 * The expanded key: 16 * (rounds + 1) bytes.
 *
 * Each word is the previous one xored with the word Nk back, with every Nk-th
 * word passed through RotWord, SubWord and a round constant. AES-256 has the
 * extra SubWord at the halfway point, which is the one asymmetry in the schedule.
 */
export u8[] aesExpandKey(u8[] key) {
  i32 nk = key.len() / 4;
  i32 nr = aesRounds(key.len());
  i32 total = 4 * (nr + 1);

  u8[] w = u8[total * 4]();
  for (i32 i = 0; i < key.len(); i++) { w[i] = key[i]; }

  for (i32 i = nk; i < total; i++) {
    i32 a = (i - 1) * 4;
    i32 t0 = w[a]; i32 t1 = w[a + 1]; i32 t2 = w[a + 2]; i32 t3 = w[a + 3];

    if (i % nk == 0) {
      // RotWord, then SubWord, then the round constant on the first byte.
      i32 r0 = t1; i32 r1 = t2; i32 r2 = t3; i32 r3 = t0;
      t0 = SBOX[r0] ^ RCON[i / nk - 1];
      t1 = SBOX[r1];
      t2 = SBOX[r2];
      t3 = SBOX[r3];
    } else if (nk > 6 && i % nk == 4) {
      // AES-256 only: SubWord without the rotate.
      t0 = SBOX[t0]; t1 = SBOX[t1]; t2 = SBOX[t2]; t3 = SBOX[t3];
    }

    i32 b = (i - nk) * 4;
    i32 o = i * 4;
    w[o]     = w[b]     ^ t0;
    w[o + 1] = w[b + 1] ^ t1;
    w[o + 2] = w[b + 2] ^ t2;
    w[o + 3] = w[b + 3] ^ t3;
  }
  return w;
}

void addRoundKey(u8[] s, u8[] w, i32 round) {
  for (i32 i = 0; i < 16; i++) { s[i] ^= w[round * 16 + i]; }
}

/**
 * Encrypt one 16-byte block under an already-expanded key.
 *
 * The state is column-major: byte i sits at row i%4 of column i/4, which is why
 * ShiftRows steps by 4.
 */
export u8[] aesEncryptBlock(u8[] w, u8[] block, i32 nr) {
  u8[] s = u8[16]();
  for (i32 i = 0; i < 16; i++) { s[i] = block[i]; }

  addRoundKey(s, w, 0);

  for (i32 round = 1; round <= nr; round++) {
    for (i32 i = 0; i < 16; i++) { s[i] = SBOX[s[i]]; }

    // ShiftRows: row r rotates left by r.
    u8[] t = u8[16]();
    for (i32 c = 0; c < 4; c++) {
      for (i32 r = 0; r < 4; r++) { t[c * 4 + r] = s[((c + r) % 4) * 4 + r]; }
    }
    for (i32 i = 0; i < 16; i++) { s[i] = t[i]; }

    // MixColumns, on every round but the last.
    if (round != nr) {
      for (i32 c = 0; c < 4; c++) {
        i32 o = c * 4;
        i32 a0 = s[o]; i32 a1 = s[o + 1]; i32 a2 = s[o + 2]; i32 a3 = s[o + 3];
        s[o]     = gmul(a0, 2) ^ gmul(a1, 3) ^ a2 ^ a3;
        s[o + 1] = a0 ^ gmul(a1, 2) ^ gmul(a2, 3) ^ a3;
        s[o + 2] = a0 ^ a1 ^ gmul(a2, 2) ^ gmul(a3, 3);
        s[o + 3] = gmul(a0, 3) ^ a1 ^ a2 ^ gmul(a3, 2);
      }
    }
    addRoundKey(s, w, round);
  }
  return s;
}

/** Decrypt one 16-byte block: the rounds run backwards, with inverse steps. */
export u8[] aesDecryptBlock(u8[] w, u8[] block, i32 nr) {
  u8[] s = u8[16]();
  for (i32 i = 0; i < 16; i++) { s[i] = block[i]; }

  addRoundKey(s, w, nr);

  for (i32 round = nr - 1; round >= 0; round--) {
    // InvShiftRows: row r rotates right by r.
    u8[] t = u8[16]();
    for (i32 c = 0; c < 4; c++) {
      for (i32 r = 0; r < 4; r++) { t[((c + r) % 4) * 4 + r] = s[c * 4 + r]; }
    }
    for (i32 i = 0; i < 16; i++) { s[i] = INV_SBOX[t[i]]; }

    addRoundKey(s, w, round);

    if (round != 0) {
      for (i32 c = 0; c < 4; c++) {
        i32 o = c * 4;
        i32 a0 = s[o]; i32 a1 = s[o + 1]; i32 a2 = s[o + 2]; i32 a3 = s[o + 3];
        s[o]     = gmul(a0, 14) ^ gmul(a1, 11) ^ gmul(a2, 13) ^ gmul(a3, 9);
        s[o + 1] = gmul(a0, 9) ^ gmul(a1, 14) ^ gmul(a2, 11) ^ gmul(a3, 13);
        s[o + 2] = gmul(a0, 13) ^ gmul(a1, 9) ^ gmul(a2, 14) ^ gmul(a3, 11);
        s[o + 3] = gmul(a0, 11) ^ gmul(a1, 13) ^ gmul(a2, 9) ^ gmul(a3, 14);
      }
    }
  }
  return s;
}

/** Encrypt one block under `key`, expanding the key first. */
export u8[] aesEncrypt(u8[] key, u8[] block) {
  return aesEncryptBlock(aesExpandKey(key), block, aesRounds(key.len()));
}

/** Decrypt one block under `key`. */
export u8[] aesDecrypt(u8[] key, u8[] block) {
  return aesDecryptBlock(aesExpandKey(key), block, aesRounds(key.len()));
}
