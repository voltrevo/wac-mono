// NIST P-384: ECDSA verification.
//
// Here because the real web needs it. A client that verifies only P-256 cannot build a
// path to a large share of the public roots — Sectigo's E46, Google's GTS R4, several of
// DigiCert's — which are P-384 even when everything below them in the chain is P-256. The
// leaf being reachable is not enough; the trust anchor has to be.
//
// The curve, the field and the signature algorithm are all shared with P-256: the same
// y^2 = x^3 - 3x + b, the same Jacobian formulas in weierstrass.wac, the same Solinas
// reduction in fieldp.wac reading its prime off the limb count. So this file is four
// constants and a verification entry point, and P-384 arrived without a second copy of
// anything.
//
// Only verification is exported. There is no P-384 key exchange in this stack — TLS
// offers X25519, P-256 and the ML-KEM hybrid — and signing would need a use for it.

import { sha384 } from "./sha512.wac";
import { fpFromBytes } from "./fieldp.wac";
import { Curve, ecdsaVerify } from "./weierstrass.wac";

/** n, the group order, as 48 big-endian bytes. */
export u8[] p384Order() {
  return u8[](
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    0xc7, 0x63, 0x4d, 0x81, 0xf4, 0x37, 0x2d, 0xdf, 0x58, 0x1a, 0x0d, 0xb2,
    0x48, 0xb0, 0xa7, 0x7a, 0xec, 0xec, 0x19, 0x6a, 0xcc, 0xc5, 0x29, 0x73);
}

u8[] bBytes() {
  return u8[](
    0xb3, 0x31, 0x2f, 0xa7, 0xe2, 0x3e, 0xe7, 0xe4, 0x98, 0x8e, 0x05, 0x6b,
    0xe3, 0xf8, 0x2d, 0x19, 0x18, 0x1d, 0x9c, 0x6e, 0xfe, 0x81, 0x41, 0x12,
    0x03, 0x14, 0x08, 0x8f, 0x50, 0x13, 0x87, 0x5a, 0xc6, 0x56, 0x39, 0x8d,
    0x8a, 0x2e, 0xd1, 0x9d, 0x2a, 0x85, 0xc8, 0xed, 0xd3, 0xec, 0x2a, 0xef);
}

u8[] gxBytes() {
  return u8[](
    0xaa, 0x87, 0xca, 0x22, 0xbe, 0x8b, 0x05, 0x37, 0x8e, 0xb1, 0xc7, 0x1e,
    0xf3, 0x20, 0xad, 0x74, 0x6e, 0x1d, 0x3b, 0x62, 0x8b, 0xa7, 0x9b, 0x98,
    0x59, 0xf7, 0x41, 0xe0, 0x82, 0x54, 0x2a, 0x38, 0x55, 0x02, 0xf2, 0x5d,
    0xbf, 0x55, 0x29, 0x6c, 0x3a, 0x54, 0x5e, 0x38, 0x72, 0x76, 0x0a, 0xb7);
}

u8[] gyBytes() {
  return u8[](
    0x36, 0x17, 0xde, 0x4a, 0x96, 0x26, 0x2c, 0x6f, 0x5d, 0x9e, 0x98, 0xbf,
    0x92, 0x92, 0xdc, 0x29, 0xf8, 0xf4, 0x1d, 0xbd, 0x28, 0x9a, 0x14, 0x7c,
    0xe9, 0xda, 0x31, 0x13, 0xb5, 0xf0, 0xb8, 0xc0, 0x0a, 0x60, 0xb1, 0xce,
    0x1d, 0x7e, 0x81, 0x9d, 0x7a, 0x43, 0x1d, 0x7c, 0x90, 0xea, 0x0e, 0x5f);
}

export Curve p384() { return Curve(fpFromBytes(bBytes()), p384Order(), gxBytes(), gyBytes()); }

/** Verify an ECDSA-P384 signature over SHA-384 of `msg`. `sig` is r ++ s, 96 bytes. */
export bool p384Verify(u8[] publicKey, u8[] msg, u8[] sig) {
  return ecdsaVerify(p384(), publicKey, sha384(msg), sig);
}

/**
 * Verify against a digest the caller already has.
 *
 * Certificates need this, and not only for SHA-384: a P-384 key signing with SHA-256 is
 * legal and appears in the wild, and the truncation rule in weierstrass.wac handles a
 * digest shorter than the order by right-aligning it.
 */
export bool p384VerifyDigest(u8[] publicKey, u8[] digest, u8[] sig) {
  return ecdsaVerify(p384(), publicKey, digest, sig);
}
