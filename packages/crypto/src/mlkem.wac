// ML-KEM-768, the post-quantum key encapsulation mechanism of FIPS 203.
//
// Formerly CRYSTALS-Kyber. It is what TLS 1.3 now uses alongside X25519 in the hybrid
// group X25519MLKEM768, which Chrome enabled by default in M124 and which carries a
// large share of real HTTPS traffic — so this is a deployed algorithm rather than a
// speculative one.
//
// ## Why it is smaller than it looks
//
// Everything is arithmetic modulo q = 3329 on polynomials of degree 256. A coefficient
// fits in sixteen bits and a product of two fits in twenty-four, so there is no bignum,
// no modular inversion, no field to build first, and no curve with exceptional cases.
// Against P-256 this is a much simpler object; the difficulty is entirely in getting the
// transform and the sampling exactly right, because both are silent when wrong.
//
// ## The number-theoretic transform
//
// Multiplying two degree-256 polynomials directly is 65536 coefficient products. The NTT
// is a Fourier transform over Z_q that turns it into 256, and ML-KEM is specified with
// keys *already in* the transformed domain, so it is part of the format rather than an
// optimisation you could skip.
//
// It is an *incomplete* transform: q - 1 = 3328 = 2^8 * 13 contains a 256th root of unity
// but not a 512th, so X^256 + 1 factors into 128 quadratics rather than 256 linears. That
// is why the pointwise multiply below is a degree-1 product and not a scalar one.
//
// The 128 twiddle factors are computed rather than written out — powers of 17 permuted by
// seven-bit reversal — for the same reason Keccak's rho offsets are. A table of 128
// numbers copied from a specification is a transcription exercise with no way to check
// it by reading.
//
// ## Not constant-time
//
// Nothing here is. The rejection sampling branches on hash output, which is public; the
// comparison in decapsulation is a loop over bytes that returns early on a difference,
// which is not. See the package README.

import { sha3_256, sha3_512, shake128, shake256 } from "./keccak.wac";

i32 q() { return 3329; }
i32 n() { return 256; }
/** Module rank. 3 is ML-KEM-768; 2 and 4 would be the other parameter sets. */
i32 kk() { return 3; }
i32 eta1() { return 2; }
i32 eta2() { return 2; }
i32 du() { return 10; }
i32 dv() { return 4; }

/** Encapsulation key, decapsulation key and ciphertext sizes, in bytes. */
export i32 ekSize() { return 384 * 3 + 32; }        // 1184
export i32 dkSize() { return 768 * 3 + 96; }        // 2400
export i32 ctSize() { return 32 * (10 * 3 + 4); }   // 1088

i32 mod(i32 a) {
  i32 r = a % 3329;
  return r < 0 ? r + 3329 : r;
}

/**
 * The twiddle factors: zeta^BitRev7(i) for i in 0..127, with zeta = 17.
 *
 * 17 is a primitive 256th root of unity modulo 3329. The bit-reversed ordering is what
 * lets the transform run in place with a linear sweep of the table, and it is the one
 * part of this that is pure convention — get the reversal wrong and every polynomial
 * product is wrong, with no intermediate value that looks obviously broken.
 */
i32[] zetas() {
  i32[] pow = i32[128]();
  pow[0] = 1;
  for (i32 i = 1; i < 128; i++) { pow[i] = mod(pow[i - 1] * 17); }
  i32[] z = i32[128]();
  for (i32 i = 0; i < 128; i++) {
    i32 rev = 0;
    for (i32 b = 0; b < 7; b++) { rev = rev | (((i >> b) & 1) << (6 - b)); }
    z[i] = pow[rev];
  }
  return z;
}

/** The forward transform, in place over 256 coefficients. FIPS 203 Algorithm 9. */
void ntt(i32[] f, i32[] z) {
  i32 i = 1;
  i32 len = 128;
  while (len >= 2) {
    i32 start = 0;
    while (start < 256) {
      i32 zeta = z[i];
      i++;
      for (i32 j = start; j < start + len; j++) {
        i32 t = mod(zeta * f[j + len]);
        f[j + len] = mod(f[j] - t);
        f[j] = mod(f[j] + t);
      }
      start += 2 * len;
    }
    len = len / 2;
  }
}

/** The inverse, including the factor of 128^-1 = 3303. FIPS 203 Algorithm 10. */
void invNtt(i32[] f, i32[] z) {
  i32 i = 127;
  i32 len = 2;
  while (len <= 128) {
    i32 start = 0;
    while (start < 256) {
      i32 zeta = z[i];
      i--;
      for (i32 j = start; j < start + len; j++) {
        i32 t = f[j];
        f[j] = mod(t + f[j + len]);
        f[j + len] = mod(zeta * mod(f[j + len] - t));
      }
      start += 2 * len;
    }
    len = 2 * len;
  }
  for (i32 j = 0; j < 256; j++) { f[j] = mod(f[j] * 3303); }
}

/**
 * Pointwise multiplication in the transformed domain. FIPS 203 Algorithm 11.
 *
 * Each pair of coefficients is a degree-1 polynomial modulo X^2 - zeta^(2 BitRev7(i)+1),
 * so the product is not a scalar one: `a1*b1` folds back in multiplied by that root.
 * Treating this as 256 independent products is the mistake the incomplete transform
 * invites, and it produces a key exchange where both sides derive different secrets.
 */
i32[] multiplyNtt(i32[] a, i32[] b, i32[] z) {
  i32[] c = i32[256]();
  for (i32 i = 0; i < 128; i++) {
    i32 g = z[64 + i / 2];
    // zeta^(2 BitRev7(i) + 1) alternates sign with i's low bit.
    if ((i % 2) == 1) { g = mod(-g); }
    i32 a0 = a[2 * i];
    i32 a1 = a[2 * i + 1];
    i32 b0 = b[2 * i];
    i32 b1 = b[2 * i + 1];
    c[2 * i] = mod(mod(a0 * b0) + mod(mod(a1 * b1) * g));
    c[2 * i + 1] = mod(mod(a0 * b1) + mod(a1 * b0));
  }
  return c;
}

void polyAdd(i32[] a, i32[] b) {
  for (i32 i = 0; i < 256; i++) { a[i] = mod(a[i] + b[i]); }
}

// ── Sampling ──────────────────────────────────────────────────────────────────

/**
 * A uniform polynomial from an extendable output, by rejection. FIPS 203 Algorithm 7.
 *
 * Three bytes give two twelve-bit values; each is kept if it is below q and discarded
 * otherwise. Discarding is what makes the distribution uniform — reducing modulo q
 * instead would bias the low 767 residues, which is undetectable in any single key and
 * is the difference between the security proof applying and not.
 *
 * How many bytes are needed is not known in advance, so this squeezes generously and
 * traps if it still runs out. At three bytes per two candidates and a rejection rate of
 * about one in six, 256 coefficients need around 850 bytes on average.
 */
i32[] sampleNtt(u8[] seed, i32 i, i32 j) {
  u8[] input = u8[34]();
  for (i32 t = 0; t < 32; t++) { input[t] = seed[t]; }
  input[32] = i;
  input[33] = j;
  u8[] stream = shake128(input, 1344);   // eight blocks; overwhelmingly enough

  i32[] a = i32[256]();
  i32 count = 0;
  i32 at = 0;
  while (count < 256) {
    if (at + 3 > stream.len()) { trap; }
    i32 b0 = stream[at];
    i32 b1 = stream[at + 1];
    i32 b2 = stream[at + 2];
    at += 3;
    i32 d1 = b0 | ((b1 & 15) << 8);
    i32 d2 = (b1 >> 4) | (b2 << 4);
    if (d1 < 3329 && count < 256) { a[count] = d1; count++; }
    if (d2 < 3329 && count < 256) { a[count] = d2; count++; }
  }
  return a;
}

/**
 * A small polynomial from a centred binomial distribution. FIPS 203 Algorithm 8.
 *
 * Each coefficient is the number of set bits in one group of eta minus the number in the
 * next, giving a value in [-eta, eta] centred on zero. This is the noise the whole scheme
 * rests on: too small and the lattice problem is easy, too large and decryption fails.
 */
i32[] samplePolyCbd(u8[] bytes, i32 eta) {
  i32[] f = i32[256]();
  for (i32 i = 0; i < 256; i++) {
    i32 x = 0;
    i32 y = 0;
    for (i32 b = 0; b < eta; b++) {
      i32 bitX = 2 * i * eta + b;
      i32 bitY = 2 * i * eta + eta + b;
      x += (bytes[bitX / 8] >> (bitX % 8)) & 1;
      y += (bytes[bitY / 8] >> (bitY % 8)) & 1;
    }
    f[i] = mod(x - y);
  }
  return f;
}

/** PRF(eta, s, b) = SHAKE256(s || b, 64 * eta). */
u8[] prf(u8[] s, i32 b, i32 eta) {
  u8[] input = u8[33]();
  for (i32 i = 0; i < 32; i++) { input[i] = s[i]; }
  input[32] = b;
  return shake256(input, 64 * eta);
}

// ── Encoding and compression ──────────────────────────────────────────────────

/** Pack 256 d-bit values into 32*d bytes, little-endian across the stream. */
u8[] byteEncode(i32[] f, i32 d) {
  u8[] out = u8[32 * d]();
  i32 bitPos = 0;
  for (i32 i = 0; i < 256; i++) {
    for (i32 b = 0; b < d; b++) {
      i32 bit = (f[i] >> b) & 1;
      out[bitPos / 8] = out[bitPos / 8] | (bit << (bitPos % 8));
      bitPos++;
    }
  }
  return out;
}

/**
 * The inverse of byteEncode, reducing modulo q at twelve bits.
 *
 * FIPS 203 defines ByteDecode_d with modulus 2^d for d below twelve and *q* at twelve,
 * and the difference is not cosmetic: it is what makes the encode-decode round trip a
 * test of whether every coefficient was in range. Without the reduction the round trip
 * is the identity for any input at all, and the modulus check FIPS 203 §7.2 requires on
 * an encapsulation key silently passes everything — which is how this was written first,
 * and what the out-of-range test caught.
 */
i32[] byteDecode(u8[] bytes, i32 at, i32 d) {
  i32[] f = i32[256]();
  i32 bitPos = at * 8;
  for (i32 i = 0; i < 256; i++) {
    i32 v = 0;
    for (i32 b = 0; b < d; b++) {
      v = v | (((bytes[bitPos / 8] >> (bitPos % 8)) & 1) << b);
      bitPos++;
    }
    f[i] = d == 12 ? v % 3329 : v;
  }
  return f;
}

/**
 * Compress a coefficient to d bits: round(2^d / q * x) mod 2^d.
 *
 * Rounding, not truncation, and the difference matters — the whole scheme's correctness
 * budget is written in terms of the rounding error, and truncating instead doubles it.
 * Done in integers as `(x * 2^d + q/2) / q` to avoid a floating-point round that would
 * differ between implementations at the halfway points.
 */
i32 compress(i32 x, i32 d) {
  i32 shifted = (x << d) + 1664;   // 1664 = q/2, rounded down
  return (shifted / 3329) & ((1 << d) - 1);
}

i32 decompress(i32 y, i32 d) {
  return (y * 3329 + (1 << (d - 1))) >> d;
}

void compressPoly(i32[] f, i32 d) {
  for (i32 i = 0; i < 256; i++) { f[i] = compress(f[i], d); }
}

void decompressPoly(i32[] f, i32 d) {
  for (i32 i = 0; i < 256; i++) { f[i] = decompress(f[i], d); }
}

// ── K-PKE, the public-key encryption ML-KEM is built from ─────────────────────

/**
 * K-PKE key generation from a 32-byte seed. FIPS 203 Algorithm 13.
 *
 * Returns ek ++ dk, 1184 + 1152 bytes. The matrix A is not stored: it is regenerated
 * from rho whenever it is needed, which is why the encapsulation key can be so much
 * smaller than the matrix it stands for.
 */
u8[] pkeKeyGen(u8[] d) {
  u8[] input = u8[33]();
  for (i32 i = 0; i < 32; i++) { input[i] = d[i]; }
  input[32] = 3;                            // the rank, mixed in per FIPS 203
  u8[] g = sha3_512(input);
  u8[] rho = u8[32]();
  u8[] sigma = u8[32]();
  for (i32 i = 0; i < 32; i++) { rho[i] = g[i]; sigma[i] = g[32 + i]; }

  i32[] z = zetas();

  // s and e, each k small polynomials, then both transformed.
  i32[][] s = i32[][3]();
  i32[][] e = i32[][3]();
  i32 counter = 0;
  for (i32 i = 0; i < 3; i++) {
    s[i] = samplePolyCbd(prf(sigma, counter, 2), 2);
    counter++;
  }
  for (i32 i = 0; i < 3; i++) {
    e[i] = samplePolyCbd(prf(sigma, counter, 2), 2);
    counter++;
  }
  for (i32 i = 0; i < 3; i++) { ntt(s[i], z); ntt(e[i], z); }

  // t = A o s + e, with A generated on the fly.
  i32[][] t = i32[][3]();
  for (i32 i = 0; i < 3; i++) {
    i32[] acc = i32[256]();
    for (i32 j = 0; j < 3; j++) {
      // A[i][j] is sampled from (rho, j, i) — the indices are transposed relative to
      // how the matrix is written, and swapping them yields a key that works only
      // against another implementation with the same swap.
      i32[] aij = sampleNtt(rho, j, i);
      polyAdd(acc, multiplyNtt(aij, s[j], z));
    }
    polyAdd(acc, e[i]);
    t[i] = acc;
  }

  u8[] out = u8[1184 + 1152]();
  for (i32 i = 0; i < 3; i++) {
    u8[] enc = byteEncode(t[i], 12);
    for (i32 b = 0; b < 384; b++) { out[i * 384 + b] = enc[b]; }
  }
  for (i32 i = 0; i < 32; i++) { out[1152 + i] = rho[i]; }
  for (i32 i = 0; i < 3; i++) {
    u8[] enc = byteEncode(s[i], 12);
    for (i32 b = 0; b < 384; b++) { out[1184 + i * 384 + b] = enc[b]; }
  }
  return out;
}

/** K-PKE encryption. FIPS 203 Algorithm 14. Returns the 1088-byte ciphertext. */
u8[] pkeEncrypt(u8[] ek, u8[] m, u8[] rand) {
  i32[] z = zetas();
  u8[] rho = u8[32]();
  for (i32 i = 0; i < 32; i++) { rho[i] = ek[1152 + i]; }

  i32[][] t = i32[][3]();
  for (i32 i = 0; i < 3; i++) { t[i] = byteDecode(ek, i * 384, 12); }

  i32[][] r = i32[][3]();
  i32 counter = 0;
  for (i32 i = 0; i < 3; i++) {
    r[i] = samplePolyCbd(prf(rand, counter, 2), 2);
    counter++;
  }
  i32[][] e1 = i32[][3]();
  for (i32 i = 0; i < 3; i++) {
    e1[i] = samplePolyCbd(prf(rand, counter, 2), 2);
    counter++;
  }
  i32[] e2 = samplePolyCbd(prf(rand, counter, 2), 2);

  for (i32 i = 0; i < 3; i++) { ntt(r[i], z); }

  // u = invNTT(A^T o r) + e1. The transpose is the difference from key generation and
  // is the whole reason both sides land on the same secret.
  i32[][] u = i32[][3]();
  for (i32 i = 0; i < 3; i++) {
    i32[] acc = i32[256]();
    for (i32 j = 0; j < 3; j++) {
      i32[] aji = sampleNtt(rho, i, j);
      polyAdd(acc, multiplyNtt(aji, r[j], z));
    }
    invNtt(acc, z);
    polyAdd(acc, e1[i]);
    u[i] = acc;
  }

  // v = invNTT(t^T o r) + e2 + Decompress(m, 1)
  i32[] v = i32[256]();
  for (i32 j = 0; j < 3; j++) { polyAdd(v, multiplyNtt(t[j], r[j], z)); }
  invNtt(v, z);
  polyAdd(v, e2);
  i32[] mu = byteDecode(m, 0, 1);
  decompressPoly(mu, 1);
  polyAdd(v, mu);

  u8[] out = u8[1088]();
  for (i32 i = 0; i < 3; i++) {
    compressPoly(u[i], 10);
    u8[] enc = byteEncode(u[i], 10);
    for (i32 b = 0; b < 320; b++) { out[i * 320 + b] = enc[b]; }
  }
  compressPoly(v, 4);
  u8[] encV = byteEncode(v, 4);
  for (i32 b = 0; b < 128; b++) { out[960 + b] = encV[b]; }
  return out;
}

/** K-PKE decryption. FIPS 203 Algorithm 15. Returns the 32-byte message. */
u8[] pkeDecrypt(u8[] dkPke, u8[] ct) {
  i32[] z = zetas();
  i32[][] u = i32[][3]();
  for (i32 i = 0; i < 3; i++) {
    u[i] = byteDecode(ct, i * 320, 10);
    decompressPoly(u[i], 10);
    ntt(u[i], z);
  }
  i32[] v = byteDecode(ct, 960, 4);
  decompressPoly(v, 4);

  i32[] w = i32[256]();
  for (i32 i = 0; i < 3; i++) {
    i32[] si = byteDecode(dkPke, i * 384, 12);
    polyAdd(w, multiplyNtt(si, u[i], z));
  }
  invNtt(w, z);
  for (i32 i = 0; i < 256; i++) { w[i] = mod(v[i] - w[i]); }
  compressPoly(w, 1);
  return byteEncode(w, 1);
}

// ── ML-KEM ────────────────────────────────────────────────────────────────────

/**
 * Key generation from the 64-byte seed d ++ z. FIPS 203 Algorithm 16.
 *
 * Returns ek ++ dk. The decapsulation key carries the encapsulation key and its hash
 * inside it, which looks redundant and is not: decapsulation has to re-encrypt to check
 * the ciphertext, and doing that needs the public key.
 */
export u8[] mlkemKeyGen(u8[] seed) {
  if (seed.len() != 64) { trap; }
  u8[] d = u8[32]();
  u8[] zz = u8[32]();
  for (i32 i = 0; i < 32; i++) { d[i] = seed[i]; zz[i] = seed[32 + i]; }

  u8[] pke = pkeKeyGen(d);
  u8[] ek = u8[1184]();
  for (i32 i = 0; i < 1184; i++) { ek[i] = pke[i]; }

  u8[] dk = u8[2400]();
  for (i32 i = 0; i < 1152; i++) { dk[i] = pke[1184 + i]; }
  for (i32 i = 0; i < 1184; i++) { dk[1152 + i] = ek[i]; }
  u8[] h = sha3_256(ek);
  for (i32 i = 0; i < 32; i++) { dk[2336 + i] = h[i]; }
  for (i32 i = 0; i < 32; i++) { dk[2368 + i] = zz[i]; }

  u8[] out = u8[1184 + 2400]();
  for (i32 i = 0; i < 1184; i++) { out[i] = ek[i]; }
  for (i32 i = 0; i < 2400; i++) { out[1184 + i] = dk[i]; }
  return out;
}

/**
 * Encapsulate under `ek` with 32 bytes of randomness. FIPS 203 Algorithm 17.
 *
 * Returns the 32-byte shared secret followed by the 1088-byte ciphertext. `m` is a
 * parameter for the same reason ECDSA's k is: wac has no randomness, and a caller that
 * can see the responsibility is better than one that cannot.
 *
 * The modulus check on `ek` is required by FIPS 203 §7.2 and is not decoration — an
 * encapsulation key whose coefficients are not all below q is not a valid key, and
 * accepting one lets an attacker choose the arithmetic.
 */
export u8[] mlkemEncaps(u8[] ek, u8[] m) {
  if (ek.len() != 1184) { trap; }
  if (m.len() != 32) { trap; }
  // Round-trip the encoding: re-encoding what we decoded must give back the same bytes,
  // which is exactly the condition that every coefficient was below q.
  for (i32 i = 0; i < 3; i++) {
    i32[] ti = byteDecode(ek, i * 384, 12);
    u8[] re = byteEncode(ti, 12);
    for (i32 b = 0; b < 384; b++) {
      if (re[b] != ek[i * 384 + b]) { trap; }
    }
  }

  u8[] h = sha3_256(ek);
  u8[] gIn = u8[64]();
  for (i32 i = 0; i < 32; i++) { gIn[i] = m[i]; gIn[32 + i] = h[i]; }
  u8[] g = sha3_512(gIn);
  u8[] key = u8[32]();
  u8[] r = u8[32]();
  for (i32 i = 0; i < 32; i++) { key[i] = g[i]; r[i] = g[32 + i]; }

  u8[] ct = pkeEncrypt(ek, m, r);
  u8[] out = u8[32 + 1088]();
  for (i32 i = 0; i < 32; i++) { out[i] = key[i]; }
  for (i32 i = 0; i < 1088; i++) { out[32 + i] = ct[i]; }
  return out;
}

/**
 * Decapsulate. FIPS 203 Algorithm 18. Returns the 32-byte shared secret.
 *
 * The re-encryption is the point of the whole construction. A ciphertext that does not
 * decrypt to something which would re-encrypt to itself is rejected — but rejected by
 * returning a *different* secret derived from a key only the holder knows, never by
 * signalling failure. A KEM that reported "invalid ciphertext" would hand an attacker
 * the decryption oracle the Fujisaki-Okamoto transform exists to deny them.
 */
export u8[] mlkemDecaps(u8[] dk, u8[] ct) {
  if (dk.len() != 2400) { trap; }
  if (ct.len() != 1088) { trap; }

  u8[] dkPke = u8[1152]();
  for (i32 i = 0; i < 1152; i++) { dkPke[i] = dk[i]; }
  u8[] ek = u8[1184]();
  for (i32 i = 0; i < 1184; i++) { ek[i] = dk[1152 + i]; }
  u8[] h = u8[32]();
  for (i32 i = 0; i < 32; i++) { h[i] = dk[2336 + i]; }
  u8[] zz = u8[32]();
  for (i32 i = 0; i < 32; i++) { zz[i] = dk[2368 + i]; }

  u8[] mPrime = pkeDecrypt(dkPke, ct);
  u8[] gIn = u8[64]();
  for (i32 i = 0; i < 32; i++) { gIn[i] = mPrime[i]; gIn[32 + i] = h[i]; }
  u8[] g = sha3_512(gIn);
  u8[] kPrime = u8[32]();
  u8[] rPrime = u8[32]();
  for (i32 i = 0; i < 32; i++) { kPrime[i] = g[i]; rPrime[i] = g[32 + i]; }

  // The implicit rejection key, from z and the ciphertext.
  u8[] jIn = u8[32 + 1088]();
  for (i32 i = 0; i < 32; i++) { jIn[i] = zz[i]; }
  for (i32 i = 0; i < 1088; i++) { jIn[32 + i] = ct[i]; }
  u8[] kBar = shake256(jIn, 32);

  u8[] ctPrime = pkeEncrypt(ek, mPrime, rPrime);
  i32 diff = 0;
  for (i32 i = 0; i < 1088; i++) { diff = diff | (ctPrime[i] ^ ct[i]); }

  u8[] out = u8[32]();
  for (i32 i = 0; i < 32; i++) { out[i] = diff == 0 ? kPrime[i] : kBar[i]; }
  return out;
}
