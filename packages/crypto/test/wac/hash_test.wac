// SHA-2, tested in wac against an independent implementation passed in from the host.
//
// The pilot for moving tests out of TypeScript. Everything here used to be a `.test.ts`
// that reached into wac through a probe; now the test is wac and the *oracle* is the only
// thing that comes from outside. That inverts the dependency: TypeScript supplies a fact,
// rather than owning the loop, the assertions and the failure messages.
//
// `ref(bytes, bits)` is `node:crypto`, which matters for a reason beyond convenience.
// WebCrypto's digest is a Promise, and a wasm call cannot await, so it cannot be a
// callback at all — while node's `createHash` is synchronous and can. That is the whole
// difference between this file being possible and not.
//
// ## What is checked, and why these lengths
//
// SHA-2 is a block function with length padding, so the interesting inputs are the ones
// that straddle a block: a message one byte short of 64 leaves no room for the 8-byte
// length and forces a second block that is nothing but padding. An implementation that
// writes the length into the wrong block is correct for almost every input and wrong
// there. Both rates are covered from both sides — 64 bytes for SHA-256, 128 for the
// SHA-512 family, whose eight-byte length field is really sixteen.

import { T } from "../../../wactest/src/assert.wac";
import { itoa64 } from "../../../wactest/src/itoa64.wac";
import { sha256 } from "../../src/sha256.wac";
import { sha512, sha384 } from "../../src/sha512.wac";

/** A deterministic message of `n` bytes; no two lengths share a prefix pattern. */
u8[] msg(i32 n, i32 seed) {
  u8[] out = u8[n]();
  for (i32 i = 0; i < n; i++) { out[i] = (i * 37 + seed * 11 + 3) & 0xFF; }
  return out;
}

/** The lengths a padding bug hides in, for a block size of `rate`. */
i32[] boundaries(i32 rate, i32 lenBytes) {
  return i32[](0, 1, 2,
               rate - lenBytes - 1, rate - lenBytes, rate - lenBytes + 1,
               rate - 2, rate - 1, rate, rate + 1,
               2 * rate - 1, 2 * rate, 2 * rate + 1,
               3 * rate + 17);
}

export string test_sha256_agrees_with_the_host(fn[u8[](u8[], i32)] ref) {
  T t = T.create();
  i32[] lens = boundaries(64, 8);
  for (i32 i = 0; i < lens.len(); i++) {
    u8[] m = msg(lens[i], i);
    t.eqBytes(sha256(m), ref(m, 256), "sha256 at " + itoa64(lens[i] as i64) + " bytes");
  }
  return t.report();
}

export string test_sha512_and_sha384_agree_with_the_host(fn[u8[](u8[], i32)] ref) {
  T t = T.create();
  i32[] lens = boundaries(128, 16);
  for (i32 i = 0; i < lens.len(); i++) {
    u8[] m = msg(lens[i], i + 7);
    t.eqBytes(sha512(m), ref(m, 512), "sha512 at " + itoa64(lens[i] as i64) + " bytes");
    t.eqBytes(sha384(m), ref(m, 384), "sha384 at " + itoa64(lens[i] as i64) + " bytes");
  }
  return t.report();
}

export string test_the_three_are_different_functions(fn[u8[](u8[], i32)] ref) {
  // SHA-384 is SHA-512 with a different initial state and a truncated output, so an
  // implementation that truncated without changing the state would agree with SHA-512 on
  // its first 48 bytes. Comparing them to each other catches that; comparing each to the
  // oracle catches it too, but only this says which mistake was made.
  T t = T.create();
  u8[] m = msg(200, 5);
  u8[] a = sha384(m);
  u8[] b = sha512(m);
  bool samePrefix = true;
  for (i32 i = 0; i < 48; i++) { if (a[i] != b[i]) { samePrefix = false; } }
  t.isFalse(samePrefix, "sha384 is not a truncated sha512");
  t.eqI32(a.len(), 48, "sha384 output length");
  t.eqI32(b.len(), 64, "sha512 output length");
  t.eqI32(sha256(m).len(), 32, "sha256 output length");
  return t.report();
}

/**
 * A test with no oracle at all, in the same file.
 *
 * Worth having here to show the two kinds coexist: this one declares no parameter, so it
 * reaches nothing outside the module, and the compiled binary says so — a wac module with
 * no `fn` parameter has no imports, which is checkable rather than promised.
 */
export string test_hashing_is_a_function() {
  T t = T.create();
  u8[] m = msg(97, 2);
  t.eqBytes(sha256(m), sha256(m), "the same input gives the same digest");
  u8[] other = msg(97, 3);
  bool differs = false;
  u8[] x = sha256(m);
  u8[] y = sha256(other);
  for (i32 i = 0; i < 32; i++) { if (x[i] != y[i]) { differs = true; } }
  t.isTrue(differs, "different inputs give different digests");
  return t.report();
}

/** Hex, so the published vectors read as they are printed. */
u8[] unhex(string h) {
  u8[] src = h.toBytes();
  u8[] out = u8[src.len() / 2]();
  for (i32 i = 0; i < out.len(); i++) { out[i] = nib(src[2 * i]) * 16 + nib(src[2 * i + 1]); }
  return out;
}
i32 nib(i32 c) {
  if (c >= '0' && c <= '9') { return c - '0'; }
  if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
  trap;
}

/**
 * The published NIST vectors.
 *
 * Stronger than the differential above and worth having beside it: agreeing with FIPS
 * 180-4 is agreeing with the standard, where agreeing with node is agreeing with another
 * implementation's reading of it. The differential still earns its place by covering
 * every block boundary, which the published set does not.
 */
export string test_the_published_nist_vectors() {
  T t = T.create();
  t.eqBytes(sha256("".toBytes()),
            unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"),
            "sha256 of the empty string");
  t.eqBytes(sha256("abc".toBytes()),
            unhex("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"),
            "sha256 abc");
  t.eqBytes(sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".toBytes()),
            unhex("248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"),
            "sha256 the 56-byte vector, which straddles a block");
  t.eqBytes(sha512("".toBytes()),
            unhex("cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce" +
                  "47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"),
            "sha512 of the empty string");
  t.eqBytes(sha512("abc".toBytes()),
            unhex("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a" +
                  "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"),
            "sha512 abc");
  t.eqBytes(sha384("".toBytes()),
            unhex("38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"),
            "sha384 of the empty string");
  t.eqBytes(sha384("abc".toBytes()),
            unhex("cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"),
            "sha384 abc");
  return t.report();
}

/**
 * A million 'a', which is the vector that catches a length counter that is too narrow.
 *
 * SHA-256 encodes the message length in bits as a 64-bit field; a million bytes is eight
 * million bits, past what a 32-bit counter holds once it is multiplied by eight in the
 * wrong width. Nothing shorter reaches that.
 */
export string test_the_long_nist_vector() {
  T t = T.create();
  u8[] m = u8[1000000]();
  for (i32 i = 0; i < m.len(); i++) { m[i] = 'a'; }
  t.eqBytes(sha256(m),
            unhex("cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"),
            "sha256 of a million a");
  t.eqBytes(sha512(m),
            unhex("e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973eb" +
                  "de0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b"),
            "sha512 of a million a");
  return t.report();
}

/**
 * Every length through two blocks, not just the boundaries.
 *
 * The boundary set above is chosen from knowing where padding goes wrong; this makes no
 * such assumption and simply checks all of them. Cheap enough that picking cleverly is
 * not worth the risk of picking wrongly.
 */
export string test_every_length_through_two_blocks(fn[u8[](u8[], i32)] ref) {
  T t = T.create();
  for (i32 n = 0; n <= 130; n++) {
    u8[] m = u8[n]();
    for (i32 i = 0; i < n; i++) { m[i] = (i * 37 + 11) & 0xFF; }
    t.eqBytes(sha256(m), ref(m, 256), "sha256 at length " + itoa64(n as i64));
  }
  for (i32 n = 0; n <= 260; n++) {
    u8[] m = u8[n]();
    for (i32 i = 0; i < n; i++) { m[i] = (i * 53 + 7) & 0xFF; }
    t.eqBytes(sha512(m), ref(m, 512), "sha512 at length " + itoa64(n as i64));
  }
  return t.report();
}

/**
 * Random inputs, deterministically generated.
 *
 * An LCG rather than real randomness: a test that fails only sometimes is a test nobody
 * can act on, and the point of sweeping is breadth rather than surprise. The generator is
 * three lines, so the corpus costs nothing to store — which is the argument for computing
 * inputs over committing a table of them.
 */
export string test_random_inputs(fn[u8[](u8[], i32)] ref) {
  T t = T.create();
  i64 s = 305419896;
  for (i32 k = 0; k < 120; k++) {
    s = (s * 1103515245 + 12345) & 2147483647;
    i32 n = ((s >> 7) % 4000) as! i32;
    u8[] m = u8[n]();
    for (i32 i = 0; i < n; i++) {
      s = (s * 1103515245 + 12345) & 2147483647;
      m[i] = ((s >> 13) & 255) as! i32;
    }
    t.eqBytes(sha256(m), ref(m, 256), "sha256 random " + itoa64(k as i64));
    t.eqBytes(sha512(m), ref(m, 512), "sha512 random " + itoa64(k as i64));
  }
  return t.report();
}
