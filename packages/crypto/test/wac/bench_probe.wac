// The hashes over a large message, measured inside wasm.
//
// The message is allocated and hashed on this side of the bridge on purpose: bindgen copies an array one
// exported call per element, so handing 36 MB across it would measure the boundary rather than the hash.
import { sha256 } from "../../src/sha256.wac";
import { sha512 } from "../../src/sha512.wac";
import { keccak256, sha3_256 } from "../../src/keccak.wac";

u8[] message(i32 n) {
  // Not zeroes: a compressing hash does not care, but a reader comparing these numbers against another
  // implementation might, and a constant input invites the question.
  u8[] m = u8[n]();
  i32 x = 1;
  for (i32 i = 0; i < n; i++) { x = (x * 1103515245 + 12345) & 0x7FFFFFFF; m[i] = x >> 16; }
  return m;
}

/**
 * The message alone, so the bench can subtract it.
 *
 * wac has no mutable module-level state, so a probe cannot build the input once and keep it — and handing
 * it across bindgen would cost more than the hash. Building it per call and measuring the build on its own
 * is what is left, and it is not small: a PRNG byte at a time over 36 MB is comparable to hashing it.
 */
export u8[] benchBuild(i32 n) {
  u8[] m = message(n);
  u8[] out = u8[32]();
  out.copyFrom(m, 0, 0, 32);
  return out;
}

export u8[] benchSha256(i32 n) { return sha256(message(n)); }
export u8[] benchSha512(i32 n) { return sha512(message(n)); }
export u8[] benchKeccak(i32 n) { return keccak256(message(n)); }
export u8[] benchSha3(i32 n) { return sha3_256(message(n)); }
