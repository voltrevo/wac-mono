// Host-visible wrappers for the differential tests.
import { sha256 as sha256Impl } from "../../src/sha256.wac";
import { sha512 as sha512Impl, sha384 as sha384Impl } from "../../src/sha512.wac";
import { aesEncrypt as aesEncImpl, aesDecrypt as aesDecImpl } from "../../src/aes.wac";
import { aesCtr as aesCtrImpl } from "../../src/aesctr.wac";
import { ghash as ghashImpl } from "../../src/ghash.wac";
import { gcmEncrypt as gcmEncImpl, gcmTag as gcmTagImpl, gcmDecrypt as gcmDecImpl, gcmInc32 as incImpl } from "../../src/aesgcm.wac";
import { hmacSha256 as hmacImpl } from "../../src/hmac.wac";
import { chachaBlock as blockImpl, chacha20 as chachaImpl } from "../../src/chacha20.wac";
import { hkdf as hkdfImpl, hkdfExtract as extractImpl } from "../../src/hkdf.wac";
import { poly1305 as polyImpl } from "../../src/poly1305.wac";
import { aeadEncrypt as encImpl, aeadDecrypt as decImpl, aeadTag as tagImpl } from "../../src/aead.wac";
import { leWord32 as leWord32Impl, storeLE32 as storeLE32Impl, beWord32 as beWord32Impl,
  storeBE32 as storeBE32Impl, beWord64 as beWord64Impl, storeBE64 as storeBE64Impl,
  padTo16 as padTo16Impl } from "../../src/layout.wac";

export u8[] sha256(u8[] m) { return sha256Impl(m); }

export u8[] hmac(u8[] key, u8[] msg) { return hmacImpl(key, msg); }

export u8[] chachaBlock(u8[] key, u32 ctr, u8[] nonce) { return blockImpl(key, ctr, nonce); }
export u8[] chacha20(u8[] key, u32 ctr, u8[] nonce, u8[] msg) { return chachaImpl(key, ctr, nonce, msg); }

export u8[] hkdfExtract(u8[] salt, u8[] ikm) { return extractImpl(salt, ikm); }
export u8[] hkdf(u8[] salt, u8[] ikm, u8[] info, i32 len) { return hkdfImpl(salt, ikm, info, len); }

export u8[] poly1305(u8[] key, u8[] msg) { return polyImpl(key, msg); }

export u8[] aeadEncrypt(u8[] k, u8[] n, u8[] p) { return encImpl(k, n, p); }
export u8[] aeadTag(u8[] k, u8[] n, u8[] a, u8[] c) { return tagImpl(k, n, a, c); }
export u8[] aeadDecrypt(u8[] k, u8[] n, u8[] a, u8[] c, u8[] t) { return decImpl(k, n, a, c, t); }

export u8[] sha512(u8[] m) { return sha512Impl(m); }
export u8[] sha384(u8[] m) { return sha384Impl(m); }

export u8[] aesEncrypt(u8[] k, u8[] b) { return aesEncImpl(k, b); }
export u8[] aesDecrypt(u8[] k, u8[] b) { return aesDecImpl(k, b); }

export u8[] aesCtr(u8[] k, u8[] iv, u8[] d) { return aesCtrImpl(k, iv, d); }

export u8[] ghash(u8[] h, u8[] d) { return ghashImpl(h, d); }
export u8[] gcmEncrypt(u8[] k, u8[] iv, u8[] p) { return gcmEncImpl(k, iv, p); }
export u8[] gcmTag(u8[] k, u8[] iv, u8[] a, u8[] c) { return gcmTagImpl(k, iv, a, c); }
export u8[] gcmDecrypt(u8[] k, u8[] iv, u8[] a, u8[] c, u8[] t) { return gcmDecImpl(k, iv, a, c, t); }

export u8[] gcmInc32(u8[] c) { u8[] o = u8[16](); for (i32 i = 0; i < 16; i++) { o[i] = c[i]; } incImpl(o); return o; }

// layout.wac's conversions, so they can be checked against the host's DataView
// rather than only indirectly through the primitives that use them.
export u32 leWord32(u8[] b, i32 i) { return leWord32Impl(b, i); }
export u32 beWord32(u8[] b, i32 i) { return beWord32Impl(b, i); }
export u64 beWord64(u8[] b, i32 i) { return beWord64Impl(b, i); }
export u8[] storeLE32(u32 v) { u8[] o = u8[4](); storeLE32Impl(v, o, 0); return o; }
export u8[] storeBE32(u32 v) { u8[] o = u8[4](); storeBE32Impl(v, o, 0); return o; }
export u8[] storeBE64(u64 v) { u8[] o = u8[8](); storeBE64Impl(v, o, 0); return o; }
export i32 padTo16(i32 n) { return padTo16Impl(n); }
