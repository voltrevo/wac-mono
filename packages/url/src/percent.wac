// Percent-encoding, and the encode sets the URL standard defines.
//
// Five sets, each a superset of the one before it, applied to different parts of a URL. They
// are not interchangeable and the differences are load-bearing: `'` is escaped in the query of
// a special scheme but not otherwise, and `%` itself is only escaped in the component set,
// which is why `%41` survives a path but not `encodeURIComponent`.
//
// Everything here works on UTF-8 bytes rather than code points. That is what the standard says
// to encode — "UTF-8 percent-encode" is defined byte-wise — so a multi-byte scalar becomes one
// `%XX` per byte with no special handling, and this file needs no notion of a code point at all.

import { Buf } from "../../bytes/src/buf.wac";

// The sets, ordered so that each includes every one above it. Passed as an i32 rather than
// resolved through a funcref: `Map` takes funcrefs because its key type is open, but these are
// a closed set of five, and a `switch` on a constant is both faster and easier to read.
export i32 SET_C0() { return 0; }
export i32 SET_FRAGMENT() { return 1; }
export i32 SET_QUERY() { return 2; }
export i32 SET_SPECIAL_QUERY() { return 3; }
export i32 SET_PATH() { return 4; }
export i32 SET_USERINFO() { return 5; }
export i32 SET_COMPONENT() { return 6; }

/**
 * Whether byte `c` must be percent-encoded in `set`.
 *
 * Written as a cascade of `if`s over the set index rather than as a table, because the sets
 * nest: everything outside C0 is encoded everywhere, and each set adds a handful of ASCII
 * punctuation to the one before.
 */
export bool inEncodeSet(i32 c, i32 set) {
  // The C0 control percent-encode set: C0 controls and everything above `~`. Every other set
  // contains it, so this is the common case and comes first.
  if (c < 0x20 || c > 0x7E) { return true; }
  if (set == SET_C0()) { return false; }

  if (set == SET_FRAGMENT()) {
    return c == ' ' || c == '"' || c == '<' || c == '>' || c == '`';
  }

  // Query, and the special-scheme query which adds the apostrophe.
  if (set == SET_QUERY() || set == SET_SPECIAL_QUERY()) {
    if (c == ' ' || c == '"' || c == '#' || c == '<' || c == '>') { return true; }
    return set == SET_SPECIAL_QUERY() && c == '\'';
  }

  // Path, userinfo and component all start from the query set (without the apostrophe).
  if (c == ' ' || c == '"' || c == '#' || c == '<' || c == '>') { return true; }
  if (c == '?' || c == '`' || c == '{' || c == '}') { return true; }
  if (set == SET_PATH()) { return false; }

  if (c == '/' || c == ':' || c == ';' || c == '=' || c == '@'
      || c == '[' || c == '\\' || c == ']' || c == '^' || c == '|') {
    return true;
  }
  if (set == SET_USERINFO()) { return false; }

  // The component set, which is what `encodeURIComponent` approximates. `%` is here and
  // nowhere else, so this is the only set under which an already-encoded string is re-encoded.
  return c == '$' || c == '%' || c == '&' || c == '+' || c == ',';
}

i32 hexDigitValue(i32 c) {
  if (c >= '0' && c <= '9') { return c - '0'; }
  if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
  if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
  return -1;
}

export bool isHexDigit(i32 c) { return hexDigitValue(c) >= 0; }

i32 hexUpper(i32 nibble) { return nibble < 10 ? 48 + nibble : 55 + nibble; }

/** Append `%XX` for one byte, uppercase, which is the form the standard serializes. */
export void writePercent(Buf out, i32 b) {
  out.push('%');
  out.push(hexUpper((b >> 4) & 15));
  out.push(hexUpper(b & 15));
}

/** Append `bytes`, percent-encoding whatever `set` requires and passing the rest through. */
export void encodeInto(Buf out, u8[] bytes, i32 set) {
  for (i32 i = 0; i < bytes.len(); i++) {
    i32 c = bytes[i];
    if (inEncodeSet(c, set)) {
      writePercent(out, c);
    } else {
      out.push(c);
    }
  }
}

export u8[] encode(u8[] bytes, i32 set) {
  Buf out = Buf.create();
  encodeInto(out, bytes, set);
  return out.take();
}

/**
 * Percent-decoding.
 *
 * A `%` not followed by two hex digits is a literal `%` — the standard decodes rather than
 * rejects, so `%zz` and a trailing `%` both survive unchanged. The result is bytes and may not
 * be valid UTF-8; that is the caller's problem, and for hosts it is deliberately not checked
 * here.
 */
export u8[] decode(u8[] bytes) {
  Buf out = Buf.create();
  i32 i = 0;
  while (i < bytes.len()) {
    i32 c = bytes[i];
    if (c != '%' || i + 2 >= bytes.len()) {
      out.push(c);
      i++;
      continue;
    }
    i32 hi = hexDigitValue(bytes[i + 1]);
    i32 lo = hexDigitValue(bytes[i + 2]);
    if (hi < 0 || lo < 0) {
      out.push(c);
      i++;
      continue;
    }
    out.push(hi * 16 + lo);
    i = i + 3;
  }
  return out.take();
}
