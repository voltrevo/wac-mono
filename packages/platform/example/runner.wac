// Run another wac program as a worker, feed it, and read what it says.
//
//   runner <child.worker.js> <text>
//
// The child is a handle, so nothing here is new: `send` gives it standard input,
// `closeSocket` ends that input, `recv` reads what it wrote, and `exitCode` waits for it.
// The same four calls would serve a socket.
//
// Build a child with `--worker`:
//
//   deno task app:build packages/platform/example/wc.wac --worker -o wc.worker.js
//   runner wc.worker.js "one two three"     ->  1 3 14

import { Child, Cli, Core, FileResult, Pending } from "../src/platform.wac";

export i32 main(Core core, Cli cli) {
  if (cli.argCount().wait() < 2) {
    core.warn("usage: runner <child.worker.js> <text>");
    return 2;
  }

  // Two steps rather than one: read the program, then run it. There is no registry of
  // launchable things — where the code came from is the filesystem's business.
  FileResult prog = cli.readFile(cli.arg(0).wait()).wait();
  if (!prog.ok) {
    core.warn("runner: " + cli.arg(0).wait() + ": " + prog.error);
    return 1;
  }

  Child kid = cli.spawn(string.fromBytes(prog.bytes), string[]()).wait();
  if (kid.handle < 0) {
    core.warn("runner: " + kid.error);
    return 1;
  }

  // Its standard input, then end it — a child reading to EOF gets one.
  cli.send(kid.handle, (cli.arg(1).wait() + "\n").toBytes()).wait();
  cli.closeFeed(kid.handle);

  // Everything it wrote, until it stops writing.
  while (true) {
    u8[] chunk = cli.recv(kid.handle).wait();
    if (chunk.len() == 0) { break; }
    cli.write(chunk);
  }

  i32 code = cli.exitCode(kid.handle).wait();
  if (code != 0) { core.warn("runner: child exited " + itoa(code)); }
  return code;
}

string itoa(i32 n) {
  if (n == 0) { return "0"; }
  i32 v = n < 0 ? 0 - n : n;
  u8[] digits = u8[12](fill: 0);
  i32 at = 12;
  while (v > 0) { at--; digits[at] = '0' + (v % 10); v = v / 10; }
  u8[] used = u8[12 - at](fill: 0);
  used.copyFrom(digits, at, 0, 12 - at);
  return (n < 0 ? "-" : "") + string.fromBytes(used);
}
