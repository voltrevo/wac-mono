// Two programs, piped together, with no shell involved.
//
//   pipe <worker.js> <argsA> <argsB>
//
// Standard input goes to the first child, its output becomes the second child's input, and
// the second child's output goes to standard output. What a shell's `|` does, except that
// the plumbing is a wac program and both stages run inside this process as workers.
//
//   deno task app:build packages/box/src/box.wac --worker -o box.worker.js
//   printf 'b\na\nb\n' | pipe box.worker.js sort uniq      ->  a  b
//
// Three handles are live at once — standard input, and one per child — and the loop waits on
// whichever moves. It never asks which kind a handle is, because there is nothing to ask:
// `recv` reads standard input at handle 0 exactly as it reads a child or a socket. That is
// the property being demonstrated, more than the pipeline itself.
//
// Note the deadlock this cannot have. A shell pipeline needs an OS buffer between the stages,
// and a stage that stops reading while the one before it keeps writing wedges both. Here the
// three reads are in flight together, so a slow second stage parks this loop rather than the
// first child, and the ring supplies the backpressure.
//
// It does need a slot per watched handle, plus one for the write. Two stages is four of
// sixteen; it was four of four when the ring had four, which is why a third stage was not
// something this could grow.

import { Child, Cli, Core, FileResult, GRANT_NONE, Pending } from "../src/platform.wac";

/** Standard input, in the same handle space as sockets and children. */
const i32 STDIN = 0;

export i32 main(Core core, Cli cli) {
  if (cli.argCount().wait() < 3) {
    core.warn("usage: pipe <worker.js> <argsA> <argsB>");
    return 2;
  }
  string path = cli.arg(0).wait();

  FileResult prog = cli.readFile(path).wait();
  if (!prog.ok) {
    core.warn("pipe: " + path + ": " + prog.error);
    return 1;
  }
  string source = string.fromBytes(prog.bytes);

  // The same bundle twice, differing only in argv. Nothing stops them being different
  // programs — one bundle just makes the example short.
  Child a = cli.spawn(source, argv(cli.arg(1).wait()), GRANT_NONE).wait();
  Child b = cli.spawn(source, argv(cli.arg(2).wait()), GRANT_NONE).wait();
  if (a.handle < 0 || b.handle < 0) {
    core.warn("pipe: " + (a.handle < 0 ? a.error : b.error));
    return 1;
  }

  pump(cli, a.handle, b.handle);

  i32 ca = cli.exitCode(a.handle).wait();
  i32 cb = cli.exitCode(b.handle).wait();
  cli.closeSocket(a.handle);
  cli.closeSocket(b.handle);
  // A pipeline's status is its last stage's, as in a shell.
  return cb != 0 ? cb : (ca != 0 ? ca : 0);
}

/**
 * A stage's argv, where empty means none.
 *
 * A stage that takes no arguments still needs a placeholder on the command line, and passing
 * `""` through as an argument is not the same thing: `wc ""` reads a file called nothing and
 * reports that it cannot, which is how this example first failed.
 */
string[] argv(string s) {
  return s == "" ? string[]() : string[](s);
}

/**
 * stdin -> a -> b -> stdout, until the second child stops writing.
 *
 * Each source's end is passed on rather than ending the pipeline: `sort` emits nothing until
 * its input closes, so a stage's own end is the only thing that finishes it.
 */
void pump(Cli cli, i32 a, i32 b) {
  Pending<u8[]> tIn = cli.recv(STDIN);
  Pending<u8[]> tA = cli.recv(a);
  Pending<u8[]> tB = cli.recv(b);
  bool inLive = true;
  bool aLive = true;

  while (true) {
    // The waited-on set shrinks as sources end, so the index `waitAny` returns means
    // different things at different times — hence the parallel list of what each one is.
    i32 n = (inLive ? 1 : 0) + (aLive ? 1 : 0) + 1;
    i32[] ids = i32[n](fill: 0);
    i32[] from = i32[n](fill: 0);
    i32 k = 0;
    if (inLive) { ids[k] = tIn.id; from[k] = 0; k++; }
    if (aLive) { ids[k] = tA.id; from[k] = 1; k++; }
    ids[k] = tB.id; from[k] = 2;

    i32 got = cli.waitAny(ids, -1);
    if (got < 0) { return; }

    if (from[got] == 0) {
      u8[] c = tIn.wait();
      if (c.len() == 0) {
        cli.closeFeed(a);
        inLive = false;
      } else {
        cli.send(a, c).wait();
        tIn = cli.recv(STDIN);
      }
    } else if (from[got] == 1) {
      u8[] c = tA.wait();
      if (c.len() == 0) {
        cli.closeFeed(b);
        aLive = false;
      } else {
        cli.send(b, c).wait();
        tA = cli.recv(a);
      }
    } else {
      u8[] c = tB.wait();
      if (c.len() == 0) { return; }
      cli.write(c);
      tB = cli.recv(b);
    }
  }
}
