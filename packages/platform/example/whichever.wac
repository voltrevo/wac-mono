// Wait on two sockets and report whichever speaks first.
//
// This is the shape `nc`, an SSH relay and a shell all need and none could express before:
// two `recv` calls in flight, and a park until *either* answers. Polling `isDone` in a loop
// would spin a core to avoid it.
//
//   whichever <port> <port>
//
// Connects to both, waits, and prints which index answered and what it said. Then does it
// again for the other one, so the second answer is not lost.

import { Cli, Core, Pending, Socket } from "../src/platform.wac";

export i32 main(Core core, Cli cli) {
  if (cli.argCount().wait() < 2) {
    core.warn("usage: whichever <port> <port>");
    return 2;
  }
  Socket a = cli.connect("127.0.0.1", atoi(cli.arg(0).wait())).wait();
  Socket b = cli.connect("127.0.0.1", atoi(cli.arg(1).wait())).wait();
  if (a.handle < 0 || b.handle < 0) {
    core.warn("whichever: " + (a.handle < 0 ? a.error : b.error));
    return 1;
  }

  // Both reads are in flight from here. Neither has been waited for.
  Pending<u8[]> ra = cli.recv(a.handle);
  Pending<u8[]> rb = cli.recv(b.handle);

  i32 first = cli.waitAny(i32[](ra.id, rb.id), -1);
  core.log("first=" + itoa(first) + " said=" + trim(first == 0 ? ra.wait() : rb.wait()));

  // And the other one, which was never cancelled and is still running.
  i32 second = first == 0 ? 1 : 0;
  core.log("second=" + itoa(second) + " said=" + trim(second == 0 ? ra.wait() : rb.wait()));

  cli.closeSocket(a.handle);
  cli.closeSocket(b.handle);
  return 0;
}

string trim(u8[] b) {
  i32 n = b.len();
  while (n > 0 && (b[n - 1] == '\n' || b[n - 1] == '\r')) { n--; }
  u8[] out = u8[n](fill: 0);
  out.copyFrom(b, 0, 0, n);
  return string.fromBytes(out);
}

i32 atoi(string s) {
  u8[] b = s.toBytes();
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < '0' || b[i] > '9') { return n; }
    n = n * 10 + (b[i] - '0');
  }
  return n;
}

string itoa(i32 n) {
  if (n == 0) { return "0"; }
  i32 v = n < 0 ? 0 - n : n;
  u8[] digits = u8[12](fill: 0);
  i32 at = 12;
  while (v > 0) { at--; digits[at] = '0' + (v % 10); v = v / 10; }
  u8[] used = u8[12 - at](fill: 0);
  used.copyFrom(digits, at, 0, 12 - at);
  return (n < 0 ? "-" : "") + string.fromBytes(used);
}
