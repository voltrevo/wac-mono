// A busybox-shaped application: one program, many applets, chosen by the first argument.
//
//   box grep -i wac README.md
//   cat README.md | box sort -u
//   box du packages
//
// Two things it is for. It is the widest test of the capability world — twenty-seven small
// programs is a lot of ways to find out that something is missing — and it composes this
// repo's packages rather than sitting beside them, which is where the bugs have been.
//
// **A multicall binary weakens the permission story**, and that is worth saying rather
// than hiding. `box`'s grants are the *union* of what its applets need, so running `box
// echo` carries the filesystem access `box cp` would want. Building each applet as its own
// executable gives each its own shebang and its own list; this exists to exercise the
// world, not because one binary with twenty-seven entry points is the better shape.

import { Cli, Core, FileResult, Stat } from "../src/platform.wac";
import { sha256 } from "../../crypto/src/sha256.wac";
import { sha512 } from "../../crypto/src/sha512.wac";
import { encode as b64encode, ALPHABET_STANDARD } from "../../codec/src/base64.wac";
import { encode as b32encode, ALPHABET_STANDARD as B32_STANDARD } from "../../codec/src/base32.wac";
import { encode as hexencode } from "../../codec/src/hex.wac";
import { compile, compileIgnoreCase, search, slotCount } from "../../regex/src/regex.wac";
import { Program, NO_MATCH } from "../../regex/src/program.wac";

export i32 main(Core core, Cli cli) {
  if (cli.argCount() < 1) { return usage(core); }
  string applet = cli.arg(0);
  Args a = parseArgs(cli);

  // Applets that find their own input, or need none.
  if (applet == "help")     { return usage(core); }
  if (applet == "true")     { return 0; }
  if (applet == "false")    { return 1; }
  if (applet == "echo")     { return echo(core, a); }
  if (applet == "seq")      { return seq(core, a); }
  if (applet == "basename") { return basename(core, a); }
  if (applet == "dirname")  { return dirname(core, a); }
  if (applet == "ls")       { return ls(core, cli, a); }
  if (applet == "find")     { return find(core, cli, a); }
  if (applet == "du")       { return du(core, cli, a); }
  if (applet == "cp")       { return cp(core, cli, a); }
  if (applet == "grep")     { return grep(core, cli, a); }
  if (applet == "tee")      { return tee(core, cli, a); }

  // Everything below reads one input: a file if named, otherwise standard input.
  Input in = readInput(core, cli, a, 0);
  if (!in.ok) { return 1; }

  if (applet == "cat")       { cli.write(in.bytes); return 0; }
  if (applet == "wc")        { return wc(core, in, a); }
  if (applet == "rev")       { cli.write(rev(in.bytes)); return 0; }
  if (applet == "tac")       { cli.write(tac(in.bytes)); return 0; }
  if (applet == "nl")        { cli.write(nl(in.bytes)); return 0; }
  if (applet == "head")      { cli.write(pick(in.bytes, a.num == 0 ? 10 : a.num, true)); return 0; }
  if (applet == "tail")      { cli.write(pick(in.bytes, a.num == 0 ? 10 : a.num, false)); return 0; }
  if (applet == "sort")      { cli.write(sortLines(in.bytes, has(a, 'r'), has(a, 'u'))); return 0; }
  if (applet == "uniq")      { cli.write(uniqLines(in.bytes, has(a, 'c'))); return 0; }
  if (applet == "sha256sum") { return digestOf(core, sha256(in.bytes), in.label); }
  if (applet == "sha512sum") { return digestOf(core, sha512(in.bytes), in.label); }
  if (applet == "base64")    { cli.write(withNewline(b64encode(in.bytes, ALPHABET_STANDARD(), true))); return 0; }
  if (applet == "base32")    { cli.write(withNewline(b32encode(in.bytes, B32_STANDARD(), true))); return 0; }
  if (applet == "hex")       { cli.write(withNewline(hexencode(in.bytes))); return 0; }

  core.warn("box: unknown applet '" + applet + "'");
  return usage(core);
}

i32 usage(Core core) {
  core.warn("usage: box <applet> [-flags] [args]");
  core.warn("  base32 base64 basename cat cp dirname du echo false find grep head hex");
  core.warn("  ls nl rev seq sha256sum sha512sum sort tac tail tee true uniq wc");
  core.warn("flags: grep -ivnc   sort -ru   uniq -c   wc -lwc   head/tail -N");
  return 2;
}

// ── Arguments ─────────────────────────────────────────────────────────────────

/**
 * Flags and positional arguments, parsed once for every applet.
 *
 * Without this each applet hardcoded its behaviour — `head` always took ten lines and `wc`
 * could not do `-l`. One parser makes a dozen of them real rather than approximate, which
 * is worth more than any single applet.
 */
struct Args {
  /** The letters of every `-x` flag, concatenated: `-iv` and `-i -v` both give "iv". */
  string flags;
  /** `-5`, or `-n 5`. Zero when absent, which each applet reads as its own default. */
  i32 num;
  string[] rest;
}

bool has(Args a, i32 flag) {
  u8[] f = a.flags.toBytes();
  for (i32 i = 0; i < f.len(); i++) { if (f[i] == flag) { return true; } }
  return false;
}

Args parseArgs(Cli cli) {
  // Counted first so the array is the right size: there is no growable list here, and
  // walking twice is less code than guessing a capacity and copying.
  i32 count = 0;
  for (i32 i = 1; i < cli.argCount(); i++) {
    if (!isFlag(cli.arg(i))) { count++; }
  }
  string[] rest = string[count](fill: "");

  string flags = "";
  i32 num = 0;
  i32 at = 0;
  i32 i = 1;
  while (i < cli.argCount()) {
    string s = cli.arg(i);
    if (!isFlag(s)) { rest[at] = s; at++; i++; continue; }
    u8[] b = s.toBytes();
    if (b[1] >= '0' && b[1] <= '9') {
      num = atoi(string.fromBytes(slice(b, 1, b.len())));          // -5
    } else {
      for (i32 k = 1; k < b.len(); k++) {
        bool takesValue = b[k] == 'n' && i + 1 < cli.argCount() && allDigits(cli.arg(i + 1));
        if (takesValue) { num = atoi(cli.arg(i + 1)); i++; }       // -n 5
        else { flags = flags + string.fromBytes(slice(b, k, k + 1)); }
      }
    }
    i++;
  }
  return Args(flags, num, rest);
}

bool isFlag(string s) {
  u8[] b = s.toBytes();
  return b.len() > 1 && b[0] == '-';
}

bool allDigits(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0) { return false; }
  for (i32 i = 0; i < b.len(); i++) { if (b[i] < '0' || b[i] > '9') { return false; } }
  return true;
}

// ── Input ─────────────────────────────────────────────────────────────────────

struct Input { bool ok; u8[] bytes; string label; }

/** Positional argument `n` names a file; without one, standard input. */
Input readInput(Core core, Cli cli, Args a, i32 n) {
  if (a.rest.len() <= n) { return Input(true, cli.readStdin(), ""); }
  string path = a.rest[n];
  FileResult f = cli.readFile(path);
  if (!f.ok) {
    core.warn("box: " + path + ": " + f.error);
    return Input(false, u8[0](), path);
  }
  return Input(true, f.bytes, path);
}

// ── Applets ───────────────────────────────────────────────────────────────────

i32 echo(Core core, Args a) {
  string out = "";
  for (i32 i = 0; i < a.rest.len(); i++) {
    if (i > 0) { out = out + " "; }
    out = out + a.rest[i];
  }
  core.log(out);
  return 0;
}

i32 seq(Core core, Args a) {
  if (a.rest.len() < 1) { core.warn("usage: box seq <count>"); return 2; }
  i32 n = atoi(a.rest[0]);
  for (i32 i = 1; i <= n; i++) { core.log(itoa(i)); }
  return 0;
}

i32 basename(Core core, Args a) {
  if (a.rest.len() < 1) { core.warn("usage: box basename <path>"); return 2; }
  u8[] b = a.rest[0].toBytes();
  i32 cut = 0;
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == '/') { cut = i + 1; } }
  core.log(string.fromBytes(slice(b, cut, b.len())));
  return 0;
}

i32 dirname(Core core, Args a) {
  if (a.rest.len() < 1) { core.warn("usage: box dirname <path>"); return 2; }
  u8[] b = a.rest[0].toBytes();
  i32 cut = -1;
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == '/') { cut = i; } }
  core.log(cut <= 0 ? (cut == 0 ? "/" : ".") : string.fromBytes(slice(b, 0, cut)));
  return 0;
}

i32 ls(Core core, Cli cli, Args a) {
  string path = a.rest.len() < 1 ? "." : a.rest[0];
  string[]? names = cli.readDir(path);
  if (names is null) {
    Stat st = cli.stat(path);
    if (st.exists) { core.log(path); return 0; }
    core.warn("box: " + path + ": cannot list");
    return 1;
  }
  string[] found = names!;
  for (i32 i = 0; i < found.len(); i++) { core.log(found[i]); }
  return 0;
}

/** Every path under a root, depth first — the first applet that recurses. */
i32 find(Core core, Cli cli, Args a) {
  string root = a.rest.len() < 1 ? "." : a.rest[0];
  Stat st = cli.stat(root);
  if (!st.exists) { core.warn("box: " + root + ": not found"); return 1; }
  core.log(root);
  walk(core, cli, root, 0);
  return 0;
}

void walk(Core core, Cli cli, string dir, i32 depth) {
  // A bound rather than a cycle check: `stat` does not distinguish a symlink, so a loop
  // through one is possible and this is what stops it being an infinite one.
  if (depth > 32) { return; }
  string[]? names = cli.readDir(dir);
  if (names is null) { return; }
  string[] found = names!;
  for (i32 i = 0; i < found.len(); i++) {
    string path = dir + "/" + found[i];
    core.log(path);
    if (cli.stat(path).isDir) { walk(core, cli, path, depth + 1); }
  }
}

/** Total bytes under a path — `stat` and `readDir` doing real work together. */
i32 du(Core core, Cli cli, Args a) {
  string root = a.rest.len() < 1 ? "." : a.rest[0];
  Stat st = cli.stat(root);
  if (!st.exists) { core.warn("box: " + root + ": not found"); return 1; }
  core.log(itoa64(st.isDir ? sizeOf(cli, root, 0) : st.size) + "\t" + root);
  return 0;
}

i64 sizeOf(Cli cli, string dir, i32 depth) {
  if (depth > 32) { return 0; }
  string[]? names = cli.readDir(dir);
  if (names is null) { return 0; }
  string[] found = names!;
  i64 total = 0;
  for (i32 i = 0; i < found.len(); i++) {
    string path = dir + "/" + found[i];
    Stat st = cli.stat(path);
    total = total + (st.isDir ? sizeOf(cli, path, depth + 1) : st.size);
  }
  return total;
}

i32 cp(Core core, Cli cli, Args a) {
  if (a.rest.len() < 2) { core.warn("usage: box cp <src> <dst>"); return 2; }
  FileResult f = cli.readFile(a.rest[0]);
  if (!f.ok) { core.warn("box: " + a.rest[0] + ": " + f.error); return 1; }
  if (!cli.writeFile(a.rest[1], f.bytes)) {
    core.warn("box: " + a.rest[1] + ": cannot write");
    return 1;
  }
  return 0;
}

/** Standard input to standard output *and* a file — two destinations, which is the point. */
i32 tee(Core core, Cli cli, Args a) {
  u8[] data = cli.readStdin();
  cli.write(data);
  for (i32 i = 0; i < a.rest.len(); i++) {
    if (!cli.writeFile(a.rest[i], data)) {
      core.warn("box: " + a.rest[i] + ": cannot write");
      return 1;
    }
  }
  return 0;
}

/**
 * Lines matching a pattern. `-i` ignores case, `-v` inverts, `-n` numbers, `-c` counts.
 *
 * A bad pattern is a *user* error and is reported as one — the first applet where the
 * input can be wrong in a way that is nobody's bug.
 */
i32 grep(Core core, Cli cli, Args a) {
  if (a.rest.len() < 1) { core.warn("usage: box grep [-ivnc] <pattern> [file]"); return 2; }
  Program? prog = has(a, 'i')
    ? compileIgnoreCase(a.rest[0].toBytes())
    : compile(a.rest[0].toBytes());
  if (prog is null) { core.warn("box: bad pattern: " + a.rest[0]); return 2; }
  Program p = prog!;

  Input in = readInput(core, cli, a, 1);
  if (!in.ok) { return 1; }

  i32[] caps = i32[slotCount(p)](fill: 0);
  bool invert = has(a, 'v');
  bool number = has(a, 'n');
  bool countOnly = has(a, 'c');
  u8[][] lines = splitLines(in.bytes);
  i32 matches = 0;

  for (i32 i = 0; i < lines.len(); i++) {
    bool hit = search(p, lines[i], 0, caps, 1000000) != NO_MATCH();
    if (hit == invert) { continue; }
    matches++;
    if (countOnly) { continue; }
    string text = string.fromBytes(lines[i]);
    core.log(number ? itoa(i + 1) + ":" + text : text);
  }
  if (countOnly) { core.log(itoa(matches)); }
  return matches > 0 ? 0 : 1;
}

i32 wc(Core core, Input in, Args a) {
  u8[] data = in.bytes;
  i32 lineCount = 0;
  i32 words = 0;
  bool inWord = false;
  for (i32 i = 0; i < data.len(); i++) {
    i32 b = data[i];
    if (b == '\n') { lineCount++; }
    bool space = b == ' ' || b == '\n' || b == '\t' || b == '\r';
    if (space) { inWord = false; } else if (!inWord) { inWord = true; words++; }
  }
  // One number and no label when exactly one of -l -w -c is asked for, as the real one does.
  bool l = has(a, 'l');
  bool w = has(a, 'w');
  bool c = has(a, 'c');
  if (l && !w && !c) { core.log(itoa(lineCount)); return 0; }
  if (w && !l && !c) { core.log(itoa(words)); return 0; }
  if (c && !l && !w) { core.log(itoa(data.len())); return 0; }
  string line = itoa(lineCount) + " " + itoa(words) + " " + itoa(data.len());
  core.log(in.label == "" ? line : line + " " + in.label);
  return 0;
}

i32 digestOf(Core core, u8[] digest, string label) {
  core.log(string.fromBytes(hexencode(digest)) + "  " + (label == "" ? "-" : label));
  return 0;
}

// ── Line operations ───────────────────────────────────────────────────────────

/** Split into lines, dropping the empty one a trailing newline would produce. */
u8[][] splitLines(u8[] data) {
  i32 n = 0;
  for (i32 i = 0; i < data.len(); i++) { if (data[i] == '\n') { n++; } }
  if (data.len() > 0 && data[data.len() - 1] != '\n') { n++; }
  u8[][] out = u8[][n](fill: u8[0]());
  i32 at = 0;
  i32 start = 0;
  for (i32 i = 0; i <= data.len(); i++) {
    bool end = i == data.len() || data[i] == '\n';
    if (!end) { continue; }
    if (i == data.len() && i == start) { break; }
    out[at] = slice(data, start, i);
    at++;
    start = i + 1;
  }
  return out;
}

u8[] joinLines(u8[][] lines, i32 count) {
  i32 total = 0;
  for (i32 i = 0; i < count; i++) { total = total + lines[i].len() + 1; }
  u8[] out = u8[total](fill: '\n');
  i32 at = 0;
  for (i32 i = 0; i < count; i++) {
    out.copyFrom(lines[i], 0, at, lines[i].len());
    at = at + lines[i].len() + 1;
  }
  return out;
}

/** Byte order, as `sort` uses by default. Negative, zero or positive. */
i32 cmpBytes(u8[] a, u8[] b) {
  i32 n = a.len() < b.len() ? a.len() : b.len();
  for (i32 i = 0; i < n; i++) {
    i32 x = a[i];
    i32 y = b[i];
    if (x != y) { return x < y ? -1 : 1; }
  }
  if (a.len() == b.len()) { return 0; }
  return a.len() < b.len() ? -1 : 1;
}

/**
 * Merge sort, because an insertion sort looks fine on a fixture and takes minutes on a
 * real file. Stable, which `sort -u` then depends on to drop only adjacent equals.
 */
u8[][] mergeSort(u8[][] xs, i32 n) {
  if (n <= 1) { return xs; }
  i32 mid = n / 2;
  i32 right = n - mid;
  u8[][] l = u8[][mid](fill: u8[0]());
  u8[][] r = u8[][right](fill: u8[0]());
  for (i32 i = 0; i < mid; i++) { l[i] = xs[i]; }
  for (i32 i = 0; i < right; i++) { r[i] = xs[mid + i]; }
  u8[][] ls = mergeSort(l, mid);
  u8[][] rs = mergeSort(r, right);

  u8[][] out = u8[][n](fill: u8[0]());
  i32 li = 0;
  i32 ri = 0;
  for (i32 i = 0; i < n; i++) {
    bool takeLeft = ri >= right || (li < mid && cmpBytes(ls[li], rs[ri]) <= 0);
    if (takeLeft) { out[i] = ls[li]; li++; } else { out[i] = rs[ri]; ri++; }
  }
  return out;
}

u8[] sortLines(u8[] data, bool reverse, bool unique) {
  u8[][] lines = splitLines(data);
  i32 n = lines.len();
  u8[][] sorted = mergeSort(lines, n);

  u8[][] out = u8[][n](fill: u8[0]());
  i32 at = 0;
  for (i32 i = 0; i < n; i++) {
    if (unique && i > 0 && cmpBytes(sorted[i], sorted[i - 1]) == 0) { continue; }
    out[at] = sorted[i];
    at++;
  }
  if (!reverse) { return joinLines(out, at); }
  u8[][] flipped = u8[][at](fill: u8[0]());
  for (i32 i = 0; i < at; i++) { flipped[i] = out[at - 1 - i]; }
  return joinLines(flipped, at);
}

/** Adjacent duplicates collapsed. Sorted input is the caller's business, as with `uniq`. */
u8[] uniqLines(u8[] data, bool count) {
  u8[][] lines = splitLines(data);
  i32 n = lines.len();
  u8[][] out = u8[][n](fill: u8[0]());
  i32 at = 0;
  i32 run = 0;
  for (i32 i = 0; i < n; i++) {
    run++;
    bool last = i == n - 1;
    if (!last && cmpBytes(lines[i], lines[i + 1]) == 0) { continue; }
    if (count) {
      // GNU pads the count to seven columns and follows it with a space.
      string padded = itoa(run);
      while (padded.len() < 7) { padded = " " + padded; }
      out[at] = concat((padded + " ").toBytes(), lines[i]);
    } else {
      out[at] = lines[i];
    }
    at++;
    run = 0;
  }
  return joinLines(out, at);
}

/** Lines in reverse order — `tac`, as distinct from `rev`, which reverses within a line. */
u8[] tac(u8[] data) {
  u8[][] lines = splitLines(data);
  i32 n = lines.len();
  u8[][] out = u8[][n](fill: u8[0]());
  for (i32 i = 0; i < n; i++) { out[i] = lines[n - 1 - i]; }
  return joinLines(out, n);
}

/** Each line reversed, keeping the line breaks where they are. */
u8[] rev(u8[] data) {
  u8[] out = u8[data.len()](fill: 0);
  i32 start = 0;
  for (i32 i = 0; i <= data.len(); i++) {
    bool end = i == data.len() || data[i] == '\n';
    if (!end) { continue; }
    for (i32 k = 0; k < i - start; k++) { out[start + k] = data[i - 1 - k]; }
    if (i < data.len()) { out[i] = '\n'; }
    start = i + 1;
  }
  return out;
}

/** Number every line, right-aligned in six columns then a tab, as GNU `nl` does. */
u8[] nl(u8[] data) {
  u8[][] lines = splitLines(data);
  u8[][] out = u8[][lines.len()](fill: u8[0]());
  for (i32 i = 0; i < lines.len(); i++) {
    u8[] num = itoa(i + 1).toBytes();
    u8[] row = u8[7 + lines[i].len()](fill: ' ');
    row.copyFrom(num, 0, 6 - num.len(), num.len());
    row[6] = '\t';
    row.copyFrom(lines[i], 0, 7, lines[i].len());
    out[i] = row;
  }
  return joinLines(out, lines.len());
}

/** The first or last `count` lines. */
u8[] pick(u8[] data, i32 count, bool fromStart) {
  u8[][] lines = splitLines(data);
  i32 n = lines.len();
  i32 take = count < n ? count : n;
  if (take < 0) { take = 0; }
  u8[][] out = u8[][take](fill: u8[0]());
  for (i32 i = 0; i < take; i++) { out[i] = fromStart ? lines[i] : lines[n - take + i]; }
  return joinLines(out, take);
}

// ── Byte helpers ──────────────────────────────────────────────────────────────

u8[] concat(u8[] a, u8[] b) {
  u8[] out = u8[a.len() + b.len()](fill: 0);
  out.copyFrom(a, 0, 0, a.len());
  out.copyFrom(b, 0, a.len(), b.len());
  return out;
}

u8[] slice(u8[] a, i32 at, i32 to) {
  i32 n = to - at;
  if (n <= 0) { return u8[0](); }
  u8[] out = u8[n](fill: 0);
  out.copyFrom(a, at, 0, n);
  return out;
}

u8[] withNewline(u8[] a) {
  u8[] out = u8[a.len() + 1](fill: '\n');
  out.copyFrom(a, 0, 0, a.len());
  return out;
}

// ── Numbers ───────────────────────────────────────────────────────────────────

string itoa(i32 n) {
  if (n == 0) { return "0"; }
  i32 v = n < 0 ? 0 - n : n;
  u8[] digits = u8[12](fill: 0);
  i32 at = 12;
  while (v > 0) { at--; digits[at] = '0' + (v % 10); v = v / 10; }
  string s = string.fromBytes(slice(digits, at, 12));
  return n < 0 ? "-" + s : s;
}

string itoa64(i64 n) {
  if (n == 0) { return "0"; }
  i64 v = n < 0 ? 0 - n : n;
  u8[] digits = u8[24](fill: 0);
  i32 at = 24;
  while (v > 0) { at--; digits[at] = ('0' as i64 + (v % 10)) as~ i32; v = v / 10; }
  string s = string.fromBytes(slice(digits, at, 24));
  return n < 0 ? "-" + s : s;
}

i32 atoi(string s) {
  u8[] b = s.toBytes();
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    i32 c = b[i];
    if (c < '0' || c > '9') { break; }
    v = v * 10 + (c - '0');
  }
  return v;
}
