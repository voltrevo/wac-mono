// A busybox-shaped application: one program, many applets, chosen by the first argument.
//
//   box grep -i wac README.md
//   cat README.md | box sort -u | box wc -l
//   box du packages
//
// This file is the dispatcher and nothing else. One applet per file under `applets/`, so
// finding one takes no thought: it is `applets/<name>.wac`, always. The shared parts —
// argument parsing, line splitting, byte and number helpers — are under `lib/`.
//
// The twenty-six imports below are the table of contents. wac has no re-export, so this is
// the one place that has to know every applet exists, which is the right place for it.
//
// **A multicall binary weakens the permission story**, and that is worth saying rather
// than hiding. `box`'s grants are the *union* of what its applets need, so running `box
// echo` carries the filesystem access `box cp` would want. One applet per file means each
// could also be built alone, with only what it needs; this exists to exercise the world,
// not because one binary with twenty-six entry points is the better shape.

import { Cli, Core } from "../../src/platform.wac";
import { Args, parseArgs } from "./lib/args.wac";

import { base32 } from "./applets/base32.wac";
import { base64 } from "./applets/base64.wac";
import { basename } from "./applets/basename.wac";
import { cat } from "./applets/cat.wac";
import { cp } from "./applets/cp.wac";
import { dirname } from "./applets/dirname.wac";
import { du } from "./applets/du.wac";
import { echo } from "./applets/echo.wac";
import { find } from "./applets/find.wac";
import { grep } from "./applets/grep.wac";
import { head } from "./applets/head.wac";
import { hex } from "./applets/hex.wac";
import { ls } from "./applets/ls.wac";
import { nl } from "./applets/nl.wac";
import { rev } from "./applets/rev.wac";
import { seq } from "./applets/seq.wac";
import { sha256sum } from "./applets/sha256sum.wac";
import { sha512sum } from "./applets/sha512sum.wac";
import { sort } from "./applets/sort.wac";
import { tac } from "./applets/tac.wac";
import { tail } from "./applets/tail.wac";
import { tee } from "./applets/tee.wac";
import { uniq } from "./applets/uniq.wac";
import { wc } from "./applets/wc.wac";

export i32 main(Core core, Cli cli) {
  if (cli.argCount() < 1) { return usage(core); }
  string applet = cli.arg(0);
  Args a = parseArgs(cli);

  if (applet == "base32")    { return base32(core, cli, a); }
  if (applet == "base64")    { return base64(core, cli, a); }
  if (applet == "basename")  { return basename(core, cli, a); }
  if (applet == "cat")       { return cat(core, cli, a); }
  if (applet == "cp")        { return cp(core, cli, a); }
  if (applet == "dirname")   { return dirname(core, cli, a); }
  if (applet == "du")        { return du(core, cli, a); }
  if (applet == "echo")      { return echo(core, cli, a); }
  if (applet == "find")      { return find(core, cli, a); }
  if (applet == "grep")      { return grep(core, cli, a); }
  if (applet == "head")      { return head(core, cli, a); }
  if (applet == "help")      { return usage(core); }
  if (applet == "hex")       { return hex(core, cli, a); }
  if (applet == "ls")        { return ls(core, cli, a); }
  if (applet == "nl")        { return nl(core, cli, a); }
  if (applet == "rev")       { return rev(core, cli, a); }
  if (applet == "seq")       { return seq(core, cli, a); }
  if (applet == "sha256sum") { return sha256sum(core, cli, a); }
  if (applet == "sha512sum") { return sha512sum(core, cli, a); }
  if (applet == "sort")      { return sort(core, cli, a); }
  if (applet == "tac")       { return tac(core, cli, a); }
  if (applet == "tail")      { return tail(core, cli, a); }
  if (applet == "tee")       { return tee(core, cli, a); }
  if (applet == "uniq")      { return uniq(core, cli, a); }
  if (applet == "wc")        { return wc(core, cli, a); }

  // `true` and `false` have no body: the dispatcher returning a constant *is* the whole
  // applet, and a file containing one `return` would be ceremony rather than clarity.
  if (applet == "true")      { return 0; }
  if (applet == "false")     { return 1; }

  core.warn("box: unknown applet '" + applet + "'");
  return usage(core);
}

i32 usage(Core core) {
  core.warn("usage: box <applet> [-flags] [args]");
  core.warn("  base32 base64 basename cat cp dirname du echo false find grep head hex");
  core.warn("  ls nl rev seq sha256sum sha512sum sort tac tail tee true uniq wc");
  core.warn("flags: grep -ivnc   sort -ru   uniq -c   wc -lwc   head/tail -N");
  return 2;
}
