// `grep` on its own: the same applet, built as its own program.
//
// Grants: `--allow-read`, and only because it can be given a filename. As
// a filter it needs nothing either.
//
// The applet file is imported unchanged. Splitting one per file was about readability, but
// this is what it also bought: an entry point is four lines, and the thing it wraps did not
// have to know it was ever part of a multicall binary.

import { Cli, Core } from "../../../src/platform.wac";
import { parseFrom } from "../lib/args.wac";
import { grep } from "../applets/grep.wac";

export i32 main(Core core, Cli cli) {
  return grep(core, cli, parseFrom(cli, 0, "grep"));
}
