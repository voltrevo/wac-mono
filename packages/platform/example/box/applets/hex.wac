// Encoded, with a trailing newline.

import { Cli, Core } from "../../../src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, readInput } from "../lib/input.wac";
import { withNewline } from "../lib/bytes.wac";
import { encode as hexencode } from "../../../../codec/src/hex.wac";

export i32 hex(Core core, Cli cli, Args a) {
  Input in = readInput(core, cli, a, 0);
  if (!in.ok) { return 1; }
  cli.write(withNewline(hexencode(in.bytes)));
  return 0;
}
