// The names in a directory, or the path itself when it is a file.

import { Cli, Core, Stat } from "../../../src/platform.wac";
import { Args } from "../lib/args.wac";

export i32 ls(Core core, Cli cli, Args a) {
  string path = a.rest.len() < 1 ? "." : a.rest[0];
  string[]? names = cli.readDir(path);
  if (names is null) {
    // Not a directory, or not permitted — the application cannot tell, by design.
    Stat st = cli.stat(path);
    if (st.exists) { core.log(path); return 0; }
    core.warn("box: " + path + ": cannot list");
    return 1;
  }
  string[] found = names!;
  for (i32 i = 0; i < found.len(); i++) { core.log(found[i]); }
  return 0;
}
