// Adjacent duplicates collapsed. Sorted input is the caller's business, as with `uniq`.

import { Cli, Core } from "../../../src/platform.wac";
import { Args, has } from "../lib/args.wac";
import { Input, readInput } from "../lib/input.wac";
import { concat } from "../lib/bytes.wac";
import { cmpBytes, joinLines, splitLines } from "../lib/lines.wac";
import { itoa } from "../lib/num.wac";

export i32 uniq(Core core, Cli cli, Args a) {
  Input in = readInput(core, cli, a, 0);
  if (!in.ok) { return 1; }
  bool count = has(a, 'c');

  u8[][] lines = splitLines(in.bytes);
  i32 n = lines.len();
  u8[][] out = u8[][n](fill: u8[0]());
  i32 at = 0;
  i32 run = 0;
  for (i32 i = 0; i < n; i++) {
    run++;
    bool last = i == n - 1;
    if (!last && cmpBytes(lines[i], lines[i + 1]) == 0) { continue; }
    if (count) {
      // GNU pads the count to seven columns and follows it with a space.
      string padded = itoa(run);
      while (padded.len() < 7) { padded = " " + padded; }
      out[at] = concat((padded + " ").toBytes(), lines[i]);
    } else {
      out[at] = lines[i];
    }
    at++;
    run = 0;
  }
  cli.write(joinLines(out, at));
  return 0;
}
