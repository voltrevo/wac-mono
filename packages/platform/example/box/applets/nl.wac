// Every line numbered, right-aligned in six columns then a tab, as GNU `nl` does.

import { Cli, Core } from "../../../src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, readInput } from "../lib/input.wac";
import { joinLines, splitLines } from "../lib/lines.wac";
import { itoa } from "../lib/num.wac";

export i32 nl(Core core, Cli cli, Args a) {
  Input in = readInput(core, cli, a, 0);
  if (!in.ok) { return 1; }
  u8[][] lines = splitLines(in.bytes);
  u8[][] out = u8[][lines.len()](fill: u8[0]());
  for (i32 i = 0; i < lines.len(); i++) {
    u8[] num = itoa(i + 1).toBytes();
    u8[] row = u8[7 + lines[i].len()](fill: ' ');
    row.copyFrom(num, 0, 6 - num.len(), num.len());
    row[6] = '\t';
    row.copyFrom(lines[i], 0, 7, lines[i].len());
    out[i] = row;
  }
  cli.write(joinLines(out, lines.len()));
  return 0;
}
