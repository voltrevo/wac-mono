// A file copied — through a temporary name, so an interrupted copy cannot leave a
// half-written destination. See `lib/safe.wac` for why that is worth the extra step.

import { Cli, Core, FileResult } from "../../../src/platform.wac";
import { Args } from "../lib/args.wac";
import { writeAtomic } from "../lib/safe.wac";

export i32 cp(Core core, Cli cli, Args a) {
  if (a.rest.len() < 2) { core.warn("usage: " + a.name + " <src> <dst>"); return 2; }
  FileResult f = cli.readFile(a.rest[0]);
  if (!f.ok) { core.warn(a.name + ": " + a.rest[0] + ": " + f.error); return 1; }
  if (!writeAtomic(core, cli, a.rest[1], f.bytes)) {
    core.warn(a.name + ": " + a.rest[1] + ": cannot write");
    return 1;
  }
  return 0;
}
