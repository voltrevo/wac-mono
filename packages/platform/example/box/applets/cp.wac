// A file copied. Needs no capability the world did not already have.

import { Cli, Core, FileResult } from "../../../src/platform.wac";
import { Args } from "../lib/args.wac";

export i32 cp(Core core, Cli cli, Args a) {
  if (a.rest.len() < 2) { core.warn("usage: box cp <src> <dst>"); return 2; }
  FileResult f = cli.readFile(a.rest[0]);
  if (!f.ok) { core.warn("box: " + a.rest[0] + ": " + f.error); return 1; }
  if (!cli.writeFile(a.rest[1], f.bytes)) {
    core.warn("box: " + a.rest[1] + ": cannot write");
    return 1;
  }
  return 0;
}
