// Decompress standard input, or a file, to standard output.

import { Cli, Core } from "../../../src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, readInput } from "../lib/input.wac";
import { gunzipBytes } from "../../../../gzip/src/inflate.wac";

export i32 gunzip(Core core, Cli cli, Args a) {
  Input in = readInput(core, cli, a, 0);
  if (!in.ok) { return 1; }
  cli.write(gunzipBytes(in.bytes));
  return 0;
}
