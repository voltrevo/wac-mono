// The last N lines, ten by default. `pick` lives in `head`, being the same operation.

import { Cli, Core } from "../../../src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, readInput } from "../lib/input.wac";
import { pick } from "./head.wac";

export i32 tail(Core core, Cli cli, Args a) {
  Input in = readInput(core, cli, a, 0);
  if (!in.ok) { return 1; }
  cli.write(pick(in.bytes, a.num == 0 ? 10 : a.num, false));
  return 0;
}
