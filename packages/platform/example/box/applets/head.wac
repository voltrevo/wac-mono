// The first N lines, ten by default.

import { Cli, Core } from "../../../src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, readInput } from "../lib/input.wac";
import { joinLines, splitLines } from "../lib/lines.wac";

export i32 head(Core core, Cli cli, Args a) {
  Input in = readInput(core, cli, a, 0);
  if (!in.ok) { return 1; }
  cli.write(pick(in.bytes, a.num == 0 ? 10 : a.num, true));
  return 0;
}

/** Shared with `tail`, which is the same operation from the other end. */
export u8[] pick(u8[] data, i32 count, bool fromStart) {
  u8[][] lines = splitLines(data);
  i32 n = lines.len();
  i32 take = count < n ? count : n;
  if (take < 0) { take = 0; }
  u8[][] out = u8[][take](fill: u8[0]());
  for (i32 i = 0; i < take; i++) { out[i] = fromStart ? lines[i] : lines[n - take + i]; }
  return joinLines(out, take);
}
