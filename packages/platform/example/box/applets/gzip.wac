// Compress standard input, or a file, to standard output.
//
// The whole applet is one call. `gzipStream` wants `fn[u8[]()]` and `fn[bool(u8[])]`, which
// is exactly what `readChunk` and `write` are — so the capabilities are handed over
// directly. wac has no closures, so if the shapes had not matched there would have been no
// adapter to write; that they do is why these signatures are what they are.

import { Cli, Core } from "../../../src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, openStream } from "../lib/input.wac";
import { gzipStream } from "../../../../gzip/src/gzip.wac";

export i32 gzip(Core core, Cli cli, Args a) {
  Input in = openStream(core, cli, a, 0);
  if (!in.ok) { return 1; }
  return gzipStream(cli.readChunk, cli.write);
}
