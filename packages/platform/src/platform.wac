// The platform world: everything an application may do, and nothing else.
//
// wac has no ambient access — no imports a program can name, no globals reaching outside
// — so an application can only touch what it is handed. These structs *are* the
// permission list. Reading one tells you exactly what a program can do, not because of a
// convention but because there is no other route out.
//
// Two profiles rather than one flat struct, so an application takes what it needs and a
// reader can see the difference between "reads the clock" and "reads your filesystem".
//
// Every capability returns a value; none fills a buffer. Arrays *copy* across the
// boundary, so a `fn[void(u8[])] fill` type-checks and quietly does nothing — the host's
// writes land on a copy. Returning is the only shape that works.
//
// Capabilities are also coarse on purpose. Behind each one may be a thread parking and
// unparking on a `SharedArrayBuffer`, which is nothing per file read and ruinous per byte.
// `readFile`, never `readByte`.

/**
 * A file that may not have been there. `bytes` is empty when `ok` is false.
 *
 * The static exists so the *host* can build one. A struct has no constructor JavaScript
 * can reach, and without this every application had to re-export a maker of its own —
 * ceremony that had nothing to do with counting words.
 */
export struct FileResult {
  bool ok;
  u8[] bytes;
  string error;

  FileResult of(bool ok, u8[] bytes, string error) { return FileResult(ok, bytes, error); }
}

/**
 * What every host can do, synchronously or made to look so.
 *
 * Deno, Node and a browser all provide these, which is what makes an application that
 * uses only `Core` portable without qualification.
 */
export struct Core {
  /** Wall clock, milliseconds since the epoch. Moves backwards; do not measure with it. */
  fn[i64()] nowMillis;
  /** Monotonic nanoseconds from an arbitrary origin. For measuring, never for dating. */
  fn[i64()] monotonicNanos;
  /** Cryptographically secure random bytes. */
  fn[u8[](i32)] randomBytes;
  /** A line of output. */
  fn[void(string)] log;
  /** A line of output on the error channel. */
  fn[void(string)] warn;

  Core of(
    fn[i64()] nowMillis,
    fn[i64()] monotonicNanos,
    fn[u8[](i32)] randomBytes,
    fn[void(string)] log,
    fn[void(string)] warn
  ) {
    return Core(nowMillis, monotonicNanos, randomBytes, log, warn);
  }
}

/** What a path is, if it is anything. Everything is zero or false when `exists` is false. */
export struct Stat {
  bool exists;
  bool isFile;
  bool isDir;
  i64 size;
  /** Milliseconds since the epoch, or 0 where the host does not say. */
  i64 modifiedMillis;

  Stat of(bool exists, bool isFile, bool isDir, i64 size, i64 modifiedMillis) {
    return Stat(exists, isFile, isDir, size, modifiedMillis);
  }
}

/**
 * The command line, the standard streams and the filesystem. Absent in a browser, which
 * is the honest reason this is not part of `Core`.
 *
 * `readStdin` and `write` need no grant, for the same reason `arg` does not: what the
 * user pipes in and what the program prints are the user's own doing, not a reach into
 * anything they did not offer. The filesystem is different and is gated.
 */
/**
 * A socket, or why there isn't one.
 *
 * A handle rather than a current-socket, unlike `openInput` and `openOutput`. Those are
 * one-at-a-time because the wac side has no closures to carry a handle *into a funcref*;
 * an `i32` in a struct has no such problem, and a server needs a listener and a
 * connection open at the same time, so a current-socket could not express it.
 */
export struct Socket {
  i32 handle;      // negative when `error` is set
  string error;
}

export struct Cli {
  fn[i32()] argCount;
  fn[string(i32)] arg;
  /** Null when the variable is unset, which is not the same as empty. */
  fn[string?(string)] env;

  /** All of standard input, to the end. Empty when there is none. */
  fn[u8[]()] readStdin;
  /**
   * Exactly these bytes on standard output — no newline, no encoding.
   *
   * `log` is for lines of text; this is for a program whose output *is* bytes. Without it
   * nothing could emit binary, which ruled out every compressor and encoder as a filter.
   *
   * Answers with whether the write succeeded, which most callers discard. The type is not
   * for them: `fn[bool(u8[])]` is the shape every streaming transform in this repo takes
   * for its sink, so `write` can be handed to one directly instead of through an adapter
   * — and wac has no closures, so an adapter is not a thing that could have been written.
   */
  fn[bool(u8[])] write;

  fn[FileResult(string)] readFile;
  /** True when the write succeeded. */
  fn[bool(string, u8[])] writeFile;
  /** What a path is. `exists` is false where the filesystem was not granted. */
  fn[Stat(string)] stat;
  /** Names within a directory, or null if it is not one — or not permitted. */
  fn[string[]?(string)] readDir;

  /**
   * Making, unmaking and moving. All three answer with whether they worked.
   *
   * `writeFile` alone cannot express a safe update: it truncates and then fills, so a
   * reader arriving in between sees a half-written file, and a crash leaves one. With
   * `rename` an application can write beside the target and move it into place, which on
   * every filesystem this runs on is atomic. That is why these are one tier rather than
   * three conveniences — see `applets/cp.wac`, which does exactly that.
   *
   * `parents` and `recursive` are `mkdir -p` and `rm -r`. Both default to nothing: a
   * caller has to ask for the recursive form, because the recursive form is the one that
   * can destroy something it was not pointed at.
   */
  fn[bool(string, bool)] mkdir;
  fn[bool(string, bool)] remove;
  fn[bool(string, string)] rename;

  /**
   * Streaming input: `openInput` chooses the source, `readChunk` pulls from it.
   *
   * Everything else here answers with the whole of something, which is fine for a
   * filename and wrong for a pipe — `cat` of a large file held it entirely in memory, and
   * so did every filter. These two are the incremental half.
   *
   * `openInput("")` selects standard input, which is also where a program starts, so an
   * applet that only ever filters need not call it at all. A path selects that file
   * instead, and the previous source is closed. There is one current input rather than a
   * handle per file, because a program with no closures cannot carry a handle into the
   * `fn[u8[]()]` a transform wants — the state has to live somewhere, and the world is
   * the honest place for it.
   *
   * `readChunk` answers with an empty array at end of input, and with at most
   * `CHUNK` bytes otherwise. A short chunk does not mean the end.
   *
   * `openInput` answers with the empty string on success and the host's message
   * otherwise, exactly as `FileResult.error` does. A bool would have been enough for the
   * applet to exit 1, and would have cost the reason — `cat: README.md: cannot read`
   * instead of `cat: README.md: filesystem read not granted to this application`. The
   * distinction between "no such file" and "you were not given the filesystem" is the one
   * thing a person needs from this message.
   */
  fn[string(string)] openInput;
  fn[u8[]()] readChunk;

  /**
   * Where `write` goes. `openOutput("")` is standard output, which is where it starts.
   *
   * The mirror of `openInput`, and for the same reason: without it a program could not
   * produce more output to a *file* than fits in memory, because `writeFile` takes the
   * whole of it at once. `cp` of a file larger than memory needed this; so would `split`,
   * or any filter told to write somewhere other than a pipe.
   *
   * A path truncates that file and makes it the destination of every subsequent `write`.
   * Opening another output closes the previous one, and so does opening `""` — which is
   * how a program that has finished writing a file knows the bytes are there, since
   * `rename` over a file still open would move it half-written. `cp` does exactly that.
   *
   * Answers with the empty string on success and the host's message otherwise.
   */
  fn[string(string)] openOutput;

  /**
   * The network. `--allow-net`, and nothing without it.
   *
   * `connect` resolves and dials; `listen` binds a port and `accept` blocks until someone
   * arrives. `recv` answers with at most `CHUNK` bytes and with an empty array when the
   * peer has closed — a short read means nothing, exactly as it does for a file.
   *
   * There is no `poll`, so a program can wait on one socket at a time. That is enough for
   * a request/response protocol and for a server that handles one connection at a time; it
   * is not enough for a proxy, or for anything that must watch two sockets at once. When
   * something needs it, that is the shape to add.
   */
  fn[Socket(string, i32)] connect;
  fn[Socket(i32)] listen;
  fn[Socket(i32)] accept;
  fn[u8[](i32)] recv;
  fn[bool(i32, u8[])] send;
  fn[void(i32)] closeSocket;

  Cli of(
    fn[i32()] argCount,
    fn[string(i32)] arg,
    fn[string?(string)] env,
    fn[u8[]()] readStdin,
    fn[bool(u8[])] write,
    fn[FileResult(string)] readFile,
    fn[bool(string, u8[])] writeFile,
    fn[Stat(string)] stat,
    fn[string[]?(string)] readDir,
    fn[bool(string, bool)] mkdir,
    fn[bool(string, bool)] remove,
    fn[bool(string, string)] rename,
    fn[string(string)] openInput,
    fn[u8[]()] readChunk,
    fn[string(string)] openOutput,
    fn[Socket(string, i32)] connect,
    fn[Socket(i32)] listen,
    fn[Socket(i32)] accept,
    fn[u8[](i32)] recv,
    fn[bool(i32, u8[])] send,
    fn[void(i32)] closeSocket
  ) {
    return Cli(
      argCount, arg, env, readStdin, write, readFile, writeFile, stat, readDir,
      mkdir, remove, rename, openInput, readChunk, openOutput,
      connect, listen, accept, recv, send, closeSocket
    );
  }
}
