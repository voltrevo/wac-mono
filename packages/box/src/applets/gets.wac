// An HTTPS GET. `box gets <host> <path> <root.der> [-<port>]`.
//
// TLS 1.3, in wac, over a raw socket — `packages/tls` does the protocol and this drives
// it. The point is that the package needed no changes: `tlsClientInit` and
// `tlsClientFeed` are a state machine over byte arrays, exactly like `packages/server`'s,
// and a state machine is what a socket wants.
//
// **The root is a file, not a bundle.** This client trusts the one certificate it is
// handed, because `packages/tls` takes a trust store rather than a flag to skip
// verification, and shipping a copy of Mozilla's list is a different job. That makes
// `gets` a demonstration rather than a `curl` — which is the honest description.
//
// Ephemeral keys come from `randomBytes`, so the world's one unprivileged source of
// entropy is what a handshake's secrecy rests on. Worth knowing.

import { Cli, Core, FileResult, Socket } from "../../../platform/src/platform.wac";
import { Args, has } from "../lib/args.wac";
import { itoa } from "../../../fmt/src/itoa.wac";
import { concat, slice } from "../lib/bytes.wac";
import { recordsReady } from "../../../tls/src/record.wac";
import { tlsClientInit, tlsClientFeed, tlsClientSend, tlsClientClose,
         tlsClientPhase, tlsClientFailure } from "../../../tls/src/client.wac";
import { Incoming, ParsedResponse, parseResponse } from "../../../http/src/incoming.wac";
import { Read } from "../../../bytes/src/read.wac";

/** `[state][toSend][appData]`, each behind a big-endian u32 length. */
struct Step { u8[] state; u8[] toSend; u8[] appData; }

Step unpack(u8[] r) {
  i32 at = 0;
  u8[][] parts = u8[][3](fill: u8[0]());
  for (i32 i = 0; i < 3; i++) {
    i32 n = (r[at] << 24) | (r[at + 1] << 16) | (r[at + 2] << 8) | r[at + 3];
    parts[i] = slice(r, at + 4, at + 4 + n);
    at = at + 4 + n;
  }
  return Step(parts[0], parts[1], parts[2]);
}

export i32 gets(Core core, Cli cli, Args a) {
  if (a.rest.len() < 3) {
    core.warn("usage: " + a.name + " <host> <path> <root.der> [-<port>] [-i]");
    return 2;
  }
  string host = a.rest[0];
  string path = a.rest[1];
  i32 port = a.hasNum ? a.num : 443;

  FileResult rootFile = cli.readFile(a.rest[2]).wait();
  if (!rootFile.ok) { core.warn(a.name + ": " + a.rest[2] + ": " + rootFile.error); return 1; }
  u8[] root = rootFile.bytes;
  // The store is DER certificates end to end, indexed by (start, end) pairs. One here.
  i32[] offsets = i32[](0, root.len());

  Step s = unpack(tlsClientInit(
    host.toBytes(), root, offsets,
    core.randomBytes(32).wait(),      // X25519 ephemeral
    core.randomBytes(32).wait(),      // P-256 ephemeral
    core.randomBytes(64).wait(),      // ML-KEM seed, for the hybrid group
    core.randomBytes(32).wait(),      // client random
    // Seconds, not milliseconds. `notBefore`/`notAfter` are parsed from the certificate
    // as seconds since the epoch, and handing this the millisecond clock puts "now"
    // around the year 57000, where every certificate has expired — which arrives as a
    // bad_certificate alert and looks like a chain problem.
    core.nowMillis().wait() / 1000));

  Socket sock = cli.connect(host, port).wait();
  if (sock.handle < 0) { core.warn(a.name + ": " + host + ": " + sock.error); return 1; }
  if (!cli.send(sock.handle, s.toSend).wait()) {
    core.warn(a.name + ": cannot send the client hello");
    cli.closeSocket(sock.handle);
    return 1;
  }

  u8[] buffered = u8[0]();
  u8[] body = u8[0]();
  bool requested = false;

  while (true) {
    i32 phase = tlsClientPhase(s.state);
    if (phase == 4) {
      // Phase 4 is "the connection is over", not "the handshake failed". A server that
      // was asked for `Connection: close` ends with a close_notify, which lands here
      // *after* the response — so what decides is whether the response arrived, not the
      // phase. Reading it as a failure reported "handshake failed" on every successful
      // fetch, with the body already in hand.
      if (body.len() > 0) { break; }
      core.warn(a.name + ": connection failed (code " + itoa(tlsClientFailure(s.state)) + ")");
      cli.closeSocket(sock.handle);
      return 1;
    }

    // Once the handshake is done, ask for the page — once.
    if (phase == 3 && !requested) {
      string req = "GET " + path + " HTTP/1.1\r\n"
        + "Host: " + host + "\r\n"
        + "User-Agent: box\r\n"
        + "Connection: close\r\n\r\n";
      Step out = unpack(tlsClientSend(s.state, req.toBytes()));
      s = Step(out.state, out.toSend, u8[0]());
      if (!cli.send(sock.handle, s.toSend).wait()) { break; }
      requested = true;
    }

    bool closed = false;
    match (cli.recv(sock.handle).wait()) {
      case Data(bytes): { buffered = concat(buffered, bytes); }
      case End: { closed = true; }            // the peer closed
      case Failed(why): {
        core.warn(a.name + ": " + host + ": " + why);
        cli.closeSocket(sock.handle);
        return 1;
      }
    }
    if (closed) { break; }

    // Feed whole records only: a record's length is in its first five bytes, so a partial one has to
    // wait, and handing the state machine half a record is how a reader that "mostly works" fails on a
    // fast connection rather than a slow one.
    //
    // `recordsReady` is that rule, in the package that owns it. This file had its own copy of the six
    // lines and `packages/tor`'s link layer had the same six with the framing left out entirely — one
    // correct and one silently broken, which is the argument for a function rather than a convention.
    // wac-mono issue 0029.
    i32 ready = recordsReady(buffered);
    if (ready == 0) { continue; }

    Step step = unpack(tlsClientFeed(s.state, slice(buffered, 0, ready)));
    buffered = slice(buffered, ready, buffered.len());
    s = step;
    if (s.toSend.len() > 0 && !cli.send(sock.handle, s.toSend).wait()) { break; }
    if (s.appData.len() > 0) { body = concat(body, s.appData); }
  }

  unpack(tlsClientClose(s.state));
  cli.closeSocket(sock.handle);

  if (body.len() == 0) {
    core.warn(a.name + ": the connection closed before any response arrived");
    return 1;
  }
  return show(core, cli, parseResponse(body, "GET".toBytes(), true, 1 << 26), has(a, 'i'), a.name);
}

i32 show(Core core, Cli cli, ParsedResponse p, bool headers, string name) {
  match (p) {
    case Incomplete: { core.warn(name + ": the response ended mid-message"); return 1; }
    case Bad(code): { core.warn(name + ": unparseable response (" + itoa(code) + ")"); return 1; }
    case Ok(res): {
      if (headers) {
        core.log("HTTP " + itoa(res.status));
        for (i32 i = 0; i < res.headers.count; i++) {
          core.log(string.fromBytes(res.headers.nameAt(i)) + ": "
                 + string.fromBytes(res.headers.valueAt(i)));
        }
        core.log("");
      }
      cli.write(res.body);
      return res.status >= 400 ? 1 : 0;
    }
  }
  return 1;
}
