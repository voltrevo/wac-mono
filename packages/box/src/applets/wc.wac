// Lines, words and bytes. `-l`, `-w` or `-c` alone prints just that number.
//
// Counted a chunk at a time. The only state that has to survive a chunk boundary is
// `inWord`: a word split across two reads is one word, and forgetting that would count it
// twice — which is the whole difficulty of turning a whole-input loop into a streaming one.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args, has } from "../lib/args.wac";
import { Chunk, Input, openStream, nextChunk } from "../lib/input.wac";
import { itoa } from "../../../fmt/src/itoa.wac";

export i32 wc(Core core, Cli cli, Args a) {
  Input in = openStream(core, cli, a, 0);
  if (!in.ok) { return 1; }

  i32 lineCount = 0;
  i32 words = 0;
  i32 bytes = 0;
  bool inWord = false;
  while (true) {
    Chunk got = nextChunk(core, cli, a);
    if (!got.ok) { return 1; }
    if (!got.more) { break; }
    u8[] data = got.bytes;
    bytes = bytes + data.len();
    for (i32 i = 0; i < data.len(); i++) {
      i32 b = data[i];
      if (b == '\n') { lineCount++; }
      bool space = b == ' ' || b == '\n' || b == '\t' || b == '\r';
      if (space) { inWord = false; } else if (!inWord) { inWord = true; words++; }
    }
  }

  // One number and no label when exactly one of -l -w -c is asked for, as the real one does.
  bool l = has(a, 'l');
  bool w = has(a, 'w');
  bool c = has(a, 'c');
  if (l && !w && !c) { core.log(itoa(lineCount)); return 0; }
  if (w && !l && !c) { core.log(itoa(words)); return 0; }
  if (c && !l && !w) { core.log(itoa(bytes)); return 0; }

  string line = itoa(lineCount) + " " + itoa(words) + " " + itoa(bytes);
  core.log(in.label == "" ? line : line + " " + in.label);
  return 0;
}
