// Lines matching a pattern. `-i` ignores case, `-v` inverts, `-n` numbers, `-c` counts.
//
// A bad pattern is a *user* error and is reported as one — the only applet where the input
// can be wrong in a way that is nobody's bug.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args, has } from "../lib/args.wac";
import { Sink } from "../../../platform/src/stream.wac";
import { Input, openStream } from "../lib/input.wac";
import { Line, Lines, nextLine } from "../lib/reader.wac";
import { itoa } from "../lib/num.wac";
import { compile, compileIgnoreCase, search, slotCount } from "../../../regex/src/regex.wac";
import { Program, BUDGET, NO_MATCH } from "../../../regex/src/program.wac";

export i32 grep(Core core, Cli cli, Args a) {
  if (a.rest.len() < 1) { core.warn("usage: " + a.name + " [-ivnc] <pattern> [file]"); return 2; }
  Program? prog = has(a, 'i')
    ? compileIgnoreCase(a.rest[0].toBytes())
    : compile(a.rest[0].toBytes());
  if (prog is null) { core.warn(a.name + ": bad pattern: " + a.rest[0]); return 2; }
  Program p = prog!;

  Input in = openStream(core, cli, a, 1);
  if (!in.ok) { return 1; }

  i32[] caps = i32[slotCount(p)](fill: 0);
  bool invert = has(a, 'v');
  bool number = has(a, 'n');
  bool countOnly = has(a, 'c');
  i32 matches = 0;
  i32 n = 0;
  Lines s = Lines.create();
  Sink out = Sink.create(cli);
  while (true) {
    Line l = nextLine(s, cli);
    if (!l.ok) { break; }
    n++;
    i32 found = search(p, l.bytes, 0, caps, 1000000);
    // Three answers, not two. `BUDGET` means the engine gave up backtracking on this line, and
    // testing `!= NO_MATCH()` counted that as a match — so a pathological pattern reported hits it
    // had never found, and `grep -c` counted them. Exiting 2 is what the real one does when it
    // cannot answer, and it is the only honest status: neither "matched" nor "did not match" is
    // known.
    if (found == BUDGET()) {
      core.warn(a.name + ": " + itoa(n) + ": pattern too expensive on this line, giving up");
      return 2;
    }
    bool hit = found != NO_MATCH();
    if (hit == invert) { continue; }
    matches++;
    if (countOnly) { continue; }
    string text = string.fromBytes(l.bytes);
    // Buffered: a pattern that matches most of a large file is one host call per line otherwise, and
    // each is a park and a wake. Issue 0039.
    if (!out.line(number ? itoa(n) + ":" + text : text)) { break; }
  }
  if (countOnly) { out.line(itoa(matches)); }
  out.flush();
  return matches > 0 ? 0 : 1;
}
