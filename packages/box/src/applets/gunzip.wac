// Decompress standard input, or a file, to standard output.
//
// The whole applet is one call. `gunzipStream` wants `fn[u8[]()]` and `fn[bool(u8[])]`, which
// is exactly what `readChunk` and `write` are — so the capabilities are handed over
// directly. `fn[u8[]()]` has no parameter, so an adapter would have nowhere to keep a
// ticket or a handle — which is why those two capabilities stayed blocking rather than
// joining the rest on the ticket surface.
//
// wac *can* carry context beside a funcref, as an unbound method reference. It is this
// signature that has no room for it, not the language.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, openStream } from "../lib/input.wac";
import { gunzipStream } from "../../../gzip/src/inflate.wac";

export i32 gunzip(Core core, Cli cli, Args a) {
  Input in = openStream(core, cli, a, 0);
  if (!in.ok) { return 1; }
  return gunzipStream(cli.readChunk, cli.write);
}
