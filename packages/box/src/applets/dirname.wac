// Everything but the last path component.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { slice } from "../lib/bytes.wac";

export i32 dirname(Core core, Cli cli, Args a) {
  if (a.rest.len() < 1) { core.warn("usage: " + a.name + " <path>"); return 2; }
  u8[] b = a.rest[0].toBytes();
  i32 cut = -1;
  for (i32 i = 0; i < b.len(); i++) { if (b[i] == '/') { cut = i; } }
  core.log(cut <= 0 ? (cut == 0 ? "/" : ".") : string.fromBytes(slice(b, 0, cut)));
  return 0;
}
