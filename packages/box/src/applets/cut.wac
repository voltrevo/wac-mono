// Selected fields of each line: `cut -d, -f2`. Tab is the delimiter by default.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args, flagValue } from "../lib/args.wac";
import { Input, openStream } from "../lib/input.wac";
import { Feed, Line, Lines, Sink, emitTo, nextLine } from "../../../platform/src/stream.wac";
import { slice } from "../lib/bytes.wac";
import { atoi } from "../../../fmt/src/itoa.wac";

export i32 cut(Core core, Cli cli, Args a) {
  string d = flagValue(a, 'd');
  i32 delim = d == "" ? '\t' : d.toBytes()[0];
  i32 field = atoi(flagValue(a, 'f'));
  // Either spelling: `-f2` and `-f 2` are the same, since `takesValue` in `args.wac` knows that `-d`
  // and `-f` have values and consumes them. The detached form used to arrive here as no value at all
  // and got this message, which is how GNU's own documented spelling was a usage error.
  if (field < 1) { core.warn("usage: " + a.name + " -f<n> [-d<c>] [file]"); return 2; }

  Input in = openStream(core, cli, a, 0);
  if (!in.ok) { return 1; }
  Lines s = Lines.create();
  Feed fed = Feed.fromStdin(cli);
  Sink out = Sink.create(cli);
  while (true) {
    Line l = nextLine(s, fed);
    if (!l.ok) { out.flush(); return 0; }
    emitTo(out, fieldOf(l.bytes, delim, field), true);
  }
  return 0;
}

/**
 * The `n`th field, or the whole line when it has no delimiter — which is what `cut` does,
 * on the reasoning that a line with no fields is one field.
 */
u8[] fieldOf(u8[] line, i32 delim, i32 n) {
  i32 seen = 1;
  i32 start = 0;
  for (i32 i = 0; i <= line.len(); i++) {
    bool end = i == line.len() || line[i] == delim;
    if (!end) { continue; }
    if (seen == n) { return slice(line, start, i); }
    seen++;
    start = i + 1;
  }
  bool hasDelim = false;
  for (i32 i = 0; i < line.len(); i++) { if (line[i] == delim) { hasDelim = true; } }
  return hasDelim ? u8[0]() : line;
}
