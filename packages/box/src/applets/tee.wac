// Standard input to standard output *and* a file — two destinations, which is the point.
//
// **The one applet that still buffers by nature rather than for want of an API.** The
// world has one current output, so `write` goes to exactly one place at a time; `tee`
// wants two at once and cannot express that. Streaming it would need either a second sink
// or an append, and neither exists. `cp`, which has one destination, streams.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";

export i32 tee(Core core, Cli cli, Args a) {
  u8[] data = cli.readStdin().wait();
  cli.write(data);
  for (i32 i = 0; i < a.rest.len(); i++) {
    if (!cli.writeFile(a.rest[i], data).wait()) {
      core.warn(a.name + ": " + a.rest[i] + ": cannot write");
      return 1;
    }
  }
  return 0;
}
