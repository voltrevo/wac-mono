// Decompress Zstandard, a block at a time.
//
// This used to hold its whole input, with a note saying the limit was the package's rather than the
// world's. `packages/zstd` has `unzstdStream` now (wac-mono 0088), so the applet is the same three lines
// `gunzip` is: the host blocks in `readChunk`, the decoder keeps its ordinary loops, and neither the
// compressed input nor the decoded output is held whole.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, openStream } from "../lib/input.wac";
import { unzstdStream } from "../../../zstd/src/stream.wac";

export i32 unzstd(Core core, Cli cli, Args a) {
  Input in = openStream(core, cli, a, 0);
  if (!in.ok) { return 1; }
  unzstdStream(cli.readChunk, cli.write);
  return 0;
}
