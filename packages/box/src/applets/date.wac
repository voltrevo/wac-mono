// The current time, RFC 3339. The clock is a capability, so this is `Core` at work.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { format } from "../../../datetime/src/rfc3339.wac";

export i32 date(Core core, Cli cli, Args a) {
  core.log(string.fromBytes(format(core.nowMillis().wait())));
  return 0;
}
