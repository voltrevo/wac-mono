// The digest, then two spaces and the name — `-` for standard input, as the real one does.
//
// Streams, since `packages/crypto` grew `Sha256.create/update/finish`. It was the last
// applet in this package that buffered for want of an API rather than by nature.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { Chunk, Input, openStream, nextChunk } from "../lib/input.wac";
import { encode as hexencode } from "../../../codec/src/hex.wac";
import { Sha256 } from "../../../crypto/src/sha256.wac";

export i32 sha256sum(Core core, Cli cli, Args a) {
  Input in = openStream(core, cli, a, 0);
  if (!in.ok) { return 1; }

  Sha256 h = Sha256.create();
  while (true) {
    Chunk got = nextChunk(core, cli, a);
    if (!got.ok) { return 1; }
    if (!got.more) { break; }
    u8[] chunk = got.bytes;
    h.update(chunk);
  }

  string name = in.label == "" ? "-" : in.label;
  core.log(string.fromBytes(hexencode(h.finish())) + "  " + name);
  return 0;
}
