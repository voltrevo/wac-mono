// What a path is: type, size, and modification time.
//
// The `stat` capability has existed since the world did, and nothing surfaced it — `du`
// and `find` use it internally and never show it. The mtime goes through `datetime`, the
// same pairing `date` uses.

import { Cli, Core, faultWords, Stat } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { itoa64 } from "../../../fmt/src/itoa.wac";
import { format } from "../../../datetime/src/rfc3339.wac";

export i32 stat(Core core, Cli cli, Args a) {
  if (a.rest.len() < 1) { core.warn("usage: " + a.name + " <path>..."); return 2; }
  i32 code = 0;
  for (i32 i = 0; i < a.rest.len(); i++) {
    Stat st = cli.stat(a.rest[i]).wait();
    if (!st.exists) {
      // `not found` was the only thing this could say, and it was a guess whenever the answer was not an
      // answer: no read capability, or a name the host cannot express, both arrived as `exists = false`.
      string words = faultWords(st.fault);
      core.warn(a.name + ": " + a.rest[i] + ": " + (words == "" ? "not found" : words));
      code = 1;
      continue;
    }
    string kind = st.isDir ? "directory" : (st.isFile ? "file" : "other");
    core.log(a.rest[i] + " " + kind + " " + itoa64(st.size) + " "
           + string.fromBytes(format(st.modifiedMillis)));
  }
  return code;
}
