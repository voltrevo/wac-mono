// The CRC-32 of the input, in hex — the checksum gzip itself uses.
//
// `crc32Start`/`Update`/`Finish` exist precisely so this need not hold the input, and
// nothing used them until there was a chunked read to feed them with.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { Chunk, Input, openStream, nextChunk } from "../lib/input.wac";
import { crc32Start, crc32Update, crc32Finish, crcTable8 } from "../../../gzip/src/crc32.wac";

export i32 crc32(Core core, Cli cli, Args a) {
  Input in = openStream(core, cli, a, 0);
  if (!in.ok) { return 1; }

  u32[] table = crcTable8();
  u32 acc = crc32Start();
  while (true) {
    Chunk got = nextChunk(core, cli, a);
    if (!got.ok) { return 1; }
    if (!got.more) { break; }
    u8[] chunk = got.bytes;
    acc = crc32Update(table, acc, chunk);
  }

  // `as@` keeps the bits; `as~` would clamp a checksum past 2^31 to i32 max. `& 15` then
  // makes the sign-extension of the top nibble's shift irrelevant.
  i32 v = crc32Finish(acc) as@ i32;
  u8[] out = u8[8](fill: '0');
  u8[] digits = "0123456789abcdef".toBytes();
  for (i32 i = 0; i < 8; i++) {
    out[7 - i] = digits[(v >> (i * 4)) & 15];
  }
  core.log(string.fromBytes(out) + "  " + (in.label == "" ? "-" : in.label));
  return 0;
}
