// The names in a directory, or the path itself when it is a file.

import { Cli, Core, faultWords, Stat } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";

export i32 ls(Core core, Cli cli, Args a) {
  string path = a.rest.len() < 1 ? "." : a.rest[0];
  string[]? names = cli.readDir(path).wait();
  if (names is null) {
    // Not a directory, not there, or not permitted. The comment here used to say the application could not
    // tell "by design" — it can now: `Stat` carries a fault, so a path this host cannot name and a path
    // with nothing at it are different answers rather than the same `exists = false`. wac-mono 0065.
    Stat st = cli.stat(path).wait();
    if (st.exists) { core.log(path); return 0; }
    string words = faultWords(st.fault);
    core.warn(a.name + ": " + path + ": " + (words == "" ? "cannot list" : words));
    return 1;
  }
  string[] found = names!;
  for (i32 i = 0; i < found.len(); i++) { core.log(found[i]); }
  return 0;
}
