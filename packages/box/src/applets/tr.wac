// Translate bytes: `tr a-z A-Z`. Ranges expand; sets are matched by position.
//
// The 256-entry table is built once and every chunk maps through it, so this holds one
// chunk however long the input is.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { Chunk, Input, openStream, nextChunk } from "../lib/input.wac";

export i32 tr(Core core, Cli cli, Args a) {
  if (a.rest.len() < 2) { core.warn("usage: " + a.name + " <set1> <set2> [file]"); return 2; }
  u8[] from = expand(a.rest[0].toBytes());
  u8[] to = expand(a.rest[1].toBytes());
  if (to.len() == 0) { core.warn(a.name + ": empty replacement set"); return 2; }

  Input in = openStream(core, cli, a, 2);
  if (!in.ok) { return 1; }

  // A 256-entry table, so the inner loop is one lookup rather than a scan per byte.
  u8[] map = u8[256](fill: 0);
  for (i32 i = 0; i < 256; i++) { map[i] = i; }
  for (i32 i = 0; i < from.len(); i++) {
    // A short replacement set repeats its last member, as the real one does.
    map[from[i]] = i < to.len() ? to[i] : to[to.len() - 1];
  }

  while (true) {
    Chunk got = nextChunk(core, cli, a);
    if (!got.ok) { return 1; }
    if (!got.more) { return 0; }
    u8[] chunk = got.bytes;
    u8[] out = u8[chunk.len()](fill: 0);
    for (i32 i = 0; i < chunk.len(); i++) { out[i] = map[chunk[i]]; }
    cli.write(out);
  }
  return 0;
}

/** `a-z` becomes the twenty-six bytes it names; everything else is itself. */
u8[] expand(u8[] set) {
  i32 n = 0;
  for (i32 i = 0; i < set.len(); i++) {
    bool range = i + 2 < set.len() && set[i + 1] == '-' && set[i + 2] >= set[i];
    if (range) { n = n + (set[i + 2] - set[i] + 1); i = i + 2; } else { n++; }
  }
  u8[] out = u8[n](fill: 0);
  i32 at = 0;
  for (i32 i = 0; i < set.len(); i++) {
    bool range = i + 2 < set.len() && set[i + 1] == '-' && set[i + 2] >= set[i];
    if (range) {
      for (i32 c = set[i]; c <= set[i + 2]; c++) { out[at] = c; at++; }
      i = i + 2;
    } else {
      out[at] = set[i];
      at++;
    }
  }
  return out;
}
