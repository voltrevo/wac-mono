// Files removed; `-r` for a directory and everything under it, `-f` to say nothing
// about what was not there.
//
// **`-f` means "ignore what is already gone", not "ignore everything".** It used to mean the
// second, because `remove` answered `bool` and a missing file was indistinguishable from a
// permission denied — so `rm -f` on a file it could not delete said nothing and exited 0, and the
// file was still there. `remove` carries the host's message now, and existence is a separate
// question, so the two cases can be told apart without reading the message's words.

import { Cli, Core, Stat } from "../../../platform/src/platform.wac";
import { Args, has } from "../lib/args.wac";

export i32 rm(Core core, Cli cli, Args a) {
  bool force = has(a, 'f');
  if (a.rest.len() < 1) {
    if (force) { return 0; }
    core.warn("usage: " + a.name + " [-rf] <path>...");
    return 2;
  }
  bool recursive = has(a, 'r');
  i32 code = 0;
  for (i32 i = 0; i < a.rest.len(); i++) {
    // Asked before removing rather than inferred from the failure afterwards: matching the host's
    // message against the words "not found" would be a guess about three operating systems.
    Stat st = cli.stat(a.rest[i]).wait();
    if (!st.exists) {
      if (force) { continue; }
      core.warn(a.name + ": " + a.rest[i] + ": no such file or directory");
      code = 1;
      continue;
    }
    string err = cli.remove(a.rest[i], recursive).wait();
    if (err == "") { continue; }
    // It was there and it is still there. `-f` does not get to hide that.
    core.warn(a.name + ": " + a.rest[i] + ": " + err);
    code = 1;
  }
  return code;
}
