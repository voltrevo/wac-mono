// Soak up all of standard input, *then* write the file.
//
// The applet that only exists because of the atomic write. `box sort f | box sponge f`
// works where `box sort f > f` cannot: the shell truncates `f` before `sort` has read it,
// and this does not touch the target until every byte has arrived.

import { Change, Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, openStream } from "../lib/input.wac";
import { streamAtomic } from "../lib/safe.wac";

export i32 sponge(Core core, Cli cli, Args a) {
  if (a.rest.len() < 1) { core.warn("usage: " + a.name + " <file>"); return 2; }
  Input in = openStream(core, cli, a, 1);   // index 1: the file is the destination
  if (!in.ok) { return 1; }
  Change wrote = streamAtomic(core, cli, a.rest[0]);
  if (wrote.ok()) { return 0; }
  core.warn(a.name + ": " + a.rest[0] + ": " + wrote.message);
  return 1;
}
