// An HTTP GET, to standard output. `box get example.com /path -80 -i`.
//
// The counterpart to `serve`, and the reason `connect` exists.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args, has } from "../lib/args.wac";
import { fetch } from "../lib/fetch.wac";

export i32 get(Core core, Cli cli, Args a) {
  if (a.rest.len() < 1) {
    core.warn("usage: " + a.name + " <host> [path] [-<port>] [-i]");
    return 2;
  }
  return fetch(core, cli, a.name, a.rest[0],
               a.rest.len() > 1 ? a.rest[1] : "/",
               a.hasNum ? a.num : 80, has(a, 'i'));
}
