// Each line reversed — by character, not by byte.
//
// Reversing bytes mangles anything outside ASCII: the em dash in this repo's own README
// comes back as three replacement characters. The real `rev` reverses characters, so this
// walks the line with `unicode`'s decoder and moves whole scalars. Invalid bytes are moved
// as single bytes, which is what `decode` reporting `size: 1` on a bad lead is for.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { Reader } from "../lib/input.wac";
import { Line, Sink, emitTo, nextLine } from "../../../platform/src/stream.wac";
import { decode, Scalar } from "../../../unicode/src/utf8.wac";

export i32 rev(Core core, Cli cli, Args a) {
  Reader r = Reader.create(core, cli, a, 0);
  if (!r.ok) { return 1; }

  Sink out = Sink.create(cli);
  while (true) {
    Line l = r.next(core, cli, a);
    if (!l.ok) { out.flush(); return r.broken ? 1 : 0; }
    if (!emitTo(out, reversed(l.bytes), l.nl)) { return 0; }
  }
  return 0;
}

/** The line's scalars in the opposite order, each one's bytes kept intact. */
u8[] reversed(u8[] line) {
  u8[] out = u8[line.len()](fill: 0);
  i32 write = line.len();
  i32 at = 0;
  while (at < line.len()) {
    Scalar sc = decode(line, at);
    i32 size = sc.size < 1 ? 1 : sc.size;
    if (at + size > line.len()) { size = line.len() - at; }
    write = write - size;
    out.copyFrom(line, at, write, size);
    at = at + size;
  }
  return out;
}
