// Every path under a root, depth first.

import { Cli, Core, Stat } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";

export i32 find(Core core, Cli cli, Args a) {
  string root = a.rest.len() < 1 ? "." : a.rest[0];
  Stat st = cli.stat(root);
  if (!st.exists) { core.warn(a.name + ": " + root + ": not found"); return 1; }
  core.log(root);
  walk(core, cli, root, 0);
  return 0;
}

void walk(Core core, Cli cli, string dir, i32 depth) {
  // A depth bound rather than a cycle check: `stat` does not distinguish a symlink, so a
  // loop through one is possible and this is what stops it being an infinite one.
  if (depth > 32) { return; }
  string[]? names = cli.readDir(dir);
  if (names is null) { return; }
  string[] found = names!;
  for (i32 i = 0; i < found.len(); i++) {
    string path = dir + "/" + found[i];
    core.log(path);
    if (cli.stat(path).isDir) { walk(core, cli, path, depth + 1); }
  }
}
