// A random UUID, version 4. `-<n>` for more than one.
//
// Sixteen bytes from `randomBytes` with the six bits the specification pins down. The
// only applet whose whole job is a capability nothing else called.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";

export i32 uuid(Core core, Cli cli, Args a) {
  i32 n = a.num == 0 ? 1 : a.num;
  u8[] digits = "0123456789abcdef".toBytes();
  for (i32 k = 0; k < n; k++) {
    u8[] r = core.randomBytes(16);
    r[6] = (r[6] & 0x0F) | 0x40;    // version 4
    r[8] = (r[8] & 0x3F) | 0x80;    // variant 1
    u8[] out = u8[36](fill: '-');
    i32 at = 0;
    for (i32 i = 0; i < 16; i++) {
      // The dashes are already in place; step over them rather than tracking two indices.
      if (at == 8 || at == 13 || at == 18 || at == 23) { at++; }
      out[at] = digits[(r[i] >> 4) & 15];
      out[at + 1] = digits[r[i] & 15];
      at = at + 2;
    }
    core.log(string.fromBytes(out));
  }
  return 0;
}
