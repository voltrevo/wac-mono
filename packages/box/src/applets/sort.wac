// Lines in byte order. `-r` reverses, `-u` drops duplicates.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args, has } from "../lib/args.wac";
import { Input, readInput } from "../lib/input.wac";
import { cmpBytes, joinLines, mergeSort, splitLines } from "../lib/lines.wac";

export i32 sort(Core core, Cli cli, Args a) {
  Input in = readInput(core, cli, a, 0);
  if (!in.ok) { return 1; }
  bool reverse = has(a, 'r');
  bool unique = has(a, 'u');

  u8[][] lines = splitLines(in.bytes);
  i32 n = lines.len();
  u8[][] sorted = mergeSort(lines, n);

  u8[][] out = u8[][n](fill: u8[0]());
  i32 at = 0;
  for (i32 i = 0; i < n; i++) {
    if (unique && i > 0 && cmpBytes(sorted[i], sorted[i - 1]) == 0) { continue; }
    out[at] = sorted[i];
    at++;
  }
  if (!reverse) { cli.write(joinLines(out, at)); return 0; }

  u8[][] flipped = u8[][at](fill: u8[0]());
  for (i32 i = 0; i < at; i++) { flipped[i] = out[at - 1 - i]; }
  cli.write(joinLines(flipped, at));
  return 0;
}
