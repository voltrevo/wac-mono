// Empty directories removed. Never recursive — that is `rm -r`, and the difference
// between them is the whole reason `rmdir` is a separate command.

import { Change, Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";

export i32 rmdir(Core core, Cli cli, Args a) {
  if (a.rest.len() < 1) { core.warn("usage: " + a.name + " <dir>..."); return 2; }
  i32 code = 0;
  for (i32 i = 0; i < a.rest.len(); i++) {
    Change c = cli.remove(a.rest[i], false).wait();
    if (c.ok()) { continue; }
    core.warn(a.name + ": " + a.rest[i] + ": " + c.message);
    code = 1;
  }
  return code;
}
