// Adjacent duplicate lines collapsed; `-c` counts them.
//
// Adjacent is the whole point: one line of state is enough, so this streams even though
// `sort -u`, which does the same job for non-adjacent lines, cannot.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args, has } from "../lib/args.wac";
import { Input, openStream } from "../lib/input.wac";
import { Feed, Line, Lines, Sink, emitTo, nextLine } from "../../../platform/src/stream.wac";
import { cmpBytes } from "../lib/lines.wac";
import { itoa } from "../../../fmt/src/itoa.wac";

export i32 uniq(Core core, Cli cli, Args a) {
  Input in = openStream(core, cli, a, 0);
  if (!in.ok) { return 1; }
  bool counting = has(a, 'c');

  Lines s = Lines.create();
  Feed fed = Feed.fromStdin(cli);
  Sink out = Sink.create(cli);
  u8[] prev = u8[0]();
  bool lastNl = true;
  i32 run = 0;
  while (true) {
    Line l = nextLine(s, fed);
    if (!l.ok) { break; }
    if (run > 0 && cmpBytes(l.bytes, prev) == 0) { run++; lastNl = l.nl; continue; }
    if (run > 0) { show(out, prev, run, counting, lastNl); }
    prev = l.bytes;
    lastNl = l.nl;
    run = 1;
  }
  if (run > 0) { show(out, prev, run, counting, lastNl); }
  out.flush();
  return 0;
}

/**
 * `uniq` terminates its last line even when the input did not — checked against the real
 * one, which is not uniform across these tools: `head`, `tail` and `rev` preserve a
 * missing final newline and `uniq` and `nl` add one.
 */
void show(Sink out, u8[] line, i32 run, bool counting, bool nl) {
  if (!counting) { emitTo(out, line, true); return; }
  // The real one right-aligns the count in a field of seven, then a space.
  string n = itoa(run);
  string pad = "";
  for (i32 i = n.toBytes().len(); i < 7; i++) { pad = pad + " "; }
  emitTo(out, (pad + n + " " + string.fromBytes(line)).toBytes(), true);
}
