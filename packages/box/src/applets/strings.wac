// Runs of printable bytes, four or more — `strings -6` for a longer minimum.
//
// The run itself is the only thing held, and it carries across a chunk boundary: a string
// split by a read is one string, not two short ones that both fall under the minimum.

import { Cli, Core } from "../../../platform/src/platform.wac";
import { Args } from "../lib/args.wac";
import { Input, openStream, inputEnded } from "../lib/input.wac";
import { Buf } from "../../../bytes/src/buf.wac";

export i32 strings(Core core, Cli cli, Args a) {
  Input in = openStream(core, cli, a, 0);
  if (!in.ok) { return 1; }
  i32 min = a.hasNum ? a.num : 4;

  Buf run = Buf.create();
  while (true) {
    u8[] data = cli.readChunk();
    if (data.len() == 0) { if (!inputEnded(core, cli, a)) { return 1; } break; }
    for (i32 i = 0; i < data.len(); i++) {
      i32 b = data[i];
      if (b >= 32 && b < 127) { run.push(b); continue; }
      emit(cli, run, min);
    }
  }
  emit(cli, run, min);
  return 0;
}

/** The run so far, if it is long enough, and reset either way. */
void emit(Cli cli, Buf run, i32 min) {
  if (run.len >= min) {
    u8[] out = u8[run.len + 1](fill: '\n');
    out.copyFrom(run.data, 0, 0, run.len);
    cli.write(out);
  }
  run.len = 0;
}
