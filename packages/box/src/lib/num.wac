// Numbers to text and back. wac has no formatting in the language.

import { slice } from "./bytes.wac";

export string itoa(i32 n) {
  if (n == 0) { return "0"; }
  i32 v = n < 0 ? 0 - n : n;
  u8[] digits = u8[12](fill: 0);
  i32 at = 12;
  while (v > 0) { at--; digits[at] = '0' + (v % 10); v = v / 10; }
  string s = string.fromBytes(slice(digits, at, 12));
  return n < 0 ? "-" + s : s;
}

export string itoa64(i64 n) {
  if (n == 0) { return "0"; }
  i64 v = n < 0 ? 0 - n : n;
  u8[] digits = u8[24](fill: 0);
  i32 at = 24;
  while (v > 0) { at--; digits[at] = ('0' as i64 + (v % 10)) as~ i32; v = v / 10; }
  string s = string.fromBytes(slice(digits, at, 24));
  return n < 0 ? "-" + s : s;
}

/** Leading digits only, zero when there are none — a command line is not a parser. */
export i32 atoi(string s) {
  u8[] b = s.toBytes();
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    i32 c = b[i];
    if (c < '0' || c > '9') { break; }
    v = v * 10 + (c - '0');
  }
  return v;
}
