// Lines pulled from the streaming input, one at a time.
//
// `splitLines` needs the whole input in memory, which is what an applet is trying to avoid
// by streaming. This holds one chunk plus one partial line instead, so a line-oriented
// applet costs whatever its own state costs and nothing for the input's size.
//
// A line is still a line: a very long one grows `pending` to hold it. That is inherent —
// the line is the unit — and no line-oriented tool can promise better.
//
// **It has to be linear as well as bounded**, which the first version was not. It appended
// with `concat` and rescanned from the start of the buffer after every refill, so an input
// with no newlines in it — a 300MB file of one line — copied and scanned the whole buffer
// once per 64K chunk. That is O(n²): it had not finished after two minutes, where the
// version it replaced took seconds and 1.5GB. A doubling `Buf` for the append and a
// `scanned` watermark for the search make both halves linear.

import { Cli } from "../../../platform/src/platform.wac";
import { Sink } from "./out.wac";
import { slice } from "./bytes.wac";
import { Buf } from "../../../bytes/src/buf.wac";

/**
 * One line, or `ok: false` at the end of the input.
 *
 * `nl` says whether the line was newline-terminated, which only the last line of an input
 * can fail to be. Carrying it is what lets these applets match the real tools on a file
 * that does not end in a newline: `tail -1` of one prints `b`, not `b\n`.
 */
export struct Line { bool ok; u8[] bytes; bool nl; }

export struct Lines {
  /**
   * Empty unless a read failed, in which case this is the host's message and the lines seen so far
   * are all there are. An applet that ignores it reports success over a truncated file — which is
   * what the `u8[]` answer used to force on everybody.
   */
  string broken;
  Buf pending;    // bytes read but not yet handed out; doubles, so appending is amortised
  i32 at;         // where the line being built starts
  i32 scanned;    // no newline anywhere in pending[at..scanned) — never re-examined
  bool ended;     // the input said so; `pending` may still hold a last line

  Lines create() { return Lines("", Buf.create(), 0, 0, false); }
}

/**
 * The next line, without its newline.
 *
 * The final line is returned even without a trailing newline, and an input that ends with
 * one does not produce a trailing empty line — which is what `splitLines` does, so the
 * applets behave the same whichever they use.
 */
export Line nextLine(Lines s, Cli cli) {
  while (true) {
    // From the watermark, not from `at`: bytes already looked at cannot become newlines.
    for (i32 i = s.scanned; i < s.pending.len; i++) {
      if (s.pending.data[i] != '\n') { continue; }
      u8[] line = slice(s.pending.data, s.at, i);
      s.at = i + 1;
      s.scanned = s.at;
      return Line(true, line, true);
    }
    s.scanned = s.pending.len;

    // No newline in what is left, so it is either the start of a longer line or the last
    // line of the input.
    if (s.ended) {
      u8[] rest = slice(s.pending.data, s.at, s.pending.len);
      s.pending.len = 0;
      s.at = 0;
      s.scanned = 0;
      return rest.len() > 0 ? Line(true, rest, false) : Line(false, u8[0](), false);
    }

    // Drop what has already been handed out before growing. `array.copy` is a memmove, so
    // a downward overlapping shift is exactly what it is for.
    if (s.at > 0) {
      i32 live = s.pending.len - s.at;
      s.pending.data.copyFrom(s.pending.data, s.at, 0, live);
      s.pending.len = live;
      s.scanned = s.scanned - s.at;
      s.at = 0;
    }

    // A broken read is not the end of the input. `Lines.broken` carries that up to the applet,
    // which is the only place that knows whether a half-read file is worth acting on.
    match (cli.readChunk()) {
      case Data(bytes): { s.pending.pushAll(bytes); }
      case End: { s.ended = true; }
      case Failed(why): { s.ended = true; s.broken = why; }
    }
  }
  return Line(false, u8[0](), false);
}

/**
 * A line into a `Sink`, terminated only if the one it came from was.
 *
 * The buffered twin of `emit` below, and the one to use in a loop: a `write` per line is a park and a
 * wake per line, which cost `seq` fourteen seconds for two hundred thousand of them (issue 0039).
 * Answers false once the reader has gone away, so a filter stops rather than producing into nothing.
 *
 * `emit` stays for the handful of places that write once and return.
 */
export bool emitTo(Sink out, u8[] line, bool nl) {
  if (!nl) { return out.bytes(line); }
  return out.lineBytes(line);
}

/** A line, terminated only if the one it came from was. */
export void emit(Cli cli, u8[] line, bool nl) {
  if (!nl) { cli.write(line); return; }
  u8[] out = u8[line.len() + 1](fill: '\n');
  out.copyFrom(line, 0, 0, line.len());
  cli.write(out);
}
