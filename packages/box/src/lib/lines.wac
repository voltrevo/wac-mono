// Splitting, joining, comparing and sorting lines — what most applets are made of.

import { slice } from "./bytes.wac";

/** Split into lines, dropping the empty one a trailing newline would produce. */
export u8[][] splitLines(u8[] data) {
  i32 n = 0;
  for (i32 i = 0; i < data.len(); i++) { if (data[i] == '\n') { n++; } }
  if (data.len() > 0 && data[data.len() - 1] != '\n') { n++; }
  u8[][] out = u8[][n](fill: u8[0]());
  i32 at = 0;
  i32 start = 0;
  for (i32 i = 0; i <= data.len(); i++) {
    bool end = i == data.len() || data[i] == '\n';
    if (!end) { continue; }
    if (i == data.len() && i == start) { break; }
    out[at] = slice(data, start, i);
    at++;
    start = i + 1;
  }
  return out;
}

/** The first `count` of `lines`, each followed by a newline. */
export u8[] joinLines(u8[][] lines, i32 count) {
  i32 total = 0;
  for (i32 i = 0; i < count; i++) { total = total + lines[i].len() + 1; }
  u8[] out = u8[total](fill: '\n');
  i32 at = 0;
  for (i32 i = 0; i < count; i++) {
    out.copyFrom(lines[i], 0, at, lines[i].len());
    at = at + lines[i].len() + 1;
  }
  return out;
}

/** Byte order, as `sort` uses by default. Negative, zero or positive. */
export i32 cmpBytes(u8[] a, u8[] b) {
  i32 n = a.len() < b.len() ? a.len() : b.len();
  for (i32 i = 0; i < n; i++) {
    i32 x = a[i];
    i32 y = b[i];
    if (x != y) { return x < y ? -1 : 1; }
  }
  if (a.len() == b.len()) { return 0; }
  return a.len() < b.len() ? -1 : 1;
}

/**
 * Merge sort, ordered by whatever comparison you hand it.
 *
 * Merge rather than insertion because an insertion sort looks fine on a fixture and takes minutes on a
 * real file. Stable, which `sort -u` then relies on to drop only adjacent equals.
 *
 * There was a `mergeSort(xs, n)` beside this that passed `cmpBytes` for you, and nothing ever called
 * it: `sort` is the only caller and it always chooses a comparison, because `sort -n` needs a different
 * one. A wrapper saving one argument, for one caller that does not want it, is a name that documents
 * nothing — issue 0009.
 *
 * The comparison is a parameter because `sort -n` needs a different one and the merge itself is
 * identical — the alternative was a second copy of a recursive sort differing in one call, which
 * is where the stability bug would eventually have gone.
 */
export u8[][] mergeSortWith(u8[][] xs, i32 n, fn[i32(u8[], u8[])] cmp) {
  if (n <= 1) { return xs; }
  i32 mid = n / 2;
  i32 right = n - mid;
  u8[][] l = u8[][mid](fill: u8[0]());
  u8[][] r = u8[][right](fill: u8[0]());
  for (i32 i = 0; i < mid; i++) { l[i] = xs[i]; }
  for (i32 i = 0; i < right; i++) { r[i] = xs[mid + i]; }
  u8[][] ls = mergeSortWith(l, mid, cmp);
  u8[][] rs = mergeSortWith(r, right, cmp);

  u8[][] out = u8[][n](fill: u8[0]());
  i32 li = 0;
  i32 ri = 0;
  for (i32 i = 0; i < n; i++) {
    // `<= 0` keeps the sort stable, which `-n` depends on: two lines with the same number come
    // out in the order they arrived, as GNU's does.
    bool takeLeft = ri >= right || (li < mid && cmp(ls[li], rs[ri]) <= 0);
    if (takeLeft) { out[i] = ls[li]; li++; } else { out[i] = rs[ri]; ri++; }
  }
  return out;
}

/**
 * Lines by the number they begin with, for `sort -n`.
 *
 * Leading blanks and a sign are part of the number, as GNU has them. A line with no number at all
 * counts as zero rather than sorting apart, which is also GNU's rule.
 *
 * It is *not* the whole of `sort -n`, and this comment used to say it was: "the non-numbers keep their
 * order among the zeroes" is what happens with a stable sort and no tie-break, and GNU breaks the tie
 * by comparing the whole line. `sort -n` over `b`, `a`, `1` answers `a b 1` there and answered the
 * input's order here. `cmpNumericThenBytes` is the comparison a sort wants; this one is the *key*, and
 * `-u` is where the difference shows.
 *
 * **Integers only.** GNU compares decimals and thousands separators too. That is a real shortfall
 * and is written down rather than discovered: `sort -n` over `1.5` and `1.25` here orders them by
 * the `1` and then by their bytes, where GNU orders them by the fraction.
 */
export i32 cmpNumeric(u8[] a, u8[] b) {
  i64 x = leadingNumber(a);
  i64 y = leadingNumber(b);
  if (x == y) { return 0; }
  return x < y ? -1 : 1;
}

/**
 * The numeric key, then the whole line — GNU's *last-resort comparison*, which is what makes `sort -n`
 * over lines with equal keys deterministic instead of merely stable.
 *
 * Separate from `cmpNumeric` because `-u` must not use it: uniqueness is the key's, so `1` and `01` are
 * one line, and the survivor is the first in input order rather than the first in byte order.
 */
export i32 cmpNumericThenBytes(u8[] a, u8[] b) {
  i32 c = cmpNumeric(a, b);
  return c != 0 ? c : cmpBytes(a, b);
}

/**
 * The integer a line starts with, after blanks, or zero if it does not start with one.
 *
 * **i64, and saturating.** In i32 it wrapped: `sort -n` over `4294967296 1 2147483648 -1` answered
 * `2147483648 -1 4294967296 1`, and `-nu` merged `4294967296` with `0` because both keys came out
 * the same — a distinct line silently dropped. Saturation rather than wrapping keeps the order
 * monotonic for input wider than i64 as well; GNU compares those exactly, which needs arbitrary
 * precision and is a bigger change than this bug.
 */
i64 leadingNumber(u8[] b) {
  i32 i = 0;
  while (i < b.len() && (b[i] == ' ' || b[i] == '\t')) { i++; }
  bool negative = false;
  if (i < b.len() && (b[i] == '-' || b[i] == '+')) {
    negative = b[i] == '-';
    i++;
  }
  i64 v = 0;
  i64 cap = 922337203685477580;              // i64 max / 10, so the multiply below cannot overflow
  bool saturated = false;
  while (i < b.len() && b[i] >= '0' && b[i] <= '9') {
    if (v > cap) { saturated = true; }
    if (!saturated) { v = v * 10 + ((b[i] - '0') as i64); }
    i++;
  }
  if (saturated) { return negative ? -9223372036854775807 : 9223372036854775807; }
  return negative ? 0 - v : v;
}
