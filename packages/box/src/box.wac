// A busybox-shaped application: one program, many applets, chosen by the first argument.
//
//   box grep -i wac README.md
//   cat README.md | box sort -u | box wc -l
//   box gzip data | box gunzip | box sha256sum
//   box serve -8080
//
// This file is the dispatcher and nothing else. One applet per file under `applets/`, so
// finding one takes no thought: it is `applets/<name>.wac`, always. The shared parts —
// argument parsing, line splitting, byte and number helpers, the line reader, the atomic
// write — are under `lib/`.
//
// The imports below are the table of contents. wac has no re-export, so this is the one
// place that has to know every applet exists, which is the right place for it.
//
// Many of these are a few lines over a package from this monorepo: `gzip`, `zstd`, `json`,
// `sha256sum`, `date`, `serve` and `get` are all thin. That is the point of them — those
// packages were written to be called from TypeScript through bindgen and needed no change
// at all to become the inside of a program.
//
// **A multicall binary weakens the permission story**, and that is worth saying rather
// than hiding. `box`'s grants are the *union* of what its applets need, so running `box
// echo` carries the filesystem *and network* access `box cp` and `box get` would want. One
// applet per file means each could also be built alone, with only what it needs — `bin/`
// does exactly that for four of them, and measures what it saves.

import { Cli, Core } from "../../platform/src/platform.wac";
import { Args, parseArgs } from "./lib/args.wac";

import { base32 } from "./applets/base32.wac";
import { base64 } from "./applets/base64.wac";
import { basename } from "./applets/basename.wac";
import { cat } from "./applets/cat.wac";
import { cp } from "./applets/cp.wac";
import { crc32 } from "./applets/crc32.wac";
import { cut } from "./applets/cut.wac";
import { date } from "./applets/date.wac";
import { dirname } from "./applets/dirname.wac";
import { du } from "./applets/du.wac";
import { echo } from "./applets/echo.wac";
import { find } from "./applets/find.wac";
import { fold } from "./applets/fold.wac";
import { get } from "./applets/get.wac";
import { grep } from "./applets/grep.wac";
import { gunzip } from "./applets/gunzip.wac";
import { gzip } from "./applets/gzip.wac";
import { head } from "./applets/head.wac";
import { hex } from "./applets/hex.wac";
import { httpd } from "./applets/httpd.wac";
import { json } from "./applets/json.wac";
import { ls } from "./applets/ls.wac";
import { mkdir } from "./applets/mkdir.wac";
import { mv } from "./applets/mv.wac";
import { nl } from "./applets/nl.wac";
import { paste } from "./applets/paste.wac";
import { rev } from "./applets/rev.wac";
import { rm } from "./applets/rm.wac";
import { rmdir } from "./applets/rmdir.wac";
import { seq } from "./applets/seq.wac";
import { serve } from "./applets/serve.wac";
import { sha256sum } from "./applets/sha256sum.wac";
import { sha512sum } from "./applets/sha512sum.wac";
import { shuf } from "./applets/shuf.wac";
import { sort } from "./applets/sort.wac";
import { split } from "./applets/split.wac";
import { sponge } from "./applets/sponge.wac";
import { stat } from "./applets/stat.wac";
import { strings } from "./applets/strings.wac";
import { tac } from "./applets/tac.wac";
import { tail } from "./applets/tail.wac";
import { tee } from "./applets/tee.wac";
import { touch } from "./applets/touch.wac";
import { tr } from "./applets/tr.wac";
import { uniq } from "./applets/uniq.wac";
import { unzstd } from "./applets/unzstd.wac";
import { urldecode } from "./applets/urldecode.wac";
import { urlencode } from "./applets/urlencode.wac";
import { uuid } from "./applets/uuid.wac";
import { wc } from "./applets/wc.wac";
import { wget } from "./applets/wget.wac";
import { yes } from "./applets/yes.wac";
import { zstd } from "./applets/zstd.wac";

export i32 main(Core core, Cli cli) {
  if (cli.argCount() < 1) { return usage(core); }
  string applet = cli.arg(0);
  Args a = parseArgs(cli);

  if (applet == "base32")    { return base32(core, cli, a); }
  if (applet == "base64")    { return base64(core, cli, a); }
  if (applet == "basename")  { return basename(core, cli, a); }
  if (applet == "cat")       { return cat(core, cli, a); }
  if (applet == "cp")        { return cp(core, cli, a); }
  if (applet == "crc32")     { return crc32(core, cli, a); }
  if (applet == "cut")       { return cut(core, cli, a); }
  if (applet == "date")      { return date(core, cli, a); }
  if (applet == "dirname")   { return dirname(core, cli, a); }
  if (applet == "du")        { return du(core, cli, a); }
  if (applet == "echo")      { return echo(core, cli, a); }
  if (applet == "find")      { return find(core, cli, a); }
  if (applet == "fold")      { return fold(core, cli, a); }
  if (applet == "get")       { return get(core, cli, a); }
  if (applet == "grep")      { return grep(core, cli, a); }
  if (applet == "gunzip")    { return gunzip(core, cli, a); }
  if (applet == "gzip")      { return gzip(core, cli, a); }
  if (applet == "head")      { return head(core, cli, a); }
  if (applet == "help")      { return usage(core); }
  if (applet == "hex")       { return hex(core, cli, a); }
  if (applet == "httpd")     { return httpd(core, cli, a); }
  if (applet == "json")      { return json(core, cli, a); }
  if (applet == "ls")        { return ls(core, cli, a); }
  if (applet == "mkdir")     { return mkdir(core, cli, a); }
  if (applet == "mv")        { return mv(core, cli, a); }
  if (applet == "nl")        { return nl(core, cli, a); }
  if (applet == "paste")     { return paste(core, cli, a); }
  if (applet == "rev")       { return rev(core, cli, a); }
  if (applet == "rm")        { return rm(core, cli, a); }
  if (applet == "rmdir")     { return rmdir(core, cli, a); }
  if (applet == "seq")       { return seq(core, cli, a); }
  if (applet == "serve")     { return serve(core, cli, a); }
  if (applet == "sha256sum") { return sha256sum(core, cli, a); }
  if (applet == "sha512sum") { return sha512sum(core, cli, a); }
  if (applet == "shuf")      { return shuf(core, cli, a); }
  if (applet == "sort")      { return sort(core, cli, a); }
  if (applet == "split")     { return split(core, cli, a); }
  if (applet == "sponge")    { return sponge(core, cli, a); }
  if (applet == "stat")      { return stat(core, cli, a); }
  if (applet == "strings")   { return strings(core, cli, a); }
  if (applet == "tac")       { return tac(core, cli, a); }
  if (applet == "tail")      { return tail(core, cli, a); }
  if (applet == "tee")       { return tee(core, cli, a); }
  if (applet == "touch")     { return touch(core, cli, a); }
  if (applet == "tr")        { return tr(core, cli, a); }
  if (applet == "uniq")      { return uniq(core, cli, a); }
  if (applet == "unzstd")    { return unzstd(core, cli, a); }
  if (applet == "urldecode") { return urldecode(core, cli, a); }
  if (applet == "urlencode") { return urlencode(core, cli, a); }
  if (applet == "uuid")      { return uuid(core, cli, a); }
  if (applet == "wc")        { return wc(core, cli, a); }
  if (applet == "wget")      { return wget(core, cli, a); }
  if (applet == "yes")       { return yes(core, cli, a); }
  if (applet == "zstd")      { return zstd(core, cli, a); }

  // `true` and `false` have no body: the dispatcher returning a constant *is* the whole
  // applet, and a file containing one `return` would be ceremony rather than clarity.
  if (applet == "true")      { return 0; }
  if (applet == "false")     { return 1; }

  core.warn("box: unknown applet '" + applet + "'");
  return usage(core);
}

i32 usage(Core core) {
  core.warn("usage: box <applet> [-flags] [args]");
  core.warn("  base32 base64 basename cat cp crc32 cut date dirname du echo false find");
  core.warn("  fold get grep gunzip gzip head hex httpd json ls mkdir mv nl paste rev rm");
  core.warn("  rmdir seq serve sha256sum sha512sum shuf sort split sponge stat strings");
  core.warn("  tac tail tee touch tr true uniq unzstd urldecode urlencode uuid wc wget");
  core.warn("  yes zstd");
  core.warn("flags: grep -ivnc   sort -ru   uniq -c   wc -lwc   head/tail/fold -N");
  core.warn("       cut -f<n> -d<c>   tr <set1> <set2>   mkdir -p   rm -rf   json -c");
  core.warn("net:   get <host> [path] [-<port>] [-i]   wget <host> <path> <out>\n"
            + "       serve [-<port>] [-o]   httpd [-<port>] [dir] [-o]");
  return 2;
}
