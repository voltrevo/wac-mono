// The smallest thing that asks a node a question: `eth_blockNumber`, printed.
//
// Its job is to be the first program in this repo that talks to a chain at all — everything above it
// verifies what a node says, and until this existed nothing could ask. Run it against a local anvil:
//
//     deno task app:build packages/ethrpc/example/blocknumber.wac --allow-net -o blocknumber
//     ./blocknumber 127.0.0.1 8545
import { Cli, Core } from "../../platform/src/platform.wac";
import { call, stringOf, Answer } from "../src/rpc.wac";
import { itoa } from "../../fmt/src/itoa.wac";

export i32 main(Core core, Cli cli) {
  i32 n = cli.argCount().wait();
  string host = n > 0 ? string.fromBytes(cli.arg(0).wait()) : "127.0.0.1";
  i32 port = n > 1 ? atoiOr(string.fromBytes(cli.arg(1).wait()), 8545) : 8545;

  Answer a = call(cli, host, port, "eth_blockNumber", "[]");
  if (!a.ok) { core.warn("blocknumber: " + a.error); return 1; }
  core.log(string.fromBytes(stringOf(a.result)));
  return 0;
}

i32 atoiOr(string s, i32 fallback) {
  u8[] b = s.toBytes();
  if (b.len() == 0) { return fallback; }
  i32 n = 0;
  for (i32 i = 0; i < b.len(); i++) {
    if (b[i] < '0' || b[i] > '9') { return fallback; }
    n = n * 10 + (b[i] - '0');
  }
  return n;
}
