// The field at the TypeScript boundary, so a test can hand it bytes and read bytes back.
//
// Only `toBytes`/`fromBytes` cross, deliberately: Montgomery form is an internal
// representation and a test that could see it would be testing the representation rather
// than the arithmetic. Everything below takes canonical 48-byte big-endian values.

import { fpAdd, fpSub, fpMul, fpNeg, fpSquare, fpFromBytes, fpToBytes, fpOne, fpIsZero,
         fpEquals } from "../../src/fp.wac";

/** 0 ok, 1 a is not canonical, 2 b is not canonical. */
export i32 blsFpStatus(u8[] a, u8[] b) {
  if (fpFromBytes(a) is null) { return 1; }
  if (fpFromBytes(b) is null) { return 2; }
  return 0;
}

u8[] binary(u8[] a, u8[] b, i32 op) {
  u32[]? x = fpFromBytes(a);
  u32[]? y = fpFromBytes(b);
  if ((x is null) || (y is null)) { return u8[0](); }
  if (op == 0) { return fpToBytes(fpAdd(x!, y!)); }
  if (op == 1) { return fpToBytes(fpSub(x!, y!)); }
  return fpToBytes(fpMul(x!, y!));
}

export u8[] blsFpAdd(u8[] a, u8[] b) { return binary(a, b, 0); }
export u8[] blsFpSub(u8[] a, u8[] b) { return binary(a, b, 1); }
export u8[] blsFpMul(u8[] a, u8[] b) { return binary(a, b, 2); }

export u8[] blsFpNeg(u8[] a) {
  u32[]? x = fpFromBytes(a);
  return (x is null) ? u8[0]() : fpToBytes(fpNeg(x!));
}

export u8[] blsFpSquare(u8[] a) {
  u32[]? x = fpFromBytes(a);
  return (x is null) ? u8[0]() : fpToBytes(fpSquare(x!));
}

/** One's canonical encoding, which is also a check that Montgomery form round-trips. */
export u8[] blsFpOneBytes() { return fpToBytes(fpOne()); }

/** `a` round-tripped through the form and back, which must be the identity. */
export u8[] blsFpRoundTrip(u8[] a) {
  u32[]? x = fpFromBytes(a);
  return (x is null) ? u8[0]() : fpToBytes(x!);
}

/** Whether `a·1 == a` in the form — the one internal invariant worth asserting from here. */
export bool blsFpMulByOneIsIdentity(u8[] a) {
  u32[]? x = fpFromBytes(a);
  if (x is null) { return false; }
  return fpEquals(fpMul(x!, fpOne()), x!);
}

export bool blsFpIsZeroBytes(u8[] a) {
  u32[]? x = fpFromBytes(a);
  return (x is null) ? false : fpIsZero(x!);
}

// ── Inversion, roots, and Fp2 ─────────────────────────────────────────────────

import { fpInvert, fpSqrt, fpIsLexicographicallyLarger } from "../../src/fp.wac";
import { Fp2, fp2Add, fp2Sub, fp2Mul, fp2Square, fp2Conjugate, fp2MulByU,
         fp2MulByNonresidue, fp2Norm, fp2FromBytes, fp2C0Bytes, fp2C1Bytes,
         fp2Equals, fp2One, fp2Zero } from "../../src/fp2.wac";

/** `a⁻¹`, or empty when `a` is zero. */
export u8[] blsFpInvert(u8[] a) {
  u32[]? x = fpFromBytes(a);
  if (x is null) { return u8[0](); }
  u32[]? r = fpInvert(x!);
  return (r is null) ? u8[0]() : fpToBytes(r!);
}

/** A square root, or empty when there is none — the two cases a caller must tell apart. */
export u8[] blsFpSqrt(u8[] a) {
  u32[]? x = fpFromBytes(a);
  if (x is null) { return u8[0](); }
  u32[]? r = fpSqrt(x!);
  return (r is null) ? u8[0]() : fpToBytes(r!);
}

export bool blsFpLarger(u8[] a) {
  u32[]? x = fpFromBytes(a);
  return (x is null) ? false : fpIsLexicographicallyLarger(x!);
}

Fp2? read2(u8[] c0, u8[] c1) { return fp2FromBytes(c1, c0); }

/** Every Fp2 operation, selected by `op`, returning `c0 || c1` as 96 bytes. */
export u8[] blsFp2Op(u8[] ac0, u8[] ac1, u8[] bc0, u8[] bc1, i32 op) {
  Fp2? a = read2(ac0, ac1);
  Fp2? b = read2(bc0, bc1);
  if ((a is null) || (b is null)) { return u8[0](); }
  Fp2 r = fp2Zero();
  if (op == 0) { r = fp2Add(a!, b!); }
  else if (op == 1) { r = fp2Sub(a!, b!); }
  else if (op == 2) { r = fp2Mul(a!, b!); }
  else if (op == 3) { r = fp2Square(a!); }
  else if (op == 4) { r = fp2Conjugate(a!); }
  else if (op == 5) { r = fp2MulByU(a!); }
  else if (op == 6) { r = fp2MulByNonresidue(a!); }
  else { return u8[0](); }
  u8[] out = u8[96]();
  u8[] lo = fp2C0Bytes(r);
  u8[] hi = fp2C1Bytes(r);
  for (i32 i = 0; i < 48; i++) { out[i] = lo[i]; out[48 + i] = hi[i]; }
  return out;
}

export u8[] blsFp2Norm(u8[] ac0, u8[] ac1) {
  Fp2? a = read2(ac0, ac1);
  return (a is null) ? u8[0]() : fpToBytes(fp2Norm(a!));
}

/** `1·1 == 1` in Fp2 — a shape check on the identity, not a correctness claim. */
export bool blsFp2OneIsIdempotent() { return fp2Equals(fp2Mul(fp2One(), fp2One()), fp2One()); }

// ── The tower ─────────────────────────────────────────────────────────────────
//
// Fp6 and Fp12 elements cross as a flat run of 48-byte coefficients: within each Fp2, c0 then
// c1; above that, ascending degree. Six coefficients for Fp6, twelve for Fp12.

import { Fp6, Fp12, fp6Mul, fp6Square, fp6MulByV, fp6Invert, fp6Frobenius, fp6Zero,
         fp12Mul, fp12Square, fp12Conjugate, fp12Invert, fp12Frobenius, fp12One, fp12Zero,
         fp12Equals, fp12IsOne } from "../../src/fp12.wac";

Fp2? at2(u8[] s, i32 i) {
  u8[] c0 = u8[48]();
  u8[] c1 = u8[48]();
  for (i32 k = 0; k < 48; k++) {
    c0[k] = s[96 * i + k];
    c1[k] = s[96 * i + 48 + k];
  }
  return fp2FromBytes(c1, c0);
}

/** Six coefficients in, an Fp6 out, or null if any is non-canonical. */
Fp6? read6(u8[] s) {
  if (s.len() != 288) { return null; }
  Fp2? a = at2(s, 0);
  Fp2? b = at2(s, 1);
  Fp2? c = at2(s, 2);
  if ((a is null) || (b is null) || (c is null)) { return null; }
  return Fp6(a!, b!, c!);
}

Fp12? read12(u8[] s) {
  if (s.len() != 576) { return null; }
  u8[] lo = u8[288]();
  u8[] hi = u8[288]();
  for (i32 k = 0; k < 288; k++) { lo[k] = s[k]; hi[k] = s[288 + k]; }
  Fp6? a = read6(lo);
  Fp6? b = read6(hi);
  if ((a is null) || (b is null)) { return null; }
  return Fp12(a!, b!);
}

void write2(u8[] out, i32 i, Fp2 a) {
  u8[] c0 = fp2C0Bytes(a);
  u8[] c1 = fp2C1Bytes(a);
  for (i32 k = 0; k < 48; k++) {
    out[96 * i + k] = c0[k];
    out[96 * i + 48 + k] = c1[k];
  }
}

u8[] bytes6(Fp6 a) {
  u8[] out = u8[288]();
  write2(out, 0, a.c0);
  write2(out, 1, a.c1);
  write2(out, 2, a.c2);
  return out;
}

u8[] bytes12(Fp12 a) {
  u8[] out = u8[576]();
  u8[] lo = bytes6(a.c0);
  u8[] hi = bytes6(a.c1);
  for (i32 k = 0; k < 288; k++) { out[k] = lo[k]; out[288 + k] = hi[k]; }
  return out;
}

/** Fp6 operations by index: 0 mul, 1 square, 2 mulByV, 3 invert, 4..6 Frobenius at 1..3. */
export u8[] blsFp6Op(u8[] a, u8[] b, i32 op) {
  Fp6? x = read6(a);
  Fp6? y = read6(b);
  if ((x is null) || (y is null)) { return u8[0](); }
  if (op == 0) { return bytes6(fp6Mul(x!, y!)); }
  if (op == 1) { return bytes6(fp6Square(x!)); }
  if (op == 2) { return bytes6(fp6MulByV(x!)); }
  if (op == 3) {
    Fp6? r = fp6Invert(x!);
    return (r is null) ? u8[0]() : bytes6(r!);
  }
  if (op >= 4 && op <= 6) { return bytes6(fp6Frobenius(x!, op - 3)); }
  return u8[0]();
}

/** Fp12 operations: 0 mul, 1 square, 2 conjugate, 3 invert, 4..6 Frobenius at 1..3. */
export u8[] blsFp12Op(u8[] a, u8[] b, i32 op) {
  Fp12? x = read12(a);
  Fp12? y = read12(b);
  if ((x is null) || (y is null)) { return u8[0](); }
  if (op == 0) { return bytes12(fp12Mul(x!, y!)); }
  if (op == 1) { return bytes12(fp12Square(x!)); }
  if (op == 2) { return bytes12(fp12Conjugate(x!)); }
  if (op == 3) {
    Fp12? r = fp12Invert(x!);
    return (r is null) ? u8[0]() : bytes12(r!);
  }
  if (op >= 4 && op <= 6) { return bytes12(fp12Frobenius(x!, op - 3)); }
  return u8[0]();
}

/** `a · a⁻¹ == 1` in Fp12 — a shape check, not the correctness oracle. */
export bool blsFp12InverseIsInverse(u8[] a) {
  Fp12? x = read12(a);
  if (x is null) { return false; }
  Fp12? r = fp12Invert(x!);
  if (r is null) { return false; }
  return fp12IsOne(fp12Mul(x!, r!));
}

// ── G1 ────────────────────────────────────────────────────────────────────────

import { groupOrder } from "../../src/g1.wac";
import { G1, g1Generator, g1Infinity, g1IsInfinity, g1Add, g1Double, g1Mul, g1Negate,
         g1IsOnCurve, g1InSubgroup, g1Compress, g1Decompress, g1FromBytes, g1AffineX,
         g1AffineY } from "../../src/g1.wac";

/**
 * What a decompression attempt produced, as a single number a test can assert on.
 *
 * 0 accepted, 1 the encoding was refused, 2 it decoded but is off the curve, 3 it decoded and
 * is on the curve but outside the order-r subgroup. Distinguishing 1 from 2 from 3 is the point:
 * they are three different bugs and a bool would hide which.
 */
export i32 blsG1Status(u8[] s) {
  G1? p = g1Decompress(s);
  if (p is null) { return 1; }
  if (!g1IsOnCurve(p!)) { return 2; }
  if (!g1InSubgroup(p!)) { return 3; }
  return 0;
}

/** The affine x of a decompressed point, or empty. */
export u8[] blsG1X(u8[] s) {
  G1? p = g1FromBytes(s);
  if (p is null) { return u8[0](); }
  u32[]? x = g1AffineX(p!);
  return (x is null) ? u8[0]() : fpToBytes(x!);
}

export u8[] blsG1Y(u8[] s) {
  G1? p = g1FromBytes(s);
  if (p is null) { return u8[0](); }
  u32[]? y = g1AffineY(p!);
  return (y is null) ? u8[0]() : fpToBytes(y!);
}

/** Re-compressing a decompressed point must give the same bytes back. */
export u8[] blsG1RoundTrip(u8[] s) {
  G1? p = g1FromBytes(s);
  return (p is null) ? u8[0]() : g1Compress(p!);
}

/** `k·G` compressed, for a scalar given as eight little-endian words. */
export u8[] blsG1MulGenerator(u32[] k) { return g1Compress(g1Mul(g1Generator(), k)); }

/** The generator's compressed form. */
export u8[] blsG1GeneratorBytes() { return g1Compress(g1Generator()); }

/** `P + (−P)` must be infinity, and `P + P` must equal `2P` — the two degenerate paths. */
export bool blsG1DegenerateAddition() {
  G1 g = g1Generator();
  if (!g1IsInfinity(g1Add(g, g1Negate(g)))) { return false; }
  u8[] viaAdd = g1Compress(g1Add(g, g));
  u8[] viaDouble = g1Compress(g1Double(g));
  if (viaAdd.len() != viaDouble.len()) { return false; }
  for (i32 i = 0; i < viaAdd.len(); i++) {
    if (viaAdd[i] != viaDouble[i]) { return false; }
  }
  return true;
}

/** `r·G == O`, which is the subgroup check applied to the generator itself. */
export bool blsG1OrderIsR() { return g1IsInfinity(g1Mul(g1Generator(), groupOrder())); }

// ── G2 ────────────────────────────────────────────────────────────────────────

import { G2, g2Generator, g2Infinity, g2IsInfinity, g2Add, g2Double, g2Mul, g2Negate,
         g2IsOnCurve, g2InSubgroup, g2Compress, g2Decompress, g2FromBytes, g2AffineX,
         g2AffineY } from "../../src/g2.wac";

/** As `blsG1Status`: 0 accepted, 1 encoding refused, 2 off curve, 3 outside the subgroup. */
export i32 blsG2Status(u8[] s) {
  G2? p = g2Decompress(s);
  if (p is null) { return 1; }
  if (!g2IsOnCurve(p!)) { return 2; }
  if (!g2InSubgroup(p!)) { return 3; }
  return 0;
}

/** `x.c0 || x.c1` of a decompressed point, 96 bytes, or empty. */
export u8[] blsG2X(u8[] s) {
  G2? p = g2FromBytes(s);
  if (p is null) { return u8[0](); }
  Fp2? x = g2AffineX(p!);
  if (x is null) { return u8[0](); }
  u8[] out = u8[96]();
  u8[] c0 = fp2C0Bytes(x!);
  u8[] c1 = fp2C1Bytes(x!);
  for (i32 i = 0; i < 48; i++) { out[i] = c0[i]; out[48 + i] = c1[i]; }
  return out;
}

export u8[] blsG2Y(u8[] s) {
  G2? p = g2FromBytes(s);
  if (p is null) { return u8[0](); }
  Fp2? y = g2AffineY(p!);
  if (y is null) { return u8[0](); }
  u8[] out = u8[96]();
  u8[] c0 = fp2C0Bytes(y!);
  u8[] c1 = fp2C1Bytes(y!);
  for (i32 i = 0; i < 48; i++) { out[i] = c0[i]; out[48 + i] = c1[i]; }
  return out;
}

export u8[] blsG2RoundTrip(u8[] s) {
  G2? p = g2FromBytes(s);
  return (p is null) ? u8[0]() : g2Compress(p!);
}

export u8[] blsG2MulGenerator(u32[] k) { return g2Compress(g2Mul(g2Generator(), k)); }
export u8[] blsG2GeneratorBytes() { return g2Compress(g2Generator()); }

export bool blsG2DegenerateAddition() {
  G2 g = g2Generator();
  if (!g2IsInfinity(g2Add(g, g2Negate(g)))) { return false; }
  u8[] viaAdd = g2Compress(g2Add(g, g));
  u8[] viaDouble = g2Compress(g2Double(g));
  for (i32 i = 0; i < 96; i++) {
    if (viaAdd[i] != viaDouble[i]) { return false; }
  }
  return true;
}

export bool blsG2OrderIsR() { return g2IsInfinity(g2Mul(g2Generator(), groupOrder())); }

// ── hash_to_field ─────────────────────────────────────────────────────────────

import { expandMessageXmd, hashToFieldFp2 } from "../../src/hash.wac";

export u8[] blsExpandMessage(u8[] msg, u8[] dst, i32 len) {
  return expandMessageXmd(msg, dst, len);
}

/** The two Fp2 elements, flattened as u0.c0 || u0.c1 || u1.c0 || u1.c1. */
export u8[] blsHashToField(u8[] msg, u8[] dst) {
  Fp2[] u = hashToFieldFp2(msg, dst);
  u8[] out = u8[192]();
  for (i32 i = 0; i < 2; i++) {
    u8[] c0 = fp2C0Bytes(u[i]);
    u8[] c1 = fp2C1Bytes(u[i]);
    for (i32 k = 0; k < 48; k++) {
      out[96 * i + k] = c0[k];
      out[96 * i + 48 + k] = c1[k];
    }
  }
  return out;
}
