// Fp6 = Fp2[v]/(v³ − ξ) with ξ = 1 + u, and Fp12 = Fp6[w]/(w² − v).
//
// Two towers in one file because they are one decision: BLS12-381's pairing lands in Fp12, and
// reaching it through Fp2 → Fp6 → Fp12 rather than a degree-12 extension directly is what makes
// each multiplication a handful of the layer below instead of 144 coefficient products.
//
//   an Fp6 multiply  = 6 Fp2 multiplies   (Karatsuba over three coefficients)
//   an Fp12 multiply = 3 Fp6 multiplies   = 18 Fp2 = 54 Fp
//
// Those factors are the whole performance story: a pairing is thousands of Fp12 operations, so
// every multiplication saved here is multiplied by thousands.
//
// ## The Frobenius constants are generated, not transcribed
//
// `frob6C1_n` and friends hold ξ^((pⁿ−1)/3) and similar, in Montgomery form. They were emitted
// by a script from `test/tower.py` and pasted, never typed: each is twelve 32-bit words, and a
// single wrong digit gives a pairing that is entirely self-consistent and disagrees with every
// published vector. `test/tower.py` checks them the only way that means anything — by comparing
// Frobenius-by-constants against actually raising to the pⁿ-th power in the tower.

import { fpAdd, fpSub, fpMul, fpNeg, fpZero, fpOne, fpIsZero, fpEquals, fpCopy } from "./fp.wac";
import { Fp2, fp2Add, fp2Sub, fp2Mul, fp2Square, fp2Neg, fp2Conjugate, fp2Zero, fp2One,
         fp2IsZero, fp2Equals, fp2Copy, fp2MulByNonresidue, fp2Norm, fp2Invert } from "./fp2.wac";

/** `c0 + c1·v + c2·v²`. */
export struct Fp6 {
  Fp2 c0;
  Fp2 c1;
  Fp2 c2;
}

/** `c0 + c1·w`. */
export struct Fp12 {
  Fp6 c0;
  Fp6 c1;
}

export Fp6 fp6Zero() { return Fp6(fp2Zero(), fp2Zero(), fp2Zero()); }
export Fp6 fp6One() { return Fp6(fp2One(), fp2Zero(), fp2Zero()); }
export bool fp6Equals(Fp6 a, Fp6 b) {
  return fp2Equals(a.c0, b.c0) && fp2Equals(a.c1, b.c1) && fp2Equals(a.c2, b.c2);
}

export Fp6 fp6Add(Fp6 a, Fp6 b) {
  return Fp6(fp2Add(a.c0, b.c0), fp2Add(a.c1, b.c1), fp2Add(a.c2, b.c2));
}
export Fp6 fp6Sub(Fp6 a, Fp6 b) {
  return Fp6(fp2Sub(a.c0, b.c0), fp2Sub(a.c1, b.c1), fp2Sub(a.c2, b.c2));
}
export Fp6 fp6Neg(Fp6 a) { return Fp6(fp2Neg(a.c0), fp2Neg(a.c1), fp2Neg(a.c2)); }

/**
 * Six Fp2 multiplications rather than nine, by Karatsuba over the three coefficients.
 *
 * The ξ factors are where `v³ = ξ` folds back in: any product of coefficients whose degrees sum
 * past two comes back down one power of v carrying a ξ.
 */
export Fp6 fp6Mul(Fp6 a, Fp6 b) {
  Fp2 t0 = fp2Mul(a.c0, b.c0);
  Fp2 t1 = fp2Mul(a.c1, b.c1);
  Fp2 t2 = fp2Mul(a.c2, b.c2);

  Fp2 m12 = fp2Mul(fp2Add(a.c1, a.c2), fp2Add(b.c1, b.c2));
  Fp2 c0 = fp2Add(t0, fp2MulByNonresidue(fp2Sub(fp2Sub(m12, t1), t2)));

  Fp2 m01 = fp2Mul(fp2Add(a.c0, a.c1), fp2Add(b.c0, b.c1));
  Fp2 c1 = fp2Add(fp2Sub(fp2Sub(m01, t0), t1), fp2MulByNonresidue(t2));

  Fp2 m02 = fp2Mul(fp2Add(a.c0, a.c2), fp2Add(b.c0, b.c2));
  Fp2 c2 = fp2Add(fp2Sub(fp2Sub(m02, t0), t2), t1);

  return Fp6(c0, c1, c2);
}

export Fp6 fp6Square(Fp6 a) { return fp6Mul(a, a); }

/** `a·v`, which rotates the coefficients and folds `v³` into ξ. */
export Fp6 fp6MulByV(Fp6 a) {
  return Fp6(fp2MulByNonresidue(a.c2), fp2Copy(a.c0), fp2Copy(a.c1));
}

/** `a·(b0 + b1·v)` — a sparse multiply, for the pairing's line functions. */
export Fp6 fp6MulBy01(Fp6 a, Fp2 b0, Fp2 b1) {
  Fp2 t0 = fp2Mul(a.c0, b0);
  Fp2 t1 = fp2Mul(a.c1, b1);
  Fp2 c0 = fp2Add(t0, fp2MulByNonresidue(fp2Mul(a.c2, b1)));
  Fp2 c1 = fp2Sub(fp2Sub(fp2Mul(fp2Add(a.c0, a.c1), fp2Add(b0, b1)), t0), t1);
  Fp2 c2 = fp2Add(fp2Mul(a.c2, b0), t1);
  return Fp6(c0, c1, c2);
}

/** `a·(b1·v)` — sparser still, for the other line shape. */
export Fp6 fp6MulBy1(Fp6 a, Fp2 b1) {
  return Fp6(fp2MulByNonresidue(fp2Mul(a.c2, b1)), fp2Mul(a.c0, b1), fp2Mul(a.c1, b1));
}

/** `a⁻¹`, or null when `a` is zero. */
export Fp6? fp6Invert(Fp6 a) {
  Fp2 t0 = fp2Sub(fp2Square(a.c0), fp2MulByNonresidue(fp2Mul(a.c1, a.c2)));
  Fp2 t1 = fp2Sub(fp2MulByNonresidue(fp2Square(a.c2)), fp2Mul(a.c0, a.c1));
  Fp2 t2 = fp2Sub(fp2Square(a.c1), fp2Mul(a.c0, a.c2));
  Fp2 d = fp2Add(fp2Mul(a.c0, t0),
                 fp2MulByNonresidue(fp2Add(fp2Mul(a.c2, t1), fp2Mul(a.c1, t2))));
  Fp2? n = fp2Invert(d);
  if (n is null) { return null; }
  return Fp6(fp2Mul(t0, n!), fp2Mul(t1, n!), fp2Mul(t2, n!));
}

/** ξ^((p^1−1)/3), the Fp6 Frobenius coefficient on v. */
Fp2 frob6C1_1() {
  u32[] a = u32[12]();
  a[0] = 0x00000000; a[1] = 0x00000000; a[2] = 0x00000000; a[3] = 0x00000000;
  a[4] = 0x00000000; a[5] = 0x00000000; a[6] = 0x00000000; a[7] = 0x00000000;
  a[8] = 0x00000000; a[9] = 0x00000000; a[10] = 0x00000000; a[11] = 0x00000000;
  u32[] b = u32[12]();
  b[0] = 0x8671f071; b[1] = 0xcd03c9e4; b[2] = 0x1fcda5d2; b[3] = 0x5dab2246;
  b[4] = 0xd3851b95; b[5] = 0x587042af; b[6] = 0x01bacb9e; b[7] = 0x8eb60ebe;
  b[8] = 0x83d050d2; b[9] = 0x03f97d6e; b[10] = 0x54638741; b[11] = 0x18f02065;
  return Fp2(a, b);
}

/** ξ^(2(p^1−1)/3), the coefficient on v². */
Fp2 frob6C2_1() {
  u32[] a = u32[12]();
  a[0] = 0x867545c3; a[1] = 0x890dc9e4; a[2] = 0x3285a5d5; a[3] = 0x2af32253;
  a[4] = 0x309b7e2c; a[5] = 0x50880866; a[6] = 0x7e881024; a[7] = 0xa20d1b8c;
  a[8] = 0xe2db9068; a[9] = 0x14e4f04f; a[10] = 0x1564853a; a[11] = 0x14e56d3f;
  u32[] b = u32[12]();
  b[0] = 0x00000000; b[1] = 0x00000000; b[2] = 0x00000000; b[3] = 0x00000000;
  b[4] = 0x00000000; b[5] = 0x00000000; b[6] = 0x00000000; b[7] = 0x00000000;
  b[8] = 0x00000000; b[9] = 0x00000000; b[10] = 0x00000000; b[11] = 0x00000000;
  return Fp2(a, b);
}

