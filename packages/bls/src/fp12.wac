  b[0] = 0x00000000; b[1] = 0x00000000; b[2] = 0x00000000; b[3] = 0x00000000;
  b[4] = 0x00000000; b[5] = 0x00000000; b[6] = 0x00000000; b[7] = 0x00000000;
  b[8] = 0x00000000; b[9] = 0x00000000; b[10] = 0x00000000; b[11] = 0x00000000;
  return Fp2(a, b);
}

/** ξ^((p^3−1)/6), the Fp12 Frobenius coefficient on w. */
Fp2 frob12C1_3() {
  u32[] a = u32[12]();
  a[0] = 0xa55c9ad1; a[1] = 0x3e2f585d; a[2] = 0x86c18183; a[3] = 0x4294213d;
  a[4] = 0x8b623732; a[5] = 0x382844c8; a[6] = 0x19103e18; a[7] = 0x92ad2afd;
  a[8] = 0xac7cf0b9; a[9] = 0x1d794e4f; a[10] = 0x7d825ec8; a[11] = 0x0bd592fc;
  u32[] b = u32[12]();
  b[0] = 0x5aa30fda; b[1] = 0x7bcfa7a2; b[2] = 0x2a927e7c; b[3] = 0xdc17dec1;
  b[4] = 0x6b4ebef1; b[5] = 0x2f088dd8; b[6] = 0xda74d4a7; b[7] = 0xd1ca2087;
  b[8] = 0x96cebc1d; b[9] = 0x2da25966; b[10] = 0xbbfd87d2; b[11] = 0x0e2b7eed;
  return Fp2(a, b);
}

/**
 * The pⁿ-power map on Fp6, for n in {1, 2, 3}.
 *
 * On Fp2 the p-power map is conjugation, because p ≡ 3 (mod 4) makes `u^p = −u`; an even power
 * is the identity. Everything else is the constants above.
 */
export Fp6 fp6Frobenius(Fp6 a, i32 n) {
  Fp2 b0 = (n == 2) ? fp2Copy(a.c0) : fp2Conjugate(a.c0);
  Fp2 b1 = (n == 2) ? fp2Copy(a.c1) : fp2Conjugate(a.c1);
  Fp2 b2 = (n == 2) ? fp2Copy(a.c2) : fp2Conjugate(a.c2);
  Fp2 k1 = (n == 1) ? frob6C1_1() : ((n == 2) ? frob6C1_2() : frob6C1_3());
  Fp2 k2 = (n == 1) ? frob6C2_1() : ((n == 2) ? frob6C2_2() : frob6C2_3());
  return Fp6(b0, fp2Mul(b1, k1), fp2Mul(b2, k2));
}

// ── Fp12 ─────────────────────────────────────────────────────────────────────

export Fp12 fp12Zero() { return Fp12(fp6Zero(), fp6Zero()); }
export Fp12 fp12One() { return Fp12(fp6One(), fp6Zero()); }
export bool fp12Equals(Fp12 a, Fp12 b) {
  return fp6Equals(a.c0, b.c0) && fp6Equals(a.c1, b.c1);
}
export bool fp12IsOne(Fp12 a) { return fp12Equals(a, fp12One()); }

export Fp12 fp12Add(Fp12 a, Fp12 b) { return Fp12(fp6Add(a.c0, b.c0), fp6Add(a.c1, b.c1)); }
export Fp12 fp12Sub(Fp12 a, Fp12 b) { return Fp12(fp6Sub(a.c0, b.c0), fp6Sub(a.c1, b.c1)); }

/**
 * `c0 − c1·w`.
 *
 * On the cyclotomic subgroup — everything the pairing produces after the final exponentiation
 * lives there — this *is* the inverse, which is why the final exponentiation can avoid an
 * Fp12 inversion almost entirely. A sign error here is the classic way to get a pairing that
 * satisfies bilinearity and matches no published value.
 */
export Fp12 fp12Conjugate(Fp12 a) { return Fp12(a.c0, fp6Neg(a.c1)); }

/** Three Fp6 multiplications, by Karatsuba, with `w² = v` folding the cross term. */
export Fp12 fp12Mul(Fp12 a, Fp12 b) {
  Fp6 t0 = fp6Mul(a.c0, b.c0);
  Fp6 t1 = fp6Mul(a.c1, b.c1);
  Fp6 c0 = fp6Add(t0, fp6MulByV(t1));
  Fp6 mid = fp6Mul(fp6Add(a.c0, a.c1), fp6Add(b.c0, b.c1));
  return Fp12(c0, fp6Sub(fp6Sub(mid, t0), t1));
}

/**
 * Squaring in two Fp6 multiplications rather than the three `fp12Mul` would use.
 *
 * Complex squaring: with `w² = v`,
 *
 *   (a0 + a1·w)² = (a0² + v·a1²) + 2·a0·a1·w
 *
 * and `a0² + v·a1²` factors as `(a0 + a1)(a0 + v·a1) − a0a1 − v·a0a1`, so one product serves both
 * coefficients. The final exponentiation does about 315 of these, so a third off each is worth
 * having — and it was `fp12Mul(a, a)` until someone counted.
 */
export Fp12 fp12Square(Fp12 a) {
  Fp6 t = fp6Mul(a.c0, a.c1);
  Fp6 cross = fp6Mul(fp6Add(a.c0, a.c1), fp6Add(a.c0, fp6MulByV(a.c1)));
  Fp6 c0 = fp6Sub(fp6Sub(cross, t), fp6MulByV(t));
  return Fp12(c0, fp6Add(t, t));
}

/**
 * Squaring for elements of the cyclotomic subgroup GΦ₆(p²) — Granger–Scott, eprint 2009/565.
 *
 * Every value the final exponentiation touches lives in this subgroup: the easy part maps into it
 * and the subgroup is closed under multiplication, conjugation and Frobenius. There the six Fp2
 * coefficients satisfy relations that a general Fp12 element does not, and squaring reduces to
 * three Fp4 squarings — nine Fp2 multiplies against `fp12Square`'s eighteen.
 *
 * It is *wrong* outside the subgroup, which is why it is not called `fp12Square`. The Miller loop
 * must keep the general one; its accumulator is not cyclotomic until the easy part has run.
 *
 * The three Fp4 squarings are inlined rather than factored into a helper returning a pair: this
 * runs ~315 times per verification and three fewer heap objects each time is the point.
 */
export Fp12 fp12CyclotomicSquare(Fp12 a) {
  // Fp4 squaring of (x, y) is (x² + ξy², (x+y)² − x² − y²), over three coefficient pairs.
  Fp2 a2 = fp2Square(a.c0.c0);
  Fp2 b2 = fp2Square(a.c1.c1);
  Fp2 t3 = fp2Add(fp2MulByNonresidue(b2), a2);
  Fp2 t4 = fp2Sub(fp2Sub(fp2Square(fp2Add(a.c0.c0, a.c1.c1)), a2), b2);

  Fp2 c2 = fp2Square(a.c1.c0);
  Fp2 d2 = fp2Square(a.c0.c2);
  Fp2 t5 = fp2Add(fp2MulByNonresidue(d2), c2);
  Fp2 t6 = fp2Sub(fp2Sub(fp2Square(fp2Add(a.c1.c0, a.c0.c2)), c2), d2);

  Fp2 e2 = fp2Square(a.c0.c1);
  Fp2 f2 = fp2Square(a.c1.c2);
  Fp2 t7 = fp2Add(fp2MulByNonresidue(f2), e2);
  Fp2 t8 = fp2Sub(fp2Sub(fp2Square(fp2Add(a.c0.c1, a.c1.c2)), e2), f2);
  Fp2 t9 = fp2MulByNonresidue(t8);

  // Each coefficient is 3·t ∓ 2·original: 2(t − orig) + t on c0, 2(t + orig) + t on c1.
  Fp2 x0 = fp2Sub(t3, a.c0.c0);
  Fp2 x1 = fp2Sub(t5, a.c0.c1);
  Fp2 x2 = fp2Sub(t7, a.c0.c2);
  Fp2 y0 = fp2Add(t9, a.c1.c0);
  Fp2 y1 = fp2Add(t4, a.c1.c1);
  Fp2 y2 = fp2Add(t6, a.c1.c2);
  return Fp12(
    Fp6(fp2Add(fp2Add(x0, x0), t3), fp2Add(fp2Add(x1, x1), t5), fp2Add(fp2Add(x2, x2), t7)),
    Fp6(fp2Add(fp2Add(y0, y0), t9), fp2Add(fp2Add(y1, y1), t4), fp2Add(fp2Add(y2, y2), t6)));
}

export Fp12? fp12Invert(Fp12 a) {
  Fp6? t = fp6Invert(fp6Sub(fp6Square(a.c0), fp6MulByV(fp6Square(a.c1))));
  if (t is null) { return null; }
  return Fp12(fp6Mul(a.c0, t!), fp6Neg(fp6Mul(a.c1, t!)));
}

/** The pⁿ-power map on Fp12, for n in {1, 2, 3}. */
export Fp12 fp12Frobenius(Fp12 a, i32 n) {
  Fp6 b0 = fp6Frobenius(a.c0, n);
  Fp6 b1 = fp6Frobenius(a.c1, n);
  Fp2 k = (n == 1) ? frob12C1_1() : ((n == 2) ? frob12C1_2() : frob12C1_3());
  return Fp12(b0, Fp6(fp2Mul(b1.c0, k), fp2Mul(b1.c1, k), fp2Mul(b1.c2, k)));
}

/**
 * `f · (o0 + o1·v + o4·v·w)` — the sparse multiply a line evaluation needs.
 *
 * Three of the six Fp2 coefficients are zero, so this is three sparse Fp6 multiplies rather than
 * the three full ones `fp12Mul` would do. On a Miller loop of ~64 iterations with one or two line
 * evaluations each, that is most of the pairing's cost.
 *
 * The naming is the convention the pairing literature uses: 0, 1 and 4 are the indices of the
 * non-zero coefficients when Fp12 is read as six Fp2 values.
 */
export Fp12 fp12MulBy014(Fp12 f, Fp2 o0, Fp2 o1, Fp2 o4) {
  Fp6 t0 = fp6MulBy01(f.c0, o0, o1);
  Fp6 t1 = fp6MulBy1(f.c1, o4);
  Fp6 t2 = fp6MulBy01(fp6Add(f.c0, f.c1), o0, fp2Add(o1, o4));
  return Fp12(fp6Add(fp6MulByV(t1), t0), fp6Sub(fp6Sub(t2, t0), t1));
}

/**
 * `f^(p⁶)`, by composing the cube-power Frobenius with itself.
 *
 * Needed by the final exponentiation's easy part, where `f` is not yet in the cyclotomic subgroup
 * and so conjugation is *not* yet the same thing as this. Once past the easy part they coincide,
 * which is what makes the rest of the chain cheap — and mistaking one for the other before that
 * point is a bug the vectors would catch and bilinearity would not.
 */
export Fp12 fp12FrobeniusP6(Fp12 a) { return fp12Frobenius(fp12Frobenius(a, 3), 3); }
