Fp2 frob6C2_2() {
  u32[] a = u32[12]();
  a[0] = 0x8671f071; a[1] = 0xcd03c9e4; a[2] = 0x1fcda5d2; a[3] = 0x5dab2246;
  a[4] = 0xd3851b95; a[5] = 0x587042af; a[6] = 0x01bacb9e; a[7] = 0x8eb60ebe;
  a[8] = 0x83d050d2; a[9] = 0x03f97d6e; a[10] = 0x54638741; a[11] = 0x18f02065;
