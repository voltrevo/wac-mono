/** ξ^((p^1−1)/6), the Fp12 Frobenius coefficient on w. */
Fp2 frob12C1_1() {
  u32[] a = u32[12]();
  a[0] = 0xb319d465; a[1] = 0x07089552; a[2] = 0xb50a8313; a[3] = 0xc6695f92;
