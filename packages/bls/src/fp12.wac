/** ξ^((p^2−1)/6), the Fp12 Frobenius coefficient on w. */
Fp2 frob12C1_2() {
  u32[] a = u32[12]();
  a[0] = 0x798dba3a; a[1] = 0xecfb361b; a[2] = 0x91865a2c; a[3] = 0xc100ddb8;
  a[4] = 0x232bda8e; a[5] = 0x0ec08ff1; a[6] = 0xf1ca4721; a[7] = 0xd5c13cc6;
