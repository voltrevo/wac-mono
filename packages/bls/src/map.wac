/**
 * Simplified SWU onto E', returning affine (x, y).
 *
 * Follows RFC 9380 §6.6.2 step for step, including the two branches that look like edge cases
 * and are not: when `Z²u⁴ + Zu²` is zero the formula would divide by zero and the constant
 * `−1/Z` stands in, and when `g(x1)` is not a square the map uses `x2` instead. Both happen for
 * real inputs, and a version that ignored either would work for almost every message.
 */
Fp2[] mapToCurveSswu(Fp2 u) {
  Fp2 a = swuA();
  Fp2 b = swuB();
  Fp2 z = swuZ();

  Fp2 tv1 = fp2Mul(z, fp2Square(u));                 // Z·u²
  Fp2 tv2 = fp2Square(tv1);                          // Z²·u⁴
  Fp2 x1 = fp2Add(tv1, tv2);
  x1 = fp2Inv0(x1);
  bool degenerate = fp2IsZero(x1);
  x1 = fp2Add(x1, fp2One());
  // −1/Z, the value the RFC substitutes when the denominator vanishes. A constant: the first
  // version inverted Z here on every call, and Z is `swuZ()`.
  if (degenerate) { x1 = swuNegInvZ(); }
  // x1 = (−B/A)·(1 + 1/(Z²u⁴ + Zu²)). −B/A is likewise a constant, and was likewise being
  // recomputed with a 570-multiplication inversion every time through.
  x1 = fp2Mul(x1, swuNegBOverA());

  Fp2 gx1 = fp2Add(fp2Mul(fp2Add(fp2Square(x1), a), x1), b);   // x1³ + A·x1 + B
  Fp2 x2 = fp2Mul(tv1, x1);                                    // Z·u²·x1
  Fp2 gx2 = fp2Mul(gx1, fp2Mul(tv1, tv2));                     // (Z·u²)³·gx1

  // One square root, not two. `fp2IsSquare` *is* an attempted root, so asking whether gx1 is a
  // square and then taking its root computed the same expensive thing twice — and a root is a
  // square-root exponentiation plus two inversions.
  Fp2? root1 = fp2Sqrt(gx1);
  bool square = root1 is not null;
  Fp2 x = square ? x1 : x2;
  Fp2 y = fp2Zero();
  if (square) { y = root1!; }
  else {
    Fp2? root2 = fp2Sqrt(gx2);
    if (root2 is not null) { y = root2!; }
  }

  // The sign of y follows the sign of u, by `sgn0` — parity, not the compression convention.
  if (fp2Sgn0(y) != fp2Sgn0(u)) { y = fp2Neg(y); }

  Fp2[] out = Fp2[2]();
  out[0] = x;
  out[1] = y;
  return out;
}

/**
 * The 3-isogeny E' → E, as four polynomial evaluations.
 *
 *   x = x_num / x_den  where x_num is cubic in x' and x_den quadratic with leading 1
 *   y = y' · y_num / y_den  where y_num is cubic and y_den cubic with leading 1
 *
 * Horner in each, and one shared inversion for the two denominators would save a little; it is
 * written the plain way because this runs twice per signature and correctness was the scarce
 * thing.
 */
G2 isogenyMap(Fp2 xp, Fp2 yp) {
  Fp2 x2 = fp2Square(xp);
  Fp2 x3 = fp2Mul(x2, xp);

  Fp2 xNum = fp2Add(fp2Add(fp2Mul(isoK13(), x3), fp2Mul(isoK12(), x2)),
                    fp2Add(fp2Mul(isoK11(), xp), isoK10()));
  Fp2 xDen = fp2Add(fp2Add(x2, fp2Mul(isoK21(), xp)), isoK20());

  Fp2 yNum = fp2Add(fp2Add(fp2Mul(isoK33(), x3), fp2Mul(isoK32(), x2)),
                    fp2Add(fp2Mul(isoK31(), xp), isoK30()));
  Fp2 yDen = fp2Add(fp2Add(x3, fp2Mul(isoK42(), x2)),
                    fp2Add(fp2Mul(isoK41(), xp), isoK40()));

  // A zero denominator is the isogeny's kernel, which maps to the point at infinity.
  if (fp2IsZero(xDen) || fp2IsZero(yDen)) { return G2(fp2One(), fp2One(), fp2Zero()); }

  // Jacobian directly, so no inversion is needed. With Z = xDen·yDen:
  //
  //   X = xNum·xDen·yDen²          X/Z² = xNum/xDen                    ✓
  //   Y = yp·yNum·xDen³·yDen²      Y/Z³ = yp·yNum/yDen                 ✓
  //
  // The `yDen²` on Y is the part I got wrong first time round, and it is worth keeping the
  // arithmetic written out. Without it, Y/Z³ comes to yp·yNum/yDen³ — x was correct, y was
  // cubed, and the point sat off the curve. The CFRG vectors named it immediately: Q0's x
  // matched to the byte and its y did not, which is a far smaller search than "hash_to_G2 is
  // wrong".
  Fp2 z = fp2Mul(xDen, yDen);
  Fp2 yDen2 = fp2Square(yDen);
  Fp2 x = fp2Mul(fp2Mul(xNum, xDen), yDen2);
  Fp2 xDen3 = fp2Mul(fp2Square(xDen), xDen);
  Fp2 y = fp2Mul(fp2Mul(fp2Mul(yp, yNum), xDen3), yDen2);
  return G2(x, y, z);
}

/** `map_to_curve` for G2: simplified SWU onto E', then the isogeny back to E. */
export G2 mapToCurveG2(Fp2 u) {
  Fp2[] p = mapToCurveSswu(u);
  return isogenyMap(p[0], p[1]);
}

/**
 * `clear_cofactor` by Budroni–Pintore (eprint 2017/419), rather than by multiplying by `h_eff`.
 *
 * The RFC defines the operation as `h_eff · P` with `h_eff` 636 bits, which is 636 doublings. This
 * computes the same subgroup element as
 *
 *     [x²−x−1]P + [x−1]Ψ(P) + Ψ²(2P)
 *
 * using the ψ endomorphism and two multiplications by the 64-bit |x| — measured, 12 ms of the
 * original 109. Ψ² is ψ applied twice; a dedicated ψ² map would save one Frobenius pair and is not
 * worth the second constant table.
 *
 * The signs are the whole difficulty. BLS12-381's x is **negative**, so `absXScalar()` is |x| and
 * each multiplication by it is followed by a negation. I first wrote this chain from memory and got
 * exactly that wrong — dropping both negations — which produces a point that is on the curve, in a
 * subgroup, and not the right one. Bilinearity would not have noticed. The version here follows
 * `@noble/curves` line for line, and what checks it is RFC 9380 §J.10's final `P` values together
 * with Ethereum's `hash_to_G2` fixtures, neither of which this implementation had any hand in.
 */
export G2 clearCofactorG2(G2 p) {
  G2 t1 = g2Negate(g2Mul(p, absXScalar()));            // [−x]P
  G2 t2 = g2Psi(p);                                    // Ψ(P)
  G2 t3 = g2Psi(g2Psi(g2Double(p)));                   // Ψ²(2P)
  t3 = g2Add(t3, g2Negate(t2));                        // Ψ²(2P) − Ψ(P)
  t2 = g2Negate(g2Mul(g2Add(t1, t2), absXScalar()));   // [x²]P − [x]Ψ(P)
  t3 = g2Add(t3, t2);
  t3 = g2Add(t3, g2Negate(t1));
  return g2Add(t3, g2Negate(p));
}

/**
 * `hash_to_G2(msg, DST)` — RFC 9380's random-oracle encoding.
 *
 * Two field elements, each mapped to the curve, added, then cofactor-cleared. The addition is
 * what makes it a *random oracle* rather than merely a map onto the curve: one `map_to_curve`
 * alone has a distinguishable image, which is the difference between `_RO_` and `_NU_` in the
 * suite name and matters for the security proof of anything built on it.
 */
export G2 hashToG2(u8[] msg, u8[] dst) {
  Fp2[] u = hashToFieldFp2(msg, dst);
  G2 q0 = mapToCurveG2(u[0]);
  G2 q1 = mapToCurveG2(u[1]);
  return clearCofactorG2(g2Add(q0, q1));
}
