// RFC 9380 §6.6.2 simplified SWU, and the 3-isogeny that carries its output back to G2.
//
// The map lands on E': y² = x³ + 240u·x + 1012(1 + u), which is 3-isogenous to the curve
// signatures actually live on. That indirection is not an optimisation — the real curve has
// A = 0, and simplified SWU needs A and B both non-zero, so the isogeny is how the construction
// applies at all.
//
// ## Every constant here came out of the draft by script
//
// The thirteen isogeny coefficients were parsed from RFC 9380's appendix, shape-checked against
// the 4/2/4/3 the 3-isogeny must have, and emitted in Montgomery form. My first parse silently
// merged them with G1's *11*-isogeny — a single-digit regex turned `k_(1,11)` into `k_(1,1)` —
// and produced forty plausible-looking coefficients. The shape assertion caught it; the spot
// checks I had written did not, because the collision missed the ones they tested.
//
// That is the whole argument for the arrangement of this package: wrong constants give
// arithmetic that is entirely self-consistent and disagrees only with published vectors.

import { fpZero, fpOne } from "./fp.wac";
import { Fp2, fp2Add, fp2Sub, fp2Mul, fp2Square, fp2Neg, fp2Zero, fp2One, fp2IsZero, fp2Equals,
         fp2Copy, fp2Invert, fp2Sqrt, fp2Sgn0, fp2Inv0, fp2IsSquare } from "./fp2.wac";
import { G2, g2Add, g2Mul, g2Double, g2Negate, g2Psi,
         absX as absXScalar } from "./g2.wac";
import { hashToFieldFp2 } from "./hash.wac";

/** A' = 240·u, the isogenous curve's A. */
Fp2 swuA() {
  u32[] a = u32[12]();
  a[0] = 0x00000000; a[1] = 0x00000000; a[2] = 0x00000000; a[3] = 0x00000000;
  a[4] = 0x00000000; a[5] = 0x00000000; a[6] = 0x00000000; a[7] = 0x00000000;
  a[8] = 0x00000000; a[9] = 0x00000000; a[10] = 0x00000000; a[11] = 0x00000000;
  u32[] b = u32[12]();
  b[0] = 0x03135242; b[1] = 0xe53a0000; b[2] = 0xdef80285; b[3] = 0x01080c0f;
  b[4] = 0xe340f6bd; b[5] = 0xe7889edb; b[6] = 0x26310601; b[7] = 0x0b513751;
  b[8] = 0x17c744ab; b[9] = 0x02d69857; b[10] = 0x79ea5467; b[11] = 0x1220b4e9;
  return Fp2(a, b);
}

