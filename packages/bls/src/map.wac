/** -1/Z, the value substituted when the SSWU denominator vanishes. */
Fp2 swuNegInvZ() {
  u32[] a = u32[12]();
  a[0] = 0x00011110; a[1] = 0xacd00000; a[2] = 0xc88ccccd; a[3] = 0x9dd9999d;
