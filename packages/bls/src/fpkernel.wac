  acc = t1 + a1 * bi + carry;
  t1 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t2 + a2 * bi + carry;
  t2 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t3 + a3 * bi + carry;
  t3 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t4 + a4 * bi + carry;
  t4 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t5 + a5 * bi + carry;
  t5 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t6 + a6 * bi + carry;
  t6 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t7 + a7 * bi + carry;
  t7 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t8 + a8 * bi + carry;
  t8 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t9 + a9 * bi + carry;
  t9 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t10 + a10 * bi + carry;
  t10 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t11 + a11 * bi + carry;
  t11 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  hi = t12 + carry;
  t12 = hi & 0xFFFFFFFF;
  spill = hi >> 32;
  m = (t0 * MINV) & 0xFFFFFFFF;
  carry = (t0 + 0xffffaaab * m) >> 32;
  acc = t1 + 0xb9feffff * m + carry;
  t0 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t2 + 0xb153ffff * m + carry;
  t1 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t3 + 0x1eabfffe * m + carry;
  t2 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t4 + 0xf6b0f624 * m + carry;
  t3 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t5 + 0x6730d2a0 * m + carry;
  t4 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t6 + 0xf38512bf * m + carry;
  t5 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t7 + 0x64774b84 * m + carry;
  t6 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t8 + 0x434bacd7 * m + carry;
  t7 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t9 + 0x4b1ba7b6 * m + carry;
  t8 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t10 + 0x397fe69a * m + carry;
  t9 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  acc = t11 + 0x1a0111ea * m + carry;
  t10 = acc & 0xFFFFFFFF;
  carry = acc >> 32;
  hi = t12 + carry;
  t11 = hi & 0xFFFFFFFF;
  t12 = spill + (hi >> 32);

  u32[] out = u32[12]();
  out[0] = (t0 & 0xFFFFFFFF) as@ u32;
  out[1] = (t1 & 0xFFFFFFFF) as@ u32;
  out[2] = (t2 & 0xFFFFFFFF) as@ u32;
  out[3] = (t3 & 0xFFFFFFFF) as@ u32;
  out[4] = (t4 & 0xFFFFFFFF) as@ u32;
  out[5] = (t5 & 0xFFFFFFFF) as@ u32;
  out[6] = (t6 & 0xFFFFFFFF) as@ u32;
  out[7] = (t7 & 0xFFFFFFFF) as@ u32;
  out[8] = (t8 & 0xFFFFFFFF) as@ u32;
  out[9] = (t9 & 0xFFFFFFFF) as@ u32;
  out[10] = (t10 & 0xFFFFFFFF) as@ u32;
  out[11] = (t11 & 0xFFFFFFFF) as@ u32;
  if (t12 != 0 || atLeastP(out)) { subPInPlace(out); }
  return out;
}
